        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1241"
                TIME_SLOT_REF1="ts2655" TIME_SLOT_REF2="ts2657">
                <ANNOTATION_VALUE>Иә.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1242"
                TIME_SLOT_REF1="ts2659" TIME_SLOT_REF2="ts2661">
                <ANNOTATION_VALUE>Анау кішкене өзі тұрсын.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1243"
                TIME_SLOT_REF1="ts2662" TIME_SLOT_REF2="ts2665">
                <ANNOTATION_VALUE>Пысса пысып қалатын шығар жәшікте.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1244"
                TIME_SLOT_REF1="ts2667" TIME_SLOT_REF2="ts2669">
                <ANNOTATION_VALUE>А.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1248"
                TIME_SLOT_REF1="ts2675" TIME_SLOT_REF2="ts2677">
                <ANNOTATION_VALUE>Біраз жәшікте тұрса,</ANNOTATION_VALUE>
