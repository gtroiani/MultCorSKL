            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1042" TIME_SLOT_REF1="ts2474" TIME_SLOT_REF2="ts2485">
                <ANNOTATION_VALUE>Oh that ¬Zulfiya... your father said she is a good kelin.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1545" TIME_SLOT_REF1="ts2488" TIME_SLOT_REF2="ts2492">
                <ANNOTATION_VALUE>She is ¬Alemkhan's oldest child.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1548" TIME_SLOT_REF1="ts2493" TIME_SLOT_REF2="ts2497">
                <ANNOTATION_VALUE>The rest died.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1549" TIME_SLOT_REF1="ts2500" TIME_SLOT_REF2="ts2503">
                <ANNOTATION_VALUE>For that old woman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1256" TIME_SLOT_REF1="ts2549" TIME_SLOT_REF2="ts2556">
                <ANNOTATION_VALUE>Yes, yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1257" TIME_SLOT_REF1="ts2557" TIME_SLOT_REF2="ts2562">
                <ANNOTATION_VALUE>It is good.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1540" TIME_SLOT_REF1="ts2573" TIME_SLOT_REF2="ts2579">
                <ANNOTATION_VALUE>She left once actually.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1541" TIME_SLOT_REF1="ts2582" TIME_SLOT_REF2="ts2593">
                <ANNOTATION_VALUE>She lived in Almaty, and after not returning for some time, she came back, didn't you know?  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1546" TIME_SLOT_REF1="ts2609" TIME_SLOT_REF2="ts2615">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1296" TIME_SLOT_REF1="ts2621" TIME_SLOT_REF2="ts2627">
                <ANNOTATION_VALUE>Well, yes, what ¬Alikhan did is...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1297" TIME_SLOT_REF1="ts2630" TIME_SLOT_REF2="ts2655">
                <ANNOTATION_VALUE>He lived with those people...hmm... ¬Zulfiya's sisters or something like this.   </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1304" TIME_SLOT_REF1="ts2658" TIME_SLOT_REF2="ts2661">
                <ANNOTATION_VALUE>I don't know.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1305" TIME_SLOT_REF1="ts2664" TIME_SLOT_REF2="ts2670">
                <ANNOTATION_VALUE>Is it a lie or a truth — I do not know.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1306" TIME_SLOT_REF1="ts2679" TIME_SLOT_REF2="ts2686">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1307" TIME_SLOT_REF1="ts2687" TIME_SLOT_REF2="ts2691">
                <ANNOTATION_VALUE>After that he sold his house in Almaty and returned.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1537" TIME_SLOT_REF1="ts2694" TIME_SLOT_REF2="ts2705">
                <ANNOTATION_VALUE>"Oh, she is in Almaty, waiting for ¬Nurbol", said those women, spreading rumors.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1319" TIME_SLOT_REF1="ts2778" TIME_SLOT_REF2="ts2780">
                <ANNOTATION_VALUE>Why did she wash those?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1320" TIME_SLOT_REF1="ts2783" TIME_SLOT_REF2="ts2794">
                <ANNOTATION_VALUE>She washed them all with a hosepipe in front of the house. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1321" TIME_SLOT_REF1="ts2800" TIME_SLOT_REF2="ts2811">
                <ANNOTATION_VALUE>After she did this, it all got muddy around.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1141" TIME_SLOT_REF1="ts2830" TIME_SLOT_REF2="ts2835">
                <ANNOTATION_VALUE>That's good.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1336" TIME_SLOT_REF1="ts2922" TIME_SLOT_REF2="ts2925">
                <ANNOTATION_VALUE>Russian?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a22814" TIME_SLOT_REF1="ts2929" TIME_SLOT_REF2="ts2932">
                <ANNOTATION_VALUE>Mhm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1337" TIME_SLOT_REF1="ts2934" TIME_SLOT_REF2="ts2937">
                <ANNOTATION_VALUE>Delicious...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1340" TIME_SLOT_REF1="ts2940" TIME_SLOT_REF2="ts2943">
                <ANNOTATION_VALUE>Del- del-...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1342" TIME_SLOT_REF1="ts2946" TIME_SLOT_REF2="ts2949">
                <ANNOTATION_VALUE>Where?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1343" TIME_SLOT_REF1="ts2952" TIME_SLOT_REF2="ts2958">
                <ANNOTATION_VALUE>Wow!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1346" TIME_SLOT_REF1="ts2961" TIME_SLOT_REF2="ts2970">
                <ANNOTATION_VALUE>So clean indeed!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1348" TIME_SLOT_REF1="ts2976" TIME_SLOT_REF2="ts2979">
                <ANNOTATION_VALUE>What will you do with it?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1351" TIME_SLOT_REF1="ts2988" TIME_SLOT_REF2="ts2991">
                <ANNOTATION_VALUE>Will you make kompot?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1354" TIME_SLOT_REF1="ts3006" TIME_SLOT_REF2="ts3017">
                <ANNOTATION_VALUE>Then take this and put it higher into that place where other jars are kept.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1358" TIME_SLOT_REF1="ts3026" TIME_SLOT_REF2="ts3029">
                <ANNOTATION_VALUE>Will you put it into that?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1362" TIME_SLOT_REF1="ts3052" TIME_SLOT_REF2="ts3055">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1363" TIME_SLOT_REF1="ts3064" TIME_SLOT_REF2="ts3067">
                <ANNOTATION_VALUE>Oh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1364" TIME_SLOT_REF1="ts3076" TIME_SLOT_REF2="ts3083">
                <ANNOTATION_VALUE>Oh, yes, I see. You are going to make it in the big bowl. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1368" TIME_SLOT_REF1="ts3086" TIME_SLOT_REF2="ts3088">
                <ANNOTATION_VALUE>Don't give them your mantovarka!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1370" TIME_SLOT_REF1="ts3089" TIME_SLOT_REF2="ts3096">
                <ANNOTATION_VALUE>No need. They will get one themselves.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1371" TIME_SLOT_REF1="ts3097" TIME_SLOT_REF2="ts3101">
                <ANNOTATION_VALUE>They all earn money.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1372" TIME_SLOT_REF1="ts3104" TIME_SLOT_REF2="ts3111">
                <ANNOTATION_VALUE>You stupid... they said you told them they can take your mantovarka. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1373" TIME_SLOT_REF1="ts3114" TIME_SLOT_REF2="ts3117">
                <ANNOTATION_VALUE>I said, "Did you give it in an exchange for something?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1374" TIME_SLOT_REF1="ts3120" TIME_SLOT_REF2="ts3124">
                <ANNOTATION_VALUE>I normally don't speak like that.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1375" TIME_SLOT_REF1="ts3125" TIME_SLOT_REF2="ts3129">
                <ANNOTATION_VALUE>I got angry.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1376" TIME_SLOT_REF1="ts3132" TIME_SLOT_REF2="ts3135">
                <ANNOTATION_VALUE>I never raised voiced at any one of them.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1377" TIME_SLOT_REF1="ts3138" TIME_SLOT_REF2="ts3141">
                <ANNOTATION_VALUE>I do not know.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1378" TIME_SLOT_REF1="ts3144" TIME_SLOT_REF2="ts3147">
                <ANNOTATION_VALUE>She...also...you...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1379" TIME_SLOT_REF1="ts3150" TIME_SLOT_REF2="ts3154">
                <ANNOTATION_VALUE>um-m-m-...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1380" TIME_SLOT_REF1="ts3155" TIME_SLOT_REF2="ts3159">
                <ANNOTATION_VALUE>does that...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1381" TIME_SLOT_REF1="ts3162" TIME_SLOT_REF2="ts3164">
                <ANNOTATION_VALUE>...makes you angry.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1382" TIME_SLOT_REF1="ts3168" TIME_SLOT_REF2="ts3176">
                <ANNOTATION_VALUE>I said "She was happy saying that her zhezde bought it for her". </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1384" TIME_SLOT_REF1="ts3180" TIME_SLOT_REF2="ts3190">
                <ANNOTATION_VALUE>I said, "You did not buy it either, ¬Ekonay bought it for her..gave the money for it".  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1387" TIME_SLOT_REF1="ts3194" TIME_SLOT_REF2="ts3205">
                <ANNOTATION_VALUE>I do not know...you remember the thing you brought me which was brown and light? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1389" TIME_SLOT_REF1="ts3208" TIME_SLOT_REF2="ts3211">
                <ANNOTATION_VALUE>I also left it there.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1390" TIME_SLOT_REF1="ts3214" TIME_SLOT_REF2="ts3225">
                <ANNOTATION_VALUE>She took it, saying "Why do you need it? It does not fit you"  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1391" TIME_SLOT_REF1="ts3234" TIME_SLOT_REF2="ts3237">
                <ANNOTATION_VALUE>I said, "Ok, let it stay".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1394" TIME_SLOT_REF1="ts3246" TIME_SLOT_REF2="ts3257">
                <ANNOTATION_VALUE>That brown, light clothing Aisulu brought...you and Bayan bought for me...  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1395" TIME_SLOT_REF1="ts3260" TIME_SLOT_REF2="ts3267">
                <ANNOTATION_VALUE>...the thing that you put on...it is light.. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1396" TIME_SLOT_REF1="ts3275" TIME_SLOT_REF2="ts3280">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1397" TIME_SLOT_REF1="ts3281" TIME_SLOT_REF2="ts3285">
                <ANNOTATION_VALUE>Was it a cardgian?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1399" TIME_SLOT_REF1="ts3306" TIME_SLOT_REF2="ts3309">
                <ANNOTATION_VALUE>Not blue.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1400" TIME_SLOT_REF1="ts3312" TIME_SLOT_REF2="ts3315">
                <ANNOTATION_VALUE>Brown.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1401" TIME_SLOT_REF1="ts3318" TIME_SLOT_REF2="ts3321">
                <ANNOTATION_VALUE>With the blue thingy.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1406" TIME_SLOT_REF1="ts3340" TIME_SLOT_REF2="ts3342">
                <ANNOTATION_VALUE>Not expensive actually.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1407" TIME_SLOT_REF1="ts3352" TIME_SLOT_REF2="ts3359">
                <ANNOTATION_VALUE>Oh my, that thing that you put on over a dress, you know? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1411" TIME_SLOT_REF1="ts3372" TIME_SLOT_REF2="ts3383">
                <ANNOTATION_VALUE>The one that does not have a collar and that has some cloth in the neck area... </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1412" TIME_SLOT_REF1="ts3386" TIME_SLOT_REF2="ts3392">
                <ANNOTATION_VALUE>...with a weaving.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1413" TIME_SLOT_REF1="ts3404" TIME_SLOT_REF2="ts3407">
                <ANNOTATION_VALUE>How could I know...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1416" TIME_SLOT_REF1="ts3410" TIME_SLOT_REF2="ts3413">
                <ANNOTATION_VALUE>I... it..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1417" TIME_SLOT_REF1="ts3416" TIME_SLOT_REF2="ts3419">
                <ANNOTATION_VALUE>..maybe she will deliver it to me through somebody.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1421" TIME_SLOT_REF1="ts3443" TIME_SLOT_REF2="ts3450">
                <ANNOTATION_VALUE>Oh, god!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1534" TIME_SLOT_REF1="ts3451" TIME_SLOT_REF2="ts3462">
                <ANNOTATION_VALUE>Oh my, did anybody bring me any good stuff...ever? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1422" TIME_SLOT_REF1="ts3465" TIME_SLOT_REF2="ts3471">
                <ANNOTATION_VALUE>No, I know.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1423" TIME_SLOT_REF1="ts3474" TIME_SLOT_REF2="ts3478">
                <ANNOTATION_VALUE>I..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1424" TIME_SLOT_REF1="ts3479" TIME_SLOT_REF2="ts3483">
                <ANNOTATION_VALUE>I also know the difference.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1426" TIME_SLOT_REF1="ts3486" TIME_SLOT_REF2="ts3489">
                <ANNOTATION_VALUE>I know all of it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1427" TIME_SLOT_REF1="ts3507" TIME_SLOT_REF2="ts3521">
                <ANNOTATION_VALUE> Its fabric and its quality - I know all of it.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1435" TIME_SLOT_REF1="ts3556" TIME_SLOT_REF2="ts3564">
                <ANNOTATION_VALUE>No, it doesn't.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1437" TIME_SLOT_REF1="ts3566" TIME_SLOT_REF2="ts3573">
                <ANNOTATION_VALUE>She said, "You will take it later when you need it". </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1438" TIME_SLOT_REF1="ts3586" TIME_SLOT_REF2="ts3589">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1441" TIME_SLOT_REF1="ts3598" TIME_SLOT_REF2="ts3601">
                <ANNOTATION_VALUE>No.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1442" TIME_SLOT_REF1="ts3604" TIME_SLOT_REF2="ts3607">
                <ANNOTATION_VALUE>It fits.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1443" TIME_SLOT_REF1="ts3614" TIME_SLOT_REF2="ts3617">
                <ANNOTATION_VALUE>I am not sure but she said she would bring it when she'll come here.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1444" TIME_SLOT_REF1="ts3620" TIME_SLOT_REF2="ts3623">
                <ANNOTATION_VALUE>Looks like she will bring it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1445" TIME_SLOT_REF1="ts3626" TIME_SLOT_REF2="ts3650">
                <ANNOTATION_VALUE>And then after scolding me, she says "Why do you need this, why do you need that?"     </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1449" TIME_SLOT_REF1="ts3652" TIME_SLOT_REF2="ts3655">
                <ANNOTATION_VALUE>And so, I have one dress.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1532" TIME_SLOT_REF1="ts3658" TIME_SLOT_REF2="ts3661">
                <ANNOTATION_VALUE>Ink...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1535" TIME_SLOT_REF1="ts3664" TIME_SLOT_REF2="ts3673">
                <ANNOTATION_VALUE>¬Zhaidar gave her..that thingy of hers. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1450" TIME_SLOT_REF1="ts3672" TIME_SLOT_REF2="ts3681">
                <ANNOTATION_VALUE>She bought it a long time ago when she lived in the aul.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1451" TIME_SLOT_REF1="ts3684" TIME_SLOT_REF2="ts3687">
                <ANNOTATION_VALUE>A velour dress.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1452" TIME_SLOT_REF1="ts3690" TIME_SLOT_REF2="ts3697">
                <ANNOTATION_VALUE>She took that as well, saying "Why do you need this?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1453" TIME_SLOT_REF1="ts3700" TIME_SLOT_REF2="ts3707">
                <ANNOTATION_VALUE>"No need, ok", I said.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1454" TIME_SLOT_REF1="ts3710" TIME_SLOT_REF2="ts3717">
                <ANNOTATION_VALUE>I said, "As long as you do not burn them, it is ok. Do not burn them." </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1455" TIME_SLOT_REF1="ts3726" TIME_SLOT_REF2="ts3729">
                <ANNOTATION_VALUE>Yeah, I know.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1460" TIME_SLOT_REF1="ts3756" TIME_SLOT_REF2="ts3766">
                <ANNOTATION_VALUE>The other day, ¬Salim's yellow daughter..  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1463" TIME_SLOT_REF1="ts3770" TIME_SLOT_REF2="ts3777">
                <ANNOTATION_VALUE>..mmm when there was this...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1464" TIME_SLOT_REF1="ts3780" TIME_SLOT_REF2="ts3787">
                <ANNOTATION_VALUE>mmmm...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1468" TIME_SLOT_REF1="ts3802" TIME_SLOT_REF2="ts3805">
                <ANNOTATION_VALUE>They gave katym.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1469" TIME_SLOT_REF1="ts3812" TIME_SLOT_REF2="ts3815">
                <ANNOTATION_VALUE>They invited me there.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1472" TIME_SLOT_REF1="ts3818" TIME_SLOT_REF2="ts3822">
                <ANNOTATION_VALUE>Her husband is such a good guy.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1473" TIME_SLOT_REF1="ts3823" TIME_SLOT_REF2="ts3830">
                <ANNOTATION_VALUE>The way he speaks is so nice.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1476" TIME_SLOT_REF1="ts3839" TIME_SLOT_REF2="ts3845">
                <ANNOTATION_VALUE>He is so spirited.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1479" TIME_SLOT_REF1="ts3848" TIME_SLOT_REF2="ts3852">
                <ANNOTATION_VALUE>Hm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1480" TIME_SLOT_REF1="ts3853" TIME_SLOT_REF2="ts3865">
                <ANNOTATION_VALUE>¬Luba was there, covering her head.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1481" TIME_SLOT_REF1="ts3868" TIME_SLOT_REF2="ts3871">
                <ANNOTATION_VALUE>Looks good.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1482" TIME_SLOT_REF1="ts3886" TIME_SLOT_REF2="ts3889">
                <ANNOTATION_VALUE>I also thought that she was pregnant.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1484" TIME_SLOT_REF1="ts3892" TIME_SLOT_REF2="ts3902">
                <ANNOTATION_VALUE>Oh, she recovered from that thing.. right? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1485" TIME_SLOT_REF1="ts3908" TIME_SLOT_REF2="ts3922">
                <ANNOTATION_VALUE>Mmm, mmm, from cancer?  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1487" TIME_SLOT_REF1="ts3928" TIME_SLOT_REF2="ts3931">
                <ANNOTATION_VALUE>I also thought so.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1488" TIME_SLOT_REF1="ts3934" TIME_SLOT_REF2="ts3941">
                <ANNOTATION_VALUE>¬Takalok is such a glutton, you know. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1490" TIME_SLOT_REF1="ts3944" TIME_SLOT_REF2="ts3959">
                <ANNOTATION_VALUE>He came in, sat down, holding his two kids, and kept eating everyting that was on the table.   </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1494" TIME_SLOT_REF1="ts3984" TIME_SLOT_REF2="ts3987">
                <ANNOTATION_VALUE>Oh, for God's sake!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1495" TIME_SLOT_REF1="ts3990" TIME_SLOT_REF2="ts3997">
                <ANNOTATION_VALUE>A little kid, dealing with being a father of four children... </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1497" TIME_SLOT_REF1="ts4000" TIME_SLOT_REF2="ts4004">
                <ANNOTATION_VALUE>His wife is good.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1498" TIME_SLOT_REF1="ts4005" TIME_SLOT_REF2="ts4009">
                <ANNOTATION_VALUE>The mother is like a Russian... a moron.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1499" TIME_SLOT_REF1="ts4012" TIME_SLOT_REF2="ts4015">
                <ANNOTATION_VALUE>Oh, his dad is...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1500" TIME_SLOT_REF1="ts4022" TIME_SLOT_REF2="ts4025">
                <ANNOTATION_VALUE>But his dad is very Kazakh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1501" TIME_SLOT_REF1="ts4028" TIME_SLOT_REF2="ts4031">
                <ANNOTATION_VALUE>That blacnkess of his hands...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1502" TIME_SLOT_REF1="ts4034" TIME_SLOT_REF2="ts4041">
                <ANNOTATION_VALUE>Oh my god.. with the tip of his hand he cut the meat. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1505" TIME_SLOT_REF1="ts4057" TIME_SLOT_REF2="ts4060">
                <ANNOTATION_VALUE>Oh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1506" TIME_SLOT_REF1="ts4066" TIME_SLOT_REF2="ts4073">
                <ANNOTATION_VALUE>The mother was just speaking Russian only!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1509" TIME_SLOT_REF1="ts4098" TIME_SLOT_REF2="ts4101">
                <ANNOTATION_VALUE>Of course, it is.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1510" TIME_SLOT_REF1="ts4104" TIME_SLOT_REF2="ts4107">
                <ANNOTATION_VALUE>What else should happen to it?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1513" TIME_SLOT_REF1="ts4110" TIME_SLOT_REF2="ts4128">
                <ANNOTATION_VALUE>After you are done organizing that, we should cut these for kompot.. oh no.. for jam.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1514" TIME_SLOT_REF1="ts4146" TIME_SLOT_REF2="ts4154">
                <ANNOTATION_VALUE>No, I mean in case you want to make jam. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1518" TIME_SLOT_REF1="ts4163" TIME_SLOT_REF2="ts4169">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1519" TIME_SLOT_REF1="ts4172" TIME_SLOT_REF2="ts4179">
                <ANNOTATION_VALUE>See how it will turn out. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1526" TIME_SLOT_REF1="ts4206" TIME_SLOT_REF2="ts4209">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1528" TIME_SLOT_REF1="ts4222" TIME_SLOT_REF2="ts4225">
                <ANNOTATION_VALUE>They will ripen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1529" TIME_SLOT_REF1="ts4228" TIME_SLOT_REF2="ts4235">
                <ANNOTATION_VALUE>Just cover them. They will ripen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
