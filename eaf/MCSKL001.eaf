        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a626"
                TIME_SLOT_REF1="ts750" TIME_SLOT_REF2="ts757">
                <ANNOTATION_VALUE>Apparently, our Keneskhan has been given a position of some sort beside the town mayor.</ANNOTATION_VALUE>
