        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1293"
                TIME_SLOT_REF1="ts1476" TIME_SLOT_REF2="ts1480">
                <ANNOTATION_VALUE>Worked as copywriters. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1294"
