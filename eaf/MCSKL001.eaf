    </TIER>
    <TIER LINGUISTIC_TYPE_REF="Translation" TIER_ID="trx_en@SPK0032">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a226"
                TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts4">
                <ANNOTATION_VALUE>So when I got measured...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a227"
                TIME_SLOT_REF1="ts6" TIME_SLOT_REF2="ts12">
                <ANNOTATION_VALUE>I am not sure but the other day…I ate one bitter qurt…###</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a229"
                TIME_SLOT_REF1="ts14" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>Ah, some small amount of jam…After I tasted a little of the jam made from that thingy...some bird cherry jam</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a232"
                TIME_SLOT_REF1="ts22" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>to my surprise…[my glucose level] apparently went up to 8.3.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a233"
                TIME_SLOT_REF1="ts25" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>Then I thought that it perhaps measured falsely.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a234"
                TIME_SLOT_REF1="ts44" TIME_SLOT_REF2="ts49">
                <ANNOTATION_VALUE>I did not have food [at that time]. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a235"
                TIME_SLOT_REF1="ts50" TIME_SLOT_REF2="ts56">
                <ANNOTATION_VALUE>[It was during] afternoon…at that place, when [we] were sitting outside.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a238"
                TIME_SLOT_REF1="ts58" TIME_SLOT_REF2="ts72">
                <ANNOTATION_VALUE>Then I said that my child also has [the thing] like this and that [I will] bring that and have it measured [when I go her place].</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245"
                TIME_SLOT_REF1="ts98" TIME_SLOT_REF2="ts102">
                <ANNOTATION_VALUE>Put this thing of yours [on the stove] and rest a little.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248"
                TIME_SLOT_REF1="ts114" TIME_SLOT_REF2="ts116">
                <ANNOTATION_VALUE>Will you sterilize [the jars] in that one?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a249"
                TIME_SLOT_REF1="ts126" TIME_SLOT_REF2="ts132">
                <ANNOTATION_VALUE>[I totally forgot about] one old coffee pot of mine. My mind was all over the place, you know.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a252"
                TIME_SLOT_REF1="ts134" TIME_SLOT_REF2="ts136">
                <ANNOTATION_VALUE>I gave it away to Zhanar.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253"
                TIME_SLOT_REF1="ts138" TIME_SLOT_REF2="ts140">
                <ANNOTATION_VALUE>After Zhanar asked for it…</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254"
                TIME_SLOT_REF1="ts142" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>…in order to [prepare] jars, like this (like we are doing), with her sister.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257"
                TIME_SLOT_REF1="ts150" TIME_SLOT_REF2="ts152">
                <ANNOTATION_VALUE>And then there is that white bucket [which I also forgot about (?)]</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a258"
                TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts170">
                <ANNOTATION_VALUE>Apparently ¬Akmana…Apparently there are two boxes of kitchware of the entire kitchen ... and plates.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a263"
                TIME_SLOT_REF1="ts172" TIME_SLOT_REF2="ts176">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a264"
                TIME_SLOT_REF1="ts182" TIME_SLOT_REF2="ts190">
                <ANNOTATION_VALUE>Oh my, she [¬Akmana] will make sure it doesn’t go yellow.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a268"
                TIME_SLOT_REF1="ts194" TIME_SLOT_REF2="ts198">
                <ANNOTATION_VALUE>¬Aynar says [all the above]. Also…</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a269"
                TIME_SLOT_REF1="ts200" TIME_SLOT_REF2="ts208">
                <ANNOTATION_VALUE>…those aluminum spoons……they sold them for 100 tenge each… </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a273"
                TIME_SLOT_REF1="ts210" TIME_SLOT_REF2="ts214">
                <ANNOTATION_VALUE>¬Saigul took them all says she. Can you imagine?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a274"
                TIME_SLOT_REF1="ts216" TIME_SLOT_REF2="ts240">
                <ANNOTATION_VALUE>Also…[Those things] called ‘for dessert’…those small...white plates that do not have flower [prints on them]. [She apparently sold] those for two hundred and for one hundred and fifty.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a281"
                TIME_SLOT_REF1="ts242" TIME_SLOT_REF2="ts260">
                <ANNOTATION_VALUE>That ¬Zhalgas, [you know, works] at that thingy...at the canteen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a285"
                TIME_SLOT_REF1="ts262" TIME_SLOT_REF2="ts270">
                <ANNOTATION_VALUE>After that, he worked at SPTU.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a288"
                TIME_SLOT_REF1="ts272" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>They bought a dacha, apparently.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a289"
                TIME_SLOT_REF1="ts280" TIME_SLOT_REF2="ts282">
                <ANNOTATION_VALUE>In Semey.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a291"
                TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts294">
                <ANNOTATION_VALUE>With ¬Tore.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a293"
                TIME_SLOT_REF1="ts304" TIME_SLOT_REF2="ts310">
                <ANNOTATION_VALUE>With ¬Zengi Baba.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a295"
                TIME_SLOT_REF1="ts316" TIME_SLOT_REF2="ts318">
                <ANNOTATION_VALUE>He is living with ¬Zengi Baba.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a296"
                TIME_SLOT_REF1="ts332" TIME_SLOT_REF2="ts336">
                <ANNOTATION_VALUE>No. They apparently live on the seventh floor [of a residential building].</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a298"
                TIME_SLOT_REF1="ts338" TIME_SLOT_REF2="ts341">
                <ANNOTATION_VALUE>Apparently, he bought a 4-bedroom house.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a299"
                TIME_SLOT_REF1="ts342" TIME_SLOT_REF2="ts348">
                <ANNOTATION_VALUE>Did ¬Kenesbay say it was 3 or 4 bedroooms, hmm, I don't remember.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302"
                TIME_SLOT_REF1="ts349" TIME_SLOT_REF2="ts356">
                <ANNOTATION_VALUE>Your brother...your father was saying that he sent the photos of it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a304"
                TIME_SLOT_REF1="ts360" TIME_SLOT_REF2="ts362">
                <ANNOTATION_VALUE>Yes, in Semey.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a305"
                TIME_SLOT_REF1="ts364" TIME_SLOT_REF2="ts368">
                <ANNOTATION_VALUE>Apparently, they said seventh floor.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a306"
                TIME_SLOT_REF1="ts372" TIME_SLOT_REF2="ts378">
                <ANNOTATION_VALUE>¬Tore and his family sold their appartment.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a309"
                TIME_SLOT_REF1="ts380" TIME_SLOT_REF2="ts382">
                <ANNOTATION_VALUE>¬Tore never had a house.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a310"
                TIME_SLOT_REF1="ts388" TIME_SLOT_REF2="ts392">
                <ANNOTATION_VALUE>¬Tore just lived in a one-bedroom appartment.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a312"
                TIME_SLOT_REF1="ts394" TIME_SLOT_REF2="ts402">
                <ANNOTATION_VALUE>They two sold their home and went to live under ¬Tore's care.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a315"
                TIME_SLOT_REF1="ts408" TIME_SLOT_REF2="ts412">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a316"
                TIME_SLOT_REF1="ts418" TIME_SLOT_REF2="ts426">
                <ANNOTATION_VALUE>Apparently, they never had one. They both lived in a one-bedroom appartment, apparently.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a318"
                TIME_SLOT_REF1="ts425" TIME_SLOT_REF2="ts428">
                <ANNOTATION_VALUE>How can I know after all?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319"
                TIME_SLOT_REF1="ts429" TIME_SLOT_REF2="ts438">
                <ANNOTATION_VALUE>So, his son got married, and now his daughter...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a322"
                TIME_SLOT_REF1="ts442" TIME_SLOT_REF2="ts447">
                <ANNOTATION_VALUE>No, he didn't.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a323"
                TIME_SLOT_REF1="ts448" TIME_SLOT_REF2="ts450">
                <ANNOTATION_VALUE>¬Orken did not come either.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a324"
                TIME_SLOT_REF1="ts454" TIME_SLOT_REF2="ts457">
                <ANNOTATION_VALUE>¬Orken did not come either.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a325"
                TIME_SLOT_REF1="ts459" TIME_SLOT_REF2="ts462">
                <ANNOTATION_VALUE>That is why ¬Zhanasyl swears about them:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a326"
                TIME_SLOT_REF1="ts464" TIME_SLOT_REF2="ts465">
                <ANNOTATION_VALUE>"You, who fuck your fathers' mouth,..."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a327"
                TIME_SLOT_REF1="ts468" TIME_SLOT_REF2="ts472">
                <ANNOTATION_VALUE>"Why do you do this?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a328"
                TIME_SLOT_REF1="ts471" TIME_SLOT_REF2="ts476">
                <ANNOTATION_VALUE>"None of them came".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a330"
                TIME_SLOT_REF1="ts498" TIME_SLOT_REF2="ts502">
                <ANNOTATION_VALUE>What?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a331"
                TIME_SLOT_REF1="ts510" TIME_SLOT_REF2="ts514">
                <ANNOTATION_VALUE>Oh, you are calling ¬Zharkyn a human...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a333"
                TIME_SLOT_REF1="ts516" TIME_SLOT_REF2="ts520">
                <ANNOTATION_VALUE>He does what that sluggish woman tells him to do.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a335"
                TIME_SLOT_REF1="ts522" TIME_SLOT_REF2="ts525">
                <ANNOTATION_VALUE>Let's keep these crushed ones, yes?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a336"
                TIME_SLOT_REF1="ts526" TIME_SLOT_REF2="ts528">
                <ANNOTATION_VALUE>For kompot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a338"
                TIME_SLOT_REF1="ts536" TIME_SLOT_REF2="ts541">
                <ANNOTATION_VALUE>These too hard ones...we do not need them.</ANNOTATION_VALUE>
