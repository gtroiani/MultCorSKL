        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a393" TIME_SLOT_REF1="ts544" TIME_SLOT_REF2="ts547">
                <ANNOTATION_VALUE>Do they live in a house?</ANNOTATION_VALUE>
