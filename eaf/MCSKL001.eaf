                <ANNOTATION_VALUE>Del- del-...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1342"
                TIME_SLOT_REF1="ts1854" TIME_SLOT_REF2="ts1856">
                <ANNOTATION_VALUE>Where?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1343"
                TIME_SLOT_REF1="ts1858" TIME_SLOT_REF2="ts1862">
                <ANNOTATION_VALUE>Wow!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1346"
                TIME_SLOT_REF1="ts1864" TIME_SLOT_REF2="ts1870">
                <ANNOTATION_VALUE>So clean indeed!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1348"
                TIME_SLOT_REF1="ts1874" TIME_SLOT_REF2="ts1876">
                <ANNOTATION_VALUE>What will you do with it?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1351"
                TIME_SLOT_REF1="ts1882" TIME_SLOT_REF2="ts1884">
                <ANNOTATION_VALUE>Will you make kompot?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1354"
                TIME_SLOT_REF1="ts1892" TIME_SLOT_REF2="ts1898">
                <ANNOTATION_VALUE>Then take this and put it higher into that place where other jars are kept.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1358"
                TIME_SLOT_REF1="ts1904" TIME_SLOT_REF2="ts1906">
                <ANNOTATION_VALUE>Will you put it into that?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1362"
                TIME_SLOT_REF1="ts1920" TIME_SLOT_REF2="ts1922">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1363"
                TIME_SLOT_REF1="ts1928" TIME_SLOT_REF2="ts1930">
                <ANNOTATION_VALUE>Oh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1364"
                TIME_SLOT_REF1="ts1936" TIME_SLOT_REF2="ts1940">
                <ANNOTATION_VALUE>Oh, yes, I see. You are going to make it in the big bowl. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1368"
                TIME_SLOT_REF1="ts1942" TIME_SLOT_REF2="ts1943">
                <ANNOTATION_VALUE>Don't give them your mantovarka!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1370"
                TIME_SLOT_REF1="ts1944" TIME_SLOT_REF2="ts1949">
                <ANNOTATION_VALUE>No need. They will get one themselves.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1371"
                TIME_SLOT_REF1="ts1950" TIME_SLOT_REF2="ts1952">
                <ANNOTATION_VALUE>They all earn money.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1372"
                TIME_SLOT_REF1="ts1954" TIME_SLOT_REF2="ts1959">
                <ANNOTATION_VALUE>You stupid... they said you told them they can take your mantovarka. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1373"
                TIME_SLOT_REF1="ts1962" TIME_SLOT_REF2="ts1964">
                <ANNOTATION_VALUE>I said, "Did you give it in an exchange for something?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1374"
                TIME_SLOT_REF1="ts1966" TIME_SLOT_REF2="ts1969">
                <ANNOTATION_VALUE>I normally don't speak like that.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1375"
                TIME_SLOT_REF1="ts1970" TIME_SLOT_REF2="ts1972">
                <ANNOTATION_VALUE>I got angry.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1376"
                TIME_SLOT_REF1="ts1974" TIME_SLOT_REF2="ts1977">
                <ANNOTATION_VALUE>I never raised voiced at any one of them.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1377"
                TIME_SLOT_REF1="ts1980" TIME_SLOT_REF2="ts1982">
                <ANNOTATION_VALUE>I do not know.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1378"
                TIME_SLOT_REF1="ts1984" TIME_SLOT_REF2="ts1986">
                <ANNOTATION_VALUE>She...also...you...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1379"
                TIME_SLOT_REF1="ts1988" TIME_SLOT_REF2="ts1991">
                <ANNOTATION_VALUE>um-m-m-...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1380"
                TIME_SLOT_REF1="ts1992" TIME_SLOT_REF2="ts1994">
                <ANNOTATION_VALUE>does that...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1381"
                TIME_SLOT_REF1="ts1996" TIME_SLOT_REF2="ts1997">
                <ANNOTATION_VALUE>...makes you angry.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1382"
                TIME_SLOT_REF1="ts2000" TIME_SLOT_REF2="ts2006">
                <ANNOTATION_VALUE>I said "She was happy saying that her zhezde bought it for her". </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1384"
                TIME_SLOT_REF1="ts2008" TIME_SLOT_REF2="ts2013">
                <ANNOTATION_VALUE>I said, "You did not buy it either, ¬Ekonay bought it for her..gave the money for it".  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1387"
                TIME_SLOT_REF1="ts2016" TIME_SLOT_REF2="ts2024">
                <ANNOTATION_VALUE>I do not know...you remember the thing you brought me which was brown and light? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1389"
                TIME_SLOT_REF1="ts2026" TIME_SLOT_REF2="ts2028">
                <ANNOTATION_VALUE>I also left it there.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1390"
                TIME_SLOT_REF1="ts2030" TIME_SLOT_REF2="ts2036">
                <ANNOTATION_VALUE>She took it, saying "Why do you need it? It does not fit you"  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1391"
                TIME_SLOT_REF1="ts2042" TIME_SLOT_REF2="ts2044">
                <ANNOTATION_VALUE>I said, "Ok, let it stay".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1394"
                TIME_SLOT_REF1="ts2050" TIME_SLOT_REF2="ts2056">
                <ANNOTATION_VALUE>That brown, light clothing ¬Aisulu brought...you and ¬Bayan bought for me...  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1395"
                TIME_SLOT_REF1="ts2058" TIME_SLOT_REF2="ts2062">
                <ANNOTATION_VALUE>...the thing that you put on...it is light.. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1396"
                TIME_SLOT_REF1="ts2068" TIME_SLOT_REF2="ts2071">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1397"
                TIME_SLOT_REF1="ts2072" TIME_SLOT_REF2="ts2074">
                <ANNOTATION_VALUE>Was it a cardgian?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1399"
                TIME_SLOT_REF1="ts2088" TIME_SLOT_REF2="ts2090">
                <ANNOTATION_VALUE>Not blue.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1400"
                TIME_SLOT_REF1="ts2092" TIME_SLOT_REF2="ts2094">
