        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1401"
                TIME_SLOT_REF1="ts2096" TIME_SLOT_REF2="ts2098">
                <ANNOTATION_VALUE>With the blue thingy.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1406"
                TIME_SLOT_REF1="ts2110" TIME_SLOT_REF2="ts2111">
                <ANNOTATION_VALUE>Not expensive actually.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1407"
                TIME_SLOT_REF1="ts2118" TIME_SLOT_REF2="ts2122">
                <ANNOTATION_VALUE>Oh my, that thing that you put on over a dress, you know? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1411"
                TIME_SLOT_REF1="ts2130" TIME_SLOT_REF2="ts2136">
