        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1027"
                TIME_SLOT_REF1="ts1462" TIME_SLOT_REF2="ts1466">
                <ANNOTATION_VALUE>¬Gulnaz, ¬Nazgul and others associated with them...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1292"
                TIME_SLOT_REF1="ts1468" TIME_SLOT_REF2="ts1471">
                <ANNOTATION_VALUE>A long time ago, they were together.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1551"
                TIME_SLOT_REF1="ts1472" TIME_SLOT_REF2="ts1474">
                <ANNOTATION_VALUE>Worked at ###.</ANNOTATION_VALUE>
