        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a398" TIME_SLOT_REF1="ts665" TIME_SLOT_REF2="ts672">
                <ANNOTATION_VALUE>Did Tore live in a one-bedroom appartment?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a399" TIME_SLOT_REF1="ts678" TIME_SLOT_REF2="ts681">
                <ANNOTATION_VALUE>Didn't ¬Tore have a house?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a400" TIME_SLOT_REF1="ts715" TIME_SLOT_REF2="ts725">
                <ANNOTATION_VALUE>Mom, ¬Tore did not come to our ¬Zharas  ['s funeral], right?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a401" TIME_SLOT_REF1="ts738" TIME_SLOT_REF2="ts744">
                <ANNOTATION_VALUE>Did Orken also not come?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a402" TIME_SLOT_REF1="ts778" TIME_SLOT_REF2="ts781">
