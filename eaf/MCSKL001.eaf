        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1237"
                TIME_SLOT_REF1="ts2638" TIME_SLOT_REF2="ts2641">
                <ANNOTATION_VALUE>Иә ана,</ANNOTATION_VALUE>
