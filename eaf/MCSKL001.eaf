        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1029"
                TIME_SLOT_REF1="ts1490" TIME_SLOT_REF2="ts1494">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1031"
                TIME_SLOT_REF1="ts1496" TIME_SLOT_REF2="ts1502">
                <ANNOTATION_VALUE>I am thinking of filling this fully so that we could wash them later. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1032"
                TIME_SLOT_REF1="ts1504" TIME_SLOT_REF2="ts1507">
                <ANNOTATION_VALUE>Let's put it there.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1033"
                TIME_SLOT_REF1="ts1508" TIME_SLOT_REF2="ts1511">
                <ANNOTATION_VALUE>You will put that in.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1034"
                TIME_SLOT_REF1="ts1512" TIME_SLOT_REF2="ts1514">
                <ANNOTATION_VALUE>Yes?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1036"
                TIME_SLOT_REF1="ts1518" TIME_SLOT_REF2="ts1526">
                <ANNOTATION_VALUE>This is the one that you said is for eating.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1042"
                TIME_SLOT_REF1="ts1552" TIME_SLOT_REF2="ts1558">
                <ANNOTATION_VALUE>Oh that ¬Zulfiya... your father said she is a good kelin.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1545"
                TIME_SLOT_REF1="ts1560" TIME_SLOT_REF2="ts1563">
                <ANNOTATION_VALUE>She is ¬Alemkhan's oldest child.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1548"
                TIME_SLOT_REF1="ts1564" TIME_SLOT_REF2="ts1566">
                <ANNOTATION_VALUE>The rest died.</ANNOTATION_VALUE>
