        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a376" TIME_SLOT_REF1="ts285" TIME_SLOT_REF2="ts294">
                <ANNOTATION_VALUE>Mom, [they] have probably gone yellow.</ANNOTATION_VALUE>
