        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1225" TIME_SLOT_REF1="ts4086" TIME_SLOT_REF2="ts4088">
                <ANNOTATION_VALUE>жуып қояйын.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1226" TIME_SLOT_REF1="ts4091" TIME_SLOT_REF2="ts4094">
                <ANNOTATION_VALUE>Ее кішкене-кішкене азайып бара жатыр @@</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1229" TIME_SLOT_REF1="ts4122" TIME_SLOT_REF2="ts4130">
                <ANNOTATION_VALUE>Андағы қазір,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1230" TIME_SLOT_REF1="ts4133" TIME_SLOT_REF2="ts4136">
