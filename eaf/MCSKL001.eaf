        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1231" TIME_SLOT_REF1="ts4139" TIME_SLOT_REF2="ts4142">
                <ANNOTATION_VALUE>мынау компот қазір.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1237" TIME_SLOT_REF1="ts4153" TIME_SLOT_REF2="ts4158">
                <ANNOTATION_VALUE>Иә ана,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1238" TIME_SLOT_REF1="ts4159" TIME_SLOT_REF2="ts4165">
                <ANNOTATION_VALUE>қарадан иә?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1241" TIME_SLOT_REF1="ts4181" TIME_SLOT_REF2="ts4184">
                <ANNOTATION_VALUE>Иә.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1242" TIME_SLOT_REF1="ts4187" TIME_SLOT_REF2="ts4190">
                <ANNOTATION_VALUE>Анау кішкене өзі тұрсын.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1243" TIME_SLOT_REF1="ts4191" TIME_SLOT_REF2="ts4196">
                <ANNOTATION_VALUE>Пысса пысып қалатын шығар жәшікте.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1244" TIME_SLOT_REF1="ts4199" TIME_SLOT_REF2="ts4202">
                <ANNOTATION_VALUE>А.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1248" TIME_SLOT_REF1="ts4211" TIME_SLOT_REF2="ts4214">
                <ANNOTATION_VALUE>Біраз жәшікте тұрса,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1249" TIME_SLOT_REF1="ts4216" TIME_SLOT_REF2="ts4218">
                <ANNOTATION_VALUE>пысып кететін шығар.</ANNOTATION_VALUE>
