        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1417"
                TIME_SLOT_REF1="ts2158" TIME_SLOT_REF2="ts2160">
                <ANNOTATION_VALUE>..maybe she will deliver it to me through somebody.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1421"
                TIME_SLOT_REF1="ts2174" TIME_SLOT_REF2="ts2179">
                <ANNOTATION_VALUE>Oh, god!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1534"
                TIME_SLOT_REF1="ts2180" TIME_SLOT_REF2="ts2186">
                <ANNOTATION_VALUE>Oh my, did anybody bring me any good stuff...ever? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1422"
                TIME_SLOT_REF1="ts2188" TIME_SLOT_REF2="ts2192">
                <ANNOTATION_VALUE>No, I know.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1423"
                TIME_SLOT_REF1="ts2194" TIME_SLOT_REF2="ts2197">
                <ANNOTATION_VALUE>I..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1424"
                TIME_SLOT_REF1="ts2198" TIME_SLOT_REF2="ts2201">
                <ANNOTATION_VALUE>I also know the difference.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1426"
                TIME_SLOT_REF1="ts2204" TIME_SLOT_REF2="ts2206">
                <ANNOTATION_VALUE>I know all of it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1427"
                TIME_SLOT_REF1="ts2218" TIME_SLOT_REF2="ts2227">
                <ANNOTATION_VALUE> Its fabric and its quality - I know all of it.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1435"
                TIME_SLOT_REF1="ts2250" TIME_SLOT_REF2="ts2254">
                <ANNOTATION_VALUE>No, it doesn't.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1437"
                TIME_SLOT_REF1="ts2256" TIME_SLOT_REF2="ts2260">
                <ANNOTATION_VALUE>She said, "You will take it later when you need it". </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1438"
                TIME_SLOT_REF1="ts2268" TIME_SLOT_REF2="ts2270">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1441"
                TIME_SLOT_REF1="ts2276" TIME_SLOT_REF2="ts2278">
                <ANNOTATION_VALUE>No.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1442"
                TIME_SLOT_REF1="ts2280" TIME_SLOT_REF2="ts2282">
                <ANNOTATION_VALUE>It fits.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1443"
                TIME_SLOT_REF1="ts2286" TIME_SLOT_REF2="ts2289">
                <ANNOTATION_VALUE>I am not sure but she said she would bring it when she'll come here.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1444"
                TIME_SLOT_REF1="ts2292" TIME_SLOT_REF2="ts2294">
                <ANNOTATION_VALUE>Looks like she will bring it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1445"
                TIME_SLOT_REF1="ts2296" TIME_SLOT_REF2="ts2308">
                <ANNOTATION_VALUE>And then after scolding me, she says "Why do you need this, why do you need that?"     </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1449"
                TIME_SLOT_REF1="ts2310" TIME_SLOT_REF2="ts2313">
                <ANNOTATION_VALUE>And so, I have one dress.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1532"
                TIME_SLOT_REF1="ts2316" TIME_SLOT_REF2="ts2318">
                <ANNOTATION_VALUE>Ink...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1535"
                TIME_SLOT_REF1="ts2320" TIME_SLOT_REF2="ts2326">
                <ANNOTATION_VALUE>¬Zhaidar gave her..that thingy of hers. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1450"
                TIME_SLOT_REF1="ts2325" TIME_SLOT_REF2="ts2330">
                <ANNOTATION_VALUE>She bought it a long time ago when she lived in the aul.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1451"
                TIME_SLOT_REF1="ts2332" TIME_SLOT_REF2="ts2334">
                <ANNOTATION_VALUE>A velour dress.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1452"
                TIME_SLOT_REF1="ts2336" TIME_SLOT_REF2="ts2340">
                <ANNOTATION_VALUE>She took that as well, saying "Why do you need this?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1453"
                TIME_SLOT_REF1="ts2342" TIME_SLOT_REF2="ts2346">
                <ANNOTATION_VALUE>"No need, ok", I said.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1454"
                TIME_SLOT_REF1="ts2348" TIME_SLOT_REF2="ts2352">
                <ANNOTATION_VALUE>I said, "As long as you do not burn them, it is ok. Do not burn them." </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1455"
                TIME_SLOT_REF1="ts2358" TIME_SLOT_REF2="ts2360">
                <ANNOTATION_VALUE>Yeah, I know.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1460"
                TIME_SLOT_REF1="ts2378" TIME_SLOT_REF2="ts2384">
                <ANNOTATION_VALUE>The other day, ¬Salim's yellow daughter..  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1463"
                TIME_SLOT_REF1="ts2385" TIME_SLOT_REF2="ts2390">
                <ANNOTATION_VALUE>..mmm when there was this...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1464"
                TIME_SLOT_REF1="ts2392" TIME_SLOT_REF2="ts2396">
                <ANNOTATION_VALUE>mmmm...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1468"
                TIME_SLOT_REF1="ts2404" TIME_SLOT_REF2="ts2406">
                <ANNOTATION_VALUE>They gave katym.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1469"
                TIME_SLOT_REF1="ts2412" TIME_SLOT_REF2="ts2414">
                <ANNOTATION_VALUE>They invited me there.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1472"
                TIME_SLOT_REF1="ts2416" TIME_SLOT_REF2="ts2421">
                <ANNOTATION_VALUE>Her husband is such a good guy.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1473"
                TIME_SLOT_REF1="ts2422" TIME_SLOT_REF2="ts2426">
                <ANNOTATION_VALUE>The way he speaks is so nice.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1476"
                TIME_SLOT_REF1="ts2432" TIME_SLOT_REF2="ts2436">
                <ANNOTATION_VALUE>He is so spirited.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1479"
                TIME_SLOT_REF1="ts2438" TIME_SLOT_REF2="ts2441">
                <ANNOTATION_VALUE>Hm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1480"
                TIME_SLOT_REF1="ts2442" TIME_SLOT_REF2="ts2448">
                <ANNOTATION_VALUE>¬Luba was there, covering her head.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1481"
                TIME_SLOT_REF1="ts2450" TIME_SLOT_REF2="ts2452">
                <ANNOTATION_VALUE>Looks good.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1482"
                TIME_SLOT_REF1="ts2462" TIME_SLOT_REF2="ts2464">
                <ANNOTATION_VALUE>I also thought that she was pregnant.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1484"
                TIME_SLOT_REF1="ts2466" TIME_SLOT_REF2="ts2472">
                <ANNOTATION_VALUE>Oh, she recovered from that thing.. right? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1485"
                TIME_SLOT_REF1="ts2476" TIME_SLOT_REF2="ts2484">
                <ANNOTATION_VALUE>Mmm, mmm, from cancer?  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1487"
                TIME_SLOT_REF1="ts2488" TIME_SLOT_REF2="ts2490">
                <ANNOTATION_VALUE>I also thought so.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1488"
                TIME_SLOT_REF1="ts2492" TIME_SLOT_REF2="ts2496">
                <ANNOTATION_VALUE>¬Takalok is such a glutton, you know. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1490"
                TIME_SLOT_REF1="ts2498" TIME_SLOT_REF2="ts2510">
                <ANNOTATION_VALUE>He came in, sat down, holding his two kids, and kept eating everyting that was on the table.   </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1494"
                TIME_SLOT_REF1="ts2528" TIME_SLOT_REF2="ts2530">
                <ANNOTATION_VALUE>Oh, for God's sake!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1495"
                TIME_SLOT_REF1="ts2532" TIME_SLOT_REF2="ts2536">
                <ANNOTATION_VALUE>A little kid, dealing with being a father of four children... </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1497"
                TIME_SLOT_REF1="ts2538" TIME_SLOT_REF2="ts2541">
                <ANNOTATION_VALUE>His wife is good.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1498"
                TIME_SLOT_REF1="ts2542" TIME_SLOT_REF2="ts2544">
                <ANNOTATION_VALUE>The mother is like a Russian... a moron.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1499"
                TIME_SLOT_REF1="ts2546" TIME_SLOT_REF2="ts2548">
                <ANNOTATION_VALUE>Oh, his dad is...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1500"
                TIME_SLOT_REF1="ts2552" TIME_SLOT_REF2="ts2554">
                <ANNOTATION_VALUE>But his dad is very Kazakh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1501"
                TIME_SLOT_REF1="ts2556" TIME_SLOT_REF2="ts2558">
                <ANNOTATION_VALUE>That blacnkess of his hands...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1502"
                TIME_SLOT_REF1="ts2560" TIME_SLOT_REF2="ts2564">
                <ANNOTATION_VALUE>Oh my god.. with the tip of his hand he cut the meat. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1505"
                TIME_SLOT_REF1="ts2574" TIME_SLOT_REF2="ts2576">
                <ANNOTATION_VALUE>Oh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1506"
                TIME_SLOT_REF1="ts2580" TIME_SLOT_REF2="ts2584">
                <ANNOTATION_VALUE>The mother was just speaking Russian only!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1509"
                TIME_SLOT_REF1="ts2600" TIME_SLOT_REF2="ts2602">
                <ANNOTATION_VALUE>Of course, it is.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1510"
                TIME_SLOT_REF1="ts2604" TIME_SLOT_REF2="ts2606">
                <ANNOTATION_VALUE>What else should happen to it?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1513"
                TIME_SLOT_REF1="ts2607" TIME_SLOT_REF2="ts2622">
                <ANNOTATION_VALUE>After you are done organizing that, we should cut these for kompot.. oh no.. for jam.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1514"
                TIME_SLOT_REF1="ts2634" TIME_SLOT_REF2="ts2639">
                <ANNOTATION_VALUE>No, I mean in case you want to make jam. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1518"
                TIME_SLOT_REF1="ts2644" TIME_SLOT_REF2="ts2648">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1519"
                TIME_SLOT_REF1="ts2650" TIME_SLOT_REF2="ts2654">
                <ANNOTATION_VALUE>See how it will turn out. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1526"
                TIME_SLOT_REF1="ts2672" TIME_SLOT_REF2="ts2674">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1528"
                TIME_SLOT_REF1="ts2682" TIME_SLOT_REF2="ts2684">
                <ANNOTATION_VALUE>They will ripen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1529"
                TIME_SLOT_REF1="ts2686" TIME_SLOT_REF2="ts2690">
                <ANNOTATION_VALUE>Just cover them. They will ripen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
