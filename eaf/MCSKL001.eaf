        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1226"
                TIME_SLOT_REF1="ts2595" TIME_SLOT_REF2="ts2597">
                <ANNOTATION_VALUE>Ее кішкене-кішкене азайып бара жатыр @@</ANNOTATION_VALUE>
