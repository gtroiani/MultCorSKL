        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1549"
                TIME_SLOT_REF1="ts1568" TIME_SLOT_REF2="ts1570">
                <ANNOTATION_VALUE>For that old woman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1256"
                TIME_SLOT_REF1="ts1596" TIME_SLOT_REF2="ts1601">
                <ANNOTATION_VALUE>Yes, yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1257"
                TIME_SLOT_REF1="ts1602" TIME_SLOT_REF2="ts1605">
                <ANNOTATION_VALUE>It is good.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1540"
                TIME_SLOT_REF1="ts1612" TIME_SLOT_REF2="ts1616">
                <ANNOTATION_VALUE>She left once actually.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1541"
                TIME_SLOT_REF1="ts1618" TIME_SLOT_REF2="ts1624">
                <ANNOTATION_VALUE>She lived in Almaty, and after not returning for some time, she came back, didn't you know?  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1546"
                TIME_SLOT_REF1="ts1634" TIME_SLOT_REF2="ts1638">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1296"
                TIME_SLOT_REF1="ts1644" TIME_SLOT_REF2="ts1648">
                <ANNOTATION_VALUE>Well, yes, what ¬Alikhan did is...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1297"
                TIME_SLOT_REF1="ts1650" TIME_SLOT_REF2="ts1664">
                <ANNOTATION_VALUE>He lived with those people...hmm... ¬Zulfiya's sisters or something like this.   </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1304"
                TIME_SLOT_REF1="ts1666" TIME_SLOT_REF2="ts1668">
                <ANNOTATION_VALUE>I don't know.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1305"
                TIME_SLOT_REF1="ts1670" TIME_SLOT_REF2="ts1674">
                <ANNOTATION_VALUE>Is it a lie or a truth — I do not know.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1306"
                TIME_SLOT_REF1="ts1682" TIME_SLOT_REF2="ts1687">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1307"
                TIME_SLOT_REF1="ts1688" TIME_SLOT_REF2="ts1691">
                <ANNOTATION_VALUE>After that he sold his house in Almaty and returned.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1537"
                TIME_SLOT_REF1="ts1694" TIME_SLOT_REF2="ts1700">
                <ANNOTATION_VALUE>"Oh, she is in Almaty, waiting for ¬Nurbol", said those women, spreading rumors.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1319"
                TIME_SLOT_REF1="ts1746" TIME_SLOT_REF2="ts1747">
                <ANNOTATION_VALUE>Why did she wash those?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1320"
                TIME_SLOT_REF1="ts1750" TIME_SLOT_REF2="ts1756">
                <ANNOTATION_VALUE>She washed them all with a hosepipe in front of the house. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1321"
                TIME_SLOT_REF1="ts1762" TIME_SLOT_REF2="ts1769">
                <ANNOTATION_VALUE>After she did this, it all got muddy around.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1141"
                TIME_SLOT_REF1="ts1782" TIME_SLOT_REF2="ts1786">
                <ANNOTATION_VALUE>That's good.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1336"
                TIME_SLOT_REF1="ts1838" TIME_SLOT_REF2="ts1840">
                <ANNOTATION_VALUE>Russian?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a22814"
                TIME_SLOT_REF1="ts1842" TIME_SLOT_REF2="ts1844">
