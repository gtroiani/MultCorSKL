            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a508"
                TIME_SLOT_REF1="ts1183" TIME_SLOT_REF2="ts1193">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a511"
                TIME_SLOT_REF1="ts1200" TIME_SLOT_REF2="ts1203">
                <ANNOTATION_VALUE>They are not the cars of one household.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a512"
                TIME_SLOT_REF1="ts1206" TIME_SLOT_REF2="ts1209">
                <ANNOTATION_VALUE>These are junk cars.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a524"
                TIME_SLOT_REF1="ts1284" TIME_SLOT_REF2="ts1292">
                <ANNOTATION_VALUE>It is good if they gather everything into one pile and take the pile there together.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a526"
                TIME_SLOT_REF1="ts1293" TIME_SLOT_REF2="ts1297">
                <ANNOTATION_VALUE>Am I right?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a528"
                TIME_SLOT_REF1="ts1307" TIME_SLOT_REF2="ts1313">
                <ANNOTATION_VALUE>They cannot take them there each of them seperately.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a529"
                TIME_SLOT_REF1="ts1316" TIME_SLOT_REF2="ts1327">
                <ANNOTATION_VALUE> Saparali's hair hasn't turned gray at all. What kind of person is he?!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a532"
                TIME_SLOT_REF1="ts1336" TIME_SLOT_REF2="ts1340">
                <ANNOTATION_VALUE>The same with Zhaniya.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5436"
                TIME_SLOT_REF1="ts1350" TIME_SLOT_REF2="ts1353">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a537"
                TIME_SLOT_REF1="ts1378" TIME_SLOT_REF2="ts1383">
                <ANNOTATION_VALUE>Oh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a541"
                TIME_SLOT_REF1="ts1402" TIME_SLOT_REF2="ts1405">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a547"
                TIME_SLOT_REF1="ts1440" TIME_SLOT_REF2="ts1446">
                <ANNOTATION_VALUE>Don't you know he has already finished his studies?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a557"
                TIME_SLOT_REF1="ts1470" TIME_SLOT_REF2="ts1476">
                <ANNOTATION_VALUE>To Astana.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a558"
                TIME_SLOT_REF1="ts1482" TIME_SLOT_REF2="ts1492">
                <ANNOTATION_VALUE>Now that he has a diploma, he will work. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a561"
                TIME_SLOT_REF1="ts1495" TIME_SLOT_REF2="ts1501">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a566"
                TIME_SLOT_REF1="ts1524" TIME_SLOT_REF2="ts1530">
                <ANNOTATION_VALUE>What is burning it?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a568"
                TIME_SLOT_REF1="ts1536" TIME_SLOT_REF2="ts1539">
                <ANNOTATION_VALUE>What did you drink?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a571"
                TIME_SLOT_REF1="ts1558" TIME_SLOT_REF2="ts1576">
                <ANNOTATION_VALUE>What a human is she?! She eats ice-cream? Isn't that weird?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a575"
                TIME_SLOT_REF1="ts1588" TIME_SLOT_REF2="ts1592">
                <ANNOTATION_VALUE>It is just her senility.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a576"
                TIME_SLOT_REF1="ts1596" TIME_SLOT_REF2="ts1599">
                <ANNOTATION_VALUE>No other explanation..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a578"
                TIME_SLOT_REF1="ts1604" TIME_SLOT_REF2="ts1611">
                <ANNOTATION_VALUE>She says her blood pressure is normal.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a581"
                TIME_SLOT_REF1="ts1630" TIME_SLOT_REF2="ts1650">
                <ANNOTATION_VALUE>He is lying. Saparali and her both have it (high blood pressure).</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a584"
                TIME_SLOT_REF1="ts1659" TIME_SLOT_REF2="ts1662">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a587"
                TIME_SLOT_REF1="ts1668" TIME_SLOT_REF2="ts1671">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a588"
                TIME_SLOT_REF1="ts1688" TIME_SLOT_REF2="ts1695">
                <ANNOTATION_VALUE>Saparali underwent a surgery for his liver. Look at him now, he has recovered. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a589"
                TIME_SLOT_REF1="ts1698" TIME_SLOT_REF2="ts1701">
                <ANNOTATION_VALUE>Good...that...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a590"
                TIME_SLOT_REF1="ts1704" TIME_SLOT_REF2="ts1707">
                <ANNOTATION_VALUE>...I mean...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a591"
                TIME_SLOT_REF1="ts1710" TIME_SLOT_REF2="ts1713">
                <ANNOTATION_VALUE>...it cleared...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
