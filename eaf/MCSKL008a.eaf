        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a396"
                TIME_SLOT_REF1="ts541" TIME_SLOT_REF2="ts546">
                <ANNOTATION_VALUE>Well here it is even more expensive than that.</ANNOTATION_VALUE>
