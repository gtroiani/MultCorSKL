        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a432"
                TIME_SLOT_REF1="ts738" TIME_SLOT_REF2="ts745">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a440"
                TIME_SLOT_REF1="ts775" TIME_SLOT_REF2="ts787">
                <ANNOTATION_VALUE>I am not saying that you said they are made here in Zelenyi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a441"
                TIME_SLOT_REF1="ts790" TIME_SLOT_REF2="ts799">
                <ANNOTATION_VALUE>You...I am saying just like that.</ANNOTATION_VALUE>
