        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a430"
                TIME_SLOT_REF1="ts727" TIME_SLOT_REF2="ts737">
                <ANNOTATION_VALUE>Oh, that's what I meant as well.</ANNOTATION_VALUE>
