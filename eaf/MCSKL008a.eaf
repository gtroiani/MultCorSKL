            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a418"
                TIME_SLOT_REF1="ts648" TIME_SLOT_REF2="ts651">
                <ANNOTATION_VALUE>That's it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a419"
                TIME_SLOT_REF1="ts657" TIME_SLOT_REF2="ts663">
                <ANNOTATION_VALUE>Mau and people related to him make what they make.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a420"
                TIME_SLOT_REF1="ts666" TIME_SLOT_REF2="ts676">
                <ANNOTATION_VALUE>That person who cooks meat. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a421"
                TIME_SLOT_REF1="ts682" TIME_SLOT_REF2="ts690">
                <ANNOTATION_VALUE>That person also distributes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a422"
                TIME_SLOT_REF1="ts691" TIME_SLOT_REF2="ts702">
                <ANNOTATION_VALUE>She also brings buns and qarma bread.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a426"
                TIME_SLOT_REF1="ts712" TIME_SLOT_REF2="ts715">
                <ANNOTATION_VALUE>I am saying Kurshim.</ANNOTATION_VALUE>
