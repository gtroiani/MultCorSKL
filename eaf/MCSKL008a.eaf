        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a465"
                TIME_SLOT_REF1="ts941" TIME_SLOT_REF2="ts957">
                <ANNOTATION_VALUE>Our Dikosh and others who can do this would do everything perfectly if they had the chance. </ANNOTATION_VALUE>
