        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a442"
                TIME_SLOT_REF1="ts802" TIME_SLOT_REF2="ts825">
                <ANNOTATION_VALUE>You are saying Zelenyi, meaning here.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a447"
                TIME_SLOT_REF1="ts831" TIME_SLOT_REF2="ts837">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a449"
                TIME_SLOT_REF1="ts844" TIME_SLOT_REF2="ts847">
                <ANNOTATION_VALUE>Didn't she say she would cook meat?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a464"
                TIME_SLOT_REF1="ts936" TIME_SLOT_REF2="ts940">
                <ANNOTATION_VALUE>Because they cannot do it...</ANNOTATION_VALUE>
