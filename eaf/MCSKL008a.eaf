                <ANNOTATION_VALUE>At some point, his daughter came.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a337"
                TIME_SLOT_REF1="ts148" TIME_SLOT_REF2="ts151">
                <ANNOTATION_VALUE>She came once and said: "Grandma..."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a338"
                TIME_SLOT_REF1="ts154" TIME_SLOT_REF2="ts161">
                <ANNOTATION_VALUE> In her hands, she had this thing like this.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a339"
                TIME_SLOT_REF1="ts164" TIME_SLOT_REF2="ts167">
                <ANNOTATION_VALUE>It was ice-cream.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a340"
                TIME_SLOT_REF1="ts170" TIME_SLOT_REF2="ts174">
                <ANNOTATION_VALUE>She brought one ice-cream and gave it to her grandmother.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a341"
                TIME_SLOT_REF1="ts175" TIME_SLOT_REF2="ts183">
                <ANNOTATION_VALUE> She had another for herself in her hands.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a342"
                TIME_SLOT_REF1="ts186" TIME_SLOT_REF2="ts189">
                <ANNOTATION_VALUE>Zhaniya just ate it all up while sitting.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a343"
                TIME_SLOT_REF1="ts192" TIME_SLOT_REF2="ts195">
                <ANNOTATION_VALUE>The ice-cream.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a344"
                TIME_SLOT_REF1="ts198" TIME_SLOT_REF2="ts208">
                <ANNOTATION_VALUE>I say, "Your throat...####... cold like ice".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a345"
                TIME_SLOT_REF1="ts214" TIME_SLOT_REF2="ts217">
                <ANNOTATION_VALUE>She says she eats.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a348"
                TIME_SLOT_REF1="ts220" TIME_SLOT_REF2="ts229">
                <ANNOTATION_VALUE> Then at some point she brought a tissue like this.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a350"
                TIME_SLOT_REF1="ts232" TIME_SLOT_REF2="ts235">
                <ANNOTATION_VALUE>It was a new one.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a351"
                TIME_SLOT_REF1="ts238" TIME_SLOT_REF2="ts241">
                <ANNOTATION_VALUE>"Here it is, grandma", said she.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a352"
                TIME_SLOT_REF1="ts244" TIME_SLOT_REF2="ts247">
                <ANNOTATION_VALUE>I looked at it wondering what it was.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a353"
                TIME_SLOT_REF1="ts250" TIME_SLOT_REF2="ts253">
                <ANNOTATION_VALUE>She said it was a tissue.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a354"
                TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts263">
                <ANNOTATION_VALUE>She first gave her ice-cream, and then she brought a tissue. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a355"
                TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>When we were having tea, she, the daughter-in-law, said: "Did you take the tissue?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a357"
                TIME_SLOT_REF1="ts275" TIME_SLOT_REF2="ts279">
                <ANNOTATION_VALUE>"Yes, she gave it to me."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a358"
                TIME_SLOT_REF1="ts282" TIME_SLOT_REF2="ts285">
                <ANNOTATION_VALUE>She pulled that old tissue away from her hands.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a359"
                TIME_SLOT_REF1="ts288" TIME_SLOT_REF2="ts301">
                <ANNOTATION_VALUE>She said, "I will throw it away...that thing in Zhaniya's hands... into the trash....into that thing... "</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a360"
                TIME_SLOT_REF1="ts306" TIME_SLOT_REF2="ts314">
                <ANNOTATION_VALUE>That thing with which she (Zhaniya) was using to wipe, she (the daughter-in-law) took this thing from her.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a362"
                TIME_SLOT_REF1="ts316" TIME_SLOT_REF2="ts319">
                <ANNOTATION_VALUE>To throw it into that thing, she said.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a363"
                TIME_SLOT_REF1="ts328" TIME_SLOT_REF2="ts334">
                <ANNOTATION_VALUE>Yes, a tissue for nose.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a366"
                TIME_SLOT_REF1="ts337" TIME_SLOT_REF2="ts344">
                <ANNOTATION_VALUE>Like this.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a369"
                TIME_SLOT_REF1="ts348" TIME_SLOT_REF2="ts351">
                <ANNOTATION_VALUE>Like that big one I have.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a371"
                TIME_SLOT_REF1="ts360" TIME_SLOT_REF2="ts363">
                <ANNOTATION_VALUE>She said the tissue costs two hundred tenges.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a373"
                TIME_SLOT_REF1="ts366" TIME_SLOT_REF2="ts385">
                <ANNOTATION_VALUE>"What will you do with it? It is old and used. It is bad. I will throw it away ", said she, and took the tissue and threw it into something that stood beside her.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a375"
                TIME_SLOT_REF1="ts394" TIME_SLOT_REF2="ts397">
                <ANNOTATION_VALUE>He is there, lying.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a377"
                TIME_SLOT_REF1="ts400" TIME_SLOT_REF2="ts431">
                <ANNOTATION_VALUE>Then  at one point she was on a call with somebody and she said: "My sister-in-law passed away apparently. I need to go to see her. How can I not?  Will I just be sitting like this when she's gone?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a381"
                TIME_SLOT_REF1="ts428" TIME_SLOT_REF2="ts433">
                <ANNOTATION_VALUE>She said something like this.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a382"
                TIME_SLOT_REF1="ts436" TIME_SLOT_REF2="ts447">
                <ANNOTATION_VALUE>And then the person said, "Now go and tell this to Zhanat". I do not know if she told reached Zhanat about this.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a383"
                TIME_SLOT_REF1="ts450" TIME_SLOT_REF2="ts456">
                <ANNOTATION_VALUE>If somebody does not take her...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a384"
                TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts466">
                <ANNOTATION_VALUE>Well with that he is making lots of money.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a386"
                TIME_SLOT_REF1="ts470" TIME_SLOT_REF2="ts476">
                <ANNOTATION_VALUE>One million.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a389"
                TIME_SLOT_REF1="ts486" TIME_SLOT_REF2="ts494">
                <ANNOTATION_VALUE>For two hundred tenges, tissues, macaroni, and qarma breads like this, you know. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a391"
                TIME_SLOT_REF1="ts498" TIME_SLOT_REF2="ts510">
                <ANNOTATION_VALUE>"Grandpa, this is home-made qarma. Please eat some", said she. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a392"
                TIME_SLOT_REF1="ts514" TIME_SLOT_REF2="ts517">
                <ANNOTATION_VALUE>All of them are store-bought qarma breads like this.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a399"
                TIME_SLOT_REF1="ts552" TIME_SLOT_REF2="ts557">
                <ANNOTATION_VALUE>It comes from our place.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a400"
                TIME_SLOT_REF1="ts558" TIME_SLOT_REF2="ts566">
                <ANNOTATION_VALUE>They don't bring it from the city.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a404"
                TIME_SLOT_REF1="ts580" TIME_SLOT_REF2="ts589">
                <ANNOTATION_VALUE> What I mean when I say that they bring stuff from the city to the stores...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a407"
                TIME_SLOT_REF1="ts588" TIME_SLOT_REF2="ts598">
                <ANNOTATION_VALUE>... I mean that the people here as well make them and sell to the stores.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a408"
                TIME_SLOT_REF1="ts599" TIME_SLOT_REF2="ts604">
                <ANNOTATION_VALUE>This is also how they bring them to the stores.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a410"
                TIME_SLOT_REF1="ts609" TIME_SLOT_REF2="ts613">
                <ANNOTATION_VALUE>Ordinary...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a411"
                TIME_SLOT_REF1="ts614" TIME_SLOT_REF2="ts623">
                <ANNOTATION_VALUE>Well, it is just like how the bakeries work.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a434"
                TIME_SLOT_REF1="ts632" TIME_SLOT_REF2="ts641">
                <ANNOTATION_VALUE>From the manufacturer ##...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a435"
                TIME_SLOT_REF1="ts654" TIME_SLOT_REF2="ts660">
                <ANNOTATION_VALUE>Who?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a424"
                TIME_SLOT_REF1="ts673" TIME_SLOT_REF2="ts679">
                <ANNOTATION_VALUE>Yes, yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a425"
                TIME_SLOT_REF1="ts697" TIME_SLOT_REF2="ts709">
                <ANNOTATION_VALUE>Oh dearie, it is not the city that makes them. They are produced locally here. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a427"
                TIME_SLOT_REF1="ts718" TIME_SLOT_REF2="ts722">
                <ANNOTATION_VALUE>Kurshim produces them.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a428"
                TIME_SLOT_REF1="ts723" TIME_SLOT_REF2="ts729">
                <ANNOTATION_VALUE>Kurshim produces them.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a429"
                TIME_SLOT_REF1="ts732" TIME_SLOT_REF2="ts742">
                <ANNOTATION_VALUE>That's what I am talking about.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a431"
                TIME_SLOT_REF1="ts748" TIME_SLOT_REF2="ts755">
                <ANNOTATION_VALUE>I am not saying that it is made here. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a433"
                TIME_SLOT_REF1="ts758" TIME_SLOT_REF2="ts761">
                <ANNOTATION_VALUE>When I say that Kurshim produces them, I really mean that it is the people of Kurshim who make them (the qarma bread).</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a436"
                TIME_SLOT_REF1="ts764" TIME_SLOT_REF2="ts767">
                <ANNOTATION_VALUE>A woman like her makes them.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a437"
                TIME_SLOT_REF1="ts770" TIME_SLOT_REF2="ts779">
                <ANNOTATION_VALUE>Let this sink in.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a443"
                TIME_SLOT_REF1="ts793" TIME_SLOT_REF2="ts796">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a444"
                TIME_SLOT_REF1="ts805" TIME_SLOT_REF2="ts808">
                <ANNOTATION_VALUE>No.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a445"
                TIME_SLOT_REF1="ts811" TIME_SLOT_REF2="ts823">
                <ANNOTATION_VALUE>No, no, they are not made in Zelenyi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a446"
                TIME_SLOT_REF1="ts828" TIME_SLOT_REF2="ts834">
                <ANNOTATION_VALUE>The people in Kurshim make this qarma bread.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a448"
                TIME_SLOT_REF1="ts850" TIME_SLOT_REF2="ts853">
                <ANNOTATION_VALUE>No.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a450"
                TIME_SLOT_REF1="ts856" TIME_SLOT_REF2="ts859">
                <ANNOTATION_VALUE>The thing is...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a451"
                TIME_SLOT_REF1="ts862" TIME_SLOT_REF2="ts865">
                <ANNOTATION_VALUE>"The other day I had a matter to deal with", said she.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a452"
                TIME_SLOT_REF1="ts868" TIME_SLOT_REF2="ts876">
                <ANNOTATION_VALUE>"There was a grandmother, where is she?", she asked me. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a454"
                TIME_SLOT_REF1="ts880" TIME_SLOT_REF2="ts883">
                <ANNOTATION_VALUE>I said, "she is at home."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a456"
                TIME_SLOT_REF1="ts886" TIME_SLOT_REF2="ts890">
                <ANNOTATION_VALUE>That kelin asked, "Why didn't she come with you?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a457"
                TIME_SLOT_REF1="ts891" TIME_SLOT_REF2="ts895">
                <ANNOTATION_VALUE>It was surprising that she asked this.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a458"
                TIME_SLOT_REF1="ts898" TIME_SLOT_REF2="ts902">
                <ANNOTATION_VALUE>That...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a459"
                TIME_SLOT_REF1="ts903" TIME_SLOT_REF2="ts908">
                <ANNOTATION_VALUE>Yesterday's food...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a460"
                TIME_SLOT_REF1="ts909" TIME_SLOT_REF2="ts914">
                <ANNOTATION_VALUE>Something...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a461"
                TIME_SLOT_REF1="ts915" TIME_SLOT_REF2="ts920">
                <ANNOTATION_VALUE>She said, "I had stuff to do, so I hurriedly went to deal with them."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a462"
                TIME_SLOT_REF1="ts921" TIME_SLOT_REF2="ts926">
                <ANNOTATION_VALUE>I said I know.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a463"
                TIME_SLOT_REF1="ts927" TIME_SLOT_REF2="ts931">
                <ANNOTATION_VALUE>That she went somewhere with her grandfather.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a467"
                TIME_SLOT_REF1="ts954" TIME_SLOT_REF2="ts961">
                <ANNOTATION_VALUE>Oh God!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a472"
                TIME_SLOT_REF1="ts993" TIME_SLOT_REF2="ts999">
                <ANNOTATION_VALUE>Oh, god, fuck it!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a474"
                TIME_SLOT_REF1="ts1004" TIME_SLOT_REF2="ts1007">
                <ANNOTATION_VALUE>He is so fucking stupid!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a480"
                TIME_SLOT_REF1="ts1044" TIME_SLOT_REF2="ts1047">
                <ANNOTATION_VALUE>What are you saying?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a483"
                TIME_SLOT_REF1="ts1058" TIME_SLOT_REF2="ts1062">
                <ANNOTATION_VALUE># in the barn...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a484"
                TIME_SLOT_REF1="ts1063" TIME_SLOT_REF2="ts1073">
                <ANNOTATION_VALUE>Inside the fences of this side, some people lined a bunch of cars up.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a486"
                TIME_SLOT_REF1="ts1074" TIME_SLOT_REF2="ts1085">
                <ANNOTATION_VALUE>Tilting the cars and putting them on their sides, oh my god!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a490"
                TIME_SLOT_REF1="ts1088" TIME_SLOT_REF2="ts1091">
                <ANNOTATION_VALUE>Five....</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
