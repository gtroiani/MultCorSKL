            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a402"
                TIME_SLOT_REF1="ts574" TIME_SLOT_REF2="ts577">
                <ANNOTATION_VALUE>They are brought to the stores here.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a413"
                TIME_SLOT_REF1="ts619" TIME_SLOT_REF2="ts626">
                <ANNOTATION_VALUE>That..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a414"
                TIME_SLOT_REF1="ts629" TIME_SLOT_REF2="ts636">
                <ANNOTATION_VALUE>You know that person also ate those people's qarma bread as well.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a417"
                TIME_SLOT_REF1="ts637" TIME_SLOT_REF2="ts644">
