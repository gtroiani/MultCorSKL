        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a744"
                TIME_SLOT_REF1="ts532" TIME_SLOT_REF2="ts541">
                <ANNOTATION_VALUE>I asked:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a745"
                TIME_SLOT_REF1="ts540" TIME_SLOT_REF2="ts542">
