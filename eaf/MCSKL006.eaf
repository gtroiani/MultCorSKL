        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1305"
                TIME_SLOT_REF1="ts917" TIME_SLOT_REF2="ts924">
                <ANNOTATION_VALUE>One watermelon is this big.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2083"
                TIME_SLOT_REF1="ts958" TIME_SLOT_REF2="ts960">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2084"
                TIME_SLOT_REF1="ts985" TIME_SLOT_REF2="ts993">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
