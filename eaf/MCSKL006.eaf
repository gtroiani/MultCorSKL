            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a746"
                TIME_SLOT_REF1="ts547" TIME_SLOT_REF2="ts554">
                <ANNOTATION_VALUE>Zhazgul said that yesterday [she] paid a visit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a747"
                TIME_SLOT_REF1="ts557" TIME_SLOT_REF2="ts564">
                <ANNOTATION_VALUE>My grandmother comes to visit regularly, says she.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a748"
                TIME_SLOT_REF1="ts595" TIME_SLOT_REF2="ts599">
                <ANNOTATION_VALUE>There you see, it is raining again.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a749"
                TIME_SLOT_REF1="ts601" TIME_SLOT_REF2="ts618">
                <ANNOTATION_VALUE>All the outer side of the window is wet.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a750"
                TIME_SLOT_REF1="ts621" TIME_SLOT_REF2="ts633">
                <ANNOTATION_VALUE>The outer side of the window is wet</ANNOTATION_VALUE>
