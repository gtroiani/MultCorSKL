        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2085"
                TIME_SLOT_REF1="ts998" TIME_SLOT_REF2="ts1000">
                <ANNOTATION_VALUE>I see!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1543"
                TIME_SLOT_REF1="ts1003" TIME_SLOT_REF2="ts1013">
                <ANNOTATION_VALUE>By sitting together next to each other, right?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1551"
                TIME_SLOT_REF1="ts1019" TIME_SLOT_REF2="ts1022">
                <ANNOTATION_VALUE>It is ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1566"
                TIME_SLOT_REF1="ts1039" TIME_SLOT_REF2="ts1043">
                <ANNOTATION_VALUE>Is it that he also works at night?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2086"
                TIME_SLOT_REF1="ts1076" TIME_SLOT_REF2="ts1078">
                <ANNOTATION_VALUE>What do you say?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1591"
                TIME_SLOT_REF1="ts1081" TIME_SLOT_REF2="ts1088">
                <ANNOTATION_VALUE>It is obvious that this is how times have changed. All here as you can see [has changed].</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1621"
                TIME_SLOT_REF1="ts1089" TIME_SLOT_REF2="ts1120">
                <ANNOTATION_VALUE>It is just that # that bright deceased Karim and all those others raised nine children with just one tractor, you know.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1626"
                TIME_SLOT_REF1="ts1123" TIME_SLOT_REF2="ts1128">
                <ANNOTATION_VALUE>He has not even gone anywhere.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2087"
                TIME_SLOT_REF1="ts1141" TIME_SLOT_REF2="ts1147">
                <ANNOTATION_VALUE>DT.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2091"
                TIME_SLOT_REF1="ts1151" TIME_SLOT_REF2="ts1157">
                <ANNOTATION_VALUE>We would spend time at DT [the tractor].</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1647"
                TIME_SLOT_REF1="ts1163" TIME_SLOT_REF2="ts1166">
                <ANNOTATION_VALUE>He also has not gone/did not go anywhere [He did not see other places].</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1657"
                TIME_SLOT_REF1="ts1169" TIME_SLOT_REF2="ts1180">
                <ANNOTATION_VALUE>But he has not lived a good life though, as I know.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1670"
                TIME_SLOT_REF1="ts1187" TIME_SLOT_REF2="ts1218">
                <ANNOTATION_VALUE>He never wanted to hoard stuff and sew a lot of clothes to live happily and relaxed like this.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1724"
                TIME_SLOT_REF1="ts1260" TIME_SLOT_REF2="ts1278">
                <ANNOTATION_VALUE>Afterwards, as soon as he began going up (financially), his son began building a house.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1799"
                TIME_SLOT_REF1="ts1348" TIME_SLOT_REF2="ts1383">
                <ANNOTATION_VALUE>Slow down! In every house, there was one blue tractor and one DT tractor, and he used to provide for his chidlren with this one tractor.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1838"
                TIME_SLOT_REF1="ts1417" TIME_SLOT_REF2="ts1432">
                <ANNOTATION_VALUE>But women did not have jobs, nothing was left for them.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1842"
                TIME_SLOT_REF1="ts1437" TIME_SLOT_REF2="ts1440">
                <ANNOTATION_VALUE>We did the work that men's work at home.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1847"
                TIME_SLOT_REF1="ts1443" TIME_SLOT_REF2="ts1450">
                <ANNOTATION_VALUE>So who did really work?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1871"
                TIME_SLOT_REF1="ts1456" TIME_SLOT_REF2="ts1478">
                <ANNOTATION_VALUE>No pension and no work.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1910"
                TIME_SLOT_REF1="ts1532" TIME_SLOT_REF2="ts1539">
                <ANNOTATION_VALUE>Becase at the time there were not any jobs.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1971"
                TIME_SLOT_REF1="ts1568" TIME_SLOT_REF2="ts1626">
                <ANNOTATION_VALUE>There was one [job] at that school and on that...on kontor..and at the medical center..and at the safhoz's kontor.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
