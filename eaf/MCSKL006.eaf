        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a670"
                TIME_SLOT_REF1="ts466" TIME_SLOT_REF2="ts476">
                <ANNOTATION_VALUE>Uh, at that person's, right?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a671"
                TIME_SLOT_REF1="ts491" TIME_SLOT_REF2="ts496">
                <ANNOTATION_VALUE>He visits Zhaka from time to time.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a672"
                TIME_SLOT_REF1="ts501" TIME_SLOT_REF2="ts504">
                <ANNOTATION_VALUE>Yes, yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a673"
                TIME_SLOT_REF1="ts522" TIME_SLOT_REF2="ts529">
                <ANNOTATION_VALUE>Yes?</ANNOTATION_VALUE>
