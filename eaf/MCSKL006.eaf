        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2106"
                TIME_SLOT_REF1="ts903" TIME_SLOT_REF2="ts907">
                <ANNOTATION_VALUE>How much do they say one kilogram costs?</ANNOTATION_VALUE>
