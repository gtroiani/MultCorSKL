        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1275"
                TIME_SLOT_REF1="ts870" TIME_SLOT_REF2="ts882">
                <ANNOTATION_VALUE>Some children were bringing some that day, saying that they have been ripened using drugs.</ANNOTATION_VALUE>
