        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2105"
                TIME_SLOT_REF1="ts893" TIME_SLOT_REF2="ts898">
                <ANNOTATION_VALUE>People who have money do not eat it.</ANNOTATION_VALUE>
