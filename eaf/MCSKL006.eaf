        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2080"
                TIME_SLOT_REF1="ts885" TIME_SLOT_REF2="ts888">
                <ANNOTATION_VALUE>One will have diarrhea.</ANNOTATION_VALUE>
