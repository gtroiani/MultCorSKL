        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a948"
                TIME_SLOT_REF1="ts853" TIME_SLOT_REF2="ts856">
                <ANNOTATION_VALUE>The other day [they] brought this Shymkent one.</ANNOTATION_VALUE>
