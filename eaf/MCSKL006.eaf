        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a428"
                TIME_SLOT_REF1="ts287" TIME_SLOT_REF2="ts293">
                <ANNOTATION_VALUE>At Zharkyn's?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a429"
                TIME_SLOT_REF1="ts301" TIME_SLOT_REF2="ts332">
                <ANNOTATION_VALUE>Dau said that he [Zholaman] borrowed a lot of money from Zharkyn and asked why would he do that.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a430"
                TIME_SLOT_REF1="ts337" TIME_SLOT_REF2="ts340">
                <ANNOTATION_VALUE>Does he borrow money from Zharkyn?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a595"
                TIME_SLOT_REF1="ts350" TIME_SLOT_REF2="ts364">
                <ANNOTATION_VALUE>He does not give money to Zholaman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a585"
                TIME_SLOT_REF1="ts373" TIME_SLOT_REF2="ts379">
                <ANNOTATION_VALUE>To Zholaman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a594"
                TIME_SLOT_REF1="ts381" TIME_SLOT_REF2="ts396">
                <ANNOTATION_VALUE>Then he says that apparently Zholaman sold his two foals, and he wondered where he spent all this money after having sold the foals. Zholaman also sold his cows, he says.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a586"
                TIME_SLOT_REF1="ts422" TIME_SLOT_REF2="ts433">
                <ANNOTATION_VALUE>Those children's clothes is also a concern.</ANNOTATION_VALUE>
