            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a954"
                TIME_SLOT_REF1="ts1828" TIME_SLOT_REF2="ts1830">
                <ANNOTATION_VALUE>This is aunt Aisulu and uncle Bakyt.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
