                <ANNOTATION_VALUE>Oh, now I understand.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a924"
                TIME_SLOT_REF1="ts1646" TIME_SLOT_REF2="ts1650">
                <ANNOTATION_VALUE>Look. They are cutting the cake now. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a926"
                TIME_SLOT_REF1="ts1654" TIME_SLOT_REF2="ts1658">
                <ANNOTATION_VALUE>Here is your kelin...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a927"
                TIME_SLOT_REF1="ts1662" TIME_SLOT_REF2="ts1668">
                <ANNOTATION_VALUE>Your kelin is apparently is an athlete. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a928"
                TIME_SLOT_REF1="ts1670" TIME_SLOT_REF2="ts1680">
                <ANNOTATION_VALUE>She does that... whachamacallit... what kind of sports was it? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a931"
                TIME_SLOT_REF1="ts1688" TIME_SLOT_REF2="ts1690">
                <ANNOTATION_VALUE>Yes, zhamby atu.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a932"
                TIME_SLOT_REF1="ts1692" TIME_SLOT_REF2="ts1704">
                <ANNOTATION_VALUE>Apparently this is when you ride a horse and... </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a935"
                TIME_SLOT_REF1="ts1710" TIME_SLOT_REF2="ts1715">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a939"
                TIME_SLOT_REF1="ts1737" TIME_SLOT_REF2="ts1746">
                <ANNOTATION_VALUE>I will show you now.. The video in which Saniya is shooting... </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a942"
                TIME_SLOT_REF1="ts1754" TIME_SLOT_REF2="ts1762">
                <ANNOTATION_VALUE>Yes, they said she is a champion. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a945"
                TIME_SLOT_REF1="ts1768" TIME_SLOT_REF2="ts1776">
                <ANNOTATION_VALUE>Grandma, it is just tamada. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a948"
                TIME_SLOT_REF1="ts1778" TIME_SLOT_REF2="ts1784">
                <ANNOTATION_VALUE>Here, look, this is Kairat and this is Saniya. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a949"
                TIME_SLOT_REF1="ts1794" TIME_SLOT_REF2="ts1796">
                <ANNOTATION_VALUE>Here here.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a950"
                TIME_SLOT_REF1="ts1804" TIME_SLOT_REF2="ts1812">
                <ANNOTATION_VALUE>Look, this is uncle Kabanbay and Saken. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a953"
                TIME_SLOT_REF1="ts1824" TIME_SLOT_REF2="ts1826">
