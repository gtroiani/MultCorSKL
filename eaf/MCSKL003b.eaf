    <TIER LINGUISTIC_TYPE_REF="Translation"  TIER_ID="trx_en@SPK3010">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a593"
                TIME_SLOT_REF1="ts10" TIME_SLOT_REF2="ts13">
                <ANNOTATION_VALUE>Is it the kelin?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a604"
                TIME_SLOT_REF1="ts62" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>Who is the person standing nearer beside her?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a607"
                TIME_SLOT_REF1="ts74" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>The one standing nearby, closer to us, I mean.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a616"
                TIME_SLOT_REF1="ts116" TIME_SLOT_REF2="ts118">
                <ANNOTATION_VALUE>This is Nazgul.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a619"
                TIME_SLOT_REF1="ts130" TIME_SLOT_REF2="ts137">
                <ANNOTATION_VALUE>Kairat has finally found a kelin and got overjoyed.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a622"
                TIME_SLOT_REF1="ts139" TIME_SLOT_REF2="ts144">
                <ANNOTATION_VALUE>Right when he turned 28.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a625"
                TIME_SLOT_REF1="ts158" TIME_SLOT_REF2="ts160">
                <ANNOTATION_VALUE>Oh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a627"
                TIME_SLOT_REF1="ts162" TIME_SLOT_REF2="ts169">
                <ANNOTATION_VALUE>Had she stayed single for two years more, she would have become a kari kyz. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a629"
                TIME_SLOT_REF1="ts178" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>It is right the time of ###</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a631"
                TIME_SLOT_REF1="ts188" TIME_SLOT_REF2="ts192">
                <ANNOTATION_VALUE>This person who is holding the hem of the dress? Is it the kelin? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a634"
                TIME_SLOT_REF1="ts202" TIME_SLOT_REF2="ts204">
                <ANNOTATION_VALUE>M.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a643"
                TIME_SLOT_REF1="ts244" TIME_SLOT_REF2="ts256">
                <ANNOTATION_VALUE>Yes, they bring everything themselves too. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a646"
                TIME_SLOT_REF1="ts260" TIME_SLOT_REF2="ts264">
                <ANNOTATION_VALUE>They they clean up afterwards themselves.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a647"
                TIME_SLOT_REF1="ts268" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>You do not have to move a finger basically. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a650"
                TIME_SLOT_REF1="ts278" TIME_SLOT_REF2="ts280">
                <ANNOTATION_VALUE>Oh really?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a661"
                TIME_SLOT_REF1="ts324" TIME_SLOT_REF2="ts328">
                <ANNOTATION_VALUE>Kulzipa. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a674"
                TIME_SLOT_REF1="ts398" TIME_SLOT_REF2="ts400">
                <ANNOTATION_VALUE>She just now made the bed so tidy, [and now you are lying there down!]..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a676"
                TIME_SLOT_REF1="ts406" TIME_SLOT_REF2="ts410">
                <ANNOTATION_VALUE>Oh really?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a677"
                TIME_SLOT_REF1="ts417" TIME_SLOT_REF2="ts424">
                <ANNOTATION_VALUE>She said she washed that thing... the blanket. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a683"
                TIME_SLOT_REF1="ts436" TIME_SLOT_REF2="ts441">
                <ANNOTATION_VALUE>Do not run away from me!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a684"
                TIME_SLOT_REF1="ts442" TIME_SLOT_REF2="ts446">
                <ANNOTATION_VALUE>Why do you involve Aset?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a686"
                TIME_SLOT_REF1="ts460" TIME_SLOT_REF2="ts462">
                <ANNOTATION_VALUE>Aset has not slept for many days.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a689"
                TIME_SLOT_REF1="ts464" TIME_SLOT_REF2="ts474">
                <ANNOTATION_VALUE>But you have! </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a690"
                TIME_SLOT_REF1="ts476" TIME_SLOT_REF2="ts482">
                <ANNOTATION_VALUE>You did sleep!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a695"
                TIME_SLOT_REF1="ts504" TIME_SLOT_REF2="ts506">
                <ANNOTATION_VALUE>Who is this?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a701"
                TIME_SLOT_REF1="ts526" TIME_SLOT_REF2="ts528">
                <ANNOTATION_VALUE>Who else is there for me to cling to?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a704"
                TIME_SLOT_REF1="ts533" TIME_SLOT_REF2="ts542">
                <ANNOTATION_VALUE>Who else shall I cling to? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a706"
                TIME_SLOT_REF1="ts546" TIME_SLOT_REF2="ts548">
                <ANNOTATION_VALUE>Mmm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a708"
                TIME_SLOT_REF1="ts556" TIME_SLOT_REF2="ts562">
                <ANNOTATION_VALUE>Once they used to gather all the kids [of the guests] in the cafiteria. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a710"
                TIME_SLOT_REF1="ts572" TIME_SLOT_REF2="ts574">
                <ANNOTATION_VALUE>Which one of these is Kunsulu?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a711"
