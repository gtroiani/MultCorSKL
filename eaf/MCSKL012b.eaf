        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1028"
                TIME_SLOT_REF1="ts1612" TIME_SLOT_REF2="ts1616">
                <ANNOTATION_VALUE>What does she say she will do with it?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1030"
                TIME_SLOT_REF1="ts1623" TIME_SLOT_REF2="ts1626">
                <ANNOTATION_VALUE>Yes, they say trend.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1032"
                TIME_SLOT_REF1="ts1627" TIME_SLOT_REF2="ts1633">
                <ANNOTATION_VALUE>Our daughter also says so.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1033"
                TIME_SLOT_REF1="ts1634" TIME_SLOT_REF2="ts1643">
                <ANNOTATION_VALUE>I say, "We do not have space at home to pur your 'trend' in it".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1038"
                TIME_SLOT_REF1="ts1663" TIME_SLOT_REF2="ts1666">
                <ANNOTATION_VALUE>Oh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1043"
                TIME_SLOT_REF1="ts1687" TIME_SLOT_REF2="ts1693">
                <ANNOTATION_VALUE>Oh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1044"
                TIME_SLOT_REF1="ts1694" TIME_SLOT_REF2="ts1706">
                <ANNOTATION_VALUE>But I was asking about the toy. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1047"
                TIME_SLOT_REF1="ts1710" TIME_SLOT_REF2="ts1713">
                <ANNOTATION_VALUE>My daughter also told me to buy her this toy.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1048"
                TIME_SLOT_REF1="ts1714" TIME_SLOT_REF2="ts1726">
                <ANNOTATION_VALUE>She says these are trending toys.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1055"
                TIME_SLOT_REF1="ts1728" TIME_SLOT_REF2="ts1736">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1056"
                TIME_SLOT_REF1="ts1738" TIME_SLOT_REF2="ts1745">
                <ANNOTATION_VALUE>She said about this very shark.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1057"
                TIME_SLOT_REF1="ts1746" TIME_SLOT_REF2="ts1753">
                <ANNOTATION_VALUE>I say, "Where am I going to put it?" </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1058"
                TIME_SLOT_REF1="ts1754" TIME_SLOT_REF2="ts1756">
                <ANNOTATION_VALUE>I really hate this...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1059"
                TIME_SLOT_REF1="ts1758" TIME_SLOT_REF2="ts1764">
                <ANNOTATION_VALUE>I'd be ok with it if she had her own room.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1064"
                TIME_SLOT_REF1="ts1787" TIME_SLOT_REF2="ts1802">
                <ANNOTATION_VALUE>Oh, haha, you imitate wonderfully.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1074"
                TIME_SLOT_REF1="ts1834" TIME_SLOT_REF2="ts1842">
                <ANNOTATION_VALUE>That thing...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1088"
                TIME_SLOT_REF1="ts1908" TIME_SLOT_REF2="ts1917">
                <ANNOTATION_VALUE>You...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1089"
                TIME_SLOT_REF1="ts1918" TIME_SLOT_REF2="ts1925">
                <ANNOTATION_VALUE>You are more agreeable and she knows it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1091"
                TIME_SLOT_REF1="ts1926" TIME_SLOT_REF2="ts1933">
                <ANNOTATION_VALUE>It is her grandmother.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1092"
                TIME_SLOT_REF1="ts1934" TIME_SLOT_REF2="ts1942">
                <ANNOTATION_VALUE>If her grandmother says no, she will never try to come back and convince her again.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1096"
                TIME_SLOT_REF1="ts1946" TIME_SLOT_REF2="ts1952">
                <ANNOTATION_VALUE>I opened a Kaspi Gold for  Mashon.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1097"
                TIME_SLOT_REF1="ts1956" TIME_SLOT_REF2="ts1960">
                <ANNOTATION_VALUE>When she was about to leave for Astana.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1100"
                TIME_SLOT_REF1="ts1978" TIME_SLOT_REF2="ts1981">
                <ANNOTATION_VALUE>We put some money into her Kaspi Gold.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1101"
                TIME_SLOT_REF1="ts1982" TIME_SLOT_REF2="ts1984">
                <ANNOTATION_VALUE>Around 20 000.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1102"
                TIME_SLOT_REF1="ts1986" TIME_SLOT_REF2="ts1990">
                <ANNOTATION_VALUE>To Mashon's account.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1103"
                TIME_SLOT_REF1="ts1992" TIME_SLOT_REF2="ts2004">
                <ANNOTATION_VALUE>I opened it because I thought she would lose her money if it was in cash form.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1105"
                TIME_SLOT_REF1="ts2006" TIME_SLOT_REF2="ts2010">
                <ANNOTATION_VALUE>Then I am able to see all of ther transactions on my phone.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1107"
                TIME_SLOT_REF1="ts2014" TIME_SLOT_REF2="ts2024">
                <ANNOTATION_VALUE>There would often be a transaction called "IP Gulzhanat", and then I thought  "Oh, she probably buys stuff at that store near Gaukhar's home". </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1113"
                TIME_SLOT_REF1="ts2026" TIME_SLOT_REF2="ts2031">
                <ANNOTATION_VALUE>One day there was a transaction for a big amount.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1114"
                TIME_SLOT_REF1="ts2032" TIME_SLOT_REF2="ts2034">
                <ANNOTATION_VALUE>I asked her, "hey, where did the money go?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1115"
                TIME_SLOT_REF1="ts2036" TIME_SLOT_REF2="ts2038">
                <ANNOTATION_VALUE>She said, "I ordered a T-Shirt."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1116"
                TIME_SLOT_REF1="ts2040" TIME_SLOT_REF2="ts2042">
                <ANNOTATION_VALUE>I said ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1117"
                TIME_SLOT_REF1="ts2044" TIME_SLOT_REF2="ts2046">
                <ANNOTATION_VALUE>And, you know what, she also took one suitcase worth of clothing with her.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1118"
                TIME_SLOT_REF1="ts2048" TIME_SLOT_REF2="ts2051">
                <ANNOTATION_VALUE>Then one day she says, "Mom, I ordered a bag".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1119"
                TIME_SLOT_REF1="ts2052" TIME_SLOT_REF2="ts2068">
                <ANNOTATION_VALUE>I thought she ordered a small, nice bag.  But it turned out that she ordered... you know these bags made of fabric that people wear these days.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1121"
                TIME_SLOT_REF1="ts2070" TIME_SLOT_REF2="ts2075">
                <ANNOTATION_VALUE>She sent to me its photo, saying "That's the bag".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1123"
                TIME_SLOT_REF1="ts2076" TIME_SLOT_REF2="ts2082">
                <ANNOTATION_VALUE>I was like, "God, is it this thing that you've ordered?" </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1124"
                TIME_SLOT_REF1="ts2084" TIME_SLOT_REF2="ts2092">
                <ANNOTATION_VALUE>It was an order from an online-shop in that city. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
