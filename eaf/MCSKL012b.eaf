    <TIER LINGUISTIC_TYPE_REF="Translation" TIER_ID="trx_en@SPK0024">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a92"
                TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts49">
                <ANNOTATION_VALUE>"Zheksen is your blood, bitch", she said to her. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97"
                TIME_SLOT_REF1="ts55" TIME_SLOT_REF2="ts70">
                <ANNOTATION_VALUE>"You bitch, Zheksen is your blood", she said.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a107"
                TIME_SLOT_REF1="ts130" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>She said, "Don't seperate them!".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111"
                TIME_SLOT_REF1="ts136" TIME_SLOT_REF2="ts143">
                <ANNOTATION_VALUE>She said, "You are not going back to him anymore". </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112"
                TIME_SLOT_REF1="ts150" TIME_SLOT_REF2="ts158">
                <ANNOTATION_VALUE>"If you guys do so again...".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
