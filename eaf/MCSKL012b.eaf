        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a948"
                TIME_SLOT_REF1="ts1270" TIME_SLOT_REF2="ts1274">
                <ANNOTATION_VALUE>Won't she look for you?</ANNOTATION_VALUE>
