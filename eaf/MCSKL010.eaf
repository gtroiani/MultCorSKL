        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a991"
                TIME_SLOT_REF1="ts1320" TIME_SLOT_REF2="ts1324">
                <ANNOTATION_VALUE>Shall I check?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
