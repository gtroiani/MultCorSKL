    <TIER LINGUISTIC_TYPE_REF="Translation"  TIER_ID="trx_en@SPK3012">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a723"
                TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts6">
                <ANNOTATION_VALUE>Are we going to Almaty or not? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a727"
                TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>What days would want to go to Almaty? Till when is your leave?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a728"
                TIME_SLOT_REF1="ts38" TIME_SLOT_REF2="ts42">
                <ANNOTATION_VALUE>Till when is your leave? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a733"
                TIME_SLOT_REF1="ts56" TIME_SLOT_REF2="ts60">
                <ANNOTATION_VALUE>Mm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a742"
                TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts116">
                <ANNOTATION_VALUE>Do you mean to which specfic places in Almaty? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a748"
                TIME_SLOT_REF1="ts134" TIME_SLOT_REF2="ts140">
                <ANNOTATION_VALUE>To Turkistan? From Almaty? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a752"
                TIME_SLOT_REF1="ts160" TIME_SLOT_REF2="ts164">
                <ANNOTATION_VALUE>Most likely so.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a753"
                TIME_SLOT_REF1="ts166" TIME_SLOT_REF2="ts174">
                <ANNOTATION_VALUE>Plus it seems to me that Ulan would not want to be there. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a755"
                TIME_SLOT_REF1="ts176" TIME_SLOT_REF2="ts178">
                <ANNOTATION_VALUE>Well if you want to go to Almaty...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a756"
                TIME_SLOT_REF1="ts180" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>you also need that...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a757"
                TIME_SLOT_REF1="ts184" TIME_SLOT_REF2="ts185">
                <ANNOTATION_VALUE>If you want to go on a tour...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a759"
                TIME_SLOT_REF1="ts188" TIME_SLOT_REF2="ts192">
                <ANNOTATION_VALUE> I think Ulan, Ayan, and others will not go.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a760"
                TIME_SLOT_REF1="ts197" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>If there is no one else with you [on the tour], I can go with you if you wish. It is not difficult for me. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a761"
                TIME_SLOT_REF1="ts212" TIME_SLOT_REF2="ts216">
                <ANNOTATION_VALUE>Let me warn you in advance: you will not be available for the whole day. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a762"
                TIME_SLOT_REF1="ts218" TIME_SLOT_REF2="ts234">
                <ANNOTATION_VALUE>What I mean is that you go to the tour bus at six in the morning and it will have been ten thirty pm by the time you finish seeing and doing all things. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a768"
                TIME_SLOT_REF1="ts250" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>It is not coffee. It is just water inside it. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a769"
                TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts260">
                <ANNOTATION_VALUE>What were you saying you were thinking about?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a771"
                TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts268">
                <ANNOTATION_VALUE>Who?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a774"
                TIME_SLOT_REF1="ts274" TIME_SLOT_REF2="ts282">
                <ANNOTATION_VALUE>Whaaat? All of us? All four of us? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a775"
                TIME_SLOT_REF1="ts289" TIME_SLOT_REF2="ts294">
                <ANNOTATION_VALUE>Who is there?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a779"
                TIME_SLOT_REF1="ts326" TIME_SLOT_REF2="ts328">
                <ANNOTATION_VALUE>Do you just not want to spend your money on that?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a783"
                TIME_SLOT_REF1="ts330" TIME_SLOT_REF2="ts332">
                <ANNOTATION_VALUE>I understand though.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a784"
