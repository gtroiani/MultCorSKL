            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1010"
                TIME_SLOT_REF1="ts1414" TIME_SLOT_REF2="ts1418">
                <ANNOTATION_VALUE>Like mine will be the top seat and yours the bottom seat... </ANNOTATION_VALUE>
