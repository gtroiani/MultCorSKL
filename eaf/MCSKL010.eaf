        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1009"
                TIME_SLOT_REF1="ts1410" TIME_SLOT_REF2="ts1413">
                <ANNOTATION_VALUE>...so that we can then swap the places...</ANNOTATION_VALUE>
