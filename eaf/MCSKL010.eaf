    <TIER LINGUISTIC_TYPE_REF="Translation"  TIER_ID="trx_en@SPK3013">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a724"
                TIME_SLOT_REF1="ts8" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>No, we are going.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a725"
                TIME_SLOT_REF1="ts12" TIME_SLOT_REF2="ts18">
                <ANNOTATION_VALUE> Let me first get my that thing... My vacation pay should be transferred to me tomorrow.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a726"
                TIME_SLOT_REF1="ts20" TIME_SLOT_REF2="ts22">
                <ANNOTATION_VALUE>I am not working the day after tomorrow.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a729"
                TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a730"
                TIME_SLOT_REF1="ts44" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>My vacation...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a731"
                TIME_SLOT_REF1="ts48" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>let me think...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a732"
                TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts54">
                <ANNOTATION_VALUE>well I need to be back at work on the 30th.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a734"
                TIME_SLOT_REF1="ts58" TIME_SLOT_REF2="ts66">
                <ANNOTATION_VALUE>I should be here by around 26th.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a735"
                TIME_SLOT_REF1="ts70" TIME_SLOT_REF2="ts72">
                <ANNOTATION_VALUE>Probably..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a736"
                TIME_SLOT_REF1="ts74" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>alright...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a737"
                TIME_SLOT_REF1="ts78" TIME_SLOT_REF2="ts84">
                <ANNOTATION_VALUE>we should make up my mind about it now. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a738"
                TIME_SLOT_REF1="ts86" TIME_SLOT_REF2="ts89">
                <ANNOTATION_VALUE>If we go to Almaty...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a739"
                TIME_SLOT_REF1="ts90" TIME_SLOT_REF2="ts100">
                <ANNOTATION_VALUE>will we go to Alakol after first getting to Almaty? Is that how we want it to be?  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a741"
                TIME_SLOT_REF1="ts104" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>If we go to Almaty, then where will we go? I mean...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a744"
                TIME_SLOT_REF1="ts118" TIME_SLOT_REF2="ts123">
                <ANNOTATION_VALUE>You said that yourself, so think now. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a746"
                TIME_SLOT_REF1="ts126" TIME_SLOT_REF2="ts132">
                <ANNOTATION_VALUE>We could take a train to Turkistan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a749"
                TIME_SLOT_REF1="ts138" TIME_SLOT_REF2="ts142">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a750"
                TIME_SLOT_REF1="ts144" TIME_SLOT_REF2="ts154">
                <ANNOTATION_VALUE>But it is too hot for that. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a754"
                TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts161">
                <ANNOTATION_VALUE>Plus it is the area near Shymkent.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a765"
                TIME_SLOT_REF1="ts230" TIME_SLOT_REF2="ts237">
                <ANNOTATION_VALUE>If I go to Almaty..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a766"
                TIME_SLOT_REF1="ts240" TIME_SLOT_REF2="ts243">
                <ANNOTATION_VALUE>If I go to Almaty...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a767"
                TIME_SLOT_REF1="ts244" TIME_SLOT_REF2="ts248">
                <ANNOTATION_VALUE> Is there coffee in it?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a770"
                TIME_SLOT_REF1="ts258" TIME_SLOT_REF2="ts264">
                <ANNOTATION_VALUE>What if we do not rent an appartment and just go to those people's place. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a772"
                TIME_SLOT_REF1="ts270" TIME_SLOT_REF2="ts272">
                <ANNOTATION_VALUE>At ####'s place?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a776"
                TIME_SLOT_REF1="ts280" TIME_SLOT_REF2="ts285">
                <ANNOTATION_VALUE>There is no one ###</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a777"
                TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts297">
                <ANNOTATION_VALUE>His wife also lives seperately.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a778"
                TIME_SLOT_REF1="ts298" TIME_SLOT_REF2="ts310">
                <ANNOTATION_VALUE>There is only Marzhan, her husband, our brother-in-law, and then their girl who studies in grade 8-9.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a780"
                TIME_SLOT_REF1="ts314" TIME_SLOT_REF2="ts316">
                <ANNOTATION_VALUE>Saida already got married [and does not live with them].</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a781"
                TIME_SLOT_REF1="ts318" TIME_SLOT_REF2="ts321">
                <ANNOTATION_VALUE>Or...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a782"
                TIME_SLOT_REF1="ts322" TIME_SLOT_REF2="ts324">
                <ANNOTATION_VALUE>Let's just rent an appartment, screw it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a792"
                TIME_SLOT_REF1="ts364" TIME_SLOT_REF2="ts370">
                <ANNOTATION_VALUE>If we go, we will go for around four days. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a794"
                TIME_SLOT_REF1="ts372" TIME_SLOT_REF2="ts378">
                <ANNOTATION_VALUE>Say, if we take two days for ourselves... </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a795"
                TIME_SLOT_REF1="ts382" TIME_SLOT_REF2="ts386">
                <ANNOTATION_VALUE>Say one day we will ### </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a797"
                TIME_SLOT_REF1="ts390" TIME_SLOT_REF2="ts392">
                <ANNOTATION_VALUE>And say if you and I go for shopping for a whole day...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a798"
                TIME_SLOT_REF1="ts394" TIME_SLOT_REF2="ts396">
                <ANNOTATION_VALUE>And you take two days for that thing of yours...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a802"
                TIME_SLOT_REF1="ts402" TIME_SLOT_REF2="ts404">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a805"
                TIME_SLOT_REF1="ts422" TIME_SLOT_REF2="ts428">
                <ANNOTATION_VALUE>Oh, no, he did not go to Shymbulak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a810"
                TIME_SLOT_REF1="ts442" TIME_SLOT_REF2="ts453">
                <ANNOTATION_VALUE>We took the cable car when we went back down from Koktobe.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a811"
                TIME_SLOT_REF1="ts454" TIME_SLOT_REF2="ts459">
                <ANNOTATION_VALUE>Oh we also took on the thing like that...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a813"
                TIME_SLOT_REF1="ts460" TIME_SLOT_REF2="ts462">
                <ANNOTATION_VALUE>you know the thing called Lesnya skazka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a814"
                TIME_SLOT_REF1="ts466" TIME_SLOT_REF2="ts470">
                <ANNOTATION_VALUE>On something like that.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a817"
                TIME_SLOT_REF1="ts472" TIME_SLOT_REF2="ts484">
                <ANNOTATION_VALUE>It turns out that Lesnya Skazka is... </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a819"
                TIME_SLOT_REF1="ts486" TIME_SLOT_REF2="ts489">
                <ANNOTATION_VALUE>Oh my...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a820"
                TIME_SLOT_REF1="ts490" TIME_SLOT_REF2="ts496">
                <ANNOTATION_VALUE>Apparently Karagai is such an expensive place!!! </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a821"
                TIME_SLOT_REF1="ts506" TIME_SLOT_REF2="ts509">
                <ANNOTATION_VALUE>No...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a822"
                TIME_SLOT_REF1="ts510" TIME_SLOT_REF2="ts515">
                <ANNOTATION_VALUE>the pool is...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
