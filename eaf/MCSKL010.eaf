        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1029"
                TIME_SLOT_REF1="ts1508" TIME_SLOT_REF2="ts1514">
                <ANNOTATION_VALUE>I guess the wedding is on the 22nd. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1030"
                TIME_SLOT_REF1="ts1518" TIME_SLOT_REF2="ts1528">
                <ANNOTATION_VALUE>She will go to the wedding on the 22nd, and then Shyrai will come back, and on the 23rd and 24th she will go to yet another wedding. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
