                <ANNOTATION_VALUE>I told Dana:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1008"
                TIME_SLOT_REF1="ts1400" TIME_SLOT_REF2="ts1408">
                <ANNOTATION_VALUE>Let's buy seats from two different  carriages but at the same kupe [number]...  </ANNOTATION_VALUE>
