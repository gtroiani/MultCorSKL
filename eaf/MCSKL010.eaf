        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1012"
                TIME_SLOT_REF1="ts1424" TIME_SLOT_REF2="ts1432">
                <ANNOTATION_VALUE>And so she bought the seats from the same carriage, and she bought her own seat at the spot which is close to that smelly part of the carriage where the toilet is...  </ANNOTATION_VALUE>
