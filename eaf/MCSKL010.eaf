        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a982"
                TIME_SLOT_REF1="ts1278" TIME_SLOT_REF2="ts1282">
                <ANNOTATION_VALUE>"Why would you get to know them? Why can't you just keep still? </ANNOTATION_VALUE>
