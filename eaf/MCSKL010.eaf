        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a786"
                TIME_SLOT_REF1="ts342" TIME_SLOT_REF2="ts347">
                <ANNOTATION_VALUE>For example there are friends of mine who I know from university who live in Almaty. </ANNOTATION_VALUE>
