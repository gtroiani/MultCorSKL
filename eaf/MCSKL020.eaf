        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a482"
                TIME_SLOT_REF1="ts678" TIME_SLOT_REF2="ts688">
                <ANNOTATION_VALUE>She says she is like her mother-in-law. She says if she falls sick, she quickly gets herself back on her feet. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a483"
                TIME_SLOT_REF1="ts694" TIME_SLOT_REF2="ts698">
                <ANNOTATION_VALUE>She says she knows how to treat herself and get back on her feet, just like her mother-in-law does.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a485"
                TIME_SLOT_REF1="ts702" TIME_SLOT_REF2="ts714">
                <ANNOTATION_VALUE>Mom, the meal is already lukewarm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a492"
                TIME_SLOT_REF1="ts728" TIME_SLOT_REF2="ts730">
                <ANNOTATION_VALUE>I feel like I’m being dragged into sleep.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a494"
                TIME_SLOT_REF1="ts736" TIME_SLOT_REF2="ts738">
                <ANNOTATION_VALUE>I cannot keep my eyes open.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a495"
                TIME_SLOT_REF1="ts740" TIME_SLOT_REF2="ts744">
                <ANNOTATION_VALUE>But sleeping at a time like this isn’t right.</ANNOTATION_VALUE>
