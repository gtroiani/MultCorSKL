        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a316"
                TIME_SLOT_REF1="ts1032" TIME_SLOT_REF2="ts1033">
                <ANNOTATION_VALUE>¬Гүлжанат ол,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a317"
                TIME_SLOT_REF1="ts1034" TIME_SLOT_REF2="ts1035">
                <ANNOTATION_VALUE>мектептің лагеріне баратын.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a318"
                TIME_SLOT_REF1="ts1036" TIME_SLOT_REF2="ts1039">
                <ANNOTATION_VALUE>Қазір мектептің лагері жоқ.</ANNOTATION_VALUE>
