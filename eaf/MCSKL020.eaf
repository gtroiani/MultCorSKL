        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a565"
                TIME_SLOT_REF1="ts832" TIME_SLOT_REF2="ts836">
                <ANNOTATION_VALUE>They are telling us that we can already begin submitting my daughter's documents.</ANNOTATION_VALUE>
