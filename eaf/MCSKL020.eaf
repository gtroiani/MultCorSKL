        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a498"
                TIME_SLOT_REF1="ts742" TIME_SLOT_REF2="ts746">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a500"
                TIME_SLOT_REF1="ts752" TIME_SLOT_REF2="ts754">
                <ANNOTATION_VALUE>It is aleady evening, right?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a501"
                TIME_SLOT_REF1="ts758" TIME_SLOT_REF2="ts762">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a503"
                TIME_SLOT_REF1="ts764" TIME_SLOT_REF2="ts775">
                <ANNOTATION_VALUE>No. I am done darling. This is too much. </ANNOTATION_VALUE>
