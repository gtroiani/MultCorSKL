        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a468"
                TIME_SLOT_REF1="ts622" TIME_SLOT_REF2="ts624">
                <ANNOTATION_VALUE>Only their son [Aliya's son] has a car.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
