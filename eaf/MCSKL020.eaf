        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a469"
                TIME_SLOT_REF1="ts628" TIME_SLOT_REF2="ts632">
                <ANNOTATION_VALUE>How is it even possible for Aliya to be able to drive a car...</ANNOTATION_VALUE>
