        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a476"
                TIME_SLOT_REF1="ts658" TIME_SLOT_REF2="ts664">
                <ANNOTATION_VALUE>The kelinshek took the car and sold it immediately. </ANNOTATION_VALUE>
