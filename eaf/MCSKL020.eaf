        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a547"
                TIME_SLOT_REF1="ts978" TIME_SLOT_REF2="ts986">
                <ANNOTATION_VALUE>I mean she is just tutoring pre-school kids at home, preparing them for school, as a way to earn additional income. </ANNOTATION_VALUE>
