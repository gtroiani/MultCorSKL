        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a471"
                TIME_SLOT_REF1="ts636" TIME_SLOT_REF2="ts640">
                <ANNOTATION_VALUE>No, Aliya does not have a car.</ANNOTATION_VALUE>
