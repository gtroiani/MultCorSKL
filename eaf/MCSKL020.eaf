        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a446"
                TIME_SLOT_REF1="ts516" TIME_SLOT_REF2="ts520">
                <ANNOTATION_VALUE>That's just what happens to me sometimes - I simply cannot sleep. </ANNOTATION_VALUE>
