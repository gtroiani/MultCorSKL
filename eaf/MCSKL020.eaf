        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a505"
                TIME_SLOT_REF1="ts784" TIME_SLOT_REF2="ts786">
                <ANNOTATION_VALUE>It tastes good.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a585"
                TIME_SLOT_REF1="ts792" TIME_SLOT_REF2="ts794">
                <ANNOTATION_VALUE>Yeap.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a508"
                TIME_SLOT_REF1="ts804" TIME_SLOT_REF2="ts808">
                <ANNOTATION_VALUE>Just now Asyl was showing me that house in Kalzhyr. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a510"
                TIME_SLOT_REF1="ts814" TIME_SLOT_REF2="ts816">
                <ANNOTATION_VALUE>Oh God.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a511"
                TIME_SLOT_REF1="ts818" TIME_SLOT_REF2="ts822">
                <ANNOTATION_VALUE>He says: "Look how rich my grandfather is. Just look at his barns." </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a514"
                TIME_SLOT_REF1="ts824" TIME_SLOT_REF2="ts828">
                <ANNOTATION_VALUE>He even mentioned your wedding [which took place in that house].</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a518"
                TIME_SLOT_REF1="ts840" TIME_SLOT_REF2="ts844">
                <ANNOTATION_VALUE>Oh you mean for children... for school?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a523"
                TIME_SLOT_REF1="ts866" TIME_SLOT_REF2="ts871">
                <ANNOTATION_VALUE>When were you planning to get back to work?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a524"
                TIME_SLOT_REF1="ts872" TIME_SLOT_REF2="ts874">
                <ANNOTATION_VALUE>Already soon?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a526"
                TIME_SLOT_REF1="ts880" TIME_SLOT_REF2="ts884">
                <ANNOTATION_VALUE>Oh, by that time, it’ll be too late, and you’ll miss the deadline.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a527"
                TIME_SLOT_REF1="ts886" TIME_SLOT_REF2="ts890">
                <ANNOTATION_VALUE>Will you be done with it by the time of kyryk shelpek? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a532"
                TIME_SLOT_REF1="ts896" TIME_SLOT_REF2="ts898">
                <ANNOTATION_VALUE>Oh, of that little boy, of course!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a533"
                TIME_SLOT_REF1="ts904" TIME_SLOT_REF2="ts908">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a534"
                TIME_SLOT_REF1="ts912" TIME_SLOT_REF2="ts916">
                <ANNOTATION_VALUE>No, what I am saying is, it will be good if they organize the kyryk shelpek around the time when you are already done with your errands and stuff. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a540"
                TIME_SLOT_REF1="ts930" TIME_SLOT_REF2="ts932">
                <ANNOTATION_VALUE>Who?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a541"
                TIME_SLOT_REF1="ts942" TIME_SLOT_REF2="ts948">
                <ANNOTATION_VALUE>Of course she will do that!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a543"
                TIME_SLOT_REF1="ts956" TIME_SLOT_REF2="ts961">
                <ANNOTATION_VALUE>I see.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a544"
                TIME_SLOT_REF1="ts962" TIME_SLOT_REF2="ts966">
                <ANNOTATION_VALUE>Well, she always works with first graders at her own school.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a570"
                TIME_SLOT_REF1="ts988" TIME_SLOT_REF2="ts990">
                <ANNOTATION_VALUE>Of course she would do that!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a548"
                TIME_SLOT_REF1="ts992" TIME_SLOT_REF2="ts1000">
                <ANNOTATION_VALUE>Ayana, apparently, is in a lager' now.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a571"
                TIME_SLOT_REF1="ts1004" TIME_SLOT_REF2="ts1008">
                <ANNOTATION_VALUE>Sakosh told me that... no, not Sakosh... </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a572"
                TIME_SLOT_REF1="ts1012" TIME_SLOT_REF2="ts1016">
                <ANNOTATION_VALUE>Yes, Dakosh told me that.</ANNOTATION_VALUE>
