            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a445"
                TIME_SLOT_REF1="ts510" TIME_SLOT_REF2="ts515">
                <ANNOTATION_VALUE>At night.. sometimes I cannot fall asleep.</ANNOTATION_VALUE>
