        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a555"
                TIME_SLOT_REF1="ts1028" TIME_SLOT_REF2="ts1037">
                <ANNOTATION_VALUE>No, that is not the case. Gulzhanat usually attends summer camps organized by her school own. But this particular summer camp is not organized by any school.</ANNOTATION_VALUE>
