        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1018"
                TIME_SLOT_REF1="ts172" TIME_SLOT_REF2="ts180">
                <ANNOTATION_VALUE>Alright.. here there is also some more... </ANNOTATION_VALUE>
