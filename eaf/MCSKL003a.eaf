        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1039"
                TIME_SLOT_REF1="ts268" TIME_SLOT_REF2="ts270">
                <ANNOTATION_VALUE>Look at all these.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1040"
                TIME_SLOT_REF1="ts274" TIME_SLOT_REF2="ts278">
                <ANNOTATION_VALUE>There are no qudagilar here.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1043"
                TIME_SLOT_REF1="ts280" TIME_SLOT_REF2="ts285">
                <ANNOTATION_VALUE>Qudasha, qudagi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1045"
                TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts300">
                <ANNOTATION_VALUE>He is here... look... the big one... with a beard. </ANNOTATION_VALUE>
