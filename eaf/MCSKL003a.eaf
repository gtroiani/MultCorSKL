        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a992"
                TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts56">
                <ANNOTATION_VALUE>She is the younger sister of your grandmother.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a995"
                TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>Your grandmother who is just over there!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a998"
                TIME_SLOT_REF1="ts72" TIME_SLOT_REF2="ts80">
                <ANNOTATION_VALUE>Stop it...Right when I started, yes, I said so, but then I fixed myself. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1002"
                TIME_SLOT_REF1="ts82" TIME_SLOT_REF2="ts84">
                <ANNOTATION_VALUE>This is her.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1003"
                TIME_SLOT_REF1="ts86" TIME_SLOT_REF2="ts89">
                <ANNOTATION_VALUE>Aunt Maulia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1004"
                TIME_SLOT_REF1="ts90" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>The one who and whose family lives in Shu.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1005"
                TIME_SLOT_REF1="ts104" TIME_SLOT_REF2="ts108">
                <ANNOTATION_VALUE>It is close, yes. </ANNOTATION_VALUE>
