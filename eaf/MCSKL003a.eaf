        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1486"
                TIME_SLOT_REF1="ts2430" TIME_SLOT_REF2="ts2432">
                <ANNOTATION_VALUE>Well...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1487"
                TIME_SLOT_REF1="ts2434" TIME_SLOT_REF2="ts2438">
                <ANNOTATION_VALUE>That will be released later, grandpa. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1488"
                TIME_SLOT_REF1="ts2440" TIME_SLOT_REF2="ts2449">
                <ANNOTATION_VALUE>They will take all the videos and merge them beautifully.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1491"
                TIME_SLOT_REF1="ts2450" TIME_SLOT_REF2="ts2456">
                <ANNOTATION_VALUE>Then they will send it over to use on a disk... </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1518"
                TIME_SLOT_REF1="ts2582" TIME_SLOT_REF2="ts2586">
                <ANNOTATION_VALUE>Ahah, grandad...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1555"
                TIME_SLOT_REF1="ts2758" TIME_SLOT_REF2="ts2760">
                <ANNOTATION_VALUE>What?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1557"
                TIME_SLOT_REF1="ts2764" TIME_SLOT_REF2="ts2768">
                <ANNOTATION_VALUE>Qufalar cannot pariticipate.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1558"
                TIME_SLOT_REF1="ts2770" TIME_SLOT_REF2="ts2772">
                <ANNOTATION_VALUE>In betashar?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1559"
                TIME_SLOT_REF1="ts2774" TIME_SLOT_REF2="ts2776">
                <ANNOTATION_VALUE>Why?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1562"
                TIME_SLOT_REF1="ts2794" TIME_SLOT_REF2="ts2806">
                <ANNOTATION_VALUE>Oh that is how it is! They follow all those traditions and cutoms, I see. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1563"
                TIME_SLOT_REF1="ts2808" TIME_SLOT_REF2="ts2810">
                <ANNOTATION_VALUE>Oh apparently the south is like that.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1566"
                TIME_SLOT_REF1="ts2816" TIME_SLOT_REF2="ts2820">
                <ANNOTATION_VALUE>Do we also do the same?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1567"
                TIME_SLOT_REF1="ts2822" TIME_SLOT_REF2="ts2827">
                <ANNOTATION_VALUE>How could I have known!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1568"
                TIME_SLOT_REF1="ts2830" TIME_SLOT_REF2="ts2836">
                <ANNOTATION_VALUE>Dad, how do the people from the south speak? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1581"
                TIME_SLOT_REF1="ts2894" TIME_SLOT_REF2="ts2898">
                <ANNOTATION_VALUE>A law.. is there such a law? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1606"
                TIME_SLOT_REF1="ts3014" TIME_SLOT_REF2="ts3018">
                <ANNOTATION_VALUE>Who is Aset?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1607"
                TIME_SLOT_REF1="ts3024" TIME_SLOT_REF2="ts3026">
                <ANNOTATION_VALUE>Oh I see.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1610"
                TIME_SLOT_REF1="ts3030" TIME_SLOT_REF2="ts3038">
                <ANNOTATION_VALUE>That person named Zhuk, who is he? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1612"
                TIME_SLOT_REF1="ts3048" TIME_SLOT_REF2="ts3052">
                <ANNOTATION_VALUE>That person...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1613"
                TIME_SLOT_REF1="ts3058" TIME_SLOT_REF2="ts3066">
                <ANNOTATION_VALUE>That person is also uncle Bakyt's younger brother, right? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1615"
                TIME_SLOT_REF1="ts3068" TIME_SLOT_REF2="ts3072">
                <ANNOTATION_VALUE>Oh, his older brother?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
