        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1011"
                TIME_SLOT_REF1="ts144" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>These are the tables, look. </ANNOTATION_VALUE>
