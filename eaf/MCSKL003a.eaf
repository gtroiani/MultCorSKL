        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1047"
                TIME_SLOT_REF1="ts306" TIME_SLOT_REF2="ts318">
                <ANNOTATION_VALUE>An old man wearing a tymak or something like that. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1048"
                TIME_SLOT_REF1="ts320" TIME_SLOT_REF2="ts322">
                <ANNOTATION_VALUE>Who is around 80 something.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1051"
                TIME_SLOT_REF1="ts328" TIME_SLOT_REF2="ts332">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1052"
                TIME_SLOT_REF1="ts334" TIME_SLOT_REF2="ts339">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1053"
                TIME_SLOT_REF1="ts340" TIME_SLOT_REF2="ts344">
                <ANNOTATION_VALUE>Yes, apparently he is the father of the qudagi. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1056"
                TIME_SLOT_REF1="ts350" TIME_SLOT_REF2="ts353">
                <ANNOTATION_VALUE>The parents of those...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1057"
                TIME_SLOT_REF1="ts354" TIME_SLOT_REF2="ts356">
                <ANNOTATION_VALUE>I mean of the quda...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1058"
                TIME_SLOT_REF1="ts358" TIME_SLOT_REF2="ts369">
                <ANNOTATION_VALUE>..they are apparently also sick. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1059"
                TIME_SLOT_REF1="ts370" TIME_SLOT_REF2="ts374">
                <ANNOTATION_VALUE>They are also like big people.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1060"
                TIME_SLOT_REF1="ts376" TIME_SLOT_REF2="ts380">
                <ANNOTATION_VALUE>Look, they are here, dancing. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1063"
                TIME_SLOT_REF1="ts388" TIME_SLOT_REF2="ts392">
                <ANNOTATION_VALUE>Yes, apparently so.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1064"
                TIME_SLOT_REF1="ts398" TIME_SLOT_REF2="ts403">
                <ANNOTATION_VALUE>They are sick, they say.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1070"
                TIME_SLOT_REF1="ts422" TIME_SLOT_REF2="ts432">
                <ANNOTATION_VALUE>The grandfather of the qudagi is still alive, look here. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1071"
                TIME_SLOT_REF1="ts434" TIME_SLOT_REF2="ts438">
                <ANNOTATION_VALUE>Apparently he is 80 something.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1074"
                TIME_SLOT_REF1="ts446" TIME_SLOT_REF2="ts451">
                <ANNOTATION_VALUE>They say he is 81.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1075"
                TIME_SLOT_REF1="ts452" TIME_SLOT_REF2="ts458">
                <ANNOTATION_VALUE>There you see.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1077"
                TIME_SLOT_REF1="ts464" TIME_SLOT_REF2="ts467">
                <ANNOTATION_VALUE>This is...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1078"
                TIME_SLOT_REF1="ts468" TIME_SLOT_REF2="ts475">
                <ANNOTATION_VALUE>They just begin pouring [alochol?] right when you enter... </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1081"
                TIME_SLOT_REF1="ts476" TIME_SLOT_REF2="ts479">
                <ANNOTATION_VALUE>..these Russians.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1082"
                TIME_SLOT_REF1="ts480" TIME_SLOT_REF2="ts486">
                <ANNOTATION_VALUE>This is Kairat's restaurant... </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1083"
                TIME_SLOT_REF1="ts492" TIME_SLOT_REF2="ts494">
                <ANNOTATION_VALUE>Look.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1084"
                TIME_SLOT_REF1="ts496" TIME_SLOT_REF2="ts500">
                <ANNOTATION_VALUE>You enter from here...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1085"
                TIME_SLOT_REF1="ts502" TIME_SLOT_REF2="ts509">
                <ANNOTATION_VALUE>...and you do not get bored before the wedding party starts. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1086"
                TIME_SLOT_REF1="ts510" TIME_SLOT_REF2="ts516">
                <ANNOTATION_VALUE>There is always something to be found to entertain yourself.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1088"
                TIME_SLOT_REF1="ts524" TIME_SLOT_REF2="ts527">
                <ANNOTATION_VALUE>You just drink...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1089"
                TIME_SLOT_REF1="ts528" TIME_SLOT_REF2="ts531">
                <ANNOTATION_VALUE>You can do so while standing even...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1090"
                TIME_SLOT_REF1="ts532" TIME_SLOT_REF2="ts534">
                <ANNOTATION_VALUE>You may not even sit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1093"
                TIME_SLOT_REF1="ts542" TIME_SLOT_REF2="ts551">
                <ANNOTATION_VALUE>No.... you see while you are waiting [for the wedding to start]... </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1094"
                TIME_SLOT_REF1="ts552" TIME_SLOT_REF2="ts566">
                <ANNOTATION_VALUE>Everything is there waiting for you...all the drinks and stuff. Just look here.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1100"
                TIME_SLOT_REF1="ts594" TIME_SLOT_REF2="ts596">
                <ANNOTATION_VALUE>You mean the wedding?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1106"
                TIME_SLOT_REF1="ts600" TIME_SLOT_REF2="ts608">
                <ANNOTATION_VALUE>I guess it ended at about 6-7. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1107"
                TIME_SLOT_REF1="ts620" TIME_SLOT_REF2="ts624">
                <ANNOTATION_VALUE>Here, look, this is Kaisar.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1112"
                TIME_SLOT_REF1="ts636" TIME_SLOT_REF2="ts640">
                <ANNOTATION_VALUE>He is just the same way he was [he did not change]. Normal.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1113"
                TIME_SLOT_REF1="ts649" TIME_SLOT_REF2="ts652">
                <ANNOTATION_VALUE>This is Kaisar.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
