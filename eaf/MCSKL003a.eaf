        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1024"
                TIME_SLOT_REF1="ts208" TIME_SLOT_REF2="ts212">
                <ANNOTATION_VALUE>Bakyt's older sister and his younger sister. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1030"
                TIME_SLOT_REF1="ts224" TIME_SLOT_REF2="ts228">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1031"
                TIME_SLOT_REF1="ts230" TIME_SLOT_REF2="ts234">
                <ANNOTATION_VALUE>That is her.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1034"
                TIME_SLOT_REF1="ts248" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>Yes yes, Turkish. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1037"
                TIME_SLOT_REF1="ts260" TIME_SLOT_REF2="ts266">
                <ANNOTATION_VALUE>They took the photos of themselves, not of their qudalar. </ANNOTATION_VALUE>
