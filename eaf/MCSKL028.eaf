                TIME_SLOT_REF1="ts115" TIME_SLOT_REF2="ts117">
                <ANNOTATION_VALUE>Yes</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2620"
                TIME_SLOT_REF1="ts120" TIME_SLOT_REF2="ts126">
                <ANNOTATION_VALUE>Thus, my mom's sister introduced me to him. In short, so, my mom's sister introduced us to each other.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2621"
                TIME_SLOT_REF1="ts132" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>I used to live in Tajikistan</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2622"
                TIME_SLOT_REF1="ts136" TIME_SLOT_REF2="ts138">
                <ANNOTATION_VALUE>for six years.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2623"
                TIME_SLOT_REF1="ts148" TIME_SLOT_REF2="ts154">
                <ANNOTATION_VALUE>In Dushanbe, a fifteen-minute drive away.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2624"
                TIME_SLOT_REF1="ts164" TIME_SLOT_REF2="ts166">
                <ANNOTATION_VALUE>In the village.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2625"
                TIME_SLOT_REF1="ts168" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>There brides are treated like this.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2626"
                TIME_SLOT_REF1="ts174" TIME_SLOT_REF2="ts196">
                <ANNOTATION_VALUE>At four in the morning you get up, milk the cow, water the garden, sweep, a handkerchief on your head, pants on your feet.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2627"
                TIME_SLOT_REF1="ts210" TIME_SLOT_REF2="ts213">
                <ANNOTATION_VALUE>Yes</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2628"
                TIME_SLOT_REF1="ts221" TIME_SLOT_REF2="ts224">
                <ANNOTATION_VALUE>Yes</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2629"
                TIME_SLOT_REF1="ts248" TIME_SLOT_REF2="ts252">
                <ANNOTATION_VALUE>Yes</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2630"
                TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts258">
                <ANNOTATION_VALUE>yes</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2631"
                TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts268">
                <ANNOTATION_VALUE>Yes</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2632"
                TIME_SLOT_REF1="ts282" TIME_SLOT_REF2="ts288">
                <ANNOTATION_VALUE>I managed to milk four cows.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2633"
                TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts296">
                <ANNOTATION_VALUE>I got up at four in the morning.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2634"
                TIME_SLOT_REF1="ts312" TIME_SLOT_REF2="ts318">
                <ANNOTATION_VALUE>Then, I baked bread on tandoor ovens.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2635"
                TIME_SLOT_REF1="ts322" TIME_SLOT_REF2="ts332">
                <ANNOTATION_VALUE>Besides, do you know these cow cakes (meaning cow dungs)?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2636"
                TIME_SLOT_REF1="ts338" TIME_SLOT_REF2="ts344">
                <ANNOTATION_VALUE> Here, we would  hung them up and stick them to the wall like this.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2637"
                TIME_SLOT_REF1="ts350" TIME_SLOT_REF2="ts366">
                <ANNOTATION_VALUE>So, when they dried up, we used to put them in the oven to cook bread.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2638"
                TIME_SLOT_REF1="ts380" TIME_SLOT_REF2="ts386">
                <ANNOTATION_VALUE>But the nature there is generally cool.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2639"
                TIME_SLOT_REF1="ts392" TIME_SLOT_REF2="ts394">
                <ANNOTATION_VALUE>Heaven.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2640"
                TIME_SLOT_REF1="ts402" TIME_SLOT_REF2="ts406">
                <ANNOTATION_VALUE>They are in Karakalpakstan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2641"
                TIME_SLOT_REF1="ts416" TIME_SLOT_REF2="ts422">
                <ANNOTATION_VALUE>Apples grow in the garden in tons.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2642"
                TIME_SLOT_REF1="ts424" TIME_SLOT_REF2="ts428">
                <ANNOTATION_VALUE>Persimmons grow in tons.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2643"
                TIME_SLOT_REF1="ts430" TIME_SLOT_REF2="ts438">
                <ANNOTATION_VALUE>Those grapes rot on the tree because no one eats them.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2644"
                TIME_SLOT_REF1="ts444" TIME_SLOT_REF2="ts450">
                <ANNOTATION_VALUE>Even though we eat, it remains anyway, on the tops of these.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2645"
                TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts466">
                <ANNOTATION_VALUE>No</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2646"
                TIME_SLOT_REF1="ts470" TIME_SLOT_REF2="ts472">
                <ANNOTATION_VALUE>We didn't.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2647"
                TIME_SLOT_REF1="ts478" TIME_SLOT_REF2="ts480">
                <ANNOTATION_VALUE>Betashar.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2648"
                TIME_SLOT_REF1="ts486" TIME_SLOT_REF2="ts500">
                <ANNOTATION_VALUE>In short, onions, potatoes, everything comes from our garden.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2649"
                TIME_SLOT_REF1="ts510" TIME_SLOT_REF2="ts512">
                <ANNOTATION_VALUE>Cool.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2650"
                TIME_SLOT_REF1="ts514" TIME_SLOT_REF2="ts523">
                <ANNOTATION_VALUE>What I really liked the most was the Uighur music.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2651"
