        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2039"
                TIME_SLOT_REF1="ts424" TIME_SLOT_REF2="ts434">
                <ANNOTATION_VALUE>It is possible to apply for a master's degree and work additionally.</ANNOTATION_VALUE>
