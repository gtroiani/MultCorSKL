        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a851"
                TIME_SLOT_REF1="ts92" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>Did ¬Dana go to Georgia that time?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a853"
                TIME_SLOT_REF1="ts102" TIME_SLOT_REF2="ts106">
