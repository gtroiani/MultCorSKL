        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2036"
                TIME_SLOT_REF1="ts402" TIME_SLOT_REF2="ts406">
                <ANNOTATION_VALUE>They will probably go to the graduate school.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2037"
                TIME_SLOT_REF1="ts410" TIME_SLOT_REF2="ts415">
                <ANNOTATION_VALUE>Why don't you apply for the graduate program?</ANNOTATION_VALUE>
