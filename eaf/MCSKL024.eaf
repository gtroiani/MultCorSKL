        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1591"
                TIME_SLOT_REF1="ts3010" TIME_SLOT_REF2="ts3014">
                <ANNOTATION_VALUE>Yes, yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1593"
                TIME_SLOT_REF1="ts3034" TIME_SLOT_REF2="ts3040">
                <ANNOTATION_VALUE>Say that you also text her you miss her and something.  </ANNOTATION_VALUE>
