        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1440"
                TIME_SLOT_REF1="ts1968" TIME_SLOT_REF2="ts1976">
                <ANNOTATION_VALUE>You take tickets to Almaty then. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1443"
                TIME_SLOT_REF1="ts1978" TIME_SLOT_REF2="ts1984">
                <ANNOTATION_VALUE>Oh no, it has to appear if you type Aqtau.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1444"
                TIME_SLOT_REF1="ts1988" TIME_SLOT_REF2="ts1992">
                <ANNOTATION_VALUE>I have been meaning to tell something else. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1445"
                TIME_SLOT_REF1="ts1998" TIME_SLOT_REF2="ts2006">
                <ANNOTATION_VALUE>I had ten thousand tenge on my phone earlier  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1447"
                TIME_SLOT_REF1="ts2008" TIME_SLOT_REF2="ts2010">
                <ANNOTATION_VALUE>I paid that to you.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1448"
                TIME_SLOT_REF1="ts2016" TIME_SLOT_REF2="ts2020">
                <ANNOTATION_VALUE>Then I spent it to something else. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1450"
                TIME_SLOT_REF1="ts2022" TIME_SLOT_REF2="ts2026">
                <ANNOTATION_VALUE>I paid for the cinema. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1451"
                TIME_SLOT_REF1="ts2030" TIME_SLOT_REF2="ts2038">
                <ANNOTATION_VALUE>I paid almost everything for food.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1453"
                TIME_SLOT_REF1="ts2040" TIME_SLOT_REF2="ts2045">
                <ANNOTATION_VALUE>Eleven hundred for the movie. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1454"
                TIME_SLOT_REF1="ts2046" TIME_SLOT_REF2="ts2050">
                <ANNOTATION_VALUE>It cost me eleven hundred. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1455"
                TIME_SLOT_REF1="ts2052" TIME_SLOT_REF2="ts2056">
                <ANNOTATION_VALUE>it was overall one thousand and seven hundred for food. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1456"
                TIME_SLOT_REF1="ts2058" TIME_SLOT_REF2="ts2064">
                <ANNOTATION_VALUE>How much is seventeen hundred divided by two?  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1457"
                TIME_SLOT_REF1="ts2074" TIME_SLOT_REF2="ts2076">
                <ANNOTATION_VALUE>Yes yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1467"
                TIME_SLOT_REF1="ts2140" TIME_SLOT_REF2="ts2142">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1468"
                TIME_SLOT_REF1="ts2150" TIME_SLOT_REF2="ts2155">
                <ANNOTATION_VALUE>Do you have to sit in that place? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1471"
                TIME_SLOT_REF1="ts2168" TIME_SLOT_REF2="ts2170">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1473"
                TIME_SLOT_REF1="ts2180" TIME_SLOT_REF2="ts2186">
                <ANNOTATION_VALUE>We can stand a little like this. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1474"
                TIME_SLOT_REF1="ts2196" TIME_SLOT_REF2="ts2204">
                <ANNOTATION_VALUE>How much are the bikes there?  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1477"
                TIME_SLOT_REF1="ts2218" TIME_SLOT_REF2="ts2222">
                <ANNOTATION_VALUE>Will they cost sixty thousand tenge? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1481"
                TIME_SLOT_REF1="ts2234" TIME_SLOT_REF2="ts2242">
                <ANNOTATION_VALUE>There are cheaper variants too, if, let's say, those for sixty thousand are good bikes.   </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1485"
                TIME_SLOT_REF1="ts2268" TIME_SLOT_REF2="ts2284">
                <ANNOTATION_VALUE>I have thought about it last year's fall that thiigs go well If I had a bike.   </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1487"
                TIME_SLOT_REF1="ts2290" TIME_SLOT_REF2="ts2298">
                <ANNOTATION_VALUE>But now, I will not be at home and I say if we could buy one for home.   </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1489"
                TIME_SLOT_REF1="ts2300" TIME_SLOT_REF2="ts2308">
                <ANNOTATION_VALUE>Ours is a bike bought ten years ago.   </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1492"
                TIME_SLOT_REF1="ts2312" TIME_SLOT_REF2="ts2316">
                <ANNOTATION_VALUE>It was left under the rain. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1493"
                TIME_SLOT_REF1="ts2318" TIME_SLOT_REF2="ts2324">
                <ANNOTATION_VALUE>Pity, it corroded and turned yellow.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1494"
                TIME_SLOT_REF1="ts2326" TIME_SLOT_REF2="ts2334">
                <ANNOTATION_VALUE>And when you ride it, it produces strange noises because the wheels run out of the air.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1495"
                TIME_SLOT_REF1="ts2342" TIME_SLOT_REF2="ts2344">
                <ANNOTATION_VALUE>I can ride.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1496"
                TIME_SLOT_REF1="ts2346" TIME_SLOT_REF2="ts2350">
                <ANNOTATION_VALUE>It's not difficult, just need to learn it once. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1498"
                TIME_SLOT_REF1="ts2352" TIME_SLOT_REF2="ts2356">
                <ANNOTATION_VALUE>You won't forget once learned. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1499"
                TIME_SLOT_REF1="ts2367" TIME_SLOT_REF2="ts2370">
                <ANNOTATION_VALUE>Say you forgot it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1503"
                TIME_SLOT_REF1="ts2401" TIME_SLOT_REF2="ts2410">
                <ANNOTATION_VALUE>I am also scared of it thinking will I fall.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1506"
                TIME_SLOT_REF1="ts2412" TIME_SLOT_REF2="ts2422">
                <ANNOTATION_VALUE>it heals for a long time if I hurt some place.    </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1507"
                TIME_SLOT_REF1="ts2424" TIME_SLOT_REF2="ts2430">
                <ANNOTATION_VALUE>Well, you know, but let me tell.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1508"
                TIME_SLOT_REF1="ts2432" TIME_SLOT_REF2="ts2444">
                <ANNOTATION_VALUE>I told how I was running backwards in the tenth grade at school.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1514"
                TIME_SLOT_REF1="ts2448" TIME_SLOT_REF2="ts2456">
                <ANNOTATION_VALUE>And it was the physical education lesson.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1516"
                TIME_SLOT_REF1="ts2470" TIME_SLOT_REF2="ts2486">
                <ANNOTATION_VALUE>It was the physical education and then our teacher organized something new.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1519"
                TIME_SLOT_REF1="ts2488" TIME_SLOT_REF2="ts2498">
                <ANNOTATION_VALUE>We used to do warm-up exercises every day.    </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1520"
                TIME_SLOT_REF1="ts2500" TIME_SLOT_REF2="ts2506">
                <ANNOTATION_VALUE>Then it was the third semester when we had PE inside of the building.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1521"
                TIME_SLOT_REF1="ts2508" TIME_SLOT_REF2="ts2516">
                <ANNOTATION_VALUE>Was gymnastics in the third semester? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1524"
                TIME_SLOT_REF1="ts2522" TIME_SLOT_REF2="ts2528">
                <ANNOTATION_VALUE>The second semester? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1527"
                TIME_SLOT_REF1="ts2530" TIME_SLOT_REF2="ts2534">
                <ANNOTATION_VALUE>I don't know but it is inside of the building. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1529"
                TIME_SLOT_REF1="ts2542" TIME_SLOT_REF2="ts2548">
                <ANNOTATION_VALUE>She made us do some gymnastics.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1530"
                TIME_SLOT_REF1="ts2550" TIME_SLOT_REF2="ts2556">
                <ANNOTATION_VALUE>Then we sat, intending to run. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1531"
                TIME_SLOT_REF1="ts2558" TIME_SLOT_REF2="ts2566">
                <ANNOTATION_VALUE>  Maybe she wanted to make that day more interesting?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1532"
                TIME_SLOT_REF1="ts2568" TIME_SLOT_REF2="ts2572">
                <ANNOTATION_VALUE>She made us race like a relay race. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1533"
                TIME_SLOT_REF1="ts2574" TIME_SLOT_REF2="ts2583">
                <ANNOTATION_VALUE>In the middle of it or what, I ran backwards.    </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1535"
                TIME_SLOT_REF1="ts2584" TIME_SLOT_REF2="ts2588">
                <ANNOTATION_VALUE>And when I ran, I didn't run right. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1536"
                TIME_SLOT_REF1="ts2590" TIME_SLOT_REF2="ts2596">
                <ANNOTATION_VALUE>I thought to myself, maybe I would fall inwards.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1537"
                TIME_SLOT_REF1="ts2598" TIME_SLOT_REF2="ts2606">
                <ANNOTATION_VALUE>I could not control my body or something.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1538"
                TIME_SLOT_REF1="ts2610" TIME_SLOT_REF2="ts2620">
                <ANNOTATION_VALUE>Besides, you need to know, ugh, how to fall, you have learn it.    </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1540"
                TIME_SLOT_REF1="ts2622" TIME_SLOT_REF2="ts2632">
                <ANNOTATION_VALUE>Parkourists, they show how to fall.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1542"
                TIME_SLOT_REF1="ts2634" TIME_SLOT_REF2="ts2644">
                <ANNOTATION_VALUE>I thought, for example, if I fall and turn my hand into a supporting base, they will hurt.    </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1543"
                TIME_SLOT_REF1="ts2648" TIME_SLOT_REF2="ts2662">
                <ANNOTATION_VALUE>When I run backwards, I said to people that my sneakers were stuck in the floor.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1546"
                TIME_SLOT_REF1="ts2664" TIME_SLOT_REF2="ts2667">
                <ANNOTATION_VALUE>But they did not stuck anywhere. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1547"
                TIME_SLOT_REF1="ts2668" TIME_SLOT_REF2="ts2678">
                <ANNOTATION_VALUE>I just could not lift my feet.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1549"
                TIME_SLOT_REF1="ts2690" TIME_SLOT_REF2="ts2692">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1550"
                TIME_SLOT_REF1="ts2694" TIME_SLOT_REF2="ts2698">
                <ANNOTATION_VALUE>I just sat on the ground </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1552"
                TIME_SLOT_REF1="ts2700" TIME_SLOT_REF2="ts2710">
                <ANNOTATION_VALUE>I thought it was okay and when I wanted to move, I could not    </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1553"
                TIME_SLOT_REF1="ts2712" TIME_SLOT_REF2="ts2734">
                <ANNOTATION_VALUE>I could not breathe, my back, spine, and everything got numb as if it was an electric shock.        </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1555"
                TIME_SLOT_REF1="ts2736" TIME_SLOT_REF2="ts2742">
                <ANNOTATION_VALUE>Not that the electric shock, I just could not move.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1557"
                TIME_SLOT_REF1="ts2744" TIME_SLOT_REF2="ts2747">
                <ANNOTATION_VALUE>I could not breathe.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1558"
                TIME_SLOT_REF1="ts2748" TIME_SLOT_REF2="ts2762">
                <ANNOTATION_VALUE>My lungs as if have stopped, felt like they did not function at all.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1559"
                TIME_SLOT_REF1="ts2764" TIME_SLOT_REF2="ts2770">
                <ANNOTATION_VALUE>After that I rested at home for two weeks.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1560"
                TIME_SLOT_REF1="ts2774" TIME_SLOT_REF2="ts2779">
                <ANNOTATION_VALUE>Then, I did not participate in PE for a good half year. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1561"
                TIME_SLOT_REF1="ts2780" TIME_SLOT_REF2="ts2803">
                <ANNOTATION_VALUE>You say my back hurts and do your yoga or whatever, and I don't even have any prescription paper.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1562"
                TIME_SLOT_REF1="ts2804" TIME_SLOT_REF2="ts2812">
                <ANNOTATION_VALUE>Although I don't have the prescription, the teacher has seen how I fell.   </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1563"
                TIME_SLOT_REF1="ts2814" TIME_SLOT_REF2="ts2822">
                <ANNOTATION_VALUE>"You better don't run" she says to me.   </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1564"
                TIME_SLOT_REF1="ts2824" TIME_SLOT_REF2="ts2828">
                <ANNOTATION_VALUE>I say "Alright, alright, thanks teacher" </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1565"
                TIME_SLOT_REF1="ts2832" TIME_SLOT_REF2="ts2836">
                <ANNOTATION_VALUE>Good.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1566"
                TIME_SLOT_REF1="ts2840" TIME_SLOT_REF2="ts2844">
                <ANNOTATION_VALUE>It was like that— </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1568"
                TIME_SLOT_REF1="ts2846" TIME_SLOT_REF2="ts2862">
                <ANNOTATION_VALUE>Boys had a male teacher and us, girls had a woman teacher.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1571"
                TIME_SLOT_REF1="ts2870" TIME_SLOT_REF2="ts2880">
                <ANNOTATION_VALUE>But aside telling that it was good, two classes had a PE at once.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1572"
                TIME_SLOT_REF1="ts2884" TIME_SLOT_REF2="ts2894">
                <ANNOTATION_VALUE>The teacher for the Russian class did better exercises.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1575"
                TIME_SLOT_REF1="ts2898" TIME_SLOT_REF2="ts2904">
                <ANNOTATION_VALUE>Those you see in Youtube?  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1576"
                TIME_SLOT_REF1="ts2910" TIME_SLOT_REF2="ts2920">
                <ANNOTATION_VALUE>They follow the rules there: how to sit and stand.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1578"
                TIME_SLOT_REF1="ts2922" TIME_SLOT_REF2="ts2940">
                <ANNOTATION_VALUE>How to bend that place, how to do the arm like that, bending to ninety degrees.    </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1579"
                TIME_SLOT_REF1="ts2942" TIME_SLOT_REF2="ts2950">
                <ANNOTATION_VALUE>She COMucts on that, but our teacher is a bit older.   </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1581"
                TIME_SLOT_REF1="ts2956" TIME_SLOT_REF2="ts2958">
                <ANNOTATION_VALUE>Yes, don't matter.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1582"
                TIME_SLOT_REF1="ts2960" TIME_SLOT_REF2="ts2962">
                <ANNOTATION_VALUE>But she didn't yell a lot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1584"
                TIME_SLOT_REF1="ts2972" TIME_SLOT_REF2="ts2976">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1588"
                TIME_SLOT_REF1="ts2988" TIME_SLOT_REF2="ts2997">
                <ANNOTATION_VALUE>it seems because you did not go, isn't it? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1589"
