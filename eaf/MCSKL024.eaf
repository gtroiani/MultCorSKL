        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1413"
                TIME_SLOT_REF1="ts1786" TIME_SLOT_REF2="ts1788">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1414"
                TIME_SLOT_REF1="ts1790" TIME_SLOT_REF2="ts1794">
                <ANNOTATION_VALUE>Well, she said it cost her eleven thousand [tenge]. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1415"
                TIME_SLOT_REF1="ts1796" TIME_SLOT_REF2="ts1802">
                <ANNOTATION_VALUE>The entrance was eleven thousand or twelve thousand.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1416"
                TIME_SLOT_REF1="ts1804" TIME_SLOT_REF2="ts1808">
                <ANNOTATION_VALUE>We paid five thousand, they paid eleven thousand. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1417"
                TIME_SLOT_REF1="ts1810" TIME_SLOT_REF2="ts1814">
                <ANNOTATION_VALUE>But they say the money is worth it. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1419"
                TIME_SLOT_REF1="ts1824" TIME_SLOT_REF2="ts1828">
                <ANNOTATION_VALUE>Yes yes yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1420"
                TIME_SLOT_REF1="ts1830" TIME_SLOT_REF2="ts1846">
                <ANNOTATION_VALUE>Then there were U-shaped swings.   </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1422"
                TIME_SLOT_REF1="ts1850" TIME_SLOT_REF2="ts1860">
                <ANNOTATION_VALUE>When you go down, the water splashes.   </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1425"
                TIME_SLOT_REF1="ts1864" TIME_SLOT_REF2="ts1866">
                <ANNOTATION_VALUE>It is inside the water.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1426"
                TIME_SLOT_REF1="ts1878" TIME_SLOT_REF2="ts1892">
                <ANNOTATION_VALUE>I was thinking of working for four days and saving up for the ticket to Aqtobe, but turns out my money is not nearly enough for Aqtau.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1428"
                TIME_SLOT_REF1="ts1896" TIME_SLOT_REF2="ts1906">
                <ANNOTATION_VALUE>I have to work a lot for that, not spending to food, to nothing.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1430"
                TIME_SLOT_REF1="ts1908" TIME_SLOT_REF2="ts1914">
                <ANNOTATION_VALUE>Aqtobe, Aqtau </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1431"
                TIME_SLOT_REF1="ts1916" TIME_SLOT_REF2="ts1918">
                <ANNOTATION_VALUE>Aqtau Aqtau.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1432"
                TIME_SLOT_REF1="ts1920" TIME_SLOT_REF2="ts1924">
                <ANNOTATION_VALUE>We can go to Aqtau next summer. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
