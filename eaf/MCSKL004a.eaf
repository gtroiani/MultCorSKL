    <TIER LINGUISTIC_TYPE_REF="Translation"  TIER_ID="trx_en@SPK3002">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a485"
                TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts6">
                <ANNOTATION_VALUE>Alright... "Art-related professions."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a486"
                TIME_SLOT_REF1="ts8" TIME_SLOT_REF2="ts12">
                <ANNOTATION_VALUE>It says here that this topic is covered on the seventh and on the eighth (of some month). </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a488"
                TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>Nothing important.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a491"
                TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts56">
                <ANNOTATION_VALUE>Is your charger working fine these days?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a842"
                TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts67">
                <ANNOTATION_VALUE>If the head of your charger gets torn off or something, and stops working for any reason, remember that we have another identical one back at home.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a499"
                TIME_SLOT_REF1="ts70" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>I mean that cable thingy.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a501"
                TIME_SLOT_REF1="ts84" TIME_SLOT_REF2="ts87">
                <ANNOTATION_VALUE>"Rescuers always..."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a503"
                TIME_SLOT_REF1="ts90" TIME_SLOT_REF2="ts95">
                <ANNOTATION_VALUE>I also put this one like this (in ###). </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a504"
                TIME_SLOT_REF1="ts98" TIME_SLOT_REF2="ts102">
                <ANNOTATION_VALUE>Next is "We create a holiday." </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a505"
                TIME_SLOT_REF1="ts118" TIME_SLOT_REF2="ts123">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a513"
                TIME_SLOT_REF1="ts158" TIME_SLOT_REF2="ts160">
                <ANNOTATION_VALUE>There are only fifteen lessons recorded.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a515"
                TIME_SLOT_REF1="ts162" TIME_SLOT_REF2="ts170">
                <ANNOTATION_VALUE>Something is wrong here too.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a520"
                TIME_SLOT_REF1="ts188" TIME_SLOT_REF2="ts191">
                <ANNOTATION_VALUE>Okay.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a521"
                TIME_SLOT_REF1="ts193" TIME_SLOT_REF2="ts204">
                <ANNOTATION_VALUE>So, Grade 4 is done, and now we are moving over to Grade 6, right? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a522"
                TIME_SLOT_REF1="ts208" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>Damn.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a523"
                TIME_SLOT_REF1="ts212" TIME_SLOT_REF2="ts214">
                <ANNOTATION_VALUE>God, why do you have so many classes?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a525"
                TIME_SLOT_REF1="ts220" TIME_SLOT_REF2="ts222">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a528"
                TIME_SLOT_REF1="ts228" TIME_SLOT_REF2="ts231">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a529"
                TIME_SLOT_REF1="ts232" TIME_SLOT_REF2="ts240">
                <ANNOTATION_VALUE>So are we doing it for the entire class of Grade 6?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a531"
                TIME_SLOT_REF1="ts244" TIME_SLOT_REF2="ts250">
                <ANNOTATION_VALUE>For the number of hours...was it two hundred? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a534"
                TIME_SLOT_REF1="ts259" TIME_SLOT_REF2="ts264">
                <ANNOTATION_VALUE>This one luckily has Grade 6 in it. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a535"
                TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts268">
                <ANNOTATION_VALUE>Grade 5.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a536"
                TIME_SLOT_REF1="ts270" TIME_SLOT_REF2="ts273">
                <ANNOTATION_VALUE>Here is Grade 6.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a537"
                TIME_SLOT_REF1="ts274" TIME_SLOT_REF2="ts276">
                <ANNOTATION_VALUE>So, this topic is called "A word is a great deed".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a538"
                TIME_SLOT_REF1="ts278" TIME_SLOT_REF2="ts280">
                <ANNOTATION_VALUE>Oh no.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a539"
                TIME_SLOT_REF1="ts282" TIME_SLOT_REF2="ts284">
                <ANNOTATION_VALUE>It is here apparently.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a541"
                TIME_SLOT_REF1="ts298" TIME_SLOT_REF2="ts302">
                <ANNOTATION_VALUE>God, mom, I know what I am doing! </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a550"
                TIME_SLOT_REF1="ts344" TIME_SLOT_REF2="ts349">
                <ANNOTATION_VALUE>Mom, what should I do with this?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a554"
                TIME_SLOT_REF1="ts362" TIME_SLOT_REF2="ts364">
                <ANNOTATION_VALUE>I took a shower yesterday.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a555"
                TIME_SLOT_REF1="ts371" TIME_SLOT_REF2="ts374">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a556"
                TIME_SLOT_REF1="ts376" TIME_SLOT_REF2="ts379">
                <ANNOTATION_VALUE>All three are working.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a562"
                TIME_SLOT_REF1="ts402" TIME_SLOT_REF2="ts404">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a564"
                TIME_SLOT_REF1="ts411" TIME_SLOT_REF2="ts420">
                <ANNOTATION_VALUE>The girl who lives with us has not chipped in yet. She said she was waiting for her stipend. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a567"
                TIME_SLOT_REF1="ts426" TIME_SLOT_REF2="ts432">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a569"
                TIME_SLOT_REF1="ts436" TIME_SLOT_REF2="ts445">
                <ANNOTATION_VALUE>She apparently also works as a babysitter. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a571"
                TIME_SLOT_REF1="ts448" TIME_SLOT_REF2="ts453">
                <ANNOTATION_VALUE>I am not sure though if she really works.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a574"
                TIME_SLOT_REF1="ts460" TIME_SLOT_REF2="ts462">
                <ANNOTATION_VALUE>I guess so.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a575"
                TIME_SLOT_REF1="ts464" TIME_SLOT_REF2="ts470">
                <ANNOTATION_VALUE>She leaves for KShT on Saturdays and Sundays. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a576"
                TIME_SLOT_REF1="ts474" TIME_SLOT_REF2="ts484">
                <ANNOTATION_VALUE>She says she babysits there. Like...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a578"
                TIME_SLOT_REF1="ts488" TIME_SLOT_REF2="ts494">
                <ANNOTATION_VALUE>I guess so.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a580"
                TIME_SLOT_REF1="ts502" TIME_SLOT_REF2="ts504">
                <ANNOTATION_VALUE>No.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a581"
                TIME_SLOT_REF1="ts506" TIME_SLOT_REF2="ts512">
                <ANNOTATION_VALUE>But just the other day she went on a date. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a584"
                TIME_SLOT_REF1="ts526" TIME_SLOT_REF2="ts530">
                <ANNOTATION_VALUE>It is not her boyfriend.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a588"
                TIME_SLOT_REF1="ts534" TIME_SLOT_REF2="ts536">
                <ANNOTATION_VALUE>What is this thing over here?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a589"
                TIME_SLOT_REF1="ts538" TIME_SLOT_REF2="ts540">
                <ANNOTATION_VALUE>It says "Chapter one".</ANNOTATION_VALUE>
