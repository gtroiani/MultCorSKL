                <ANNOTATION_VALUE>Excuse me.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13439"
                TIME_SLOT_REF1="ts4389" TIME_SLOT_REF2="ts4392">
                <ANNOTATION_VALUE>There is none.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13440"
                TIME_SLOT_REF1="ts4395" TIME_SLOT_REF2="ts4401">
                <ANNOTATION_VALUE>They (the school) don't give books.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13441"
                TIME_SLOT_REF1="ts4404" TIME_SLOT_REF2="ts4419">
                <ANNOTATION_VALUE>For Kazakh, they don't give books either.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13442"
                TIME_SLOT_REF1="ts4422" TIME_SLOT_REF2="ts4432">
                <ANNOTATION_VALUE>Neither for English. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13443"
                TIME_SLOT_REF1="ts4435" TIME_SLOT_REF2="ts4448">
                <ANNOTATION_VALUE>They give special sheets and slideshows.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13444"
                TIME_SLOT_REF1="ts4449" TIME_SLOT_REF2="ts4465">
                <ANNOTATION_VALUE>You know what, they are even better (thank books). </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13445"
                TIME_SLOT_REF1="ts4471" TIME_SLOT_REF2="ts4477">
                <ANNOTATION_VALUE>Yeah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13446"
                TIME_SLOT_REF1="ts4486" TIME_SLOT_REF2="ts4489">
                <ANNOTATION_VALUE>Only ten books.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13447"
                TIME_SLOT_REF1="ts4492" TIME_SLOT_REF2="ts4498">
                <ANNOTATION_VALUE>Ten subjects in total only.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13448"
                TIME_SLOT_REF1="ts4504" TIME_SLOT_REF2="ts4513">
                <ANNOTATION_VALUE>Oh no, I mean ten books in total only.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13449"
                TIME_SLOT_REF1="ts4519" TIME_SLOT_REF2="ts4522">
                <ANNOTATION_VALUE>So, that's how it is.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13453"
                TIME_SLOT_REF1="ts4531" TIME_SLOT_REF2="ts4537">
                <ANNOTATION_VALUE>Twenty-five.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13450"
                TIME_SLOT_REF1="ts4551" TIME_SLOT_REF2="ts4558">
                <ANNOTATION_VALUE>There are 13 boys. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
