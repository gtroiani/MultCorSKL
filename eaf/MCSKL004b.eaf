            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1335"
                TIME_SLOT_REF1="ts3454" TIME_SLOT_REF2="ts3457">
                <ANNOTATION_VALUE>Seventeenth.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1336"
                TIME_SLOT_REF1="ts3466" TIME_SLOT_REF2="ts3469">
                <ANNOTATION_VALUE>Let me just say December.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1340"
                TIME_SLOT_REF1="ts3487" TIME_SLOT_REF2="ts3511">
                <ANNOTATION_VALUE>No, there are four more hours left here.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1345"
                TIME_SLOT_REF1="ts3514" TIME_SLOT_REF2="ts3517">
                <ANNOTATION_VALUE>Twentieth.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1346"
                TIME_SLOT_REF1="ts3535" TIME_SLOT_REF2="ts3545">
                <ANNOTATION_VALUE>Twenty-one.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1347"
                TIME_SLOT_REF1="ts3548" TIME_SLOT_REF2="ts3551">
                <ANNOTATION_VALUE>For this...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1351"
                TIME_SLOT_REF1="ts3554" TIME_SLOT_REF2="ts3557">
                <ANNOTATION_VALUE>...twenty two.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1352"
                TIME_SLOT_REF1="ts3560" TIME_SLOT_REF2="ts3564">
                <ANNOTATION_VALUE>For this one...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1353"
                TIME_SLOT_REF1="ts3565" TIME_SLOT_REF2="ts3573">
                <ANNOTATION_VALUE>...twenty four. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1354"
                TIME_SLOT_REF1="ts3576" TIME_SLOT_REF2="ts3582">
                <ANNOTATION_VALUE>You have three hours per week.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1355"
                TIME_SLOT_REF1="ts3588" TIME_SLOT_REF2="ts3599">
                <ANNOTATION_VALUE>Twenty-eight, twenty-nine, thirty one.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1356"
                TIME_SLOT_REF1="ts3602" TIME_SLOT_REF2="ts3609">
                <ANNOTATION_VALUE>Twenty-eight. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1358"
                TIME_SLOT_REF1="ts3612" TIME_SLOT_REF2="ts3622">
                <ANNOTATION_VALUE>Twenty-nine. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1359"
                TIME_SLOT_REF1="ts3625" TIME_SLOT_REF2="ts3634">
                <ANNOTATION_VALUE>It ends with twenty-nine, right?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1362"
                TIME_SLOT_REF1="ts3637" TIME_SLOT_REF2="ts3647">
                <ANNOTATION_VALUE>Then we just won't include "Seven Wonders." </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1369"
                TIME_SLOT_REF1="ts3678" TIME_SLOT_REF2="ts3689">
                <ANNOTATION_VALUE>I am just saying that this "Seven Wonders" could be different. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1370"
                TIME_SLOT_REF1="ts3692" TIME_SLOT_REF2="ts3698">
                <ANNOTATION_VALUE>Or is it that?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1372"
                TIME_SLOT_REF1="ts3701" TIME_SLOT_REF2="ts3707">
                <ANNOTATION_VALUE>Let me see.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1373"
                TIME_SLOT_REF1="ts3710" TIME_SLOT_REF2="ts3713">
                <ANNOTATION_VALUE>Well..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1394"
                TIME_SLOT_REF1="ts3952" TIME_SLOT_REF2="ts3958">
                <ANNOTATION_VALUE>What?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1402"
                TIME_SLOT_REF1="ts3973" TIME_SLOT_REF2="ts3980">
                <ANNOTATION_VALUE>Hold on now.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1403"
                TIME_SLOT_REF1="ts3981" TIME_SLOT_REF2="ts3985">
                <ANNOTATION_VALUE>I'll see.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1409"
                TIME_SLOT_REF1="ts4062" TIME_SLOT_REF2="ts4065">
                <ANNOTATION_VALUE>"Masculine both or feminine both".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1419"
                TIME_SLOT_REF1="ts4156" TIME_SLOT_REF2="ts4160">
                <ANNOTATION_VALUE>You and chemistry.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1423"
                TIME_SLOT_REF1="ts4176" TIME_SLOT_REF2="ts4179">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1426"
                TIME_SLOT_REF1="ts4191" TIME_SLOT_REF2="ts4198">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1427"
                TIME_SLOT_REF1="ts4199" TIME_SLOT_REF2="ts4203">
                <ANNOTATION_VALUE>From eight to eight fifty.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1436"
                TIME_SLOT_REF1="ts4292" TIME_SLOT_REF2="ts4295">
                <ANNOTATION_VALUE>At the expense of the first.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1439"
                TIME_SLOT_REF1="ts4310" TIME_SLOT_REF2="ts4317">
                <ANNOTATION_VALUE>Well, don't you know that this is how they make us write it? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1441"
                TIME_SLOT_REF1="ts4320" TIME_SLOT_REF2="ts4332">
                <ANNOTATION_VALUE>I am thinking about writing so right away now.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1442"
                TIME_SLOT_REF1="ts4335" TIME_SLOT_REF2="ts4353">
                <ANNOTATION_VALUE>Zero one, twelve, twenty, twenty one.   </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
