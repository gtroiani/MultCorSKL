                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a386"
                TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts30">
                <ANNOTATION_VALUE>Please watch your hands.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a387"
                TIME_SLOT_REF1="ts31" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>No.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a388"
                TIME_SLOT_REF1="ts37" TIME_SLOT_REF2="ts40">
                <ANNOTATION_VALUE>Now yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a391"
                TIME_SLOT_REF1="ts42" TIME_SLOT_REF2="ts48">
                <ANNOTATION_VALUE>Now yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a383"
                TIME_SLOT_REF1="ts47" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>Continue.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a399"
                TIME_SLOT_REF1="ts82" TIME_SLOT_REF2="ts86">
                <ANNOTATION_VALUE>Is it going to be gone in its entirety?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a708"
                TIME_SLOT_REF1="ts114" TIME_SLOT_REF2="ts118">
                <ANNOTATION_VALUE>Like a carcass?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a416"
                TIME_SLOT_REF1="ts152" TIME_SLOT_REF2="ts156">
                <ANNOTATION_VALUE>But blood will drop below the ### in this case.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a421"
                TIME_SLOT_REF1="ts172" TIME_SLOT_REF2="ts176">
                <ANNOTATION_VALUE>We should still cover it with something when it is in the pantry, right?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a427"
                TIME_SLOT_REF1="ts192" TIME_SLOT_REF2="ts194">
                <ANNOTATION_VALUE>Ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a434"
                TIME_SLOT_REF1="ts218" TIME_SLOT_REF2="ts222">
                <ANNOTATION_VALUE>Ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a500"
                TIME_SLOT_REF1="ts490" TIME_SLOT_REF2="ts494">
                <ANNOTATION_VALUE>Mom?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a510"
                TIME_SLOT_REF1="ts544" TIME_SLOT_REF2="ts547">
                <ANNOTATION_VALUE>Aren't you doing to dry it first?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a511"
                TIME_SLOT_REF1="ts548" TIME_SLOT_REF2="ts552">
                <ANNOTATION_VALUE>Grandma, just give it to me.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a513"
                TIME_SLOT_REF1="ts554" TIME_SLOT_REF2="ts561">
                <ANNOTATION_VALUE>Let me just discard the water into this.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a514"
                TIME_SLOT_REF1="ts564" TIME_SLOT_REF2="ts566">
                <ANNOTATION_VALUE>I see.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a515"
                TIME_SLOT_REF1="ts568" TIME_SLOT_REF2="ts570">
                <ANNOTATION_VALUE>Oh my!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a516"
                TIME_SLOT_REF1="ts572" TIME_SLOT_REF2="ts574">
                <ANNOTATION_VALUE>The camera ###.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a549"
                TIME_SLOT_REF1="ts708" TIME_SLOT_REF2="ts712">
                <ANNOTATION_VALUE>Shall I tell Asyl to take off the camera?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a550"
                TIME_SLOT_REF1="ts716" TIME_SLOT_REF2="ts718">
                <ANNOTATION_VALUE>It is enough already.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a553"
                TIME_SLOT_REF1="ts728" TIME_SLOT_REF2="ts732">
                <ANNOTATION_VALUE>We'll go back after we wash the dishes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a556"
                TIME_SLOT_REF1="ts736" TIME_SLOT_REF2="ts740">
                <ANNOTATION_VALUE>Will you wash the head?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a558"
                TIME_SLOT_REF1="ts742" TIME_SLOT_REF2="ts748">
                <ANNOTATION_VALUE>Oh my god.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a560"
                TIME_SLOT_REF1="ts754" TIME_SLOT_REF2="ts758">
                <ANNOTATION_VALUE>Do you still need salt?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a563"
                TIME_SLOT_REF1="ts770" TIME_SLOT_REF2="ts774">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a565"
                TIME_SLOT_REF1="ts776" TIME_SLOT_REF2="ts780">
                <ANNOTATION_VALUE>No.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a567"
                TIME_SLOT_REF1="ts782" TIME_SLOT_REF2="ts786">
                <ANNOTATION_VALUE>Do you need all these bowls? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a571"
                TIME_SLOT_REF1="ts804" TIME_SLOT_REF2="ts807">
                <ANNOTATION_VALUE>This one is clean.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a573"
                TIME_SLOT_REF1="ts808" TIME_SLOT_REF2="ts812">
                <ANNOTATION_VALUE>This one is dirty.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a581"
                TIME_SLOT_REF1="ts840" TIME_SLOT_REF2="ts842">
                <ANNOTATION_VALUE>I will put the intestines into the fridge.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a642"
                TIME_SLOT_REF1="ts1090" TIME_SLOT_REF2="ts1092">
                <ANNOTATION_VALUE>Hello.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a643"
                TIME_SLOT_REF1="ts1094" TIME_SLOT_REF2="ts1096">
                <ANNOTATION_VALUE>Dad, careful, watch your legs!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a646"
                TIME_SLOT_REF1="ts1110" TIME_SLOT_REF2="ts1112">
                <ANNOTATION_VALUE>"Are you still butchering the sheep?", says he.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a647"
                TIME_SLOT_REF1="ts1114" TIME_SLOT_REF2="ts1118">
                <ANNOTATION_VALUE>"I already woke up," says he.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a649"
                TIME_SLOT_REF1="ts1120" TIME_SLOT_REF2="ts1127">
                <ANNOTATION_VALUE>"Are you still butchering the sheep? I already woke up," he says. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a653"
                TIME_SLOT_REF1="ts1148" TIME_SLOT_REF2="ts1150">
                <ANNOTATION_VALUE>Say "there is no sheep."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a660"
                TIME_SLOT_REF1="ts1173" TIME_SLOT_REF2="ts1178">
                <ANNOTATION_VALUE>Let's take it on Mazda (car brand).</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a661"
                TIME_SLOT_REF1="ts1182" TIME_SLOT_REF2="ts1186">
                <ANNOTATION_VALUE>On Mazda.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a665"
                TIME_SLOT_REF1="ts1200" TIME_SLOT_REF2="ts1207">
                <ANNOTATION_VALUE>Otherwise put the parts of the corpse into seperate plastic bags, and I will take these bags to the disposal site on the bicycle. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a669"
                TIME_SLOT_REF1="ts1220" TIME_SLOT_REF2="ts1223">
                <ANNOTATION_VALUE>What about a bigger bag?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a670"
                TIME_SLOT_REF1="ts1226" TIME_SLOT_REF2="ts1230">
                <ANNOTATION_VALUE>I'll then throw it away with the bag itself.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a672"
                TIME_SLOT_REF1="ts1232" TIME_SLOT_REF2="ts1236">
                <ANNOTATION_VALUE>I am not going with a wheelbarrow.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a676"
                TIME_SLOT_REF1="ts1246" TIME_SLOT_REF2="ts1248">
                <ANNOTATION_VALUE>Asyl does not care. He is ok with dragging the wheelbarrow.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a681"
                TIME_SLOT_REF1="ts1258" TIME_SLOT_REF2="ts1267">
                <ANNOTATION_VALUE>Where will you throw it away?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
