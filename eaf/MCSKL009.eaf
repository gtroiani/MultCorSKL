                TIME_SLOT_REF1="ts404" TIME_SLOT_REF2="ts407">
                <ANNOTATION_VALUE>Ah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a479"
                TIME_SLOT_REF1="ts410" TIME_SLOT_REF2="ts415">
                <ANNOTATION_VALUE>Oh, I am telling you my kid, he will do it himself. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a480"
                TIME_SLOT_REF1="ts419" TIME_SLOT_REF2="ts423">
                <ANNOTATION_VALUE>You see how your father-in-law does it!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a483"
                TIME_SLOT_REF1="ts426" TIME_SLOT_REF2="ts434">
                <ANNOTATION_VALUE>Hey, there was a rag. Cover the meat with that rag. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a484"
                TIME_SLOT_REF1="ts436" TIME_SLOT_REF2="ts440">
                <ANNOTATION_VALUE>The rag of that thing.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a486"
                TIME_SLOT_REF1="ts442" TIME_SLOT_REF2="ts446">
                <ANNOTATION_VALUE>Yes, that's all.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a487"
                TIME_SLOT_REF1="ts450" TIME_SLOT_REF2="ts456">
                <ANNOTATION_VALUE>Hey, Dana, you know where that thing (the rag) is, right? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a489"
                TIME_SLOT_REF1="ts458" TIME_SLOT_REF2="ts461">
                <ANNOTATION_VALUE>Wrap the meat up with it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a491"
                TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts469">
                <ANNOTATION_VALUE>So, when we went to Zeinegul aunt's place, they butchered a sheep.   </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a492"
                TIME_SLOT_REF1="ts470" TIME_SLOT_REF2="ts473">
                <ANNOTATION_VALUE>And this is how they do it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a493"
                TIME_SLOT_REF1="ts474" TIME_SLOT_REF2="ts476">
                <ANNOTATION_VALUE>And we've learned this from them.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a494"
                TIME_SLOT_REF1="ts478" TIME_SLOT_REF2="ts480">
                <ANNOTATION_VALUE>What was his name?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
