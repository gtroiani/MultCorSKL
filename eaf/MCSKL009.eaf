        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a471"
                TIME_SLOT_REF1="ts372" TIME_SLOT_REF2="ts376">
                <ANNOTATION_VALUE> When we went to that place...Ulgili Malshy.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a472"
                TIME_SLOT_REF1="ts378" TIME_SLOT_REF2="ts380">
                <ANNOTATION_VALUE> Zeinegul aunt's husband butchers their sheep like this.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a474"
                TIME_SLOT_REF1="ts388" TIME_SLOT_REF2="ts392">
                <ANNOTATION_VALUE>What?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a476"
                TIME_SLOT_REF1="ts394" TIME_SLOT_REF2="ts396">
                <ANNOTATION_VALUE>No need.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a477"
                TIME_SLOT_REF1="ts398" TIME_SLOT_REF2="ts403">
                <ANNOTATION_VALUE>Your grandfather is doing it himself.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
