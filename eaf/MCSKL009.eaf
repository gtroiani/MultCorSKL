            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a448"
                TIME_SLOT_REF1="ts280" TIME_SLOT_REF2="ts283">
                <ANNOTATION_VALUE>Stop.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a449"
                TIME_SLOT_REF1="ts284" TIME_SLOT_REF2="ts287">
                <ANNOTATION_VALUE>Hold it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a450"
                TIME_SLOT_REF1="ts288" TIME_SLOT_REF2="ts290">
                <ANNOTATION_VALUE>Pull the wheel down.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a453"
                TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts300">
                <ANNOTATION_VALUE>Pull the wheel down.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a454"
                TIME_SLOT_REF1="ts304" TIME_SLOT_REF2="ts308">
                <ANNOTATION_VALUE> Press  harder.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a473"
                TIME_SLOT_REF1="ts382" TIME_SLOT_REF2="ts386">
                <ANNOTATION_VALUE>What?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a488"
                TIME_SLOT_REF1="ts444" TIME_SLOT_REF2="ts448">
                <ANNOTATION_VALUE>That's all.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a518"
                TIME_SLOT_REF1="ts576" TIME_SLOT_REF2="ts579">
                <ANNOTATION_VALUE>Oh!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a519"
                TIME_SLOT_REF1="ts580" TIME_SLOT_REF2="ts582">
                <ANNOTATION_VALUE>You scared me!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a520"
                TIME_SLOT_REF1="ts584" TIME_SLOT_REF2="ts588">
                <ANNOTATION_VALUE>I thought I wouldn't get scared of Sakosh, but I did. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a521"
                TIME_SLOT_REF1="ts592" TIME_SLOT_REF2="ts596">
                <ANNOTATION_VALUE>So...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a523"
                TIME_SLOT_REF1="ts600" TIME_SLOT_REF2="ts604">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a526"
                TIME_SLOT_REF1="ts612" TIME_SLOT_REF2="ts618">
                <ANNOTATION_VALUE>Raised the dust?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a529"
                TIME_SLOT_REF1="ts622" TIME_SLOT_REF2="ts624">
                <ANNOTATION_VALUE>Who?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a530"
                TIME_SLOT_REF1="ts630" TIME_SLOT_REF2="ts632">
                <ANNOTATION_VALUE>You shut up.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a531"
                TIME_SLOT_REF1="ts634" TIME_SLOT_REF2="ts641">
                <ANNOTATION_VALUE>What did I do?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a534"
                TIME_SLOT_REF1="ts646" TIME_SLOT_REF2="ts648">
                <ANNOTATION_VALUE>This one?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a535"
                TIME_SLOT_REF1="ts650" TIME_SLOT_REF2="ts655">
                <ANNOTATION_VALUE>Stay here, don't move.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a538"
                TIME_SLOT_REF1="ts658" TIME_SLOT_REF2="ts661">
                <ANNOTATION_VALUE>Or it will be a shame on you!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a539"
                TIME_SLOT_REF1="ts664" TIME_SLOT_REF2="ts669">
                <ANNOTATION_VALUE>What is this?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a542"
                TIME_SLOT_REF1="ts679" TIME_SLOT_REF2="ts682">
                <ANNOTATION_VALUE>Do you want to wash them here?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a587"
                TIME_SLOT_REF1="ts856" TIME_SLOT_REF2="ts862">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a589"
                TIME_SLOT_REF1="ts866" TIME_SLOT_REF2="ts870">
                <ANNOTATION_VALUE>Where?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a592"
                TIME_SLOT_REF1="ts876" TIME_SLOT_REF2="ts880">
                <ANNOTATION_VALUE>The blood is coming off from that part of the calf that we both saw earlier.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a607"
                TIME_SLOT_REF1="ts940" TIME_SLOT_REF2="ts948">
                <ANNOTATION_VALUE>Hello Nazgul.... where is Nazgul? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a633"
                TIME_SLOT_REF1="ts1044" TIME_SLOT_REF2="ts1052">
                <ANNOTATION_VALUE> Will this person who washes (the scorched head?) using cold water in winter use hot water in summer?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a679"
                TIME_SLOT_REF1="ts1260" TIME_SLOT_REF2="ts1262">
                <ANNOTATION_VALUE>Where?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a683"
                TIME_SLOT_REF1="ts1274" TIME_SLOT_REF2="ts1276">
                <ANNOTATION_VALUE>You are joking, right?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a688"
                TIME_SLOT_REF1="ts1296" TIME_SLOT_REF2="ts1298">
                <ANNOTATION_VALUE>Bakontai!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a699"
                TIME_SLOT_REF1="ts1332" TIME_SLOT_REF2="ts1336">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
