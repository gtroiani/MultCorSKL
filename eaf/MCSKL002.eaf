        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1015"
                TIME_SLOT_REF1="ts1374" TIME_SLOT_REF2="ts1378">
                <ANNOTATION_VALUE>It is good.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1016"
                TIME_SLOT_REF1="ts1380" TIME_SLOT_REF2="ts1387">
                <ANNOTATION_VALUE>And now I am going to make a dough by adding smetana to it.  </ANNOTATION_VALUE>
