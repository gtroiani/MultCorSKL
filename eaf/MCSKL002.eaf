        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a989"
                TIME_SLOT_REF1="ts1226" TIME_SLOT_REF2="ts1234">
                <ANNOTATION_VALUE>Obvisouly when he was born.. when he was young... he could not hold his head. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a993"
