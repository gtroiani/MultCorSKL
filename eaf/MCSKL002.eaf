            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1020"
                TIME_SLOT_REF1="ts1392" TIME_SLOT_REF2="ts1396">
                <ANNOTATION_VALUE>Well, so that's how it is: Zhanasyl went after his mom. </ANNOTATION_VALUE>
