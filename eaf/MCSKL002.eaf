    <TIER LINGUISTIC_TYPE_REF="Translation"  TIER_ID="trx_eng@SPK0032">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a737"
                TIME_SLOT_REF1="ts8" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>Will you make a dough?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a738"
                TIME_SLOT_REF1="ts20" TIME_SLOT_REF2="ts27">
                <ANNOTATION_VALUE>You know I've seen people bring a store-bought, hard dough and use it. What do they do with it, Takalok?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a745"
                TIME_SLOT_REF1="ts43" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>It is already ready [for use], right? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a747"
                TIME_SLOT_REF1="ts56" TIME_SLOT_REF2="ts61">
                <ANNOTATION_VALUE>That...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a748"
                TIME_SLOT_REF1="ts62" TIME_SLOT_REF2="ts65">
                <ANNOTATION_VALUE>That [kelin of ours] uses such a [store-bought] dough.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a750"
                TIME_SLOT_REF1="ts68" TIME_SLOT_REF2="ts71">
                <ANNOTATION_VALUE>That thing which is already [made into a dough]...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a753"
                TIME_SLOT_REF1="ts72" TIME_SLOT_REF2="ts75">
                <ANNOTATION_VALUE>A piece...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a754"
                TIME_SLOT_REF1="ts76" TIME_SLOT_REF2="ts80">
                <ANNOTATION_VALUE>It is frozen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a761"
                TIME_SLOT_REF1="ts92" TIME_SLOT_REF2="ts99">
                <ANNOTATION_VALUE>Ah I see.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a762"
                TIME_SLOT_REF1="ts100" TIME_SLOT_REF2="ts107">
                <ANNOTATION_VALUE>How could I have known dearie.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a766"
                TIME_SLOT_REF1="ts128" TIME_SLOT_REF2="ts132">
                <ANNOTATION_VALUE>Yes yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a767"
                TIME_SLOT_REF1="ts136" TIME_SLOT_REF2="ts138">
                <ANNOTATION_VALUE>It looks just like that. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a770"
                TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts160">
                <ANNOTATION_VALUE>Come again dearie?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a777"
                TIME_SLOT_REF1="ts182" TIME_SLOT_REF2="ts184">
                <ANNOTATION_VALUE>Oh I see.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a778"
                TIME_SLOT_REF1="ts187" TIME_SLOT_REF2="ts190">
                <ANNOTATION_VALUE>It measures stuff like this, right?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a780"
                TIME_SLOT_REF1="ts202" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>Pashon is such a great cake maker!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a784"
                TIME_SLOT_REF1="ts216" TIME_SLOT_REF2="ts220">
                <ANNOTATION_VALUE>She isn't?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a786"
                TIME_SLOT_REF1="ts224" TIME_SLOT_REF2="ts230">
                <ANNOTATION_VALUE>Oh?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a787"
                TIME_SLOT_REF1="ts232" TIME_SLOT_REF2="ts236">
                <ANNOTATION_VALUE>Ah really?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a788"
                TIME_SLOT_REF1="ts238" TIME_SLOT_REF2="ts240">
                <ANNOTATION_VALUE>Ah, I see!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a792"
                TIME_SLOT_REF1="ts249" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>Aaa.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a793"
                TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts268">
                <ANNOTATION_VALUE>Mhm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a797"
                TIME_SLOT_REF1="ts280" TIME_SLOT_REF2="ts282">
                <ANNOTATION_VALUE>Come again dearie?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a798"
                TIME_SLOT_REF1="ts286" TIME_SLOT_REF2="ts292">
                <ANNOTATION_VALUE>Oh really?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a801"
                TIME_SLOT_REF1="ts300" TIME_SLOT_REF2="ts303">
                <ANNOTATION_VALUE>Brining all those frozen dough..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a807"
                TIME_SLOT_REF1="ts314" TIME_SLOT_REF2="ts317">
                <ANNOTATION_VALUE>She even burnt most of it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a808"
                TIME_SLOT_REF1="ts318" TIME_SLOT_REF2="ts320">
                <ANNOTATION_VALUE>They got burnt.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a809"
                TIME_SLOT_REF1="ts326" TIME_SLOT_REF2="ts329">
                <ANNOTATION_VALUE>Its smell came out...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a810"
                TIME_SLOT_REF1="ts330" TIME_SLOT_REF2="ts338">
                <ANNOTATION_VALUE>Many stuff that she baked like this got burnt...  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a817"
                TIME_SLOT_REF1="ts344" TIME_SLOT_REF2="ts348">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a818"
                TIME_SLOT_REF1="ts350" TIME_SLOT_REF2="ts356">
                <ANNOTATION_VALUE>No, Serikzhan does not bake. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a819"
                TIME_SLOT_REF1="ts358" TIME_SLOT_REF2="ts360">
                <ANNOTATION_VALUE>Serikzhan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a820"
                TIME_SLOT_REF1="ts362" TIME_SLOT_REF2="ts370">
                <ANNOTATION_VALUE>All that Serikzhan cooks is something like eggs, tomatoes and whatnot. Nothing other than that.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a821"
                TIME_SLOT_REF1="ts372" TIME_SLOT_REF2="ts374">
                <ANNOTATION_VALUE>Her mother baking...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a823"
                TIME_SLOT_REF1="ts376" TIME_SLOT_REF2="ts378">
                <ANNOTATION_VALUE>Impossible for him to have such a skill.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a828"
                TIME_SLOT_REF1="ts414" TIME_SLOT_REF2="ts418">
                <ANNOTATION_VALUE>I need a lot of things [ingredients] apparently! </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a830"
                TIME_SLOT_REF1="ts420" TIME_SLOT_REF2="ts424">
                <ANNOTATION_VALUE>Shoud I just put this into this?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a833"
                TIME_SLOT_REF1="ts426" TIME_SLOT_REF2="ts430">
                <ANNOTATION_VALUE>Ah, ok!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a834"
                TIME_SLOT_REF1="ts436" TIME_SLOT_REF2="ts439">
                <ANNOTATION_VALUE>But still...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a835"
                TIME_SLOT_REF1="ts440" TIME_SLOT_REF2="ts444">
                <ANNOTATION_VALUE>I mean that mixing all this...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a840"
                TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts468">
                <ANNOTATION_VALUE>Ah, one even needs to grate it first... </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a846"
                TIME_SLOT_REF1="ts482" TIME_SLOT_REF2="ts484">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a848"
                TIME_SLOT_REF1="ts506" TIME_SLOT_REF2="ts508">
                <ANNOTATION_VALUE>Mhm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a856"
                TIME_SLOT_REF1="ts528" TIME_SLOT_REF2="ts534">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a857"
                TIME_SLOT_REF1="ts538" TIME_SLOT_REF2="ts542">
                <ANNOTATION_VALUE>Ah I see.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a866"
                TIME_SLOT_REF1="ts590" TIME_SLOT_REF2="ts592">
                <ANNOTATION_VALUE>God save!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a868"
                TIME_SLOT_REF1="ts594" TIME_SLOT_REF2="ts596">
                <ANNOTATION_VALUE>They say Astana is even more expensive.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
