        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1000"
                TIME_SLOT_REF1="ts1294" TIME_SLOT_REF2="ts1296">
                <ANNOTATION_VALUE>What is rickets?</ANNOTATION_VALUE>
