                <ANNOTATION_VALUE>He cannot hold his head [that's why].</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a997"
                TIME_SLOT_REF1="ts1260" TIME_SLOT_REF2="ts1266">
                <ANNOTATION_VALUE>No matter what - whether his head is big or he has a lot of brains - the fact remains: he walks tilted. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a999"
                TIME_SLOT_REF1="ts1276" TIME_SLOT_REF2="ts1286">
                <ANNOTATION_VALUE> In our times, they used to cure those kids who had big heads because of the condition called rickets.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1002"
                TIME_SLOT_REF1="ts1288" TIME_SLOT_REF2="ts1292">
                <ANNOTATION_VALUE>They used to say that a child with a big head has rickets.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1003"
