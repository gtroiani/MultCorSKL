        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1008"
                TIME_SLOT_REF1="ts1328" TIME_SLOT_REF2="ts1330">
                <ANNOTATION_VALUE>Mmm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1014"
                TIME_SLOT_REF1="ts1356" TIME_SLOT_REF2="ts1370">
                <ANNOTATION_VALUE>Yes grandma, look at this... ... you first get the flour mixed with butter like this... when you grind the butter, it is good because it becomes like this... you see? </ANNOTATION_VALUE>
