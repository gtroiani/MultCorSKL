        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1022"
                TIME_SLOT_REF1="ts1408" TIME_SLOT_REF2="ts1416">
                <ANNOTATION_VALUE>There, appartments are expensive but groceris are like here. </ANNOTATION_VALUE>
