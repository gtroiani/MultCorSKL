        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1005"
                TIME_SLOT_REF1="ts1306" TIME_SLOT_REF2="ts1310">
                <ANNOTATION_VALUE>Called rickets.</ANNOTATION_VALUE>
