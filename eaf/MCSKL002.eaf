        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1006"
                TIME_SLOT_REF1="ts1314" TIME_SLOT_REF2="ts1316">
                <ANNOTATION_VALUE>Children's body get deformed,</ANNOTATION_VALUE>
