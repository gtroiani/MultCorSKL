        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a994"
                TIME_SLOT_REF1="ts1240" TIME_SLOT_REF2="ts1246">
                <ANNOTATION_VALUE> When he walks.. he would walk like this, always falling.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a995"
                TIME_SLOT_REF1="ts1254" TIME_SLOT_REF2="ts1258">
                <ANNOTATION_VALUE>He used to barely hold his head, but I do not know how he is doing now. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a998"
                TIME_SLOT_REF1="ts1268" TIME_SLOT_REF2="ts1274">
                <ANNOTATION_VALUE>Yes, grandma, he used to walk tiltedly; that child's head is big, I do not know why. </ANNOTATION_VALUE>
