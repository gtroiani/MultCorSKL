        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a739"
                TIME_SLOT_REF1="ts2884" TIME_SLOT_REF2="ts2891">
                <ANNOTATION_VALUE>since there is  elder пerson, it is not aппroпriate to go somewhere and leave quickly,</ANNOTATION_VALUE>
