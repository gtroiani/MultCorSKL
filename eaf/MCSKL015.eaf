        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a735"
                TIME_SLOT_REF1="ts2863" TIME_SLOT_REF2="ts2870">
                <ANNOTATION_VALUE>We do not stay at home. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a736"
                TIME_SLOT_REF1="ts2873" TIME_SLOT_REF2="ts2875">
