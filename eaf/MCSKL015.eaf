        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a737"
                TIME_SLOT_REF1="ts2876" TIME_SLOT_REF2="ts2879">
                <ANNOTATION_VALUE>it is time for visiting (being a guest),</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a738"
                TIME_SLOT_REF1="ts2880" TIME_SLOT_REF2="ts2883">
                <ANNOTATION_VALUE>on toп of that,</ANNOTATION_VALUE>
