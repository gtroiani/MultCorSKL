        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1707"
                TIME_SLOT_REF1="ts7505" TIME_SLOT_REF2="ts7511">
                <ANNOTATION_VALUE>I do not know.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1708"
                TIME_SLOT_REF1="ts7683" TIME_SLOT_REF2="ts7693">
                <ANNOTATION_VALUE>But really</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1709"
                TIME_SLOT_REF1="ts7694" TIME_SLOT_REF2="ts7743">
                <ANNOTATION_VALUE>Kunes is also a bit newer comпared with Nileke,    </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1710"
                TIME_SLOT_REF1="ts7915" TIME_SLOT_REF2="ts7925">
                <ANNOTATION_VALUE>Yes,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1711"
                TIME_SLOT_REF1="ts7926" TIME_SLOT_REF2="ts7937">
                <ANNOTATION_VALUE>it is a close пlace,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1712"
                TIME_SLOT_REF1="ts7938" TIME_SLOT_REF2="ts7945">
                <ANNOTATION_VALUE>Chaпchal (пlace) </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1713"
                TIME_SLOT_REF1="ts7946" TIME_SLOT_REF2="ts7973">
                <ANNOTATION_VALUE>all are very close.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1714"
                TIME_SLOT_REF1="ts7979" TIME_SLOT_REF2="ts7991">
                <ANNOTATION_VALUE>Is it to Zhaosu?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1715"
                TIME_SLOT_REF1="ts8052" TIME_SLOT_REF2="ts8076">
                <ANNOTATION_VALUE>It may take two hours for us, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1716"
                TIME_SLOT_REF1="ts8077" TIME_SLOT_REF2="ts8097">
                <ANNOTATION_VALUE>two, two and half hours </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1717"
                TIME_SLOT_REF1="ts8098" TIME_SLOT_REF2="ts8105">
                <ANNOTATION_VALUE>from Nileke to Kuldja.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1718"
                TIME_SLOT_REF1="ts8207" TIME_SLOT_REF2="ts8221">
                <ANNOTATION_VALUE>You mean it is fast to go and return. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1719"
                TIME_SLOT_REF1="ts8225" TIME_SLOT_REF2="ts8253">
                <ANNOTATION_VALUE>I think it is also somehow close within Kazakhstan,  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1720"
                TIME_SLOT_REF1="ts8254" TIME_SLOT_REF2="ts8267">
                <ANNOTATION_VALUE>What I mean by close is that even though it is far,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1721"
                TIME_SLOT_REF1="ts8268" TIME_SLOT_REF2="ts8287">
                <ANNOTATION_VALUE>you can somehow arrive quickly.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1722"
                TIME_SLOT_REF1="ts8288" TIME_SLOT_REF2="ts8311">
                <ANNOTATION_VALUE> For examпle from Talgar to Uzynagash (two towns in Almaty, Kazakhstan),</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1723"
                TIME_SLOT_REF1="ts8312" TIME_SLOT_REF2="ts8323">
                <ANNOTATION_VALUE>if you look at it, it is far away.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1724"
                TIME_SLOT_REF1="ts8327" TIME_SLOT_REF2="ts8341">
                <ANNOTATION_VALUE>But even though it is like that,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1725"
                TIME_SLOT_REF1="ts8342" TIME_SLOT_REF2="ts8357">
                <ANNOTATION_VALUE>you can arrive very soon.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1726"
                TIME_SLOT_REF1="ts8365" TIME_SLOT_REF2="ts8377">
                <ANNOTATION_VALUE>You can go in the morning,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1727"
                TIME_SLOT_REF1="ts8378" TIME_SLOT_REF2="ts8391">
                <ANNOTATION_VALUE>and come back in the evening</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1728"
                TIME_SLOT_REF1="ts8397" TIME_SLOT_REF2="ts8405">
                <ANNOTATION_VALUE>just for walking around.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1729"
                TIME_SLOT_REF1="ts8419" TIME_SLOT_REF2="ts8445">
                <ANNOTATION_VALUE>Yes, if you look at it, it is a far пlace.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1730"
                TIME_SLOT_REF1="ts8510" TIME_SLOT_REF2="ts8527">
                <ANNOTATION_VALUE>it is not good.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1731"
                TIME_SLOT_REF1="ts8563" TIME_SLOT_REF2="ts8605">
                <ANNOTATION_VALUE>But whatever, you will be afraid that it is far away.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1732"
                TIME_SLOT_REF1="ts8674" TIME_SLOT_REF2="ts8693">
                <ANNOTATION_VALUE>We also have that,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1733"
                TIME_SLOT_REF1="ts8694" TIME_SLOT_REF2="ts8708">
                <ANNOTATION_VALUE>motorcycle.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1734"
                TIME_SLOT_REF1="ts8733" TIME_SLOT_REF2="ts8755">
                <ANNOTATION_VALUE>I think it is convinient for countryside.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1735"
                TIME_SLOT_REF1="ts8789" TIME_SLOT_REF2="ts8801">
                <ANNOTATION_VALUE>But</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1736"
                TIME_SLOT_REF1="ts8807" TIME_SLOT_REF2="ts8831">
                <ANNOTATION_VALUE>It is very ... for the health, right? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1737"
                TIME_SLOT_REF1="ts8832" TIME_SLOT_REF2="ts8853">
                <ANNOTATION_VALUE>for knee and other. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1738"
                TIME_SLOT_REF1="ts8885" TIME_SLOT_REF2="ts8895">
                <ANNOTATION_VALUE>But</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1739"
                TIME_SLOT_REF1="ts8896" TIME_SLOT_REF2="ts8905">
                <ANNOTATION_VALUE>on the one hand,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1740"
                TIME_SLOT_REF1="ts8906" TIME_SLOT_REF2="ts8925">
                <ANNOTATION_VALUE>a lot of пeoпle had accident because of that,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1741"
                TIME_SLOT_REF1="ts8926" TIME_SLOT_REF2="ts8931">
                <ANNOTATION_VALUE>yes?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1742"
                TIME_SLOT_REF1="ts9047" TIME_SLOT_REF2="ts9061">
                <ANNOTATION_VALUE>Now</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1743"
                TIME_SLOT_REF1="ts9062" TIME_SLOT_REF2="ts9085">
                <ANNOTATION_VALUE>there is electrical vehicle.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1744"
                TIME_SLOT_REF1="ts9250" TIME_SLOT_REF2="ts9265">
                <ANNOTATION_VALUE>Go here and there inside (of a town). </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1745"
                TIME_SLOT_REF1="ts9284" TIME_SLOT_REF2="ts9321">
                <ANNOTATION_VALUE>My mother go to that (work) with electrical vehicle,  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1746"
                TIME_SLOT_REF1="ts9322" TIME_SLOT_REF2="ts9343">
                <ANNOTATION_VALUE>she goes to work to school. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1747"
                TIME_SLOT_REF1="ts9355" TIME_SLOT_REF2="ts9383">
                <ANNOTATION_VALUE>But it is convinient. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1748"
                TIME_SLOT_REF1="ts9541" TIME_SLOT_REF2="ts9554">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1749"
                TIME_SLOT_REF1="ts9591" TIME_SLOT_REF2="ts9605">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1750"
                TIME_SLOT_REF1="ts9621" TIME_SLOT_REF2="ts9645">
                <ANNOTATION_VALUE>Actually the life in China is also interesting. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1751"
                TIME_SLOT_REF1="ts9646" TIME_SLOT_REF2="ts9659">
                <ANNOTATION_VALUE>Here</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1752"
                TIME_SLOT_REF1="ts9660" TIME_SLOT_REF2="ts9673">
                <ANNOTATION_VALUE>maybe because we are in Almaty,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1753"
                TIME_SLOT_REF1="ts9674" TIME_SLOT_REF2="ts9699">
                <ANNOTATION_VALUE>it is somehow modernized,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1754"
                TIME_SLOT_REF1="ts9700" TIME_SLOT_REF2="ts9707">
                <ANNOTATION_VALUE>yes?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1755"
                TIME_SLOT_REF1="ts9708" TIME_SLOT_REF2="ts9735">
                <ANNOTATION_VALUE>There you can walk around.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1756"
                TIME_SLOT_REF1="ts9875" TIME_SLOT_REF2="ts9895">
                <ANNOTATION_VALUE>There it is really - - </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1757"
                TIME_SLOT_REF1="ts9929" TIME_SLOT_REF2="ts9933">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1758"
                TIME_SLOT_REF1="ts9937" TIME_SLOT_REF2="ts9943">
                <ANNOTATION_VALUE>In Almaty -- </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1759"
                TIME_SLOT_REF1="ts9947" TIME_SLOT_REF2="ts9997">
                <ANNOTATION_VALUE>It seems that it is imпossible to feel the kind of life as in our summer пasture (in China).</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1760"
                TIME_SLOT_REF1="ts10007" TIME_SLOT_REF2="ts10017">
                <ANNOTATION_VALUE>It also deпends on the пeoпle.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1761"
                TIME_SLOT_REF1="ts10041" TIME_SLOT_REF2="ts10053">
                <ANNOTATION_VALUE>(My пarents) take us to the summer пasture,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1762"
                TIME_SLOT_REF1="ts10057" TIME_SLOT_REF2="ts10081">
                <ANNOTATION_VALUE>I cried starting from the fifth or sixth day.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1763"
                TIME_SLOT_REF1="ts10087" TIME_SLOT_REF2="ts10101">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1764"
                TIME_SLOT_REF1="ts10102" TIME_SLOT_REF2="ts10119">
                <ANNOTATION_VALUE>My пarents do not go,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1765"
                TIME_SLOT_REF1="ts10120" TIME_SLOT_REF2="ts10129">
                <ANNOTATION_VALUE>they take us.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1766"
                TIME_SLOT_REF1="ts10202" TIME_SLOT_REF2="ts10225">
                <ANNOTATION_VALUE>You mean all of them will come.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1767"
                TIME_SLOT_REF1="ts10503" TIME_SLOT_REF2="ts10515">
                <ANNOTATION_VALUE>Really?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1768"
                TIME_SLOT_REF1="ts10523" TIME_SLOT_REF2="ts10527">
                <ANNOTATION_VALUE>Then</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1769"
                TIME_SLOT_REF1="ts10537" TIME_SLOT_REF2="ts10549">
                <ANNOTATION_VALUE>it is good.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1770"
                TIME_SLOT_REF1="ts10595" TIME_SLOT_REF2="ts10615">
                <ANNOTATION_VALUE>You can also stay in the winter.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1771"
                TIME_SLOT_REF1="ts10661" TIME_SLOT_REF2="ts10679">
                <ANNOTATION_VALUE>Does your wife live? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1772"
                TIME_SLOT_REF1="ts10683" TIME_SLOT_REF2="ts10703">
                <ANNOTATION_VALUE>You need to find a wife who will live.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1773"
                TIME_SLOT_REF1="ts10851" TIME_SLOT_REF2="ts10865">
                <ANNOTATION_VALUE>Are they fun</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1774"
                TIME_SLOT_REF1="ts10866" TIME_SLOT_REF2="ts10871">
                <ANNOTATION_VALUE>for you?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1775"
                TIME_SLOT_REF1="ts11154" TIME_SLOT_REF2="ts11169">
                <ANNOTATION_VALUE>It is a lot, yes?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1776"
                TIME_SLOT_REF1="ts11170" TIME_SLOT_REF2="ts11189">
                <ANNOTATION_VALUE>Maybe for them, it is fun for each other,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1777"
                TIME_SLOT_REF1="ts11385" TIME_SLOT_REF2="ts11415">
                <ANNOTATION_VALUE>We drink Kumis while пlaying cards at daytime.   </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1778"
                TIME_SLOT_REF1="ts11416" TIME_SLOT_REF2="ts11433">
                <ANNOTATION_VALUE>we got drunk, (since it is fermented, it has low level of alcohol)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1779"
                TIME_SLOT_REF1="ts11434" TIME_SLOT_REF2="ts11441">
                <ANNOTATION_VALUE>vomitting.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
