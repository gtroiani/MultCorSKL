            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a818"
                TIME_SLOT_REF1="ts3545" TIME_SLOT_REF2="ts3547">
                <ANNOTATION_VALUE>that is good.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a819"
                TIME_SLOT_REF1="ts3548" TIME_SLOT_REF2="ts3551">
                <ANNOTATION_VALUE>In the morning,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a820"
                TIME_SLOT_REF1="ts3552" TIME_SLOT_REF2="ts3557">
                <ANNOTATION_VALUE>it is a little bit hard in the morning, I helп (him).</ANNOTATION_VALUE>
