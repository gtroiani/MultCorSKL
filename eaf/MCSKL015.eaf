        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a695"
                TIME_SLOT_REF1="ts2469" TIME_SLOT_REF2="ts2476">
                <ANNOTATION_VALUE>For us, you go for forty or fifty minutes.  </ANNOTATION_VALUE>
