        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1703"
                TIME_SLOT_REF1="ts7282" TIME_SLOT_REF2="ts7315">
                <ANNOTATION_VALUE>you mean it is not allowed to drive fast. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1704"
                TIME_SLOT_REF1="ts7441" TIME_SLOT_REF2="ts7452">
                <ANNOTATION_VALUE>Zhamanty? (пlace)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1705"
                TIME_SLOT_REF1="ts7467" TIME_SLOT_REF2="ts7477">
                <ANNOTATION_VALUE>In Nileke?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1706"
                TIME_SLOT_REF1="ts7485" TIME_SLOT_REF2="ts7489">
                <ANNOTATION_VALUE>In Togyztarau? </ANNOTATION_VALUE>
