        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a733"
                TIME_SLOT_REF1="ts2825" TIME_SLOT_REF2="ts2835">
                <ANNOTATION_VALUE>Electrical vehicle is  for groceries and for something like that.</ANNOTATION_VALUE>
