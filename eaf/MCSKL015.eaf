        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a696"
                TIME_SLOT_REF1="ts2477" TIME_SLOT_REF2="ts2483">
                <ANNOTATION_VALUE>after arriving in the city, you will stuck in traffic jam,</ANNOTATION_VALUE>
