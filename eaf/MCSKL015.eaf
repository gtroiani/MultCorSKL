    <TIER LINGUISTIC_TYPE_REF="Translation" TIER_ID="trx_en@SPK1111">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a378"
                TIME_SLOT_REF1="ts7" TIME_SLOT_REF2="ts11">
                <ANNOTATION_VALUE>Yes, we do,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a379"
                TIME_SLOT_REF1="ts13" TIME_SLOT_REF2="ts15">
                <ANNOTATION_VALUE>we go there in one car,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a380"
                TIME_SLOT_REF1="ts16" TIME_SLOT_REF2="ts21">
                <ANNOTATION_VALUE>we even go for a day or two. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a381"
                TIME_SLOT_REF1="ts27" TIME_SLOT_REF2="ts31">
                <ANNOTATION_VALUE>summer pasture - -</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a382"
                TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts41">
                <ANNOTATION_VALUE>yes summer - - </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a383"
                TIME_SLOT_REF1="ts45" TIME_SLOT_REF2="ts49">
                <ANNOTATION_VALUE>yes,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a384"
                TIME_SLOT_REF1="ts50" TIME_SLOT_REF2="ts57">
                <ANNOTATION_VALUE>I grow up in summer pasture.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a385"
                TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts67">
                <ANNOTATION_VALUE>Yes, in the winter</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a386"
                TIME_SLOT_REF1="ts71" TIME_SLOT_REF2="ts73">
                <ANNOTATION_VALUE>we moved to our winter house,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a387"
                TIME_SLOT_REF1="ts75" TIME_SLOT_REF2="ts79">
                <ANNOTATION_VALUE>in the summer, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a388"
                TIME_SLOT_REF1="ts80" TIME_SLOT_REF2="ts83">
                <ANNOTATION_VALUE>that winter</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a389"
                TIME_SLOT_REF1="ts85" TIME_SLOT_REF2="ts87">
                <ANNOTATION_VALUE>winter - -</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a390"
                TIME_SLOT_REF1="ts88" TIME_SLOT_REF2="ts93">
                <ANNOTATION_VALUE>I stay in the summer pasture because of animals until the beginning of winter,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a391"
                TIME_SLOT_REF1="ts94" TIME_SLOT_REF2="ts99">
                <ANNOTATION_VALUE>(it is) enjoyable.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a392"
                TIME_SLOT_REF1="ts102" TIME_SLOT_REF2="ts105">
                <ANNOTATION_VALUE>You slaughter a sheep.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a393"
                TIME_SLOT_REF1="ts108" TIME_SLOT_REF2="ts111">
                <ANNOTATION_VALUE>On top of that, the summer pasture is close to us,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a394"
                TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts121">
                <ANNOTATION_VALUE>you can get (there) in one and half hours with car.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a395"
                TIME_SLOT_REF1="ts125" TIME_SLOT_REF2="ts129">
                <ANNOTATION_VALUE>Shashy (the name of the pasture).</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a396"
                TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts135">
                <ANNOTATION_VALUE>which you went.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a397"
                TIME_SLOT_REF1="ts143" TIME_SLOT_REF2="ts149">
                <ANNOTATION_VALUE>Yes,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a398"
                TIME_SLOT_REF1="ts150" TIME_SLOT_REF2="ts155">
                <ANNOTATION_VALUE>yes,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a399"
                TIME_SLOT_REF1="ts160" TIME_SLOT_REF2="ts169">
                <ANNOTATION_VALUE>the road is asphalt,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a400"
                TIME_SLOT_REF1="ts170" TIME_SLOT_REF2="ts173">
                <ANNOTATION_VALUE>it is asphalt until our house,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a401"
                TIME_SLOT_REF1="ts176" TIME_SLOT_REF2="ts179">
                <ANNOTATION_VALUE>cars can get there. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a402"
                TIME_SLOT_REF1="ts181" TIME_SLOT_REF2="ts183">
                <ANNOTATION_VALUE>You just come,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a403"
                TIME_SLOT_REF1="ts185" TIME_SLOT_REF2="ts187">
                <ANNOTATION_VALUE>and fill up your car.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a404"
                TIME_SLOT_REF1="ts191" TIME_SLOT_REF2="ts195">
                <ANNOTATION_VALUE>On top of that,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a405"
                TIME_SLOT_REF1="ts196" TIME_SLOT_REF2="ts199">
                <ANNOTATION_VALUE>there are resorts near us,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a406"
                TIME_SLOT_REF1="ts200" TIME_SLOT_REF2="ts205">
                <ANNOTATION_VALUE>no car is allowed beyond us.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a407"
                TIME_SLOT_REF1="ts209" TIME_SLOT_REF2="ts213">
                <ANNOTATION_VALUE>No,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a408"
                TIME_SLOT_REF1="ts215" TIME_SLOT_REF2="ts221">
                <ANNOTATION_VALUE>we don't treat the guests.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a409"
                TIME_SLOT_REF1="ts223" TIME_SLOT_REF2="ts229">
                <ANNOTATION_VALUE>They earn a lot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a410"
                TIME_SLOT_REF1="ts233" TIME_SLOT_REF2="ts235">
                <ANNOTATION_VALUE>Yes,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a411"
                TIME_SLOT_REF1="ts241" TIME_SLOT_REF2="ts251">
                <ANNOTATION_VALUE>but we do not want to serve others,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a412"
                TIME_SLOT_REF1="ts252" TIME_SLOT_REF2="ts259">
                <ANNOTATION_VALUE>we all are this kind of (disobidient) person.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a413"
                TIME_SLOT_REF1="ts262" TIME_SLOT_REF2="ts267">
                <ANNOTATION_VALUE>So we do not to want to be watchful.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a414"
                TIME_SLOT_REF1="ts268" TIME_SLOT_REF2="ts271">
                <ANNOTATION_VALUE>we are ill tempered.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a415"
                TIME_SLOT_REF1="ts274" TIME_SLOT_REF2="ts277">
                <ANNOTATION_VALUE>Beyond us, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a416"
                TIME_SLOT_REF1="ts280" TIME_SLOT_REF2="ts283">
                <ANNOTATION_VALUE>that </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a417"
                TIME_SLOT_REF1="ts286" TIME_SLOT_REF2="ts290">
                <ANNOTATION_VALUE>there are resorts near us,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a418"
                TIME_SLOT_REF1="ts294" TIME_SLOT_REF2="ts299">
                <ANNOTATION_VALUE>they blocked the road from there,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a419"
                TIME_SLOT_REF1="ts300" TIME_SLOT_REF2="ts305">
                <ANNOTATION_VALUE>beyond there, nothing including cars is not allowed to pass. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a420"
                TIME_SLOT_REF1="ts311" TIME_SLOT_REF2="ts315">
                <ANNOTATION_VALUE>Beyond that, it is herdsmen's (area).</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a421"
                TIME_SLOT_REF1="ts316" TIME_SLOT_REF2="ts321">
                <ANNOTATION_VALUE>(It is) enjoyable,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a422"
                TIME_SLOT_REF1="ts322" TIME_SLOT_REF2="ts327">
                <ANNOTATION_VALUE>cars do not go,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a423"
                TIME_SLOT_REF1="ts328" TIME_SLOT_REF2="ts331">
                <ANNOTATION_VALUE>thieves do not go,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a424"
                TIME_SLOT_REF1="ts332" TIME_SLOT_REF2="ts339">
                <ANNOTATION_VALUE>but</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a425"
                TIME_SLOT_REF1="ts343" TIME_SLOT_REF2="ts345">
                <ANNOTATION_VALUE>they let us pass from here,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a426"
                TIME_SLOT_REF1="ts346" TIME_SLOT_REF2="ts349">
                <ANNOTATION_VALUE>since we are -  -</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a427"
                TIME_SLOT_REF1="ts350" TIME_SLOT_REF2="ts353">
                <ANNOTATION_VALUE>they make a pass for us,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a428"
