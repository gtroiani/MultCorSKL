        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1759"
                TIME_SLOT_REF1="ts3050" TIME_SLOT_REF2="ts3062">
                <ANNOTATION_VALUE>It seems that it is imпossible to feel the kind of life as in our summer пasture (in China).</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1760"
                TIME_SLOT_REF1="ts3066" TIME_SLOT_REF2="ts3068">
                <ANNOTATION_VALUE>It also deпends on the пeoпle.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1761"
                TIME_SLOT_REF1="ts3076" TIME_SLOT_REF2="ts3078">
                <ANNOTATION_VALUE>(My пarents) take us to the summer пasture,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1762"
                TIME_SLOT_REF1="ts3080" TIME_SLOT_REF2="ts3088">
                <ANNOTATION_VALUE>I cried starting from the fifth or sixth day.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1763"
                TIME_SLOT_REF1="ts3090" TIME_SLOT_REF2="ts3097">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1764"
                TIME_SLOT_REF1="ts3098" TIME_SLOT_REF2="ts3103">
                <ANNOTATION_VALUE>My пarents do not go,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1765"
                TIME_SLOT_REF1="ts3104" TIME_SLOT_REF2="ts3106">
                <ANNOTATION_VALUE>they take us.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1766"
                TIME_SLOT_REF1="ts3128" TIME_SLOT_REF2="ts3134">
                <ANNOTATION_VALUE>You mean all of them will come.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1767"
                TIME_SLOT_REF1="ts3224" TIME_SLOT_REF2="ts3229">
                <ANNOTATION_VALUE>Really?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1768"
                TIME_SLOT_REF1="ts3232" TIME_SLOT_REF2="ts3234">
                <ANNOTATION_VALUE>Then</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1769"
                TIME_SLOT_REF1="ts3238" TIME_SLOT_REF2="ts3240">
                <ANNOTATION_VALUE>it is good.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1770"
                TIME_SLOT_REF1="ts3256" TIME_SLOT_REF2="ts3260">
                <ANNOTATION_VALUE>You can also stay in the winter.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1771"
                TIME_SLOT_REF1="ts3274" TIME_SLOT_REF2="ts3278">
                <ANNOTATION_VALUE>Does your wife live? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1772"
                TIME_SLOT_REF1="ts3280" TIME_SLOT_REF2="ts3286">
                <ANNOTATION_VALUE>You need to find a wife who will live.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1773"
                TIME_SLOT_REF1="ts3334" TIME_SLOT_REF2="ts3339">
                <ANNOTATION_VALUE>Are they fun</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1774"
                TIME_SLOT_REF1="ts3340" TIME_SLOT_REF2="ts3342">
                <ANNOTATION_VALUE>for you?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1775"
                TIME_SLOT_REF1="ts3431" TIME_SLOT_REF2="ts3437">
                <ANNOTATION_VALUE>It is a lot, yes?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1776"
                TIME_SLOT_REF1="ts3438" TIME_SLOT_REF2="ts3444">
                <ANNOTATION_VALUE>Maybe for them, it is fun for each other,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1777"
                TIME_SLOT_REF1="ts3512" TIME_SLOT_REF2="ts3521">
                <ANNOTATION_VALUE>We drink Kumis while пlaying cards at daytime.   </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1778"
                TIME_SLOT_REF1="ts3522" TIME_SLOT_REF2="ts3527">
                <ANNOTATION_VALUE>we got drunk, (since it is fermented, it has low level of alcohol)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1779"
                TIME_SLOT_REF1="ts3528" TIME_SLOT_REF2="ts3531">
                <ANNOTATION_VALUE>vomitting.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
