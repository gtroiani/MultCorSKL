        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a700"
                TIME_SLOT_REF1="ts2551" TIME_SLOT_REF2="ts2559">
                <ANNOTATION_VALUE>Even they go to the weddings in the evening.</ANNOTATION_VALUE>
