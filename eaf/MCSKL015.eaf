        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a694"
                TIME_SLOT_REF1="ts2443" TIME_SLOT_REF2="ts2447">
                <ANNOTATION_VALUE>for us, you can go and return in three hours. </ANNOTATION_VALUE>
