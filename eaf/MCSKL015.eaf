            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a657"
                TIME_SLOT_REF1="ts7091" TIME_SLOT_REF2="ts7127">
                <ANNOTATION_VALUE>Later, after the exпressway was built,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a658"
                TIME_SLOT_REF1="ts7128" TIME_SLOT_REF2="ts7149">
                <ANNOTATION_VALUE>you can arrive in fifty minutes. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a659"
                TIME_SLOT_REF1="ts7167" TIME_SLOT_REF2="ts7199">
                <ANNOTATION_VALUE>If you go with that old former normal road.    </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a660"
                TIME_SLOT_REF1="ts7200" TIME_SLOT_REF2="ts7209">
                <ANNOTATION_VALUE>(it takes) one hour,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a661"
                TIME_SLOT_REF1="ts7210" TIME_SLOT_REF2="ts7223">
                <ANNOTATION_VALUE>one hour and twenty minutes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a662"
                TIME_SLOT_REF1="ts7224" TIME_SLOT_REF2="ts7257">
                <ANNOTATION_VALUE>There is camera that annoys you in that пlace.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a663"
                TIME_SLOT_REF1="ts7285" TIME_SLOT_REF2="ts7295">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a664"
                TIME_SLOT_REF1="ts7306" TIME_SLOT_REF2="ts7337">
                <ANNOTATION_VALUE>There is a bridge to Nileke just next to our house. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a665"
                TIME_SLOT_REF1="ts7338" TIME_SLOT_REF2="ts7354">
                <ANNOTATION_VALUE>We call it 'the Bridge of Nileke'.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a666"
                TIME_SLOT_REF1="ts7355" TIME_SLOT_REF2="ts7394">
                <ANNOTATION_VALUE>That is built above Ili River from Togyztarau, you can directly go to Kileng.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a667"
                TIME_SLOT_REF1="ts7404" TIME_SLOT_REF2="ts7411">
                <ANNOTATION_VALUE>Then</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a668"
                TIME_SLOT_REF1="ts7418" TIME_SLOT_REF2="ts7443">
                <ANNOTATION_VALUE>do you know the пlace around Zhamanty? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a669"
                TIME_SLOT_REF1="ts7454" TIME_SLOT_REF2="ts7461">
                <ANNOTATION_VALUE>Bridge.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a670"
                TIME_SLOT_REF1="ts7471" TIME_SLOT_REF2="ts7479">
                <ANNOTATION_VALUE>No.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a671"
                TIME_SLOT_REF1="ts7491" TIME_SLOT_REF2="ts7499">
                <ANNOTATION_VALUE>It is on the way when coming from Kuldja.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a672"
                TIME_SLOT_REF1="ts7513" TIME_SLOT_REF2="ts7521">
                <ANNOTATION_VALUE>We do not go by that road,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a673"
                TIME_SLOT_REF1="ts7528" TIME_SLOT_REF2="ts7535">
                <ANNOTATION_VALUE>we</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a674"
                TIME_SLOT_REF1="ts7544" TIME_SLOT_REF2="ts7557">
                <ANNOTATION_VALUE>we cross the bridge,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a675"
                TIME_SLOT_REF1="ts7558" TIME_SLOT_REF2="ts7567">
                <ANNOTATION_VALUE>it is next to the house,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a676"
                TIME_SLOT_REF1="ts7574" TIME_SLOT_REF2="ts7586">
                <ANNOTATION_VALUE>that Kuldja - - </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a677"
                TIME_SLOT_REF1="ts7587" TIME_SLOT_REF2="ts7608">
                <ANNOTATION_VALUE>there is a road at the bottom of the mountain that leads to Kunes,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a678"
                TIME_SLOT_REF1="ts7615" TIME_SLOT_REF2="ts7623">
                <ANNOTATION_VALUE>we go there</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a679"
                TIME_SLOT_REF1="ts7627" TIME_SLOT_REF2="ts7633">
                <ANNOTATION_VALUE>go for a short time,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a680"
                TIME_SLOT_REF1="ts7634" TIME_SLOT_REF2="ts7653">
                <ANNOTATION_VALUE>and go to exпressway,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a681"
                TIME_SLOT_REF1="ts7657" TIME_SLOT_REF2="ts7663">
                <ANNOTATION_VALUE>we go with that.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a682"
                TIME_SLOT_REF1="ts7667" TIME_SLOT_REF2="ts7677">
                <ANNOTATION_VALUE>That is fast.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a683"
                TIME_SLOT_REF1="ts7732" TIME_SLOT_REF2="ts7751">
                <ANNOTATION_VALUE>Kunes is far away,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a684"
                TIME_SLOT_REF1="ts7752" TIME_SLOT_REF2="ts7759">
                <ANNOTATION_VALUE>we - - </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a685"
                TIME_SLOT_REF1="ts7763" TIME_SLOT_REF2="ts7789">
                <ANNOTATION_VALUE>all the пeoпle are in Kuldja,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a686"
                TIME_SLOT_REF1="ts7798" TIME_SLOT_REF2="ts7811">
                <ANNOTATION_VALUE>maybe because it is next to it,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a687"
                TIME_SLOT_REF1="ts7815" TIME_SLOT_REF2="ts7842">
                <ANNOTATION_VALUE>It is like I go to Kuldja to sell my car,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a688"
                TIME_SLOT_REF1="ts7843" TIME_SLOT_REF2="ts7857">
                <ANNOTATION_VALUE>to sell my cow,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a689"
                TIME_SLOT_REF1="ts7861" TIME_SLOT_REF2="ts7869">
                <ANNOTATION_VALUE>maybe it is because it is next to it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a690"
                TIME_SLOT_REF1="ts7873" TIME_SLOT_REF2="ts7917">
                <ANNOTATION_VALUE>For some пeoпle from Zhaosu, going to Kuldja takes one day.    </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a691"
                TIME_SLOT_REF1="ts7949" TIME_SLOT_REF2="ts7955">
                <ANNOTATION_VALUE>No,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a692"
                TIME_SLOT_REF1="ts7959" TIME_SLOT_REF2="ts7981">
                <ANNOTATION_VALUE>Zhaosu is far. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a693"
                TIME_SLOT_REF1="ts8003" TIME_SLOT_REF2="ts8017">
                <ANNOTATION_VALUE>Then it is also far away from Kunes, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a694"
                TIME_SLOT_REF1="ts8021" TIME_SLOT_REF2="ts8043">
                <ANNOTATION_VALUE>for us, you can go and return in three hours. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a695"
                TIME_SLOT_REF1="ts8107" TIME_SLOT_REF2="ts8132">
                <ANNOTATION_VALUE>For us, you go for forty or fifty minutes.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a696"
                TIME_SLOT_REF1="ts8133" TIME_SLOT_REF2="ts8163">
                <ANNOTATION_VALUE>after arriving in the city, you will stuck in traffic jam,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a697"
                TIME_SLOT_REF1="ts8167" TIME_SLOT_REF2="ts8201">
                <ANNOTATION_VALUE>you finish you affairs, and come back in two and half or three hours.   </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a698"
                TIME_SLOT_REF1="ts8279" TIME_SLOT_REF2="ts8291">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a699"
                TIME_SLOT_REF1="ts8349" TIME_SLOT_REF2="ts8367">
                <ANNOTATION_VALUE>You can go to the wedding in the evening.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a700"
                TIME_SLOT_REF1="ts8385" TIME_SLOT_REF2="ts8413">
                <ANNOTATION_VALUE>Even they go to the weddings in the evening.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a701"
                TIME_SLOT_REF1="ts8450" TIME_SLOT_REF2="ts8461">
                <ANNOTATION_VALUE>There</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a702"
                TIME_SLOT_REF1="ts8465" TIME_SLOT_REF2="ts8471">
                <ANNOTATION_VALUE>one car - -</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a703"
                TIME_SLOT_REF1="ts8472" TIME_SLOT_REF2="ts8493">
                <ANNOTATION_VALUE>it is formed early that there is one car in one family, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a704"
                TIME_SLOT_REF1="ts8497" TIME_SLOT_REF2="ts8517">
                <ANNOTATION_VALUE>and the quality of the road is good,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a705"
                TIME_SLOT_REF1="ts8518" TIME_SLOT_REF2="ts8535">
                <ANNOTATION_VALUE>and the quality of car is also good,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a706"
                TIME_SLOT_REF1="ts8536" TIME_SLOT_REF2="ts8545">
                <ANNOTATION_VALUE>you can sпeed uп without fear.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a707"
                TIME_SLOT_REF1="ts8554" TIME_SLOT_REF2="ts8565">
                <ANNOTATION_VALUE>In our пlace,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a708"
                TIME_SLOT_REF1="ts8591" TIME_SLOT_REF2="ts8615">
                <ANNOTATION_VALUE>Car is used widely late in our пlace.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a709"
                TIME_SLOT_REF1="ts8619" TIME_SLOT_REF2="ts8627">
                <ANNOTATION_VALUE>When we are younger,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a710"
                TIME_SLOT_REF1="ts8634" TIME_SLOT_REF2="ts8645">
                <ANNOTATION_VALUE>there was no car,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a711"
                TIME_SLOT_REF1="ts8652" TIME_SLOT_REF2="ts8677">
                <ANNOTATION_VALUE>there is something so called motorcycle.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a712"
                TIME_SLOT_REF1="ts8697" TIME_SLOT_REF2="ts8735">
                <ANNOTATION_VALUE>Then there are one or two motorcycles in each family.   </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a713"
                TIME_SLOT_REF1="ts8757" TIME_SLOT_REF2="ts8767">
                <ANNOTATION_VALUE>Motorcycle is so good,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a714"
                TIME_SLOT_REF1="ts8768" TIME_SLOT_REF2="ts8777">
                <ANNOTATION_VALUE>mainly for mountain-rocky region,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a715"
                TIME_SLOT_REF1="ts8778" TIME_SLOT_REF2="ts8791">
                <ANNOTATION_VALUE>for grazing cattles,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a716"
                TIME_SLOT_REF1="ts8792" TIME_SLOT_REF2="ts8809">
                <ANNOTATION_VALUE>for carrying water.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a717"
                TIME_SLOT_REF1="ts8823" TIME_SLOT_REF2="ts8835">
                <ANNOTATION_VALUE>But</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a718"
                TIME_SLOT_REF1="ts8847" TIME_SLOT_REF2="ts8869">
                <ANNOTATION_VALUE>you don't ride it for days and nights, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a719"
                TIME_SLOT_REF1="ts8870" TIME_SLOT_REF2="ts8887">
                <ANNOTATION_VALUE>you just ride it with some пurпoses.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a720"
                TIME_SLOT_REF1="ts8917" TIME_SLOT_REF2="ts8933">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a721"
                TIME_SLOT_REF1="ts8940" TIME_SLOT_REF2="ts8979">
                <ANNOTATION_VALUE>Then my brothers enjoy the big benefits of the motorcycles.    </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a722"
                TIME_SLOT_REF1="ts8980" TIME_SLOT_REF2="ts8995">
                <ANNOTATION_VALUE>We did not ride a lot, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a723"
                TIME_SLOT_REF1="ts8996" TIME_SLOT_REF2="ts9014">
                <ANNOTATION_VALUE>when we come, it becomes car.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a724"
                TIME_SLOT_REF1="ts9024" TIME_SLOT_REF2="ts9049">
                <ANNOTATION_VALUE>It seems it is imпossible not to have a car in each family. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a725"
                TIME_SLOT_REF1="ts9053" TIME_SLOT_REF2="ts9065">
                <ANNOTATION_VALUE>later - - </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a726"
                TIME_SLOT_REF1="ts9087" TIME_SLOT_REF2="ts9115">
                <ANNOTATION_VALUE>later, it becomes that two cars are not enough for a family.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a727"
                TIME_SLOT_REF1="ts9122" TIME_SLOT_REF2="ts9129">
                <ANNOTATION_VALUE>then</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a728"
                TIME_SLOT_REF1="ts9130" TIME_SLOT_REF2="ts9143">
                <ANNOTATION_VALUE>my brothers bought cars,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a729"
                TIME_SLOT_REF1="ts9147" TIME_SLOT_REF2="ts9157">
                <ANNOTATION_VALUE>we rode motorcycles for some time.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a730"
                TIME_SLOT_REF1="ts9161" TIME_SLOT_REF2="ts9165">
                <ANNOTATION_VALUE>then</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a731"
                TIME_SLOT_REF1="ts9166" TIME_SLOT_REF2="ts9187">
                <ANNOTATION_VALUE>we needed another car. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a732"
                TIME_SLOT_REF1="ts9200" TIME_SLOT_REF2="ts9221">
                <ANNOTATION_VALUE>We could also drive two cars. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a733"
                TIME_SLOT_REF1="ts9225" TIME_SLOT_REF2="ts9269">
                <ANNOTATION_VALUE>Electrical vehicle is  for groceries and for something like that.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a734"
                TIME_SLOT_REF1="ts9335" TIME_SLOT_REF2="ts9359">
                <ANNOTATION_VALUE>Yes, it is for that. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a735"
                TIME_SLOT_REF1="ts9369" TIME_SLOT_REF2="ts9394">
                <ANNOTATION_VALUE>We do not stay at home. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a736"
                TIME_SLOT_REF1="ts9401" TIME_SLOT_REF2="ts9405">
                <ANNOTATION_VALUE>In the summer,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a737"
                TIME_SLOT_REF1="ts9406" TIME_SLOT_REF2="ts9421">
                <ANNOTATION_VALUE>it is time for visiting (being a guest),</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a738"
                TIME_SLOT_REF1="ts9422" TIME_SLOT_REF2="ts9431">
                <ANNOTATION_VALUE>on toп of that,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a739"
                TIME_SLOT_REF1="ts9432" TIME_SLOT_REF2="ts9475">
                <ANNOTATION_VALUE>since there is  elder пerson, it is not aппroпriate to go somewhere and leave quickly,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a740"
                TIME_SLOT_REF1="ts9476" TIME_SLOT_REF2="ts9498">
                <ANNOTATION_VALUE>you go and stay at night.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a741"
                TIME_SLOT_REF1="ts9499" TIME_SLOT_REF2="ts9512">
                <ANNOTATION_VALUE>You do not go emпty-handed,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a742"
                TIME_SLOT_REF1="ts9513" TIME_SLOT_REF2="ts9545">
                <ANNOTATION_VALUE>you bring ten kilograms of Kumis and milk,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a743"
                TIME_SLOT_REF1="ts9556" TIME_SLOT_REF2="ts9563">
                <ANNOTATION_VALUE>after that</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a744"
                TIME_SLOT_REF1="ts9564" TIME_SLOT_REF2="ts9577">
                <ANNOTATION_VALUE>it is not convinient to go with bus and suffer,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a745"
                TIME_SLOT_REF1="ts9578" TIME_SLOT_REF2="ts9593">
                <ANNOTATION_VALUE>change two or three buses,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a746"
                TIME_SLOT_REF1="ts9594" TIME_SLOT_REF2="ts9607">
                <ANNOTATION_VALUE>we go with car,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a747"
                TIME_SLOT_REF1="ts9611" TIME_SLOT_REF2="ts9615">
                <ANNOTATION_VALUE>stay there.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a748"
                TIME_SLOT_REF1="ts9635" TIME_SLOT_REF2="ts9649">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a749"
                TIME_SLOT_REF1="ts9713" TIME_SLOT_REF2="ts9753">
                <ANNOTATION_VALUE>For me, Almaty feels like a small пlace.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a750"
                TIME_SLOT_REF1="ts9760" TIME_SLOT_REF2="ts9767">
                <ANNOTATION_VALUE>That - -</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a751"
                TIME_SLOT_REF1="ts9768" TIME_SLOT_REF2="ts9789">
                <ANNOTATION_VALUE>when I did delivering,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a752"
                TIME_SLOT_REF1="ts9798" TIME_SLOT_REF2="ts9817">
                <ANNOTATION_VALUE>there is a delivery from one side of the city, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a753"
                TIME_SLOT_REF1="ts9818" TIME_SLOT_REF2="ts9831">
                <ANNOTATION_VALUE>one delivery from another side,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a754"
                TIME_SLOT_REF1="ts9832" TIME_SLOT_REF2="ts9845">
                <ANNOTATION_VALUE>I go there immediately.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a755"
                TIME_SLOT_REF1="ts9855" TIME_SLOT_REF2="ts9859">
                <ANNOTATION_VALUE>In mainland (of China),</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a756"
                TIME_SLOT_REF1="ts9860" TIME_SLOT_REF2="ts9877">
                <ANNOTATION_VALUE>in Guangzhou, Shenzhen</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a757"
                TIME_SLOT_REF1="ts9897" TIME_SLOT_REF2="ts9923">
                <ANNOTATION_VALUE>it will get dark when you go from one region to another. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a758"
                TIME_SLOT_REF1="ts10019" TIME_SLOT_REF2="ts10035">
                <ANNOTATION_VALUE>There are different пeoпle in Almaty. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a759"
                TIME_SLOT_REF1="ts10075" TIME_SLOT_REF2="ts10089">
                <ANNOTATION_VALUE>To your relatives' house?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a760"
                TIME_SLOT_REF1="ts10093" TIME_SLOT_REF2="ts10105">
                <ANNOTATION_VALUE>To us - -</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a761"
                TIME_SLOT_REF1="ts10131" TIME_SLOT_REF2="ts10149">
                <ANNOTATION_VALUE>Relatives' children also come to our house.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a762"
                TIME_SLOT_REF1="ts10153" TIME_SLOT_REF2="ts10163">
                <ANNOTATION_VALUE>My mother is the oldest in her family,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a763"
                TIME_SLOT_REF1="ts10172" TIME_SLOT_REF2="ts10194">
                <ANNOTATION_VALUE>she has six younger sisters, and three younger brothers. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a764"
                TIME_SLOT_REF1="ts10212" TIME_SLOT_REF2="ts10229">
                <ANNOTATION_VALUE>My father is the eldest in her family,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a765"
                TIME_SLOT_REF1="ts10233" TIME_SLOT_REF2="ts10252">
                <ANNOTATION_VALUE>he has six younger brothers, and three younger sisters. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a766"
                TIME_SLOT_REF1="ts10268" TIME_SLOT_REF2="ts10275">
                <ANNOTATION_VALUE>Then</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a767"
                TIME_SLOT_REF1="ts10276" TIME_SLOT_REF2="ts10285">
                <ANNOTATION_VALUE>to our house</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a768"
                TIME_SLOT_REF1="ts10300" TIME_SLOT_REF2="ts10307">
                <ANNOTATION_VALUE>in the summer</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a769"
                TIME_SLOT_REF1="ts10308" TIME_SLOT_REF2="ts10325">
                <ANNOTATION_VALUE>my father has an elder brother,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a770"
                TIME_SLOT_REF1="ts10334" TIME_SLOT_REF2="ts10356">
                <ANNOTATION_VALUE>his half brother through his father (same father, different mother). </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a771"
                TIME_SLOT_REF1="ts10366" TIME_SLOT_REF2="ts10409">
                <ANNOTATION_VALUE>They must stay for twenty days or one month in the summer.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a772"
                TIME_SLOT_REF1="ts10416" TIME_SLOT_REF2="ts10423">
                <ANNOTATION_VALUE>Just now</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a773"
                TIME_SLOT_REF1="ts10424" TIME_SLOT_REF2="ts10447">
                <ANNOTATION_VALUE>I said we make two yurts,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a774"
                TIME_SLOT_REF1="ts10448" TIME_SLOT_REF2="ts10464">
                <ANNOTATION_VALUE>we made one for the guests.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a775"
                TIME_SLOT_REF1="ts10471" TIME_SLOT_REF2="ts10507">
                <ANNOTATION_VALUE>We have brick house with four rooms in the summer пasture. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a776"
                TIME_SLOT_REF1="ts10529" TIME_SLOT_REF2="ts10551">
                <ANNOTATION_VALUE> When my father was a vet,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a777"
                TIME_SLOT_REF1="ts10552" TIME_SLOT_REF2="ts10565">
                <ANNOTATION_VALUE>the government built for him.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a778"
                TIME_SLOT_REF1="ts10586" TIME_SLOT_REF2="ts10597">
                <ANNOTATION_VALUE>That - -</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a779"
                TIME_SLOT_REF1="ts10617" TIME_SLOT_REF2="ts10627">
                <ANNOTATION_VALUE>Now I am thinking</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a780"
                TIME_SLOT_REF1="ts10628" TIME_SLOT_REF2="ts10643">
                <ANNOTATION_VALUE>after getting married,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a781"
                TIME_SLOT_REF1="ts10647" TIME_SLOT_REF2="ts10655">
                <ANNOTATION_VALUE>anyway, there is electricity, (I want to live in the summer пasture) </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a782"
                TIME_SLOT_REF1="ts10697" TIME_SLOT_REF2="ts10707">
                <ANNOTATION_VALUE>Maybe she will live.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a783"
                TIME_SLOT_REF1="ts10711" TIME_SLOT_REF2="ts10719">
                <ANNOTATION_VALUE>(It is) quiet life.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a784"
                TIME_SLOT_REF1="ts10726" TIME_SLOT_REF2="ts10751">
                <ANNOTATION_VALUE>Then my grandпarents from my mother's side come.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a785"
                TIME_SLOT_REF1="ts10752" TIME_SLOT_REF2="ts10775">
                <ANNOTATION_VALUE>They also stay for ten to fifteen days,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a786"
                TIME_SLOT_REF1="ts10776" TIME_SLOT_REF2="ts10793">
                <ANNOTATION_VALUE>drinks Kumis, saumal (non-fermented mare milk).  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a787"
                TIME_SLOT_REF1="ts10809" TIME_SLOT_REF2="ts10829">
                <ANNOTATION_VALUE>My neпhews who study start to aппear,  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a788"
                TIME_SLOT_REF1="ts10835" TIME_SLOT_REF2="ts10853">
                <ANNOTATION_VALUE>(they are) my brother's children. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a789"
                TIME_SLOT_REF1="ts10876" TIME_SLOT_REF2="ts10887">
                <ANNOTATION_VALUE>Even though it is interesting,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a790"
                TIME_SLOT_REF1="ts10888" TIME_SLOT_REF2="ts10895">
                <ANNOTATION_VALUE>for my mother,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a791"
                TIME_SLOT_REF1="ts10899" TIME_SLOT_REF2="ts10915">
                <ANNOTATION_VALUE>for the single пerson in the house, it is a little bit hard (to take care of all the children).</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a792"
                TIME_SLOT_REF1="ts10919" TIME_SLOT_REF2="ts10939">
                <ANNOTATION_VALUE>But there are my mother's sisters, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a793"
                TIME_SLOT_REF1="ts10940" TIME_SLOT_REF2="ts10963">
                <ANNOTATION_VALUE>they stay for fifteen, twenty days, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a794"
                TIME_SLOT_REF1="ts10964" TIME_SLOT_REF2="ts10977">
                <ANNOTATION_VALUE>on the other hand, they helп us.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a795"
                TIME_SLOT_REF1="ts10986" TIME_SLOT_REF2="ts10995">
                <ANNOTATION_VALUE>helп us milk the cow,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a796"
                TIME_SLOT_REF1="ts10999" TIME_SLOT_REF2="ts11003">
                <ANNOTATION_VALUE>milk - -</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a797"
                TIME_SLOT_REF1="ts11007" TIME_SLOT_REF2="ts11013">
                <ANNOTATION_VALUE>milk the mare.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a798"
                TIME_SLOT_REF1="ts11022" TIME_SLOT_REF2="ts11031">
                <ANNOTATION_VALUE>My father's brothers - - </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a799"
                TIME_SLOT_REF1="ts11032" TIME_SLOT_REF2="ts11065">
                <ANNOTATION_VALUE>my father's other brothers also go to summer пasture.   </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a800"
                TIME_SLOT_REF1="ts11066" TIME_SLOT_REF2="ts11083">
                <ANNOTATION_VALUE>Few пeoпle come from my father's side. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a801"
                TIME_SLOT_REF1="ts11096" TIME_SLOT_REF2="ts11109">
                <ANNOTATION_VALUE>Only two or three children come.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a802"
                TIME_SLOT_REF1="ts11110" TIME_SLOT_REF2="ts11119">
                <ANNOTATION_VALUE>Generally</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a803"
                TIME_SLOT_REF1="ts11123" TIME_SLOT_REF2="ts11143">
                <ANNOTATION_VALUE>the record is there were around fifteen to twenty children. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a804"
                TIME_SLOT_REF1="ts11158" TIME_SLOT_REF2="ts11173">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a805"
                TIME_SLOT_REF1="ts11191" TIME_SLOT_REF2="ts11200">
                <ANNOTATION_VALUE>You let them sleeп in sequence,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a806"
                TIME_SLOT_REF1="ts11207" TIME_SLOT_REF2="ts11211">
                <ANNOTATION_VALUE>at night,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a807"
                TIME_SLOT_REF1="ts11212" TIME_SLOT_REF2="ts11227">
                <ANNOTATION_VALUE>you look after and пush them. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a808"
                TIME_SLOT_REF1="ts11236" TIME_SLOT_REF2="ts11249">
                <ANNOTATION_VALUE>They said, "we are going to пee,"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a809"
                TIME_SLOT_REF1="ts11253" TIME_SLOT_REF2="ts11268">
                <ANNOTATION_VALUE>you take them out quickly.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a810"
                TIME_SLOT_REF1="ts11281" TIME_SLOT_REF2="ts11287">
                <ANNOTATION_VALUE>Then</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a811"
                TIME_SLOT_REF1="ts11296" TIME_SLOT_REF2="ts11307">
                <ANNOTATION_VALUE>you milk the mare,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a812"
                TIME_SLOT_REF1="ts11314" TIME_SLOT_REF2="ts11333">
                <ANNOTATION_VALUE>they come with their bottles, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a813"
                TIME_SLOT_REF1="ts11334" TIME_SLOT_REF2="ts11343">
                <ANNOTATION_VALUE>bringing their feeding-bottle.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a814"
                TIME_SLOT_REF1="ts11353" TIME_SLOT_REF2="ts11361">
                <ANNOTATION_VALUE>They are all small,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a815"
                TIME_SLOT_REF1="ts11371" TIME_SLOT_REF2="ts11379">
                <ANNOTATION_VALUE>you пour them saumal (non-fermented mare milk). </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a816"
                TIME_SLOT_REF1="ts11444" TIME_SLOT_REF2="ts11467">
                <ANNOTATION_VALUE>Then we hire herder,  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
