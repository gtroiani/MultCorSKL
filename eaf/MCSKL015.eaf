            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a706"
                TIME_SLOT_REF1="ts2598" TIME_SLOT_REF2="ts2601">
                <ANNOTATION_VALUE>you can sпeed uп without fear.</ANNOTATION_VALUE>
