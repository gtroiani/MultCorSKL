        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1722"
                TIME_SLOT_REF1="ts2522" TIME_SLOT_REF2="ts2529">
                <ANNOTATION_VALUE> For examпle from Talgar to Uzynagash (two towns in Almaty, Kazakhstan),</ANNOTATION_VALUE>
