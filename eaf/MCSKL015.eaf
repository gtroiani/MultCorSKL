        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a707"
                TIME_SLOT_REF1="ts2604" TIME_SLOT_REF2="ts2609">
                <ANNOTATION_VALUE>In our пlace,</ANNOTATION_VALUE>
