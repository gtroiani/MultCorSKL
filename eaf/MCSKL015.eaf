    <TIER LINGUISTIC_TYPE_REF="Translation" TIER_ID="trx_en@SPK1104">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1588"
                TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>Do you go to summer pasture in the summer?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1589"
                TIME_SLOT_REF1="ts24" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>No generally</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1590"
                TIME_SLOT_REF1="ts36" TIME_SLOT_REF2="ts48">
                <ANNOTATION_VALUE>do you spend the whole summer in the summer pasture with your family?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1591"
                TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts70">
                <ANNOTATION_VALUE>In the winter, you go to so called 'qystau' (winter house).</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1592"
                TIME_SLOT_REF1="ts116" TIME_SLOT_REF2="ts124">
                <ANNOTATION_VALUE>Which summer pasture do you go?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1593"
                TIME_SLOT_REF1="ts128" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>A, Shashy. (name of the pasture)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1594"
                TIME_SLOT_REF1="ts138" TIME_SLOT_REF2="ts141">
                <ANNOTATION_VALUE>Shashy,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1595"
                TIME_SLOT_REF1="ts142" TIME_SLOT_REF2="ts147">
                <ANNOTATION_VALUE>it is beautiful,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1596"
                TIME_SLOT_REF1="ts148" TIME_SLOT_REF2="ts159">
                <ANNOTATION_VALUE>It is high, yes? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1597"
                TIME_SLOT_REF1="ts166" TIME_SLOT_REF2="ts168">
                <ANNOTATION_VALUE>Yes,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1598"
                TIME_SLOT_REF1="ts204" TIME_SLOT_REF2="ts212">
                <ANNOTATION_VALUE>Do you have a resort?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1599"
                TIME_SLOT_REF1="ts220" TIME_SLOT_REF2="ts227">
                <ANNOTATION_VALUE>But the resorts earn good money.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1600"
                TIME_SLOT_REF1="ts228" TIME_SLOT_REF2="ts240">
                <ANNOTATION_VALUE>The yurt is three or four hundred yuan a day.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1601"
                TIME_SLOT_REF1="ts250" TIME_SLOT_REF2="ts256">
                <ANNOTATION_VALUE>Yes,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1602"
                TIME_SLOT_REF1="ts308" TIME_SLOT_REF2="ts310">
                <ANNOTATION_VALUE>So what do you have there?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1603"
                TIME_SLOT_REF1="ts314" TIME_SLOT_REF2="ts326">
                <ANNOTATION_VALUE>It is their own territory. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1604"
                TIME_SLOT_REF1="ts336" TIME_SLOT_REF2="ts342">
                <ANNOTATION_VALUE>You mean they cannot get there.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1605"
                TIME_SLOT_REF1="ts382" TIME_SLOT_REF2="ts392">
                <ANNOTATION_VALUE>They distribute densely.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1606"
                TIME_SLOT_REF1="ts414" TIME_SLOT_REF2="ts420">
                <ANNOTATION_VALUE>They know the real meaning of life, yes?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1607"
                TIME_SLOT_REF1="ts478" TIME_SLOT_REF2="ts494">
                <ANNOTATION_VALUE>Then when I come back to China, let me visit you in Shashy,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1608"
                TIME_SLOT_REF1="ts496" TIME_SLOT_REF2="ts500">
                <ANNOTATION_VALUE> My father took us all there one year at Eid.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1609"
                TIME_SLOT_REF1="ts516" TIME_SLOT_REF2="ts534">
                <ANNOTATION_VALUE>That is good, it is relaxing, you can rest.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1610"
                TIME_SLOT_REF1="ts542" TIME_SLOT_REF2="ts545">
                <ANNOTATION_VALUE>is it that kind of electricity?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1611"
                TIME_SLOT_REF1="ts546" TIME_SLOT_REF2="ts554">
                <ANNOTATION_VALUE>with solar energy.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1612"
                TIME_SLOT_REF1="ts580" TIME_SLOT_REF2="ts588">
                <ANNOTATION_VALUE>Then it will be cleaned up.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1613"
                TIME_SLOT_REF1="ts592" TIME_SLOT_REF2="ts597">
                <ANNOTATION_VALUE>Kumis - - </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1614"
                TIME_SLOT_REF1="ts598" TIME_SLOT_REF2="ts602">
                <ANNOTATION_VALUE>serving Kumis all day.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1615"
                TIME_SLOT_REF1="ts622" TIME_SLOT_REF2="ts626">
                <ANNOTATION_VALUE>Will you milk the cow?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1616"
                TIME_SLOT_REF1="ts628" TIME_SLOT_REF2="ts636">
                <ANNOTATION_VALUE>That's good.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1617"
                TIME_SLOT_REF1="ts640" TIME_SLOT_REF2="ts644">
                <ANNOTATION_VALUE>Do you only milk one cow?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1618"
                TIME_SLOT_REF1="ts654" TIME_SLOT_REF2="ts663">
                <ANNOTATION_VALUE>A long time ago, we went to a place called Tanbaly,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1619"
                TIME_SLOT_REF1="ts664" TIME_SLOT_REF2="ts670">
                <ANNOTATION_VALUE>there (somebody) bought the milk,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1620"
                TIME_SLOT_REF1="ts678" TIME_SLOT_REF2="ts687">
                <ANNOTATION_VALUE>with a car that collects the milk,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1621"
                TIME_SLOT_REF1="ts688" TIME_SLOT_REF2="ts696">
                <ANNOTATION_VALUE>it was interesting.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1622"
                TIME_SLOT_REF1="ts698" TIME_SLOT_REF2="ts705">
                <ANNOTATION_VALUE>We somehow waited it,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1623"
                TIME_SLOT_REF1="ts706" TIME_SLOT_REF2="ts712">
                <ANNOTATION_VALUE>running and saying "oh it arrives."  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1624"
                TIME_SLOT_REF1="ts714" TIME_SLOT_REF2="ts721">
                <ANNOTATION_VALUE>My parents took my brother and me to the summer pasture every year.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1625"
                TIME_SLOT_REF1="ts722" TIME_SLOT_REF2="ts730">
                <ANNOTATION_VALUE>I always cried and came back after some days.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1626"
                TIME_SLOT_REF1="ts740" TIME_SLOT_REF2="ts745">
                <ANNOTATION_VALUE>my parent took us there. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1627"
                TIME_SLOT_REF1="ts754" TIME_SLOT_REF2="ts758">
                <ANNOTATION_VALUE>Please eat. (Speaker A is giving Speaker B some chocolate)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1628"
                TIME_SLOT_REF1="ts770" TIME_SLOT_REF2="ts773">
                <ANNOTATION_VALUE>Just open one of them,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1629"
                TIME_SLOT_REF1="ts774" TIME_SLOT_REF2="ts778">
                <ANNOTATION_VALUE>let me first finish this.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1630"
                TIME_SLOT_REF1="ts792" TIME_SLOT_REF2="ts796">
                <ANNOTATION_VALUE>How much older are your brother and sister than you?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1631"
                TIME_SLOT_REF1="ts821" TIME_SLOT_REF2="ts826">
                <ANNOTATION_VALUE>Saying only?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1632"
                TIME_SLOT_REF1="ts836" TIME_SLOT_REF2="ts841">
                <ANNOTATION_VALUE>You are the youngest child in your family.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1633"
                TIME_SLOT_REF1="ts844" TIME_SLOT_REF2="ts846">
                <ANNOTATION_VALUE>It seems it is good to be the youngest child in a family, yes?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1634"
                TIME_SLOT_REF1="ts868" TIME_SLOT_REF2="ts874">
                <ANNOTATION_VALUE>Do they say they don't want to live with parents-in-law?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1635"
                TIME_SLOT_REF1="ts906" TIME_SLOT_REF2="ts912">
                <ANNOTATION_VALUE>No, it is strange,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1636"
                TIME_SLOT_REF1="ts914" TIME_SLOT_REF2="ts920">
                <ANNOTATION_VALUE>actually they can think about their own parents.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1637"
                TIME_SLOT_REF1="ts938" TIME_SLOT_REF2="ts944">
                <ANNOTATION_VALUE>Yes,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1638"
                TIME_SLOT_REF1="ts950" TIME_SLOT_REF2="ts953">
                <ANNOTATION_VALUE>No, think about it,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1639"
                TIME_SLOT_REF1="ts954" TIME_SLOT_REF2="ts957">
                <ANNOTATION_VALUE>for example,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1640"
                TIME_SLOT_REF1="ts958" TIME_SLOT_REF2="ts962">
                <ANNOTATION_VALUE>it may be strange to live with parents-in-law,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1641"
                TIME_SLOT_REF1="ts963" TIME_SLOT_REF2="ts967">
                <ANNOTATION_VALUE>but I have my own brother,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1642"
                TIME_SLOT_REF1="ts968" TIME_SLOT_REF2="ts972">
                <ANNOTATION_VALUE>and I just think if in the future - -  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1643"
                TIME_SLOT_REF1="ts988" TIME_SLOT_REF2="ts991">
                <ANNOTATION_VALUE>On the one hand,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1644"
                TIME_SLOT_REF1="ts992" TIME_SLOT_REF2="ts996">
                <ANNOTATION_VALUE>I think about my brother,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1645"
                TIME_SLOT_REF1="ts998" TIME_SLOT_REF2="ts1001">
                <ANNOTATION_VALUE>in the future, my parents,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1646"
                TIME_SLOT_REF1="ts1002" TIME_SLOT_REF2="ts1007">
                <ANNOTATION_VALUE>for example, the daughter-in-law says I don't live</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1647"
                TIME_SLOT_REF1="ts1008" TIME_SLOT_REF2="ts1011">
                <ANNOTATION_VALUE>and if my parents live alone,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1648"
                TIME_SLOT_REF1="ts1012" TIME_SLOT_REF2="ts1016">
                <ANNOTATION_VALUE>for example, they will get older,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1649"
                TIME_SLOT_REF1="ts1018" TIME_SLOT_REF2="ts1023">
                <ANNOTATION_VALUE>they raised us all the time,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1650"
                TIME_SLOT_REF1="ts1024" TIME_SLOT_REF2="ts1027">
                <ANNOTATION_VALUE>yes,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1651"
                TIME_SLOT_REF1="ts1028" TIME_SLOT_REF2="ts1031">
                <ANNOTATION_VALUE>if they are left alone,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1652"
                TIME_SLOT_REF1="ts1032" TIME_SLOT_REF2="ts1040">
                <ANNOTATION_VALUE> it is kind of pitiful.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1653"
                TIME_SLOT_REF1="ts1084" TIME_SLOT_REF2="ts1088">
                <ANNOTATION_VALUE>it is so good.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1654"
                TIME_SLOT_REF1="ts1100" TIME_SLOT_REF2="ts1106">
                <ANNOTATION_VALUE>Do they learn from you? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1655"
                TIME_SLOT_REF1="ts1150" TIME_SLOT_REF2="ts1154">
                <ANNOTATION_VALUE>Do they come and learn from you? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1656"
                TIME_SLOT_REF1="ts1159" TIME_SLOT_REF2="ts1164">
                <ANNOTATION_VALUE>Then it is so interesting, right?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1657"
                TIME_SLOT_REF1="ts1172" TIME_SLOT_REF2="ts1176">
                <ANNOTATION_VALUE>It is kind of tough, yes? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1658"
                TIME_SLOT_REF1="ts1262" TIME_SLOT_REF2="ts1275">
                <ANNOTATION_VALUE>You mean you are shy. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1659"
                TIME_SLOT_REF1="ts1276" TIME_SLOT_REF2="ts1281">
                <ANNOTATION_VALUE>Oh, it is not a shame,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1660"
                TIME_SLOT_REF1="ts1282" TIME_SLOT_REF2="ts1290">
                <ANNOTATION_VALUE>if you are helping your mother. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1661"
                TIME_SLOT_REF1="ts1318" TIME_SLOT_REF2="ts1328">
                <ANNOTATION_VALUE>You are mixing the flour.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1662"
                TIME_SLOT_REF1="ts1330" TIME_SLOT_REF2="ts1336">
                <ANNOTATION_VALUE>How old is your sister? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1663"
                TIME_SLOT_REF1="ts1340" TIME_SLOT_REF2="ts1344">
                <ANNOTATION_VALUE>Is she the oldest?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1664"
                TIME_SLOT_REF1="ts1368" TIME_SLOT_REF2="ts1375">
                <ANNOTATION_VALUE>we will feel comfort.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1665"
                TIME_SLOT_REF1="ts1378" TIME_SLOT_REF2="ts1402">
                <ANNOTATION_VALUE>no, instead you should let your sister rest and treat her as a guest.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1666"
                TIME_SLOT_REF1="ts1422" TIME_SLOT_REF2="ts1426">
                <ANNOTATION_VALUE>It is so good.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1667"
                TIME_SLOT_REF1="ts1430" TIME_SLOT_REF2="ts1439">
                <ANNOTATION_VALUE>I dreamed of having a sister when I was young.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1668"
                TIME_SLOT_REF1="ts1440" TIME_SLOT_REF2="ts1448">
                <ANNOTATION_VALUE>Actually there are no a lot of chores to do at home - washing dishes, cleaning up.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1669"
                TIME_SLOT_REF1="ts1493" TIME_SLOT_REF2="ts1498">
                <ANNOTATION_VALUE>Does she say there is a lot of dust?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1670"
                TIME_SLOT_REF1="ts1550" TIME_SLOT_REF2="ts1555">
                <ANNOTATION_VALUE>She may not come so frequently.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1671"
                TIME_SLOT_REF1="ts1556" TIME_SLOT_REF2="ts1566">
                <ANNOTATION_VALUE>When she finally come to her parents' house.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1672"
                TIME_SLOT_REF1="ts1578" TIME_SLOT_REF2="ts1587">
                <ANNOTATION_VALUE>You mean riding a house.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1673"
                TIME_SLOT_REF1="ts1601" TIME_SLOT_REF2="ts1611">
                <ANNOTATION_VALUE>Does she live in Togyztarau (a town in Xinjiang, in which Speaker A lives)?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1674"
                TIME_SLOT_REF1="ts1686" TIME_SLOT_REF2="ts1702">
                <ANNOTATION_VALUE>Your parents may tell you that they need a daughter-in-law.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1675"
                TIME_SLOT_REF1="ts1718" TIME_SLOT_REF2="ts1721">
                <ANNOTATION_VALUE>That,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1676"
                TIME_SLOT_REF1="ts1722" TIME_SLOT_REF2="ts1725">
                <ANNOTATION_VALUE>what I wanted to say,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1677"
                TIME_SLOT_REF1="ts1726" TIME_SLOT_REF2="ts1729">
                <ANNOTATION_VALUE>what does Togyztarau mean? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1678"
                TIME_SLOT_REF1="ts1730" TIME_SLOT_REF2="ts1734">
                <ANNOTATION_VALUE>So are there nine branches? (Toqyztarau is the name of a town, where "toqyz" means "nine" and "tarau" means "branch")</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1679"
                TIME_SLOT_REF1="ts1838" TIME_SLOT_REF2="ts1842">
                <ANNOTATION_VALUE>You mean it is located exactly in one пlace of Togyztarau.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1680"
                TIME_SLOT_REF1="ts1884" TIME_SLOT_REF2="ts1889">
                <ANNOTATION_VALUE>Mai gong she (пlace),</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1681"
                TIME_SLOT_REF1="ts1890" TIME_SLOT_REF2="ts1893">
                <ANNOTATION_VALUE>I think I know,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1682"
                TIME_SLOT_REF1="ts1894" TIME_SLOT_REF2="ts1898">
                <ANNOTATION_VALUE>yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
