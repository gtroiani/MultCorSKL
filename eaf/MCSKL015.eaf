    </TIER>
    <TIER LINGUISTIC_TYPE_REF="Translation" TIER_ID="trx_en@SPK1111">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a378"
                TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts31">
                <ANNOTATION_VALUE>Yes, we do,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a379"
                TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts49">
                <ANNOTATION_VALUE>we go there in one car,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a380"
                TIME_SLOT_REF1="ts50" TIME_SLOT_REF2="ts73">
                <ANNOTATION_VALUE>we even go for a day or two. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a381"
                TIME_SLOT_REF1="ts87" TIME_SLOT_REF2="ts98">
                <ANNOTATION_VALUE>summer pasture - -</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a382"
                TIME_SLOT_REF1="ts115" TIME_SLOT_REF2="ts128">
                <ANNOTATION_VALUE>yes summer - - </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a383"
                TIME_SLOT_REF1="ts145" TIME_SLOT_REF2="ts155">
                <ANNOTATION_VALUE>yes,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a384"
                TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts175">
                <ANNOTATION_VALUE>I grow up in summer pasture.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a385"
                TIME_SLOT_REF1="ts195" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>Yes, in the winter</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a386"
                TIME_SLOT_REF1="ts215" TIME_SLOT_REF2="ts223">
                <ANNOTATION_VALUE>we moved to our winter house,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a387"
                TIME_SLOT_REF1="ts227" TIME_SLOT_REF2="ts237">
                <ANNOTATION_VALUE>in the summer, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a388"
                TIME_SLOT_REF1="ts238" TIME_SLOT_REF2="ts251">
                <ANNOTATION_VALUE>that winter</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a389"
                TIME_SLOT_REF1="ts255" TIME_SLOT_REF2="ts263">
                <ANNOTATION_VALUE>winter - -</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a390"
                TIME_SLOT_REF1="ts264" TIME_SLOT_REF2="ts287">
                <ANNOTATION_VALUE>I stay in the summer pasture because of animals until the beginning of winter,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a391"
                TIME_SLOT_REF1="ts288" TIME_SLOT_REF2="ts301">
                <ANNOTATION_VALUE>(it is) enjoyable.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a392"
                TIME_SLOT_REF1="ts310" TIME_SLOT_REF2="ts323">
                <ANNOTATION_VALUE>You slaughter a sheep.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a393"
                TIME_SLOT_REF1="ts332" TIME_SLOT_REF2="ts347">
                <ANNOTATION_VALUE>On top of that, the summer pasture is close to us,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a394"
                TIME_SLOT_REF1="ts348" TIME_SLOT_REF2="ts379">
                <ANNOTATION_VALUE>you can get (there) in one and half hours with car.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a395"
                TIME_SLOT_REF1="ts387" TIME_SLOT_REF2="ts395">
                <ANNOTATION_VALUE>Shashy (the name of the pasture).</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a396"
                TIME_SLOT_REF1="ts401" TIME_SLOT_REF2="ts411">
                <ANNOTATION_VALUE>which you went.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a397"
                TIME_SLOT_REF1="ts435" TIME_SLOT_REF2="ts449">
                <ANNOTATION_VALUE>Yes,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a398"
                TIME_SLOT_REF1="ts450" TIME_SLOT_REF2="ts465">
                <ANNOTATION_VALUE>yes,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a399"
                TIME_SLOT_REF1="ts476" TIME_SLOT_REF2="ts501">
                <ANNOTATION_VALUE>the road is asphalt,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a400"
                TIME_SLOT_REF1="ts502" TIME_SLOT_REF2="ts519">
                <ANNOTATION_VALUE>it is asphalt until our house,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a401"
                TIME_SLOT_REF1="ts526" TIME_SLOT_REF2="ts537">
                <ANNOTATION_VALUE>cars can get there. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a402"
                TIME_SLOT_REF1="ts541" TIME_SLOT_REF2="ts549">
                <ANNOTATION_VALUE>You just come,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a403"
                TIME_SLOT_REF1="ts553" TIME_SLOT_REF2="ts567">
                <ANNOTATION_VALUE>and fill up your car.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a404"
                TIME_SLOT_REF1="ts579" TIME_SLOT_REF2="ts591">
                <ANNOTATION_VALUE>On top of that,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a405"
                TIME_SLOT_REF1="ts592" TIME_SLOT_REF2="ts607">
                <ANNOTATION_VALUE>there are resorts near us,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a406"
                TIME_SLOT_REF1="ts608" TIME_SLOT_REF2="ts631">
                <ANNOTATION_VALUE>no car is allowed beyond us.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a407"
                TIME_SLOT_REF1="ts647" TIME_SLOT_REF2="ts655">
                <ANNOTATION_VALUE>No,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a408"
                TIME_SLOT_REF1="ts659" TIME_SLOT_REF2="ts681">
                <ANNOTATION_VALUE>we don't treat the guests.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a409"
                TIME_SLOT_REF1="ts693" TIME_SLOT_REF2="ts713">
                <ANNOTATION_VALUE>They earn a lot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a410"
                TIME_SLOT_REF1="ts727" TIME_SLOT_REF2="ts737">
                <ANNOTATION_VALUE>Yes,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a411"
                TIME_SLOT_REF1="ts753" TIME_SLOT_REF2="ts791">
                <ANNOTATION_VALUE>but we do not want to serve others,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a412"
                TIME_SLOT_REF1="ts792" TIME_SLOT_REF2="ts817">
                <ANNOTATION_VALUE>we all are this kind of (disobidient) person.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a413"
                TIME_SLOT_REF1="ts826" TIME_SLOT_REF2="ts847">
                <ANNOTATION_VALUE>So we do not to want to be watchful.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a414"
