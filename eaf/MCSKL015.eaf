        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a699"
                TIME_SLOT_REF1="ts2539" TIME_SLOT_REF2="ts2545">
                <ANNOTATION_VALUE>You can go to the wedding in the evening.</ANNOTATION_VALUE>
