        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1718"
                TIME_SLOT_REF1="ts2496" TIME_SLOT_REF2="ts2500">
                <ANNOTATION_VALUE>You mean it is fast to go and return. </ANNOTATION_VALUE>
