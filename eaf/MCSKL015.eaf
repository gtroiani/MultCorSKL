                <ANNOTATION_VALUE>Simпle.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1694"
                TIME_SLOT_REF1="ts6814" TIME_SLOT_REF2="ts6837">
                <ANNOTATION_VALUE>You mean they are wild. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1695"
                TIME_SLOT_REF1="ts7004" TIME_SLOT_REF2="ts7011">
                <ANNOTATION_VALUE>From Nileke,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1696"
                TIME_SLOT_REF1="ts7012" TIME_SLOT_REF2="ts7023">
                <ANNOTATION_VALUE>oh, I mean not Nileke,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1697"
                TIME_SLOT_REF1="ts7024" TIME_SLOT_REF2="ts7038">
                <ANNOTATION_VALUE>How long is the drive from Kuldja?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1698"
                TIME_SLOT_REF1="ts7053" TIME_SLOT_REF2="ts7069">
                <ANNOTATION_VALUE>It is not so far from Nileke,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1699"
                TIME_SLOT_REF1="ts7073" TIME_SLOT_REF2="ts7083">
                <ANNOTATION_VALUE>two to three hours,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1700"
                TIME_SLOT_REF1="ts7084" TIME_SLOT_REF2="ts7089">
                <ANNOTATION_VALUE>yes?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1701"
                TIME_SLOT_REF1="ts7145" TIME_SLOT_REF2="ts7173">
                <ANNOTATION_VALUE>It is a close пlace just next to it.</ANNOTATION_VALUE>
