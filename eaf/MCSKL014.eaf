        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a799"
                TIME_SLOT_REF1="ts2402" TIME_SLOT_REF2="ts2403">
                <ANNOTATION_VALUE>күнделікті ішетін менің,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a800"
                TIME_SLOT_REF1="ts2404" TIME_SLOT_REF2="ts2405">
                <ANNOTATION_VALUE>аяғым ауырға-,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a801"
                TIME_SLOT_REF1="ts2406" TIME_SLOT_REF2="ts2407">
