            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a828"
                TIME_SLOT_REF1="ts2495" TIME_SLOT_REF2="ts2497">
