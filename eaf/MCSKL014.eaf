        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1317"
                TIME_SLOT_REF1="ts2434" TIME_SLOT_REF2="ts2437">
                <ANNOTATION_VALUE>I am living on medication...</ANNOTATION_VALUE>
