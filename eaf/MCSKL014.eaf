        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a792"
                TIME_SLOT_REF1="ts2384" TIME_SLOT_REF2="ts2387">
                <ANNOTATION_VALUE>неше түрлі бар ғой.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a794"
                TIME_SLOT_REF1="ts2391" TIME_SLOT_REF2="ts2393">
                <ANNOTATION_VALUE>Иә,</ANNOTATION_VALUE>
