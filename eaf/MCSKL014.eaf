        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1316"
                TIME_SLOT_REF1="ts2428" TIME_SLOT_REF2="ts2432">
                <ANNOTATION_VALUE>Why do you think I do not take it?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
