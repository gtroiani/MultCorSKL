            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a802"
                TIME_SLOT_REF1="ts2408" TIME_SLOT_REF2="ts2409">
                <ANNOTATION_VALUE>Пачкалеп алғанмын.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a807"
                TIME_SLOT_REF1="ts2413" TIME_SLOT_REF2="ts2417">
                <ANNOTATION_VALUE>Неге мама мен,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a808"
                TIME_SLOT_REF1="ts2418" TIME_SLOT_REF2="ts2421">
                <ANNOTATION_VALUE>Мен өзім ішетін дәрілеріме апарып,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a809"
                TIME_SLOT_REF1="ts2422" TIME_SLOT_REF2="ts2425">
                <ANNOTATION_VALUE>қосып жүрмін ғой.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a810"
                TIME_SLOT_REF1="ts2427" TIME_SLOT_REF2="ts2431">
                <ANNOTATION_VALUE>Неге ішпеймін мен.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a811"
                TIME_SLOT_REF1="ts2433" TIME_SLOT_REF2="ts2435">
                <ANNOTATION_VALUE>Дәрімен қана,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a812"
                TIME_SLOT_REF1="ts2436" TIME_SLOT_REF2="ts2438">
