        </ANNOTATION>
    </TIER>
    <TIER LINGUISTIC_TYPE_REF="Translation" TIER_ID="trx_en@SPK0032">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a871"
                TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts6">
                <ANNOTATION_VALUE>This is how I get a massage done on me. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a872"
                TIME_SLOT_REF1="ts8" TIME_SLOT_REF2="ts11">
                <ANNOTATION_VALUE>You know your father says...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a874"
                TIME_SLOT_REF1="ts20" TIME_SLOT_REF2="ts22">
                <ANNOTATION_VALUE>To the horse...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a875"
                TIME_SLOT_REF1="ts24" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>...they did that thing..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a876"
                TIME_SLOT_REF1="ts28" TIME_SLOT_REF2="ts31">
                <ANNOTATION_VALUE>Should I sit like this?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a877"
                TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>Should I sit like this?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a879"
                TIME_SLOT_REF1="ts38" TIME_SLOT_REF2="ts42">
                <ANNOTATION_VALUE>Okay.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a880"
                TIME_SLOT_REF1="ts44" TIME_SLOT_REF2="ts48">
                <ANNOTATION_VALUE>[He would say:] "what are you doing like a horse that is suffocating?" </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a881"
                TIME_SLOT_REF1="ts50" TIME_SLOT_REF2="ts54">
                <ANNOTATION_VALUE>I should take this off, right?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a882"
                TIME_SLOT_REF1="ts66" TIME_SLOT_REF2="ts70">
                <ANNOTATION_VALUE>Let me take off the robe. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a886"
                TIME_SLOT_REF1="ts72" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>Let me take it off, okay?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a897"
                TIME_SLOT_REF1="ts136" TIME_SLOT_REF2="ts152">
                <ANNOTATION_VALUE>I beg you guys please do not take that little boy everywhere casually...you will get him jinxed...I mean Bakonay. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a899"
                TIME_SLOT_REF1="ts160" TIME_SLOT_REF2="ts164">
                <ANNOTATION_VALUE>That little boy went out wearing his jacket... oh my little boy! </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a901"
                TIME_SLOT_REF1="ts166" TIME_SLOT_REF2="ts168">
                <ANNOTATION_VALUE>They took him hugging.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a912"
                TIME_SLOT_REF1="ts234" TIME_SLOT_REF2="ts240">
                <ANNOTATION_VALUE>Oh God!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a922"
                TIME_SLOT_REF1="ts272" TIME_SLOT_REF2="ts282">
                <ANNOTATION_VALUE>Nazgul.. I think I add some weight...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a924"
                TIME_SLOT_REF1="ts284" TIME_SLOT_REF2="ts291">
                <ANNOTATION_VALUE>I looked at Ayazhan, and she is also big, which is good.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a926"
                TIME_SLOT_REF1="ts296" TIME_SLOT_REF2="ts300">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a928"
                TIME_SLOT_REF1="ts304" TIME_SLOT_REF2="ts308">
                <ANNOTATION_VALUE>How can I possibly know...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a929"
                TIME_SLOT_REF1="ts310" TIME_SLOT_REF2="ts312">
                <ANNOTATION_VALUE>That's what I thought.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a930"
                TIME_SLOT_REF1="ts314" TIME_SLOT_REF2="ts317">
                <ANNOTATION_VALUE>But the other day...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a931"
                TIME_SLOT_REF1="ts318" TIME_SLOT_REF2="ts321">
                <ANNOTATION_VALUE>when I was in the hospital...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a932"
                TIME_SLOT_REF1="ts322" TIME_SLOT_REF2="ts324">
                <ANNOTATION_VALUE>I weighed only 67 kgs.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a933"
                TIME_SLOT_REF1="ts330" TIME_SLOT_REF2="ts336">
                <ANNOTATION_VALUE>You know they weighed me when we were about to enter.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a934"
                TIME_SLOT_REF1="ts340" TIME_SLOT_REF2="ts342">
                <ANNOTATION_VALUE>Apparently they weigh you there first.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a937"
                TIME_SLOT_REF1="ts344" TIME_SLOT_REF2="ts348">
                <ANNOTATION_VALUE>So they said 67... </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a938"
                TIME_SLOT_REF1="ts350" TIME_SLOT_REF2="ts354">
                <ANNOTATION_VALUE>They said my clothes weighed half a kg. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a939"
                TIME_SLOT_REF1="ts358" TIME_SLOT_REF2="ts368">
                <ANNOTATION_VALUE>They apparently remove that. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a941"
                TIME_SLOT_REF1="ts372" TIME_SLOT_REF2="ts378">
                <ANNOTATION_VALUE>In that place called reception. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a946"
                TIME_SLOT_REF1="ts396" TIME_SLOT_REF2="ts404">
                <ANNOTATION_VALUE>I got fat like a bag..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a947"
                TIME_SLOT_REF1="ts406" TIME_SLOT_REF2="ts409">
                <ANNOTATION_VALUE>God save...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a953"
                TIME_SLOT_REF1="ts450" TIME_SLOT_REF2="ts455">
                <ANNOTATION_VALUE>No... I mean...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a959"
                TIME_SLOT_REF1="ts464" TIME_SLOT_REF2="ts474">
                <ANNOTATION_VALUE>I am not saying I am thin. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a960"
                TIME_SLOT_REF1="ts478" TIME_SLOT_REF2="ts486">
                <ANNOTATION_VALUE>That's what I am saying... I wish I do not do that...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a963"
                TIME_SLOT_REF1="ts496" TIME_SLOT_REF2="ts503">
                <ANNOTATION_VALUE>I wish I do not add weight. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a965"
                TIME_SLOT_REF1="ts507" TIME_SLOT_REF2="ts518">
                <ANNOTATION_VALUE> My bones are heavy.. but the other day whey I was being checked at the hospital I was only 67 kg.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a966"
                TIME_SLOT_REF1="ts520" TIME_SLOT_REF2="ts522">
                <ANNOTATION_VALUE>You know when they put me on the scales?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a967"
                TIME_SLOT_REF1="ts524" TIME_SLOT_REF2="ts528">
                <ANNOTATION_VALUE>When I was checked prior to being hospitalized. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a968"
                TIME_SLOT_REF1="ts530" TIME_SLOT_REF2="ts542">
                <ANNOTATION_VALUE>I said: "Dearie, my bones are heavy and I barely can move myself." </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a980"
                TIME_SLOT_REF1="ts620" TIME_SLOT_REF2="ts624">
                <ANNOTATION_VALUE>Akosh says that Raikhan was hospitalized yesterday. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a981"
                TIME_SLOT_REF1="ts626" TIME_SLOT_REF2="ts628">
                <ANNOTATION_VALUE>On Monday...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a982"
                TIME_SLOT_REF1="ts634" TIME_SLOT_REF2="ts638">
                <ANNOTATION_VALUE>Raikhan, apparently.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a984"
                TIME_SLOT_REF1="ts642" TIME_SLOT_REF2="ts646">
                <ANNOTATION_VALUE>Akosh says so.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a985"
                TIME_SLOT_REF1="ts656" TIME_SLOT_REF2="ts658">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a987"
