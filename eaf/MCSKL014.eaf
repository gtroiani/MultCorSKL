            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a813"
                TIME_SLOT_REF1="ts2439" TIME_SLOT_REF2="ts2441">
                <ANNOTATION_VALUE>¬Ырыс ұқсап айтып қояйын,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a814"
                TIME_SLOT_REF1="ts2442" TIME_SLOT_REF2="ts2443">
                <ANNOTATION_VALUE>дәрімен жүр емеспін бе мен.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a827"
                TIME_SLOT_REF1="ts2480" TIME_SLOT_REF2="ts2485">
