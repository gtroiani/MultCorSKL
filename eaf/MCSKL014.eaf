        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1313"
                TIME_SLOT_REF1="ts2398" TIME_SLOT_REF2="ts2410">
                <ANNOTATION_VALUE>This is aertal...the one I drink everyday..when my legs hurt... I bought it in packages.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1314"
                TIME_SLOT_REF1="ts2414" TIME_SLOT_REF2="ts2426">
                <ANNOTATION_VALUE>What? No, I do. I take it and add it to the other drugs that I take. </ANNOTATION_VALUE>
