        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19888" TIME_SLOT_REF1="ts1702" TIME_SLOT_REF2="ts1706">
                <ANNOTATION_VALUE>So [at that time] there is no sun in Almaty.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19889" TIME_SLOT_REF1="ts1708" TIME_SLOT_REF2="ts1716">
