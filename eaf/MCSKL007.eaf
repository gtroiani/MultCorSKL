        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19864" TIME_SLOT_REF1="ts1590" TIME_SLOT_REF2="ts1592">
                <ANNOTATION_VALUE>Depending on the how the sunset. Does the sun go up like this and then go back like this afterwards?</ANNOTATION_VALUE>
