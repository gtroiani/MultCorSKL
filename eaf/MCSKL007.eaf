    <TIER LINGUISTIC_TYPE_REF="Translation"  TIER_ID="trx_en@SPK0017">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19671" TIME_SLOT_REF1="ts4" TIME_SLOT_REF2="ts14">
                <ANNOTATION_VALUE>After Tian Shan there is Alatau [in terms of height].</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19672" TIME_SLOT_REF1="ts40" TIME_SLOT_REF2="ts42">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19673" TIME_SLOT_REF1="ts44" TIME_SLOT_REF2="ts49">
                <ANNOTATION_VALUE>The mountain in Tarbagatai is actually a ridge.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19674" TIME_SLOT_REF1="ts50" TIME_SLOT_REF2="ts53">
                <ANNOTATION_VALUE>It goes all the way before joining...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19675" TIME_SLOT_REF1="ts56" TIME_SLOT_REF2="ts58">
                <ANNOTATION_VALUE>the Alatau mountains in Almaty.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19676" TIME_SLOT_REF1="ts84" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>The other time ###...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19677" TIME_SLOT_REF1="ts92" TIME_SLOT_REF2="ts95">
                <ANNOTATION_VALUE>There are also rocks in Alatau ###.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19678" TIME_SLOT_REF1="ts96" TIME_SLOT_REF2="ts98">
                <ANNOTATION_VALUE>They just did not see all of the mountain. They only were on the reachable side of the mountain.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19679" TIME_SLOT_REF1="ts100" TIME_SLOT_REF2="ts102">
                <ANNOTATION_VALUE>Many do not go any farther than that.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19680" TIME_SLOT_REF1="ts104" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>They really do not know and ###.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19681" TIME_SLOT_REF1="ts108" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>When I was in Oral,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19682" TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts116">
                <ANNOTATION_VALUE>one guy suggested that we go to some village here in Kazakhstan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19684" TIME_SLOT_REF1="ts118" TIME_SLOT_REF2="ts120">
                <ANNOTATION_VALUE>He said there is a frige that needs to be brought.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19685" TIME_SLOT_REF1="ts122" TIME_SLOT_REF2="ts128">
                <ANNOTATION_VALUE>All the houses and the land was ##.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19686" TIME_SLOT_REF1="ts130" TIME_SLOT_REF2="ts132">
                <ANNOTATION_VALUE>We were driving and he shouts, saying ####.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19687" TIME_SLOT_REF1="ts134" TIME_SLOT_REF2="ts136">
                <ANNOTATION_VALUE>I was inside a jeep.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19688" TIME_SLOT_REF1="ts138" TIME_SLOT_REF2="ts140">
                <ANNOTATION_VALUE>The village ###.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19689" TIME_SLOT_REF1="ts142" TIME_SLOT_REF2="ts145">
                <ANNOTATION_VALUE>We took the fridge and loaded onto the car.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19690" TIME_SLOT_REF1="ts146" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>After that we were driving back and I asked:</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19691" TIME_SLOT_REF1="ts150" TIME_SLOT_REF2="ts152">
                <ANNOTATION_VALUE>where are your mountains? (where are the mountains that you told me would be here?)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19692" TIME_SLOT_REF1="ts154" TIME_SLOT_REF2="ts157">
                <ANNOTATION_VALUE>He said, "Didn't you see?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19693" TIME_SLOT_REF1="ts158" TIME_SLOT_REF2="ts160">
                <ANNOTATION_VALUE>I said I did not.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19694" TIME_SLOT_REF1="ts162" TIME_SLOT_REF2="ts164">
                <ANNOTATION_VALUE>He said were would go down the ###.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19695" TIME_SLOT_REF1="ts168" TIME_SLOT_REF2="ts171">
                <ANNOTATION_VALUE>I was like "nah, okay'.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19696" TIME_SLOT_REF1="ts172" TIME_SLOT_REF2="ts178">
                <ANNOTATION_VALUE>We were driving and driving, and I asked where the mountain was again.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19698" TIME_SLOT_REF1="ts180" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>He said we had already passed by it and asked me whether I did not notice the mountains.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19699" TIME_SLOT_REF1="ts184" TIME_SLOT_REF2="ts186">
                <ANNOTATION_VALUE>There was a straight mountain, he said.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19700" TIME_SLOT_REF1="ts188" TIME_SLOT_REF2="ts190">
                <ANNOTATION_VALUE>(TSK)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19701" TIME_SLOT_REF1="ts192" TIME_SLOT_REF2="ts194">
                <ANNOTATION_VALUE>I asked where he saw it at.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19702" TIME_SLOT_REF1="ts196" TIME_SLOT_REF2="ts198">
                <ANNOTATION_VALUE>Ah,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19703" TIME_SLOT_REF1="ts200" TIME_SLOT_REF2="ts204">
                <ANNOTATION_VALUE>it turns out that he was talking about the ridge like this which ###.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19704" TIME_SLOT_REF1="ts206" TIME_SLOT_REF2="ts208">
                <ANNOTATION_VALUE>It was a ridge.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19705" TIME_SLOT_REF1="ts210" TIME_SLOT_REF2="ts216">
                <ANNOTATION_VALUE>Then..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19706" TIME_SLOT_REF1="ts218" TIME_SLOT_REF2="ts223">
                <ANNOTATION_VALUE>such a small...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19707" TIME_SLOT_REF1="ts224" TIME_SLOT_REF2="ts228">
                <ANNOTATION_VALUE>##.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19708" TIME_SLOT_REF1="ts234" TIME_SLOT_REF2="ts240">
                <ANNOTATION_VALUE>Nope, I am full, thanks.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19709" TIME_SLOT_REF1="ts242" TIME_SLOT_REF2="ts248">
                <ANNOTATION_VALUE>Nope, we are not having any more coffee.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19710" TIME_SLOT_REF1="ts250" TIME_SLOT_REF2="ts256">
                <ANNOTATION_VALUE>No, they said "it is a biiiiiggg mountain".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19711" TIME_SLOT_REF1="ts264" TIME_SLOT_REF2="ts266">
                <ANNOTATION_VALUE>But in Kokshetau...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19712" TIME_SLOT_REF1="ts268" TIME_SLOT_REF2="ts272">
                <ANNOTATION_VALUE>everyone has houses built from the blue stone. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19714" TIME_SLOT_REF1="ts278" TIME_SLOT_REF2="ts281">
                <ANNOTATION_VALUE>There is no single stone.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19715" TIME_SLOT_REF1="ts282" TIME_SLOT_REF2="ts284">
                <ANNOTATION_VALUE>Oh no, I mean there is no single mountain.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19716" TIME_SLOT_REF1="ts288" TIME_SLOT_REF2="ts292">
                <ANNOTATION_VALUE>Just an endless steppe.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19717" TIME_SLOT_REF1="ts294" TIME_SLOT_REF2="ts298">
                <ANNOTATION_VALUE>I do not know ###.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19718" TIME_SLOT_REF1="ts302" TIME_SLOT_REF2="ts310">
                <ANNOTATION_VALUE>The entire village and the center of the region were built there.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19720" TIME_SLOT_REF1="ts312" TIME_SLOT_REF2="ts322">
                <ANNOTATION_VALUE>Where we are from there are blue stones that ###.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19722" TIME_SLOT_REF1="ts332" TIME_SLOT_REF2="ts334">
                <ANNOTATION_VALUE>Yes exactly.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19723" TIME_SLOT_REF1="ts335" TIME_SLOT_REF2="ts339">
                <ANNOTATION_VALUE>(SNIFFS_LOUDLY)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19724" TIME_SLOT_REF1="ts344" TIME_SLOT_REF2="ts348">
                <ANNOTATION_VALUE>Well, I've seen from many people in different place what they have.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19725" TIME_SLOT_REF1="ts350" TIME_SLOT_REF2="ts356">
                <ANNOTATION_VALUE>But you know what...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19726" TIME_SLOT_REF1="ts358" TIME_SLOT_REF2="ts360">
                <ANNOTATION_VALUE>It is all just sand.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19727" TIME_SLOT_REF1="ts366" TIME_SLOT_REF2="ts368">
                <ANNOTATION_VALUE>It is fertile.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19728" TIME_SLOT_REF1="ts370" TIME_SLOT_REF2="ts372">
                <ANNOTATION_VALUE>People grow food.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19729" TIME_SLOT_REF1="ts374" TIME_SLOT_REF2="ts378">
                <ANNOTATION_VALUE>Marmots are everywhere on the surface of the land.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19731" TIME_SLOT_REF1="ts382" TIME_SLOT_REF2="ts386">
                <ANNOTATION_VALUE>Where did they put the rock, I wonder.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19732" TIME_SLOT_REF1="ts388" TIME_SLOT_REF2="ts392">
                <ANNOTATION_VALUE>But because it is cold inside such houses they plastered the inside of the houses.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19734" TIME_SLOT_REF1="ts404" TIME_SLOT_REF2="ts410">
                <ANNOTATION_VALUE>But they say in winter it is warm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19735" TIME_SLOT_REF1="ts414" TIME_SLOT_REF2="ts420">
                <ANNOTATION_VALUE>When in winter you burn firewoord; these stones, after the house heats up, will hold the heat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19738" TIME_SLOT_REF1="ts432" TIME_SLOT_REF2="ts434">
                <ANNOTATION_VALUE>##.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19739" TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts472">
                <ANNOTATION_VALUE>What's they got in there?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19740" TIME_SLOT_REF1="ts474" TIME_SLOT_REF2="ts480">
                <ANNOTATION_VALUE>What's it got here?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19741" TIME_SLOT_REF1="ts486" TIME_SLOT_REF2="ts488">
                <ANNOTATION_VALUE>What's they got in there?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19742" TIME_SLOT_REF1="ts496" TIME_SLOT_REF2="ts498">
                <ANNOTATION_VALUE>No, I am asking what they have in there.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19743" TIME_SLOT_REF1="ts512" TIME_SLOT_REF2="ts516">
                <ANNOTATION_VALUE>Oh, God, it is just what people loitering around do - visit such places.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19744" TIME_SLOT_REF1="ts580" TIME_SLOT_REF2="ts582">
                <ANNOTATION_VALUE>There is simply no cattle, that is why.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19745" TIME_SLOT_REF1="ts586" TIME_SLOT_REF2="ts591">
                <ANNOTATION_VALUE>There is no cattle.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19746" TIME_SLOT_REF1="ts592" TIME_SLOT_REF2="ts596">
                <ANNOTATION_VALUE>No cattle.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19747" TIME_SLOT_REF1="ts606" TIME_SLOT_REF2="ts614">
                <ANNOTATION_VALUE>###############.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19748" TIME_SLOT_REF1="ts616" TIME_SLOT_REF2="ts618">
                <ANNOTATION_VALUE>No, people say they have reacher other places as well.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19749" TIME_SLOT_REF1="ts620" TIME_SLOT_REF2="ts622">
                <ANNOTATION_VALUE>In Gornyi,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19750" TIME_SLOT_REF1="ts624" TIME_SLOT_REF2="ts628">
                <ANNOTATION_VALUE>and in ####, mosquitos started appearing as well these days.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19751" TIME_SLOT_REF1="ts636" TIME_SLOT_REF2="ts638">
                <ANNOTATION_VALUE>Ее.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19752" TIME_SLOT_REF1="ts674" TIME_SLOT_REF2="ts680">
                <ANNOTATION_VALUE>They both have mosquitos there.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19753" TIME_SLOT_REF1="ts682" TIME_SLOT_REF2="ts686">
                <ANNOTATION_VALUE>There are mosquitos in Boran and Monekey.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19754" TIME_SLOT_REF1="ts690" TIME_SLOT_REF2="ts694">
                <ANNOTATION_VALUE>There are also mosquitos in Kurshim.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19755" TIME_SLOT_REF1="ts698" TIME_SLOT_REF2="ts702">
                <ANNOTATION_VALUE>Because there is water.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19756" TIME_SLOT_REF1="ts704" TIME_SLOT_REF2="ts710">
                <ANNOTATION_VALUE>There is no water in Kurshim and Tarbagatay.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19757" TIME_SLOT_REF1="ts712" TIME_SLOT_REF2="ts716">
                <ANNOTATION_VALUE>It is just that our Kalzhyr and Ertis are all ###.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19758" TIME_SLOT_REF1="ts718" TIME_SLOT_REF2="ts722">
                <ANNOTATION_VALUE>They are sitting on just water.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19759" TIME_SLOT_REF1="ts724" TIME_SLOT_REF2="ts726">
                <ANNOTATION_VALUE>####.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19760" TIME_SLOT_REF1="ts728" TIME_SLOT_REF2="ts732">
                <ANNOTATION_VALUE>In where we are, there is no water. It is just dry steppe.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19761" TIME_SLOT_REF1="ts734" TIME_SLOT_REF2="ts740">
                <ANNOTATION_VALUE>Everything is growing thanks to rainwater.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19762" TIME_SLOT_REF1="ts742" TIME_SLOT_REF2="ts746">
                <ANNOTATION_VALUE>It is all rain.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19763" TIME_SLOT_REF1="ts748" TIME_SLOT_REF2="ts753">
                <ANNOTATION_VALUE>Right.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19764" TIME_SLOT_REF1="ts754" TIME_SLOT_REF2="ts762">
                <ANNOTATION_VALUE>There are some in Zaysan's lower hemline closer to us as well.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19765" TIME_SLOT_REF1="ts764" TIME_SLOT_REF2="ts768">
                <ANNOTATION_VALUE>Арғы жағында жоқ тау жағында.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19766" TIME_SLOT_REF1="ts776" TIME_SLOT_REF2="ts782">
                <ANNOTATION_VALUE>In where we are from, the grass grows very thick and dense.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19767" TIME_SLOT_REF1="ts784" TIME_SLOT_REF2="ts788">
                <ANNOTATION_VALUE>And there is mosquitos' larve there ####.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19768" TIME_SLOT_REF1="ts790" TIME_SLOT_REF2="ts796">
                <ANNOTATION_VALUE>Lots of larva.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19769" TIME_SLOT_REF1="ts798" TIME_SLOT_REF2="ts800">
                <ANNOTATION_VALUE>In the past, when the land would start becoming greener in the beginning of spring, the cattle would trample the larva in the grass and kill them.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19770" TIME_SLOT_REF1="ts802" TIME_SLOT_REF2="ts804">
                <ANNOTATION_VALUE>And the mosquitos would decrease in number and die.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19771" TIME_SLOT_REF1="ts806" TIME_SLOT_REF2="ts808">
                <ANNOTATION_VALUE>But there is not a lot of cattle now.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19772" TIME_SLOT_REF1="ts810" TIME_SLOT_REF2="ts812">
                <ANNOTATION_VALUE>It is just endless steppe.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19773" TIME_SLOT_REF1="ts814" TIME_SLOT_REF2="ts816">
                <ANNOTATION_VALUE>Did you notice more and more people do not breed sheep anymore. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19774" TIME_SLOT_REF1="ts820" TIME_SLOT_REF2="ts826">
                <ANNOTATION_VALUE>Everyone is crazy about horses.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19775" TIME_SLOT_REF1="ts828" TIME_SLOT_REF2="ts834">
                <ANNOTATION_VALUE>If you go to Tarbagatay and Zaysan and ask the guys there,  they will say "I have 700 hundred horses...1500 horses...2000 horses....2500 horses, and</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19777" TIME_SLOT_REF1="ts836" TIME_SLOT_REF2="ts838">
                <ANNOTATION_VALUE>I have very few cows".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19778" TIME_SLOT_REF1="ts840" TIME_SLOT_REF2="ts848">
                <ANNOTATION_VALUE>So people do not see sheep and cows as cattle anymore; they changed their businesses and are doing business with horses.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19779" TIME_SLOT_REF1="ts850" TIME_SLOT_REF2="ts854">
                <ANNOTATION_VALUE>If a cow costs 200 thousand tenges,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19780" TIME_SLOT_REF1="ts856" TIME_SLOT_REF2="ts859">
                <ANNOTATION_VALUE>one horse coses a thousand dollars</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19781" TIME_SLOT_REF1="ts860" TIME_SLOT_REF2="ts864">
                <ANNOTATION_VALUE>and the price goes up to 420-450 thousand tenges.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19782" TIME_SLOT_REF1="ts866" TIME_SLOT_REF2="ts870">
                <ANNOTATION_VALUE>Mhm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19783" TIME_SLOT_REF1="ts924" TIME_SLOT_REF2="ts926">
                <ANNOTATION_VALUE>No, Zhuldyz.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19784" TIME_SLOT_REF1="ts930" TIME_SLOT_REF2="ts934">
                <ANNOTATION_VALUE>The era, the time neves changes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19785" TIME_SLOT_REF1="ts938" TIME_SLOT_REF2="ts944">
                <ANNOTATION_VALUE>Time stands at its place.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19786" TIME_SLOT_REF1="ts948" TIME_SLOT_REF2="ts955">
                <ANNOTATION_VALUE>The sun comes out.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19787" TIME_SLOT_REF1="ts956" TIME_SLOT_REF2="ts958">
                <ANNOTATION_VALUE>The sun comes out and the sun goes down - this is what an era/epoch/time is.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19788" TIME_SLOT_REF1="ts960" TIME_SLOT_REF2="ts964">
                <ANNOTATION_VALUE>The moon comes out and the moon goes down.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19789" TIME_SLOT_REF1="ts966" TIME_SLOT_REF2="ts968">
                <ANNOTATION_VALUE>It rains.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19790" TIME_SLOT_REF1="ts970" TIME_SLOT_REF2="ts974">
                <ANNOTATION_VALUE>It snows.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19791" TIME_SLOT_REF1="ts976" TIME_SLOT_REF2="ts979">
                <ANNOTATION_VALUE>That is what climate is.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19792" TIME_SLOT_REF1="ts980" TIME_SLOT_REF2="ts984">
                <ANNOTATION_VALUE>It changes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19793" TIME_SLOT_REF1="ts988" TIME_SLOT_REF2="ts990">
                <ANNOTATION_VALUE>Time/era does not change; it is the people who change.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19794" TIME_SLOT_REF1="ts992" TIME_SLOT_REF2="ts994">
                <ANNOTATION_VALUE>People's intent changes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19795" TIME_SLOT_REF1="ts996" TIME_SLOT_REF2="ts998">
                <ANNOTATION_VALUE>Their cognitive abilities.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19796" TIME_SLOT_REF1="ts1000" TIME_SLOT_REF2="ts1002">
                <ANNOTATION_VALUE>If you look at them now, if you compare their consciousness to ours...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19797" TIME_SLOT_REF1="ts1004" TIME_SLOT_REF2="ts1006">
                <ANNOTATION_VALUE>Just look at these kids...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19798" TIME_SLOT_REF1="ts1008" TIME_SLOT_REF2="ts1010">
                <ANNOTATION_VALUE>Zhanar's children's brain will be even more different.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19799" TIME_SLOT_REF1="ts1012" TIME_SLOT_REF2="ts1018">
                <ANNOTATION_VALUE>Her child's children's brain will be even more different than hers.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19800" TIME_SLOT_REF1="ts1026" TIME_SLOT_REF2="ts1030">
                <ANNOTATION_VALUE>And plus, what they think and do is so crazy.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19801" TIME_SLOT_REF1="ts1032" TIME_SLOT_REF2="ts1034">
                <ANNOTATION_VALUE>They say and so crazy stuff.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19802" TIME_SLOT_REF1="ts1036" TIME_SLOT_REF2="ts1048">
                <ANNOTATION_VALUE>If you compare them with us, we look backward for them as if we are those first people that inhabitated the Earth when it was first created.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19804" TIME_SLOT_REF1="ts1050" TIME_SLOT_REF2="ts1054">
                <ANNOTATION_VALUE>They have a different worldview.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19805" TIME_SLOT_REF1="ts1058" TIME_SLOT_REF2="ts1060">
                <ANNOTATION_VALUE>In short...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19806" TIME_SLOT_REF1="ts1064" TIME_SLOT_REF2="ts1066">
                <ANNOTATION_VALUE>#.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19807" TIME_SLOT_REF1="ts1088" TIME_SLOT_REF2="ts1096">
                <ANNOTATION_VALUE>We say so.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19808" TIME_SLOT_REF1="ts1098" TIME_SLOT_REF2="ts1112">
                <ANNOTATION_VALUE>Zhuldyz, did you notice that it is just that we think so like those old people you were talked about used to think, saying "I am still that way".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19811" TIME_SLOT_REF1="ts1114" TIME_SLOT_REF2="ts1132">
                <ANNOTATION_VALUE>But if you just go anywhere, people will say "sit down, please sit down". It such cases I feel so uncomfortable becaue I think I am yonger than the person offering me a seat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19815" TIME_SLOT_REF1="ts1134" TIME_SLOT_REF2="ts1140">
                <ANNOTATION_VALUE>But that person still lets me go first.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19816" TIME_SLOT_REF1="ts1142" TIME_SLOT_REF2="ts1152">
                <ANNOTATION_VALUE>But if you think about it, your appearance already shows - that you are older than them.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19817" TIME_SLOT_REF1="ts1186" TIME_SLOT_REF2="ts1190">
                <ANNOTATION_VALUE>Yes,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19818" TIME_SLOT_REF1="ts1202" TIME_SLOT_REF2="ts1206">
                <ANNOTATION_VALUE>Ее.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19819" TIME_SLOT_REF1="ts1248" TIME_SLOT_REF2="ts1252">
                <ANNOTATION_VALUE>By the way, does the sun go down in this direction?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19820" TIME_SLOT_REF1="ts1260" TIME_SLOT_REF2="ts1264">
                <ANNOTATION_VALUE>The west is in this side, right?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19821" TIME_SLOT_REF1="ts1268" TIME_SLOT_REF2="ts1272">
                <ANNOTATION_VALUE>Oh, exactly, it is that side.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19822" TIME_SLOT_REF1="ts1276" TIME_SLOT_REF2="ts1284">
                <ANNOTATION_VALUE>####### west.</ANNOTATION_VALUE>
