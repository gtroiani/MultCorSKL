        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20073" TIME_SLOT_REF1="ts1890" TIME_SLOT_REF2="ts1897">
                <ANNOTATION_VALUE>It is spinning like this but it is also moving like this...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20074" TIME_SLOT_REF1="ts1898" TIME_SLOT_REF2="ts1900">
                <ANNOTATION_VALUE>It is spinning and revolving at the same time.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20075" TIME_SLOT_REF1="ts1902" TIME_SLOT_REF2="ts1904">
                <ANNOTATION_VALUE>It spins like this and revolves forwards like this.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20076" TIME_SLOT_REF1="ts1906" TIME_SLOT_REF2="ts1912">
                <ANNOTATION_VALUE>###.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20077" TIME_SLOT_REF1="ts1914" TIME_SLOT_REF2="ts1917">
                <ANNOTATION_VALUE>No it spins...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20078" TIME_SLOT_REF1="ts1918" TIME_SLOT_REF2="ts1922">
                <ANNOTATION_VALUE>but it moves forwards as well.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20079" TIME_SLOT_REF1="ts1924" TIME_SLOT_REF2="ts1932">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20080" TIME_SLOT_REF1="ts1934" TIME_SLOT_REF2="ts1936">
                <ANNOTATION_VALUE>Even in that case, there is a difference.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20081" TIME_SLOT_REF1="ts1938" TIME_SLOT_REF2="ts1941">
                <ANNOTATION_VALUE>That's why...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20082" TIME_SLOT_REF1="ts1942" TIME_SLOT_REF2="ts1945">
                <ANNOTATION_VALUE>but all the water...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20083" TIME_SLOT_REF1="ts1946" TIME_SLOT_REF2="ts1948">
                <ANNOTATION_VALUE>flows towards the north...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20084" TIME_SLOT_REF1="ts1950" TIME_SLOT_REF2="ts1953">
                <ANNOTATION_VALUE>In any place...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20085" TIME_SLOT_REF1="ts1954" TIME_SLOT_REF2="ts1956">
                <ANNOTATION_VALUE>the water flows towards the north...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20086" TIME_SLOT_REF1="ts1966" TIME_SLOT_REF2="ts1970">
                <ANNOTATION_VALUE>What are you going to do there? There is no one.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20087" TIME_SLOT_REF1="ts1992" TIME_SLOT_REF2="ts1996">
                <ANNOTATION_VALUE>The telescope...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20088" TIME_SLOT_REF1="ts2020" TIME_SLOT_REF2="ts2032">
                <ANNOTATION_VALUE>@@@@@@@@@</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20089" TIME_SLOT_REF1="ts2060" TIME_SLOT_REF2="ts2068">
                <ANNOTATION_VALUE>(Hx)@@@@</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20090" TIME_SLOT_REF1="ts2096" TIME_SLOT_REF2="ts2102">
                <ANNOTATION_VALUE>You are now just digressing now and talking shit...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LINGUISTIC_TYPE_REF="Translation"  TIER_ID="trx_en@SPK0015">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20099" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>Oh really, are our mountains low?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20101" TIME_SLOT_REF1="ts17" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>I see.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20102" TIME_SLOT_REF1="ts34" TIME_SLOT_REF2="ts38">
                <ANNOTATION_VALUE>Those are Karatau mountains, right?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20103" TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>You know what.. Saniya saw the Karatau mountains for the first time. She saw it for the first time. "Are there mountains like these, I did not know" was her reaction when she went there.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20108" TIME_SLOT_REF1="ts80" TIME_SLOT_REF2="ts82">
                <ANNOTATION_VALUE>Rocks.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20109" TIME_SLOT_REF1="ts86" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>So, what kind of mountains there are in Almaty (where Saniya is from)?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20110" TIME_SLOT_REF1="ts124" TIME_SLOT_REF2="ts126">
                <ANNOTATION_VALUE>By the way, let me go and switch off the gas.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20111" TIME_SLOT_REF1="ts226" TIME_SLOT_REF2="ts230">
                <ANNOTATION_VALUE>Would you like a cup of hot tea?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20112" TIME_SLOT_REF1="ts232" TIME_SLOT_REF2="ts237">
                <ANNOTATION_VALUE>Have some black tea.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20113" TIME_SLOT_REF1="ts238" TIME_SLOT_REF2="ts246">
                <ANNOTATION_VALUE>You'll have black tea because we ran out of milk.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20114" TIME_SLOT_REF1="ts258" TIME_SLOT_REF2="ts262">
                <ANNOTATION_VALUE>Oh my God God God God God God!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20115" TIME_SLOT_REF1="ts296" TIME_SLOT_REF2="ts300">
                <ANNOTATION_VALUE>(H)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20116" TIME_SLOT_REF1="ts436" TIME_SLOT_REF2="ts441">
                <ANNOTATION_VALUE>You know, nowadays</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20117" TIME_SLOT_REF1="ts442" TIME_SLOT_REF2="ts450">
                <ANNOTATION_VALUE>everyone goes to that place in our village called Kerish. They go to that red rock over there. They go to that red mountain.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20121" TIME_SLOT_REF1="ts452" TIME_SLOT_REF2="ts457">
                <ANNOTATION_VALUE>To that thingy...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20122" TIME_SLOT_REF1="ts458" TIME_SLOT_REF2="ts459">
                <ANNOTATION_VALUE>To that mountain...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20123" TIME_SLOT_REF1="ts464" TIME_SLOT_REF2="ts468">
                <ANNOTATION_VALUE>Yes, Kiyn Kerish.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20124" TIME_SLOT_REF1="ts470" TIME_SLOT_REF2="ts476">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20125" TIME_SLOT_REF1="ts482" TIME_SLOT_REF2="ts490">
                <ANNOTATION_VALUE>They go to Kyzyl Kerish and...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20126" TIME_SLOT_REF1="ts492" TIME_SLOT_REF2="ts504">
                <ANNOTATION_VALUE>Yes, a canyon.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20127" TIME_SLOT_REF1="ts506" TIME_SLOT_REF2="ts510">
                <ANNOTATION_VALUE>There is nothing special. It is just all red, that is it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20128" TIME_SLOT_REF1="ts524" TIME_SLOT_REF2="ts532">
                <ANNOTATION_VALUE>People from overseas come to see it, it turns out.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20129" TIME_SLOT_REF1="ts534" TIME_SLOT_REF2="ts536">
                <ANNOTATION_VALUE>They go there, they say.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20130" TIME_SLOT_REF1="ts540" TIME_SLOT_REF2="ts544">
                <ANNOTATION_VALUE>It is right near us, but we never go there and never see the place.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20131" TIME_SLOT_REF1="ts554" TIME_SLOT_REF2="ts558">
                <ANNOTATION_VALUE>In there past there were not any mosquitos, right?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20133" TIME_SLOT_REF1="ts560" TIME_SLOT_REF2="ts562">
                <ANNOTATION_VALUE>They would not fly in the daytime right?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20135" TIME_SLOT_REF1="ts566" TIME_SLOT_REF2="ts568">
                <ANNOTATION_VALUE>They would come together with the cattle sometimes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20136" TIME_SLOT_REF1="ts570" TIME_SLOT_REF2="ts574">
                <ANNOTATION_VALUE>We would make some smoke and they would be gone.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20137" TIME_SLOT_REF1="ts578" TIME_SLOT_REF2="ts587">
                <ANNOTATION_VALUE>But now why did the mosquitos go crazy? I do not understand that.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20138" TIME_SLOT_REF1="ts588" TIME_SLOT_REF2="ts594">
                <ANNOTATION_VALUE>Why are there more midges these days?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20139" TIME_SLOT_REF1="ts608" TIME_SLOT_REF2="ts612">
                <ANNOTATION_VALUE>No, for real.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20140" TIME_SLOT_REF1="ts664" TIME_SLOT_REF2="ts668">
                <ANNOTATION_VALUE>That's exactly what I am saying....</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20141" TIME_SLOT_REF1="ts772" TIME_SLOT_REF2="ts778">
                <ANNOTATION_VALUE>This is so interesting.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20142" TIME_SLOT_REF1="ts780" TIME_SLOT_REF2="ts794">
                <ANNOTATION_VALUE>There are black flies in Pavlodar as well, as it turns out.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20143" TIME_SLOT_REF1="ts842" TIME_SLOT_REF2="ts844">
                <ANNOTATION_VALUE>Yeap, they changed it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20144" TIME_SLOT_REF1="ts908" TIME_SLOT_REF2="ts915">
                <ANNOTATION_VALUE>The times have changed.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20145" TIME_SLOT_REF1="ts916" TIME_SLOT_REF2="ts920">
                <ANNOTATION_VALUE>People have changed.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20146" TIME_SLOT_REF1="ts922" TIME_SLOT_REF2="ts932">
                <ANNOTATION_VALUE>In the village, it turns out that these days people do not vist each other.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20148" TIME_SLOT_REF1="ts936" TIME_SLOT_REF2="ts942">
                <ANNOTATION_VALUE>They don't visit each other.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20150" TIME_SLOT_REF1="ts946" TIME_SLOT_REF2="ts952">
                <ANNOTATION_VALUE>Ther is no mood in the village.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20152" TIME_SLOT_REF1="ts962" TIME_SLOT_REF2="ts972">
                <ANNOTATION_VALUE>The climate keeps changing.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20153" TIME_SLOT_REF1="ts1014" TIME_SLOT_REF2="ts1016">
                <ANNOTATION_VALUE>Yes, different.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20154" TIME_SLOT_REF1="ts1020" TIME_SLOT_REF2="ts1022">
                <ANNOTATION_VALUE>All got tiny, right?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20155" TIME_SLOT_REF1="ts1024" TIME_SLOT_REF2="ts1028">
                <ANNOTATION_VALUE>I mean all the people.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20156" TIME_SLOT_REF1="ts1040" TIME_SLOT_REF2="ts1042">
                <ANNOTATION_VALUE>For them, we appear more backward than them.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20157" TIME_SLOT_REF1="ts1044" TIME_SLOT_REF2="ts1046">
                <ANNOTATION_VALUE>Yes, exactly.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20158" TIME_SLOT_REF1="ts1052" TIME_SLOT_REF2="ts1056">
                <ANNOTATION_VALUE>So different indeed.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20159" TIME_SLOT_REF1="ts1062" TIME_SLOT_REF2="ts1068">
                <ANNOTATION_VALUE>Like in the past...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20160" TIME_SLOT_REF1="ts1070" TIME_SLOT_REF2="ts1075">
                <ANNOTATION_VALUE>it always seemed to me that a forty-fifty year old people  looked very old.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20163" TIME_SLOT_REF1="ts1082" TIME_SLOT_REF2="ts1084">
                <ANNOTATION_VALUE>No, I mean...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20164" TIME_SLOT_REF1="ts1086" TIME_SLOT_REF2="ts1093">
                <ANNOTATION_VALUE>If you look at it...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20165" TIME_SLOT_REF1="ts1094" TIME_SLOT_REF2="ts1100">
                <ANNOTATION_VALUE>But now...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20166" TIME_SLOT_REF1="ts1136" TIME_SLOT_REF2="ts1144">
                <ANNOTATION_VALUE>@@@@@@@</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20167" TIME_SLOT_REF1="ts1162" TIME_SLOT_REF2="ts1164">
                <ANNOTATION_VALUE>@@@</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20168" TIME_SLOT_REF1="ts1174" TIME_SLOT_REF2="ts1176">
                <ANNOTATION_VALUE>But still..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20169" TIME_SLOT_REF1="ts1178" TIME_SLOT_REF2="ts1180">
                <ANNOTATION_VALUE>@@@@</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20170" TIME_SLOT_REF1="ts1196" TIME_SLOT_REF2="ts1204">
                <ANNOTATION_VALUE>For somebody who is with you all the time, it is not so noticable. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20171" TIME_SLOT_REF1="ts1210" TIME_SLOT_REF2="ts1214">
                <ANNOTATION_VALUE>But for those people who come from outside, it is noticable easily.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20172" TIME_SLOT_REF1="ts1216" TIME_SLOT_REF2="ts1218">
                <ANNOTATION_VALUE>For some we are old, for some we are young.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20173" TIME_SLOT_REF1="ts1222" TIME_SLOT_REF2="ts1226">
                <ANNOTATION_VALUE>Oh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20174" TIME_SLOT_REF1="ts1230" TIME_SLOT_REF2="ts1232">
                <ANNOTATION_VALUE>Yes</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20175" TIME_SLOT_REF1="ts1238" TIME_SLOT_REF2="ts1246">
                <ANNOTATION_VALUE>When I was a kid, sun never went down for me, or at least it seemed to me so.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20177" TIME_SLOT_REF1="ts1245" TIME_SLOT_REF2="ts1250">
                <ANNOTATION_VALUE>That's how it appeared to me.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20178" TIME_SLOT_REF1="ts1280" TIME_SLOT_REF2="ts1282">
                <ANNOTATION_VALUE>For namaz?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
