        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19882" TIME_SLOT_REF1="ts1674" TIME_SLOT_REF2="ts1684">
                <ANNOTATION_VALUE>In Almaty.. in Otegenbay where we live, the difference is about an hour,</ANNOTATION_VALUE>
