        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20004" TIME_SLOT_REF1="ts898" TIME_SLOT_REF2="ts900">
                <ANNOTATION_VALUE>One has to clean up their feces all day.</ANNOTATION_VALUE>
