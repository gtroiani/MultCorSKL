        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19832" TIME_SLOT_REF1="ts1392" TIME_SLOT_REF2="ts1396">
                <ANNOTATION_VALUE>Nope, when you are riding in Gres,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19833" TIME_SLOT_REF1="ts1398" TIME_SLOT_REF2="ts1400">
                <ANNOTATION_VALUE>there is...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19834" TIME_SLOT_REF1="ts1402" TIME_SLOT_REF2="ts1426">
                <ANNOTATION_VALUE>In our house, when you come out from there,  and arrive at parking where you park like this, and from there if you jump and look above at the sun or the moon, the moon stays here but when you go there, it will already be here.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19840" TIME_SLOT_REF1="ts1430" TIME_SLOT_REF2="ts1434">
