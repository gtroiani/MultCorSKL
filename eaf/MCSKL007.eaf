        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19860" TIME_SLOT_REF1="ts1570" TIME_SLOT_REF2="ts1572">
                <ANNOTATION_VALUE>And if you look at the back of the graveyards, my aunties' graveyards are located in only one spot.</ANNOTATION_VALUE>
