        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19869" TIME_SLOT_REF1="ts1620" TIME_SLOT_REF2="ts1626">
                <ANNOTATION_VALUE>It depends on the degree.</ANNOTATION_VALUE>
