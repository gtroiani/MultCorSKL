        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19896" TIME_SLOT_REF1="ts1792" TIME_SLOT_REF2="ts1804">
                <ANNOTATION_VALUE>But when I was in Oral, when it was dark in Almaty it was [bright as in?] noon on that side.</ANNOTATION_VALUE>
