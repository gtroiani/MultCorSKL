        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19870" TIME_SLOT_REF1="ts1628" TIME_SLOT_REF2="ts1646">
                <ANNOTATION_VALUE>Look, when I read morning namaz, Chenyaevka and Oskemen's sunrise time are the same, it turns out.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19875" TIME_SLOT_REF1="ts1650" TIME_SLOT_REF2="ts1654">
                <ANNOTATION_VALUE>In Tarbagatay, it falls behind by 14 minutes.</ANNOTATION_VALUE>
