        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19830" TIME_SLOT_REF1="ts1370" TIME_SLOT_REF2="ts1372">
                <ANNOTATION_VALUE>After than, it will go down like this.</ANNOTATION_VALUE>
