        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20188" TIME_SLOT_REF1="ts1458" TIME_SLOT_REF2="ts1468">
                <ANNOTATION_VALUE>Well when building gravestones for the dead... With what sense of direction do they build these gravestones?</ANNOTATION_VALUE>
