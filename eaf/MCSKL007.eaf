            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19878" TIME_SLOT_REF1="ts1660" TIME_SLOT_REF2="ts1664">
                <ANNOTATION_VALUE>If here the sun appears at 2-3 o'clock, there, the sun appears at 3:10, 3:17, 3:16, it turns out.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19880" TIME_SLOT_REF1="ts1666" TIME_SLOT_REF2="ts1668">
                <ANNOTATION_VALUE>This place... around 3 something, one/same with Chernyaevka.</ANNOTATION_VALUE>
