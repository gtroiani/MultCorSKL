            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19996" TIME_SLOT_REF1="ts876" TIME_SLOT_REF2="ts884">
                <ANNOTATION_VALUE>Like that Manka, who said: "Oh fuck your father's mouth, sheep is better and horses are better."</ANNOTATION_VALUE>
