    <TIER LINGUISTIC_TYPE_REF="Translation"  TIER_ID="trx_en@SPK0016">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19924" TIME_SLOT_REF1="ts8" TIME_SLOT_REF2="ts22">
                <ANNOTATION_VALUE>Do you know what хребет means in Kazakh... oh no, I meant in Russian?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19925" TIME_SLOT_REF1="ts24" TIME_SLOT_REF2="ts27">
                <ANNOTATION_VALUE>It is means a ridge. They are usually steep.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19926" TIME_SLOT_REF1="ts28" TIME_SLOT_REF2="ts30">
                <ANNOTATION_VALUE>Not like those.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19927" TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>Those are big like this.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19928" TIME_SLOT_REF1="ts46" TIME_SLOT_REF2="ts52">
                <ANNOTATION_VALUE>Alatau...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19929" TIME_SLOT_REF1="ts67" TIME_SLOT_REF2="ts71">
                <ANNOTATION_VALUE>She said "Wow,  there are also mountains like these, I did not know".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19930" TIME_SLOT_REF1="ts72" TIME_SLOT_REF2="ts78">
                <ANNOTATION_VALUE>There are rocks everwhere.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19931" TIME_SLOT_REF1="ts166" TIME_SLOT_REF2="ts174">
                <ANNOTATION_VALUE>@@@@@</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19932" TIME_SLOT_REF1="ts202" TIME_SLOT_REF2="ts212">
                <ANNOTATION_VALUE>@@@@@@@@@@@@@@@@@@@@@@@@@</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19933" TIME_SLOT_REF1="ts214" TIME_SLOT_REF2="ts220">
                <ANNOTATION_VALUE>Yes, these people are like that.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19934" TIME_SLOT_REF1="ts244" TIME_SLOT_REF2="ts252">
                <ANNOTATION_VALUE>Yeap, those areas are all flat, of course.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19935" TIME_SLOT_REF1="ts254" TIME_SLOT_REF2="ts260">
                <ANNOTATION_VALUE>They speak like that.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19936" TIME_SLOT_REF1="ts274" TIME_SLOT_REF2="ts276">
                <ANNOTATION_VALUE>Oh, I see.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19937" TIME_SLOT_REF1="ts286" TIME_SLOT_REF2="ts290">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19938" TIME_SLOT_REF1="ts304" TIME_SLOT_REF2="ts306">
                <ANNOTATION_VALUE>#.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19939" TIME_SLOT_REF1="ts314" TIME_SLOT_REF2="ts318">
                <ANNOTATION_VALUE>######.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19940" TIME_SLOT_REF1="ts320" TIME_SLOT_REF2="ts324">
                <ANNOTATION_VALUE>Maybe these stones come out from the ground? Apparently that there are rocks that protrude from the ground.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19941" TIME_SLOT_REF1="ts326" TIME_SLOT_REF2="ts328">
                <ANNOTATION_VALUE>Like those very straight #.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19942" TIME_SLOT_REF1="ts330" TIME_SLOT_REF2="ts338">
                <ANNOTATION_VALUE>###### and there straight rocks like that.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19943" TIME_SLOT_REF1="ts342" TIME_SLOT_REF2="ts346">
                <ANNOTATION_VALUE>So I think there has to be something like that around Kokshetau.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19944" TIME_SLOT_REF1="ts352" TIME_SLOT_REF2="ts354">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19945" TIME_SLOT_REF1="ts362" TIME_SLOT_REF2="ts364">
                <ANNOTATION_VALUE>(COUGHS)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19946" TIME_SLOT_REF1="ts380" TIME_SLOT_REF2="ts384">
                <ANNOTATION_VALUE>Oh, wow.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19947" TIME_SLOT_REF1="ts394" TIME_SLOT_REF2="ts396">
                <ANNOTATION_VALUE>Stone.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19948" TIME_SLOT_REF1="ts398" TIME_SLOT_REF2="ts400">
                <ANNOTATION_VALUE>Stones, of course, are cold (when you build houses with them)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19949" TIME_SLOT_REF1="ts402" TIME_SLOT_REF2="ts406">
                <ANNOTATION_VALUE>The coldest thing is stone, you know.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19950" TIME_SLOT_REF1="ts408" TIME_SLOT_REF2="ts412">
                <ANNOTATION_VALUE>Oh I see.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19951" TIME_SLOT_REF1="ts422" TIME_SLOT_REF2="ts424">
                <ANNOTATION_VALUE>Oh the stone heats up.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19952" TIME_SLOT_REF1="ts426" TIME_SLOT_REF2="ts428">
                <ANNOTATION_VALUE>They are like tiles, you know.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19953" TIME_SLOT_REF1="ts430" TIME_SLOT_REF2="ts438">
                <ANNOTATION_VALUE>## the coldest thing is a stone, after all.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19954" TIME_SLOT_REF1="ts454" TIME_SLOT_REF2="ts466">
                <ANNOTATION_VALUE>It is called Kyin Kerish.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19955" TIME_SLOT_REF1="ts478" TIME_SLOT_REF2="ts484">
                <ANNOTATION_VALUE>They go to that place called Kyin Kerish.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19956" TIME_SLOT_REF1="ts494" TIME_SLOT_REF2="ts500">
                <ANNOTATION_VALUE>It is just a canyon.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19957" TIME_SLOT_REF1="ts503" TIME_SLOT_REF2="ts508">
                <ANNOTATION_VALUE>There is nothing special.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19958" TIME_SLOT_REF1="ts514" TIME_SLOT_REF2="ts522">
                <ANNOTATION_VALUE>It is just that people say if you lie on this canyon, it will give you some kind of energy.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19960" TIME_SLOT_REF1="ts521" TIME_SLOT_REF2="ts526">
                <ANNOTATION_VALUE>You get energy from the ground.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19961" TIME_SLOT_REF1="ts528" TIME_SLOT_REF2="ts530">
                <ANNOTATION_VALUE>All these foreigners are there, some say.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19962" TIME_SLOT_REF1="ts538" TIME_SLOT_REF2="ts542">
                <ANNOTATION_VALUE>It just looks like Mars in there you know #.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19963" TIME_SLOT_REF1="ts546" TIME_SLOT_REF2="ts548">
                <ANNOTATION_VALUE>We thought we would go there that time when we were in the village but we could not because of these freaking mosquitos.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19964" TIME_SLOT_REF1="ts550" TIME_SLOT_REF2="ts552">
                <ANNOTATION_VALUE>We barely escaped these mosquitos.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19965" TIME_SLOT_REF1="ts572" TIME_SLOT_REF2="ts576">
                <ANNOTATION_VALUE>Mhm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19966" TIME_SLOT_REF1="ts598" TIME_SLOT_REF2="ts602">
                <ANNOTATION_VALUE>Our mosquiots, Sashok says, can be found only in East Kazakhstan's Boran and Chernyaevka regions.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19968" TIME_SLOT_REF1="ts604" TIME_SLOT_REF2="ts610">
                <ANNOTATION_VALUE>There are no mosquitos in other places.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19969" TIME_SLOT_REF1="ts626" TIME_SLOT_REF2="ts631">
                <ANNOTATION_VALUE>No, just think.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19970" TIME_SLOT_REF1="ts632" TIME_SLOT_REF2="ts634">
                <ANNOTATION_VALUE>There are none in Tarbagatay.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19971" TIME_SLOT_REF1="ts640" TIME_SLOT_REF2="ts642">
                <ANNOTATION_VALUE>There are none in Zaisan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19972" TIME_SLOT_REF1="ts644" TIME_SLOT_REF2="ts646">
                <ANNOTATION_VALUE>The distance between them is just like this - very small.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19973" TIME_SLOT_REF1="ts648" TIME_SLOT_REF2="ts650">
                <ANNOTATION_VALUE>There are none in Akaral.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19974" TIME_SLOT_REF1="ts652" TIME_SLOT_REF2="ts654">
                <ANNOTATION_VALUE>No mosquitos.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19975" TIME_SLOT_REF1="ts656" TIME_SLOT_REF2="ts658">
                <ANNOTATION_VALUE>In that Birzhan village, there are none either,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19976" TIME_SLOT_REF1="ts660" TIME_SLOT_REF2="ts662">
                <ANNOTATION_VALUE>Chernyaevka is such a small village, but there are tons.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19977" TIME_SLOT_REF1="ts666" TIME_SLOT_REF2="ts670">
                <ANNOTATION_VALUE>Preyrtish has none but Shengeldi has a lot, right?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19978" TIME_SLOT_REF1="ts672" TIME_SLOT_REF2="ts676">
                <ANNOTATION_VALUE>Or is it vice versa?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19979" TIME_SLOT_REF1="ts678" TIME_SLOT_REF2="ts684">
                <ANNOTATION_VALUE>Oh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19980" TIME_SLOT_REF1="ts688" TIME_SLOT_REF2="ts692">
                <ANNOTATION_VALUE>Yes, in Monekey as well.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19981" TIME_SLOT_REF1="ts696" TIME_SLOT_REF2="ts700">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19982" TIME_SLOT_REF1="ts706" TIME_SLOT_REF2="ts714">
                <ANNOTATION_VALUE>Yes, the water in Kurshim is less in quantity. The other day ###.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19984" TIME_SLOT_REF1="ts720" TIME_SLOT_REF2="ts730">
                <ANNOTATION_VALUE>Oh, but it is too much in where we are.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19985" TIME_SLOT_REF1="ts736" TIME_SLOT_REF2="ts738">
