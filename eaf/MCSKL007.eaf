        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20000" TIME_SLOT_REF1="ts886" TIME_SLOT_REF2="ts890">
                <ANNOTATION_VALUE>I asked why he does not breed cows, and he said it is difficult with cows.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20002" TIME_SLOT_REF1="ts892" TIME_SLOT_REF2="ts896">
                <ANNOTATION_VALUE>We think cows are easy to handle, but it is difficult, people say... beacause it needs good care.</ANNOTATION_VALUE>
