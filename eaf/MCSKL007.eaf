        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20005" TIME_SLOT_REF1="ts902" TIME_SLOT_REF2="ts905">
                <ANNOTATION_VALUE>When they are young, one needs to make sure they do not get cold.</ANNOTATION_VALUE>
