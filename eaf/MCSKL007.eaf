        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19841" TIME_SLOT_REF1="ts1436" TIME_SLOT_REF2="ts1438">
                <ANNOTATION_VALUE>There, after that, when I looked at it and I did not get it.</ANNOTATION_VALUE>
