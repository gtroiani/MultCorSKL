        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19858" TIME_SLOT_REF1="ts1558" TIME_SLOT_REF2="ts1560">
                <ANNOTATION_VALUE>She is buried like this.</ANNOTATION_VALUE>
