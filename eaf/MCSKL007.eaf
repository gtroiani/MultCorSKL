        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19994" TIME_SLOT_REF1="ts862" TIME_SLOT_REF2="ts868">
                <ANNOTATION_VALUE>Do they think breeding horses is easy?</ANNOTATION_VALUE>
