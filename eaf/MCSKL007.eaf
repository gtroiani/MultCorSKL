        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19823" TIME_SLOT_REF1="ts1286" TIME_SLOT_REF2="ts1288">
                <ANNOTATION_VALUE>It is correct, yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19824" TIME_SLOT_REF1="ts1322" TIME_SLOT_REF2="ts1326">
                <ANNOTATION_VALUE>Еее.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19825" TIME_SLOT_REF1="ts1348" TIME_SLOT_REF2="ts1354">
                <ANNOTATION_VALUE>In Gres, ours is facing this direction.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19827" TIME_SLOT_REF1="ts1356" TIME_SLOT_REF2="ts1358">
                <ANNOTATION_VALUE>The sun goes down like this.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19828" TIME_SLOT_REF1="ts1362" TIME_SLOT_REF2="ts1368">
                <ANNOTATION_VALUE>After that in the summer time it goes down like this.</ANNOTATION_VALUE>
