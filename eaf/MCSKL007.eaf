        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19895" TIME_SLOT_REF1="ts1776" TIME_SLOT_REF2="ts1778">
                <ANNOTATION_VALUE>??</ANNOTATION_VALUE>
