        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1180"
                TIME_SLOT_REF1="ts1796" TIME_SLOT_REF2="ts1798">
                <ANNOTATION_VALUE>Ok, Zhaidarbek.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1182"
                TIME_SLOT_REF1="ts1800" TIME_SLOT_REF2="ts1803">
                <ANNOTATION_VALUE>Thank you.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1183"
                TIME_SLOT_REF1="ts1804" TIME_SLOT_REF2="ts1806">
                <ANNOTATION_VALUE>It's been transferred to me.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1184"
                TIME_SLOT_REF1="ts1808" TIME_SLOT_REF2="ts1810">
                <ANNOTATION_VALUE>I was just thinking of buying the tickets now.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1185"
                TIME_SLOT_REF1="ts1812" TIME_SLOT_REF2="ts1815">
                <ANNOTATION_VALUE>Hmm...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1186"
                TIME_SLOT_REF1="ts1816" TIME_SLOT_REF2="ts1818">
                <ANNOTATION_VALUE>There are tickets available to go that way but only four tickets for the way back.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1187"
                TIME_SLOT_REF1="ts1820" TIME_SLOT_REF2="ts1825">
                <ANNOTATION_VALUE>For the way back, only four seats left. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1189"
                TIME_SLOT_REF1="ts1826" TIME_SLOT_REF2="ts1828">
                <ANNOTATION_VALUE>All the way to Zhalanashkol.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1190"
                TIME_SLOT_REF1="ts1836" TIME_SLOT_REF2="ts1839">
                <ANNOTATION_VALUE>Zhaidarbek transferred to me.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1192"
                TIME_SLOT_REF1="ts1840" TIME_SLOT_REF2="ts1843">
                <ANNOTATION_VALUE>Ten thousand.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1193"
                TIME_SLOT_REF1="ts1848" TIME_SLOT_REF2="ts1854">
                <ANNOTATION_VALUE>And if now my "yellow" son can chip in some ten thousand...hahah </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1194"
                TIME_SLOT_REF1="ts1865" TIME_SLOT_REF2="ts1876">
                <ANNOTATION_VALUE>Otherwise, I do not have any money at all.   </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1197"
                TIME_SLOT_REF1="ts1878" TIME_SLOT_REF2="ts1884">
                <ANNOTATION_VALUE>I am sitting here, confidentily saying that I will go there, but I don't have money to actually be there for three days,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1198"
                TIME_SLOT_REF1="ts1888" TIME_SLOT_REF2="ts1893">
                <ANNOTATION_VALUE>What?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1200"
                TIME_SLOT_REF1="ts1898" TIME_SLOT_REF2="ts1900">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1201"
                TIME_SLOT_REF1="ts1904" TIME_SLOT_REF2="ts1910">
                <ANNOTATION_VALUE>Well, he has already transferred ten thousand to me.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1203"
                TIME_SLOT_REF1="ts1912" TIME_SLOT_REF2="ts1914">
                <ANNOTATION_VALUE>My oldest son.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1204"
                TIME_SLOT_REF1="ts1916" TIME_SLOT_REF2="ts1918">
                <ANNOTATION_VALUE>My youngest son will probably transfer some to me as well.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1205"
                TIME_SLOT_REF1="ts1924" TIME_SLOT_REF2="ts1926">
                <ANNOTATION_VALUE>He transferred ten thousand already,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1207"
                TIME_SLOT_REF1="ts1928" TIME_SLOT_REF2="ts1934">
                <ANNOTATION_VALUE>For the way to and back.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1208"
                TIME_SLOT_REF1="ts1936" TIME_SLOT_REF2="ts1940">
                <ANNOTATION_VALUE>I meam my oldest son did. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1210"
                TIME_SLOT_REF1="ts1942" TIME_SLOT_REF2="ts1945">
                <ANNOTATION_VALUE>Kulpash, we are about to leave for Alakol.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1212"
                TIME_SLOT_REF1="ts1946" TIME_SLOT_REF2="ts1949">
                <ANNOTATION_VALUE>For five days.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1213"
                TIME_SLOT_REF1="ts1950" TIME_SLOT_REF2="ts1952">
                <ANNOTATION_VALUE>Two of us - Nazgul and I.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1214"
                TIME_SLOT_REF1="ts1954" TIME_SLOT_REF2="ts1956">
                <ANNOTATION_VALUE>Go with us!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1215"
                TIME_SLOT_REF1="ts1960" TIME_SLOT_REF2="ts1966">
                <ANNOTATION_VALUE>Friday, hmm, yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1218"
                TIME_SLOT_REF1="ts1968" TIME_SLOT_REF2="ts1972">
                <ANNOTATION_VALUE>Get your work for Friday done already.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1219"
                TIME_SLOT_REF1="ts1974" TIME_SLOT_REF2="ts1982">
                <ANNOTATION_VALUE>If we get on the train on Thursday evening, we will get off the next day morning.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1220"
                TIME_SLOT_REF1="ts1984" TIME_SLOT_REF2="ts1990">
                <ANNOTATION_VALUE>In short, on sisteenth and seventeenth - we will be there.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1223"
                TIME_SLOT_REF1="ts1992" TIME_SLOT_REF2="ts1998">
                <ANNOTATION_VALUE>On eighteenth afternoon, we will travel back.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1224"
                TIME_SLOT_REF1="ts2000" TIME_SLOT_REF2="ts2003">
                <ANNOTATION_VALUE>And we will manage to get to work on Monday morning.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1225"
                TIME_SLOT_REF1="ts2004" TIME_SLOT_REF2="ts2006">
                <ANNOTATION_VALUE>Let's go!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1226"
                TIME_SLOT_REF1="ts2008" TIME_SLOT_REF2="ts2010">
                <ANNOTATION_VALUE>Imagine me saying: "Dare! Go for it", haha</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1228"
                TIME_SLOT_REF1="ts2016" TIME_SLOT_REF2="ts2018">
                <ANNOTATION_VALUE>If we don't manage, let us not.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1229"
                TIME_SLOT_REF1="ts2020" TIME_SLOT_REF2="ts2022">
                <ANNOTATION_VALUE>We will have gotten off the train at ten thirty.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1231"
                TIME_SLOT_REF1="ts2026" TIME_SLOT_REF2="ts2035">
                <ANNOTATION_VALUE>And I will come and do this with my kempirs.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1233"
                TIME_SLOT_REF1="ts2040" TIME_SLOT_REF2="ts2042">
                <ANNOTATION_VALUE>Make my tea a little lighter.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1234"
                TIME_SLOT_REF1="ts2044" TIME_SLOT_REF2="ts2047">
                <ANNOTATION_VALUE>Why this woman named Balnur does not answer her phone?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1235"
                TIME_SLOT_REF1="ts2048" TIME_SLOT_REF2="ts2050">
                <ANNOTATION_VALUE>Why Zhanar does not answer her phone either?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1236"
                TIME_SLOT_REF1="ts2054" TIME_SLOT_REF2="ts2057">
                <ANNOTATION_VALUE>I really hate when they do this.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1237"
                TIME_SLOT_REF1="ts2058" TIME_SLOT_REF2="ts2061">
                <ANNOTATION_VALUE>Being so inattentive.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1239"
                TIME_SLOT_REF1="ts2065" TIME_SLOT_REF2="ts2074">
                <ANNOTATION_VALUE>Well, just say "yes" or "no". I like concreteness.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1246"
                TIME_SLOT_REF1="ts2096" TIME_SLOT_REF2="ts2100">
                <ANNOTATION_VALUE>Aksay.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1248"
                TIME_SLOT_REF1="ts2110" TIME_SLOT_REF2="ts2112">
                <ANNOTATION_VALUE>We need to take some alcohol to there, right?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1250"
                TIME_SLOT_REF1="ts2118" TIME_SLOT_REF2="ts2120">
                <ANNOTATION_VALUE>We need to bring some alcohol.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1251"
                TIME_SLOT_REF1="ts2122" TIME_SLOT_REF2="ts2126">
                <ANNOTATION_VALUE>Beer or something else. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1252"
                TIME_SLOT_REF1="ts2128" TIME_SLOT_REF2="ts2131">
                <ANNOTATION_VALUE>Or vodka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1253"
                TIME_SLOT_REF1="ts2132" TIME_SLOT_REF2="ts2136">
                <ANNOTATION_VALUE>### right? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1254"
                TIME_SLOT_REF1="ts2138" TIME_SLOT_REF2="ts2142">
                <ANNOTATION_VALUE>They said that alcohol is expensive there.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1255"
                TIME_SLOT_REF1="ts2146" TIME_SLOT_REF2="ts2149">
                <ANNOTATION_VALUE>I guess Balnur's love has also extinguished.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1256"
                TIME_SLOT_REF1="ts2152" TIME_SLOT_REF2="ts2154">
                <ANNOTATION_VALUE>No.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1257"
                TIME_SLOT_REF1="ts2156" TIME_SLOT_REF2="ts2158">
                <ANNOTATION_VALUE>She does not answer the phone.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1269"
                TIME_SLOT_REF1="ts2177" TIME_SLOT_REF2="ts2182">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1270"
                TIME_SLOT_REF1="ts2196" TIME_SLOT_REF2="ts2202">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1280"
                TIME_SLOT_REF1="ts2242" TIME_SLOT_REF2="ts2245">
                <ANNOTATION_VALUE>Well, my auntie wrote and sent me this.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1282"
                TIME_SLOT_REF1="ts2246" TIME_SLOT_REF2="ts2248">
                <ANNOTATION_VALUE>Take a look.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1283"
                TIME_SLOT_REF1="ts2250" TIME_SLOT_REF2="ts2253">
                <ANNOTATION_VALUE>What is it saying about the time?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1284"
                TIME_SLOT_REF1="ts2254" TIME_SLOT_REF2="ts2256">
                <ANNOTATION_VALUE>We need to know that.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1290"
                TIME_SLOT_REF1="ts2274" TIME_SLOT_REF2="ts2279">
                <ANNOTATION_VALUE>No, look at this.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1291"
                TIME_SLOT_REF1="ts2280" TIME_SLOT_REF2="ts2282">
                <ANNOTATION_VALUE>Hear what my auntie has to say...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1292"
                TIME_SLOT_REF1="ts2284" TIME_SLOT_REF2="ts2286">
                <ANNOTATION_VALUE>Then this is a different train.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1300"
                TIME_SLOT_REF1="ts2310" TIME_SLOT_REF2="ts2314">
                <ANNOTATION_VALUE>She is saying that you get on the train at five thirty in Oskemen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1307"
                TIME_SLOT_REF1="ts2356" TIME_SLOT_REF2="ts2360">
                <ANNOTATION_VALUE>Come again?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1312"
                TIME_SLOT_REF1="ts2364" TIME_SLOT_REF2="ts2369">
                <ANNOTATION_VALUE> It is just that we need a place with something for remedial and treatment.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1313"
                TIME_SLOT_REF1="ts2370" TIME_SLOT_REF2="ts2375">
                <ANNOTATION_VALUE>I want to lie in Alakol's mud.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1314"
                TIME_SLOT_REF1="ts2377" TIME_SLOT_REF2="ts2379">
                <ANNOTATION_VALUE>There in Alakol.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1319"
                TIME_SLOT_REF1="ts2400" TIME_SLOT_REF2="ts2410">
                <ANNOTATION_VALUE>It has this thing...Arasan.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1323"
                TIME_SLOT_REF1="ts2412" TIME_SLOT_REF2="ts2414">
                <ANNOTATION_VALUE>Two thousand tenge per day.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1324"
                TIME_SLOT_REF1="ts2416" TIME_SLOT_REF2="ts2420">
                <ANNOTATION_VALUE>I want to get in there!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1325"
                TIME_SLOT_REF1="ts2419" TIME_SLOT_REF2="ts2422">
                <ANNOTATION_VALUE>My hand and legs are aching these days.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1327"
                TIME_SLOT_REF1="ts2428" TIME_SLOT_REF2="ts2430">
                <ANNOTATION_VALUE>There is nothing bad the mud can bring.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1329"
                TIME_SLOT_REF1="ts2432" TIME_SLOT_REF2="ts2434">
                <ANNOTATION_VALUE>If you lie in the mud, it is always good.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1330"
                TIME_SLOT_REF1="ts2436" TIME_SLOT_REF2="ts2438">
                <ANNOTATION_VALUE>What shall we do?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1331"
                TIME_SLOT_REF1="ts2440" TIME_SLOT_REF2="ts2442">
                <ANNOTATION_VALUE>Shall we get the tickets?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4732"
                TIME_SLOT_REF1="ts2446" TIME_SLOT_REF2="ts2454">
                <ANNOTATION_VALUE> For me it is conclusive.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1339"
                TIME_SLOT_REF1="ts2480" TIME_SLOT_REF2="ts2484">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1340"
                TIME_SLOT_REF1="ts2486" TIME_SLOT_REF2="ts2498">
                <ANNOTATION_VALUE>Your mom invited me, saying "there was one seat left, let's go". But I could not go the year before last year.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1345"
                TIME_SLOT_REF1="ts2510" TIME_SLOT_REF2="ts2512">
                <ANNOTATION_VALUE>What did this girl day?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LINGUISTIC_TYPE_REF="Intonation Units"  TIER_ID="IU@SPK0014">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a16"
                TIME_SLOT_REF1="ts53" TIME_SLOT_REF2="ts55">
                <ANNOTATION_VALUE>Ана жерді қайтадан айтып жіберіңіші.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
