        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1069"
                TIME_SLOT_REF1="ts1322" TIME_SLOT_REF2="ts1327">
                <ANNOTATION_VALUE>By the way, they have Kasi Red there, don't they?</ANNOTATION_VALUE>
