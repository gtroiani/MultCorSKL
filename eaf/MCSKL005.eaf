        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1051"
                TIME_SLOT_REF1="ts1230" TIME_SLOT_REF2="ts1233">
                <ANNOTATION_VALUE>You see I have a meeting on twenty first.</ANNOTATION_VALUE>
