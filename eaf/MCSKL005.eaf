        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1056"
                TIME_SLOT_REF1="ts1262" TIME_SLOT_REF2="ts1268">
                <ANNOTATION_VALUE> Oh gosh, Bikosh!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1058"
                TIME_SLOT_REF1="ts1267" TIME_SLOT_REF2="ts1270">
                <ANNOTATION_VALUE>I thought so.</ANNOTATION_VALUE>
