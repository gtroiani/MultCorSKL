            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a763"
                TIME_SLOT_REF1="ts78" TIME_SLOT_REF2="ts80">
