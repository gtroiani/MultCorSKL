        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1054"
                TIME_SLOT_REF1="ts1244" TIME_SLOT_REF2="ts1250">
                <ANNOTATION_VALUE>If they don't want to go, let it be so. We don't need those who don't want to go.  </ANNOTATION_VALUE>
