        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1316"
                TIME_SLOT_REF1="ts2372" TIME_SLOT_REF2="ts2383">
                <ANNOTATION_VALUE>It is so pity that Saryarka is so expensive at the moment!</ANNOTATION_VALUE>
