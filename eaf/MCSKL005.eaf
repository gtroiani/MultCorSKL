        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a852"
                TIME_SLOT_REF1="ts434" TIME_SLOT_REF2="ts437">
                <ANNOTATION_VALUE>No seats in Kupe.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a853"
                TIME_SLOT_REF1="ts440" TIME_SLOT_REF2="ts444">
                <ANNOTATION_VALUE>No seats in Soft.</ANNOTATION_VALUE>
