        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a765"
                TIME_SLOT_REF1="ts62" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>Was it Zhalanashkol?</ANNOTATION_VALUE>
