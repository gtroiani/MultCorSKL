            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1088"
                TIME_SLOT_REF1="ts1392" TIME_SLOT_REF2="ts1394">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1089"
                TIME_SLOT_REF1="ts1396" TIME_SLOT_REF2="ts1400">
                <ANNOTATION_VALUE>Аkosh, hi, how are you? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1090"
                TIME_SLOT_REF1="ts1402" TIME_SLOT_REF2="ts1404">
                <ANNOTATION_VALUE>How's your health?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1091"
                TIME_SLOT_REF1="ts1406" TIME_SLOT_REF2="ts1412">
                <ANNOTATION_VALUE>Akosh, if you have money, please send me ten thousand.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1092"
                TIME_SLOT_REF1="ts1414" TIME_SLOT_REF2="ts1416">
                <ANNOTATION_VALUE>I was thinking of going to Alakol for three-four days.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1093"
                TIME_SLOT_REF1="ts1418" TIME_SLOT_REF2="ts1423">
                <ANNOTATION_VALUE>For that I need money for a round-trip ticket. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1094"
                TIME_SLOT_REF1="ts1424" TIME_SLOT_REF2="ts1427">
                <ANNOTATION_VALUE>Right now my pay is not being transferred.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1095"
                TIME_SLOT_REF1="ts1430" TIME_SLOT_REF2="ts1434">
                <ANNOTATION_VALUE>If you don't have enough money, I will give it back to you on seventeenth. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1098"
                TIME_SLOT_REF1="ts1436" TIME_SLOT_REF2="ts1443">
                <ANNOTATION_VALUE>If you ask money from my oldest son, he will start whining immediately. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1100"
                TIME_SLOT_REF1="ts1444" TIME_SLOT_REF2="ts1450">
                <ANNOTATION_VALUE>Even if we gave him a taiynsha... that little...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1102"
                TIME_SLOT_REF1="ts1452" TIME_SLOT_REF2="ts1454">
                <ANNOTATION_VALUE>I should also try telling Zhaidarbek, haha.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1103"
                TIME_SLOT_REF1="ts1456" TIME_SLOT_REF2="ts1461">
                <ANNOTATION_VALUE>Pakosh, hi, how are you? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1104"
                TIME_SLOT_REF1="ts1462" TIME_SLOT_REF2="ts1465">
                <ANNOTATION_VALUE>How is your health? Is everything alright?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1105"
                TIME_SLOT_REF1="ts1466" TIME_SLOT_REF2="ts1469">
                <ANNOTATION_VALUE>Are you at work?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1106"
                TIME_SLOT_REF1="ts1470" TIME_SLOT_REF2="ts1472">
                <ANNOTATION_VALUE>Are you having rest?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1107"
                TIME_SLOT_REF1="ts1474" TIME_SLOT_REF2="ts1478">
                <ANNOTATION_VALUE>Pakosh, if you have money, please send me one thousand, please. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1108"
                TIME_SLOT_REF1="ts1480" TIME_SLOT_REF2="ts1484">
                <ANNOTATION_VALUE>I was thinking of going to Alakol for three-four days. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1109"
                TIME_SLOT_REF1="ts1486" TIME_SLOT_REF2="ts1488">
                <ANNOTATION_VALUE>For that, right now, my money is not enough.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1110"
                TIME_SLOT_REF1="ts1490" TIME_SLOT_REF2="ts1498">
                <ANNOTATION_VALUE>After that, if everything is ok, I will give your money back to you, on seventeenth.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1115"
                TIME_SLOT_REF1="ts1514" TIME_SLOT_REF2="ts1516">
                <ANNOTATION_VALUE>Oh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1119"
                TIME_SLOT_REF1="ts1526" TIME_SLOT_REF2="ts1528">
                <ANNOTATION_VALUE>Oh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1120"
                TIME_SLOT_REF1="ts1530" TIME_SLOT_REF2="ts1534">
                <ANNOTATION_VALUE>Did you buy with cash?</ANNOTATION_VALUE>
