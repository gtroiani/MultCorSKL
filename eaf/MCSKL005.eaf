        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a747"
                TIME_SLOT_REF1="ts12" TIME_SLOT_REF2="ts19">
                <ANNOTATION_VALUE>Do you want me to heat up some kuyrdak?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a752"
                TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>I am saying this.</ANNOTATION_VALUE>
