        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1075"
                TIME_SLOT_REF1="ts1341" TIME_SLOT_REF2="ts1345">
                <ANNOTATION_VALUE>Do you want to go visit?</ANNOTATION_VALUE>
