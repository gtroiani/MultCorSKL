        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1023"
                TIME_SLOT_REF1="ts1118" TIME_SLOT_REF2="ts1121">
                <ANNOTATION_VALUE>Oh these people, making me crazy!</ANNOTATION_VALUE>
