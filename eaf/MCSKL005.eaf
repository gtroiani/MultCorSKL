        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1342"
                TIME_SLOT_REF1="ts2494" TIME_SLOT_REF2="ts2496">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
