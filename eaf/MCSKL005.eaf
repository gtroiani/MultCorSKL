        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a858"
                TIME_SLOT_REF1="ts446" TIME_SLOT_REF2="ts449">
                <ANNOTATION_VALUE>No seats in Lux.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a859"
                TIME_SLOT_REF1="ts452" TIME_SLOT_REF2="ts457">
                <ANNOTATION_VALUE>It is three thousand nine hundred and seventy two (3972) tenges. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a862"
                TIME_SLOT_REF1="ts458" TIME_SLOT_REF2="ts462">
                <ANNOTATION_VALUE>Only sixty seven places left.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a863"
                TIME_SLOT_REF1="ts466" TIME_SLOT_REF2="ts468">
                <ANNOTATION_VALUE>Is it good?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a864"
                TIME_SLOT_REF1="ts474" TIME_SLOT_REF2="ts484">
                <ANNOTATION_VALUE>Look, there are some in here apparently.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a869"
                TIME_SLOT_REF1="ts486" TIME_SLOT_REF2="ts492">
                <ANNOTATION_VALUE>Only sixty seven places are left.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a873"
                TIME_SLOT_REF1="ts506" TIME_SLOT_REF2="ts508">
                <ANNOTATION_VALUE>Now..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a874"
                TIME_SLOT_REF1="ts510" TIME_SLOT_REF2="ts514">
                <ANNOTATION_VALUE>We can just get those online.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a885"
                TIME_SLOT_REF1="ts554" TIME_SLOT_REF2="ts558">
                <ANNOTATION_VALUE>For returning?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a886"
                TIME_SLOT_REF1="ts560" TIME_SLOT_REF2="ts562">
                <ANNOTATION_VALUE>The train does not go on the eighteenth.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a887"
                TIME_SLOT_REF1="ts564" TIME_SLOT_REF2="ts567">
                <ANNOTATION_VALUE>But it does on the seventeenth.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a891"
                TIME_SLOT_REF1="ts572" TIME_SLOT_REF2="ts578">
                <ANNOTATION_VALUE>When the day is an odd number.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a893"
                TIME_SLOT_REF1="ts586" TIME_SLOT_REF2="ts589">
                <ANNOTATION_VALUE>For returning.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a917"
                TIME_SLOT_REF1="ts678" TIME_SLOT_REF2="ts680">
                <ANNOTATION_VALUE>There are tickets for the eighteenth for coming back home.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a925"
                TIME_SLOT_REF1="ts702" TIME_SLOT_REF2="ts708">
                <ANNOTATION_VALUE>At three eighteen. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a927"
                TIME_SLOT_REF1="ts720" TIME_SLOT_REF2="ts724">
                <ANNOTATION_VALUE>Mom, there are only four seats left for that one.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a928"
                TIME_SLOT_REF1="ts730" TIME_SLOT_REF2="ts732">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a929"
                TIME_SLOT_REF1="ts734" TIME_SLOT_REF2="ts740">
                <ANNOTATION_VALUE>If you don't buy both of them today, I don't know if you will be able to do later. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a934"
                TIME_SLOT_REF1="ts760" TIME_SLOT_REF2="ts762">
                <ANNOTATION_VALUE>Did I say three thousand six hundred and seventy two tenges?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a935"
                TIME_SLOT_REF1="ts764" TIME_SLOT_REF2="ts777">
                <ANNOTATION_VALUE>For one person, to go there and return would cost seven thousand and three hundred.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a938"
                TIME_SLOT_REF1="ts778" TIME_SLOT_REF2="ts783">
                <ANNOTATION_VALUE>Yes, it is nothing.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a960"
                TIME_SLOT_REF1="ts848" TIME_SLOT_REF2="ts852">
                <ANNOTATION_VALUE>Let them take you.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a964"
                TIME_SLOT_REF1="ts868" TIME_SLOT_REF2="ts874">
                <ANNOTATION_VALUE>I said Aktogay, not Aksay.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a965"
                TIME_SLOT_REF1="ts876" TIME_SLOT_REF2="ts880">
                <ANNOTATION_VALUE>The last...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a974"
                TIME_SLOT_REF1="ts892" TIME_SLOT_REF2="ts896">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a977"
                TIME_SLOT_REF1="ts916" TIME_SLOT_REF2="ts921">
                <ANNOTATION_VALUE>The one that goes there?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a978"
                TIME_SLOT_REF1="ts922" TIME_SLOT_REF2="ts930">
                <ANNOTATION_VALUE>The one that goes there is at four thirty.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a979"
                TIME_SLOT_REF1="ts932" TIME_SLOT_REF2="ts934">
                <ANNOTATION_VALUE>Hold on.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a980"
                TIME_SLOT_REF1="ts936" TIME_SLOT_REF2="ts938">
                <ANNOTATION_VALUE>I forgot.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a981"
                TIME_SLOT_REF1="ts943" TIME_SLOT_REF2="ts948">
                <ANNOTATION_VALUE>Let me check, ok?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a994"
                TIME_SLOT_REF1="ts975" TIME_SLOT_REF2="ts978">
                <ANNOTATION_VALUE>Look, it is Oskemen-Aktogay.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a995"
                TIME_SLOT_REF1="ts980" TIME_SLOT_REF2="ts986">
                <ANNOTATION_VALUE>But it says Zhalanashkol, but I do not know whether it is the Zhalanashkol you are talking about.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a998"
                TIME_SLOT_REF1="ts988" TIME_SLOT_REF2="ts998">
                <ANNOTATION_VALUE>Is it at that thing... is it at the border?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1000"
                TIME_SLOT_REF1="ts1004" TIME_SLOT_REF2="ts1012">
                <ANNOTATION_VALUE>Oh, then yes, it is the place you are talking about.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1010"
                TIME_SLOT_REF1="ts1052" TIME_SLOT_REF2="ts1054">
                <ANNOTATION_VALUE>Four fifty one.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1011"
                TIME_SLOT_REF1="ts1066" TIME_SLOT_REF2="ts1073">
                <ANNOTATION_VALUE>You depart at four fifty one, and you will travel for seventeen hours. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1034"
                TIME_SLOT_REF1="ts1144" TIME_SLOT_REF2="ts1154">
                <ANNOTATION_VALUE>Yes, there are only four places left for the way back.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1035"
                TIME_SLOT_REF1="ts1156" TIME_SLOT_REF2="ts1162">
                <ANNOTATION_VALUE>Eighteenth.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1038"
                TIME_SLOT_REF1="ts1166" TIME_SLOT_REF2="ts1173">
                <ANNOTATION_VALUE>But if you want to return on some other day, let me check again.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1043"
                TIME_SLOT_REF1="ts1188" TIME_SLOT_REF2="ts1190">
                <ANNOTATION_VALUE>Oh.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1044"
                TIME_SLOT_REF1="ts1192" TIME_SLOT_REF2="ts1195">
                <ANNOTATION_VALUE>That's why.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1129"
                TIME_SLOT_REF1="ts1566" TIME_SLOT_REF2="ts1571">
                <ANNOTATION_VALUE>The phone is cool.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1130"
                TIME_SLOT_REF1="ts1574" TIME_SLOT_REF2="ts1581">
                <ANNOTATION_VALUE>It actually costs a hundred and fourty thousand.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1131"
                TIME_SLOT_REF1="ts1582" TIME_SLOT_REF2="ts1586">
                <ANNOTATION_VALUE>We bought it on a discount.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1148"
                TIME_SLOT_REF1="ts1644" TIME_SLOT_REF2="ts1646">
                <ANNOTATION_VALUE>Who is also going with you?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1149"
                TIME_SLOT_REF1="ts1648" TIME_SLOT_REF2="ts1656">
                <ANNOTATION_VALUE> Who else is going there? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1170"
                TIME_SLOT_REF1="ts1736" TIME_SLOT_REF2="ts1744">
                <ANNOTATION_VALUE>Maybe we can book them online... I mean these houses. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1173"
                TIME_SLOT_REF1="ts1750" TIME_SLOT_REF2="ts1757">
                <ANNOTATION_VALUE>But I don't know.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1174"
                TIME_SLOT_REF1="ts1758" TIME_SLOT_REF2="ts1760">
                <ANNOTATION_VALUE>I can check tho.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1259"
                TIME_SLOT_REF1="ts2160" TIME_SLOT_REF2="ts2162">
                <ANNOTATION_VALUE>I did not understand this.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1260"
                TIME_SLOT_REF1="ts2164" TIME_SLOT_REF2="ts2166">
                <ANNOTATION_VALUE>Mom, look!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1268"
                TIME_SLOT_REF1="ts2168" TIME_SLOT_REF2="ts2193">
                <ANNOTATION_VALUE>The route of your train which goes from Oskemen to Zhalanashkol is Oskemen-1-Aktogay, yes?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1272"
                TIME_SLOT_REF1="ts2194" TIME_SLOT_REF2="ts2208">
                <ANNOTATION_VALUE>Its last stop is Aktogay.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1275"
                TIME_SLOT_REF1="ts2210" TIME_SLOT_REF2="ts2226">
                <ANNOTATION_VALUE>But the route of the train which for the way back is Dostyk-Aktogay.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1278"
                TIME_SLOT_REF1="ts2228" TIME_SLOT_REF2="ts2236">
                <ANNOTATION_VALUE>But it is saying that Oskemen is one of the stops in this route.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1281"
                TIME_SLOT_REF1="ts2238" TIME_SLOT_REF2="ts2240">
                <ANNOTATION_VALUE>But how is that possible in the route from Dostyk to Aktogay?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1288"
                TIME_SLOT_REF1="ts2258" TIME_SLOT_REF2="ts2262">
                <ANNOTATION_VALUE>Its time...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1289"
                TIME_SLOT_REF1="ts2269" TIME_SLOT_REF2="ts2276">
                <ANNOTATION_VALUE>The time it departs is sixteen fifty.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1296"
                TIME_SLOT_REF1="ts2288" TIME_SLOT_REF2="ts2290">
                <ANNOTATION_VALUE>No, it is the same train.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1298"
                TIME_SLOT_REF1="ts2304" TIME_SLOT_REF2="ts2307">
                <ANNOTATION_VALUE>Is she saying we get off at five thirty?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1299"
                TIME_SLOT_REF1="ts2308" TIME_SLOT_REF2="ts2312">
                <ANNOTATION_VALUE>That person?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1302"
                TIME_SLOT_REF1="ts2322" TIME_SLOT_REF2="ts2326">
                <ANNOTATION_VALUE>It says four fifty, four fifty one </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1305"
                TIME_SLOT_REF1="ts2332" TIME_SLOT_REF2="ts2334">
                <ANNOTATION_VALUE>No.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1306"
                TIME_SLOT_REF1="ts2336" TIME_SLOT_REF2="ts2342">
                <ANNOTATION_VALUE>I guess it departs righaway at four fifty.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1304"
                TIME_SLOT_REF1="ts2344" TIME_SLOT_REF2="ts2346">
                <ANNOTATION_VALUE>You get on it earlier.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1309"
                TIME_SLOT_REF1="ts2348" TIME_SLOT_REF2="ts2351">
                <ANNOTATION_VALUE>Don't you want to go to a place called Bukhtarma?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1310"
                TIME_SLOT_REF1="ts2352" TIME_SLOT_REF2="ts2354">
                <ANNOTATION_VALUE>Just in case.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1311"
                TIME_SLOT_REF1="ts2358" TIME_SLOT_REF2="ts2362">
                <ANNOTATION_VALUE>Don't you want to visit Bukhtarma?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1317"
                TIME_SLOT_REF1="ts2381" TIME_SLOT_REF2="ts2388">
                <ANNOTATION_VALUE>Yes, cool.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1320"
                TIME_SLOT_REF1="ts2390" TIME_SLOT_REF2="ts2394">
                <ANNOTATION_VALUE>They say the lake is good when you look at its composition. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1321"
                TIME_SLOT_REF1="ts2396" TIME_SLOT_REF2="ts2405">
                <ANNOTATION_VALUE>Its inside is like that of Alakol's. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1326"
                TIME_SLOT_REF1="ts2424" TIME_SLOT_REF2="ts2426">
                <ANNOTATION_VALUE>Oh, I see.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1332"
                TIME_SLOT_REF1="ts2444" TIME_SLOT_REF2="ts2448">
                <ANNOTATION_VALUE>You need to make a final decision.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1334"
                TIME_SLOT_REF1="ts2452" TIME_SLOT_REF2="ts2457">
                <ANNOTATION_VALUE>Are you calling Saryarka?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1335"
                TIME_SLOT_REF1="ts2458" TIME_SLOT_REF2="ts2464">
                <ANNOTATION_VALUE>You want to go to Saryarka?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1337"
                TIME_SLOT_REF1="ts2470" TIME_SLOT_REF2="ts2472">
                <ANNOTATION_VALUE>Mom, Saryarka is cool.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1338"
                TIME_SLOT_REF1="ts2474" TIME_SLOT_REF2="ts2477">
                <ANNOTATION_VALUE>The one me and mom went to together.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1341"
                TIME_SLOT_REF1="ts2478" TIME_SLOT_REF2="ts2482">
                <ANNOTATION_VALUE>The one we all went to.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1343"
                TIME_SLOT_REF1="ts2500" TIME_SLOT_REF2="ts2502">
                <ANNOTATION_VALUE>This Saryarka...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1344"
                TIME_SLOT_REF1="ts2504" TIME_SLOT_REF2="ts2508">
                <ANNOTATION_VALUE>Among all, Saryarka is the best, right mom? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
