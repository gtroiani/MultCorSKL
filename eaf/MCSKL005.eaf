        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1114"
                TIME_SLOT_REF1="ts1501" TIME_SLOT_REF2="ts1504">
                <ANNOTATION_VALUE>So cool for you!</ANNOTATION_VALUE>
