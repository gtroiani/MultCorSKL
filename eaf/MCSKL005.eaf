        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a764"
                TIME_SLOT_REF1="ts82" TIME_SLOT_REF2="ts86">
                <ANNOTATION_VALUE>Not Aksay.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a767"
                TIME_SLOT_REF1="ts88" TIME_SLOT_REF2="ts102">
                <ANNOTATION_VALUE>The train goes all the way to Zhalanashkol. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a773"
                TIME_SLOT_REF1="ts106" TIME_SLOT_REF2="ts117">
                <ANNOTATION_VALUE>Oskemen-Zhalanashkol</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a775"
                TIME_SLOT_REF1="ts120" TIME_SLOT_REF2="ts124">
                <ANNOTATION_VALUE>The train...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a776"
                TIME_SLOT_REF1="ts132" TIME_SLOT_REF2="ts146">
                <ANNOTATION_VALUE>Yes, but it is in East Kazakhstan.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a781"
                TIME_SLOT_REF1="ts152" TIME_SLOT_REF2="ts156">
                <ANNOTATION_VALUE>Asyl, it is on our side, not on Almaty's side.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a783"
                TIME_SLOT_REF1="ts158" TIME_SLOT_REF2="ts162">
                <ANNOTATION_VALUE>Not Almaty's side.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a784"
                TIME_SLOT_REF1="ts164" TIME_SLOT_REF2="ts170">
                <ANNOTATION_VALUE>Was it Urzhar region or no... something like that. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a790"
                TIME_SLOT_REF1="ts178" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a791"
                TIME_SLOT_REF1="ts184" TIME_SLOT_REF2="ts189">
                <ANNOTATION_VALUE>I am sitting here, bending and saying "yes".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a796"
                TIME_SLOT_REF1="ts206" TIME_SLOT_REF2="ts208">
                <ANNOTATION_VALUE>Is Balnur on a leave?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a798"
                TIME_SLOT_REF1="ts214" TIME_SLOT_REF2="ts216">
                <ANNOTATION_VALUE>It opens with my face.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a799"
                TIME_SLOT_REF1="ts218" TIME_SLOT_REF2="ts220">
                <ANNOTATION_VALUE>It opens when I do so.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a802"
                TIME_SLOT_REF1="ts230" TIME_SLOT_REF2="ts233">
                <ANNOTATION_VALUE>Get it swapped.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a803"
                TIME_SLOT_REF1="ts234" TIME_SLOT_REF2="ts242">
                <ANNOTATION_VALUE>Boys made it so that I can open it with my finger.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a807"
                TIME_SLOT_REF1="ts258" TIME_SLOT_REF2="ts265">
                <ANNOTATION_VALUE>When I am sleeping, someone can open it with my finger. Joking.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a811"
                TIME_SLOT_REF1="ts274" TIME_SLOT_REF2="ts280">
                <ANNOTATION_VALUE>Yes, openable with yourself only. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a812"
                TIME_SLOT_REF1="ts282" TIME_SLOT_REF2="ts286">
                <ANNOTATION_VALUE>If I wear glasses, it will not open.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a816"
                TIME_SLOT_REF1="ts298" TIME_SLOT_REF2="ts308">
                <ANNOTATION_VALUE>This son of mine always says to me "mom, lie down for a bit", "mom, are you tired", "mom, you lie down",  "don't do anything".    </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a818"
                TIME_SLOT_REF1="ts310" TIME_SLOT_REF2="ts316">
                <ANNOTATION_VALUE>Today, I got up from my bed feeling super bad.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a819"
                TIME_SLOT_REF1="ts318" TIME_SLOT_REF2="ts320">
                <ANNOTATION_VALUE>I said "let me go outside".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a820"
                TIME_SLOT_REF1="ts322" TIME_SLOT_REF2="ts326">
                <ANNOTATION_VALUE>I went out, feeling suffocated very bad. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a822"
                TIME_SLOT_REF1="ts332" TIME_SLOT_REF2="ts337">
                <ANNOTATION_VALUE>A moment ago.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a825"
                TIME_SLOT_REF1="ts342" TIME_SLOT_REF2="ts350">
                <ANNOTATION_VALUE>He vacuumed a bit, tidying up the place a bit today.   </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a827"
                TIME_SLOT_REF1="ts352" TIME_SLOT_REF2="ts356">
                <ANNOTATION_VALUE>But we actually cleaned the appartment, including the windows and everything just a while ago. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a831"
                TIME_SLOT_REF1="ts366" TIME_SLOT_REF2="ts368">
                <ANNOTATION_VALUE>Our young one is not domestic.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a835"
                TIME_SLOT_REF1="ts378" TIME_SLOT_REF2="ts380">
                <ANNOTATION_VALUE>"Do we have food?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a836"
                TIME_SLOT_REF1="ts382" TIME_SLOT_REF2="ts385">
                <ANNOTATION_VALUE>'What kind of food?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a837"
                TIME_SLOT_REF1="ts386" TIME_SLOT_REF2="ts388">
                <ANNOTATION_VALUE>"Oily..."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a840"
                TIME_SLOT_REF1="ts400" TIME_SLOT_REF2="ts404">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a877"
                TIME_SLOT_REF1="ts512" TIME_SLOT_REF2="ts518">
                <ANNOTATION_VALUE>No, it is possible to buy them online. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a883"
                TIME_SLOT_REF1="ts534" TIME_SLOT_REF2="ts543">
                <ANNOTATION_VALUE>Our day back...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a884"
                TIME_SLOT_REF1="ts546" TIME_SLOT_REF2="ts548">
                <ANNOTATION_VALUE>Asyl.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a889"
