        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1001"
                TIME_SLOT_REF1="ts1014" TIME_SLOT_REF2="ts1027">
                <ANNOTATION_VALUE>If we do not negotiate with taxis in advance before arriving there, our mobile balance will get wasted because our mobile network will enter the Chinese roaming zone.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1004"
