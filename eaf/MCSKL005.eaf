        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a999"
                TIME_SLOT_REF1="ts1000" TIME_SLOT_REF2="ts1010">
                <ANNOTATION_VALUE>Yes, at the border with China. </ANNOTATION_VALUE>
