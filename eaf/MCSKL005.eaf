        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1167"
                TIME_SLOT_REF1="ts1742" TIME_SLOT_REF2="ts1746">
                <ANNOTATION_VALUE>That's what I am saying.</ANNOTATION_VALUE>
