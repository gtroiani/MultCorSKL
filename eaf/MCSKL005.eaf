        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a777"
                TIME_SLOT_REF1="ts122" TIME_SLOT_REF2="ts127">
                <ANNOTATION_VALUE>Where is Zhalanashkol?</ANNOTATION_VALUE>
