        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1078"
                TIME_SLOT_REF1="ts1356" TIME_SLOT_REF2="ts1359">
                <ANNOTATION_VALUE>Let us now decide whether we are going or not first.</ANNOTATION_VALUE>
