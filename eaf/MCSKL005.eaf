        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1176"
                TIME_SLOT_REF1="ts1780" TIME_SLOT_REF2="ts1785">
                <ANNOTATION_VALUE>He is always like this.</ANNOTATION_VALUE>
