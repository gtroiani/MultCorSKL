        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a841"
                TIME_SLOT_REF1="ts402" TIME_SLOT_REF2="ts416">
                <ANNOTATION_VALUE>Hmm, there are tickets available for fifteenth  but not for fourteenth and sixteenth because the trains alternate, right?     </ANNOTATION_VALUE>
