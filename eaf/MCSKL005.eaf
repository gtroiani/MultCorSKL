        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1082"
                TIME_SLOT_REF1="ts1365" TIME_SLOT_REF2="ts1371">
                <ANNOTATION_VALUE>Oh, god!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1084"
                TIME_SLOT_REF1="ts1372" TIME_SLOT_REF2="ts1380">
                <ANNOTATION_VALUE>If we want to pay for tickets, we need to transfer the money to Asyl so that he can buy the tickets online easily.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1086"
                TIME_SLOT_REF1="ts1382" TIME_SLOT_REF2="ts1384">
                <ANNOTATION_VALUE>We need to send the money to Asyl's card.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1087"
                TIME_SLOT_REF1="ts1386" TIME_SLOT_REF2="ts1390">
                <ANNOTATION_VALUE>In that case, we need to buy a round-trip ticket. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1099"
                TIME_SLOT_REF1="ts1440" TIME_SLOT_REF2="ts1447">
                <ANNOTATION_VALUE>Was this your youngest?</ANNOTATION_VALUE>
