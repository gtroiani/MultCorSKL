        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1162"
                TIME_SLOT_REF1="ts1710" TIME_SLOT_REF2="ts1714">
                <ANNOTATION_VALUE>We will get something more expensive and more comfortable. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1163"
                TIME_SLOT_REF1="ts1718" TIME_SLOT_REF2="ts1722">
                <ANNOTATION_VALUE>Yes?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1165"
                TIME_SLOT_REF1="ts1724" TIME_SLOT_REF2="ts1732">
                <ANNOTATION_VALUE>Hmm, we need to buy tickets. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1166"
                TIME_SLOT_REF1="ts1734" TIME_SLOT_REF2="ts1738">
                <ANNOTATION_VALUE>I am saying that we should first sort the tickets...</ANNOTATION_VALUE>
