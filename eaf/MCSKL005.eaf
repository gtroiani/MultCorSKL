        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a778"
                TIME_SLOT_REF1="ts128" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>Is it in Alakol?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a813"
                TIME_SLOT_REF1="ts284" TIME_SLOT_REF2="ts288">
                <ANNOTATION_VALUE>Mom, for when?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a839"
                TIME_SLOT_REF1="ts390" TIME_SLOT_REF2="ts397">
                <ANNOTATION_VALUE>Hmm, apparently the train stops at the station called Zhalanashkol in the route "Oskemen-1-Aktogay".   </ANNOTATION_VALUE>
