        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1076"
                TIME_SLOT_REF1="ts1348" TIME_SLOT_REF2="ts1353">
                <ANNOTATION_VALUE>We can actually go there casually. </ANNOTATION_VALUE>
