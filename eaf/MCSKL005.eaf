        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a849"
                TIME_SLOT_REF1="ts418" TIME_SLOT_REF2="ts421">
                <ANNOTATION_VALUE>There are only sixty seven places left.</ANNOTATION_VALUE>
