        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1060"
                TIME_SLOT_REF1="ts1276" TIME_SLOT_REF2="ts1278">
                <ANNOTATION_VALUE>I just saw your pictures in the stories.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1061"
                TIME_SLOT_REF1="ts1280" TIME_SLOT_REF2="ts1282">
                <ANNOTATION_VALUE>Yes, may them be healthy.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1062"
                TIME_SLOT_REF1="ts1284" TIME_SLOT_REF2="ts1286">
                <ANNOTATION_VALUE>How did she become so unhealthy?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1063"
                TIME_SLOT_REF1="ts1288" TIME_SLOT_REF2="ts1292">
                <ANNOTATION_VALUE>It is just that I came to my friend's place as a guest. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1064"
                TIME_SLOT_REF1="ts1294" TIME_SLOT_REF2="ts1296">
                <ANNOTATION_VALUE>We are sitting.</ANNOTATION_VALUE>
