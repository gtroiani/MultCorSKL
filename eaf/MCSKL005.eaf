        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1171"
                TIME_SLOT_REF1="ts1766" TIME_SLOT_REF2="ts1769">
                <ANNOTATION_VALUE>You see?</ANNOTATION_VALUE>
