        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1059"
                TIME_SLOT_REF1="ts1272" TIME_SLOT_REF2="ts1275">
                <ANNOTATION_VALUE>Your mother-in-law has lost a lot of weight.</ANNOTATION_VALUE>
