        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1333"
                TIME_SLOT_REF1="ts2460" TIME_SLOT_REF2="ts2462">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1336"
                TIME_SLOT_REF1="ts2466" TIME_SLOT_REF2="ts2468">
                <ANNOTATION_VALUE>No, I wanted to learn about something.</ANNOTATION_VALUE>
