        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1116"
                TIME_SLOT_REF1="ts1506" TIME_SLOT_REF2="ts1510">
                <ANNOTATION_VALUE>Asyl added some of his money to buy this phone. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1117"
                TIME_SLOT_REF1="ts1512" TIME_SLOT_REF2="ts1518">
                <ANNOTATION_VALUE>Thirty thousand.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1118"
                TIME_SLOT_REF1="ts1520" TIME_SLOT_REF2="ts1524">
                <ANNOTATION_VALUE>Asyl added money to buy this. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1121"
                TIME_SLOT_REF1="ts1532" TIME_SLOT_REF2="ts1536">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1122"
                TIME_SLOT_REF1="ts1540" TIME_SLOT_REF2="ts1542">
                <ANNOTATION_VALUE>Rakhat told me to buy it on a loan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1123"
                TIME_SLOT_REF1="ts1544" TIME_SLOT_REF2="ts1547">
                <ANNOTATION_VALUE>I said no.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1124"
                TIME_SLOT_REF1="ts1548" TIME_SLOT_REF2="ts1554">
                <ANNOTATION_VALUE>I am paying loans for iPhone, vaccuum cleaner already. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1127"
                TIME_SLOT_REF1="ts1556" TIME_SLOT_REF2="ts1559">
                <ANNOTATION_VALUE>The other time, daughter went to Astana.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1128"
                TIME_SLOT_REF1="ts1560" TIME_SLOT_REF2="ts1565">
                <ANNOTATION_VALUE>For Kaspi Red...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1132"
                TIME_SLOT_REF1="ts1572" TIME_SLOT_REF2="ts1578">
                <ANNOTATION_VALUE>I got her a suitcase for Kaspi Red. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1133"
                TIME_SLOT_REF1="ts1584" TIME_SLOT_REF2="ts1588">
                <ANNOTATION_VALUE>For that daughter.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1134"
                TIME_SLOT_REF1="ts1590" TIME_SLOT_REF2="ts1597">
                <ANNOTATION_VALUE>I bought a suitcase with Kaspi Red for her. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1138"
                TIME_SLOT_REF1="ts1606" TIME_SLOT_REF2="ts1608">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1139"
                TIME_SLOT_REF1="ts1610" TIME_SLOT_REF2="ts1612">
                <ANNOTATION_VALUE>To put her clothes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1140"
                TIME_SLOT_REF1="ts1614" TIME_SLOT_REF2="ts1618">
                <ANNOTATION_VALUE>These girls want to have all these days. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1143"
                TIME_SLOT_REF1="ts1620" TIME_SLOT_REF2="ts1624">
                <ANNOTATION_VALUE>They do not like carrying bags made of fabric these days. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1153"
                TIME_SLOT_REF1="ts1672" TIME_SLOT_REF2="ts1679">
                <ANNOTATION_VALUE> Hey you, let's make sure we do not end up shelterless there once we get there. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1154"
                TIME_SLOT_REF1="ts1680" TIME_SLOT_REF2="ts1682">
                <ANNOTATION_VALUE>That..surely...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1155"
                TIME_SLOT_REF1="ts1684" TIME_SLOT_REF2="ts1688">
                <ANNOTATION_VALUE>It would be better if we had our room ready already,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1164"
                TIME_SLOT_REF1="ts1720" TIME_SLOT_REF2="ts1728">
                <ANNOTATION_VALUE>For that, we should get the tickets first. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1168"
                TIME_SLOT_REF1="ts1748" TIME_SLOT_REF2="ts1754">
                <ANNOTATION_VALUE>Can we book without paying money? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1172"
                TIME_SLOT_REF1="ts1762" TIME_SLOT_REF2="ts1764">
                <ANNOTATION_VALUE>Check please.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1178"
                TIME_SLOT_REF1="ts1772" TIME_SLOT_REF2="ts1776">
                <ANNOTATION_VALUE>Is that your oldest son?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1181"
                TIME_SLOT_REF1="ts1783" TIME_SLOT_REF2="ts1793">
                <ANNOTATION_VALUE>"This money was for groceries".</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1191"
                TIME_SLOT_REF1="ts1830" TIME_SLOT_REF2="ts1834">
                <ANNOTATION_VALUE>No, we need to buy a round-trip ticket. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1196"
                TIME_SLOT_REF1="ts1860" TIME_SLOT_REF2="ts1869">
                <ANNOTATION_VALUE>I do not have a son somewhere away for me to call. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1199"
                TIME_SLOT_REF1="ts1886" TIME_SLOT_REF2="ts1890">
                <ANNOTATION_VALUE>Are you crazy?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1202"
                TIME_SLOT_REF1="ts1902" TIME_SLOT_REF2="ts1907">
                <ANNOTATION_VALUE>Is he saying he will give you money?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1206"
                TIME_SLOT_REF1="ts1920" TIME_SLOT_REF2="ts1922">
                <ANNOTATION_VALUE>He just said ok.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1211"
                TIME_SLOT_REF1="ts1930" TIME_SLOT_REF2="ts1932">
                <ANNOTATION_VALUE>Your second son.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1216"
                TIME_SLOT_REF1="ts1958" TIME_SLOT_REF2="ts1963">
                <ANNOTATION_VALUE>Not for five days.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1217"
                TIME_SLOT_REF1="ts1964" TIME_SLOT_REF2="ts1970">
                <ANNOTATION_VALUE>For three.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1227"
                TIME_SLOT_REF1="ts2012" TIME_SLOT_REF2="ts2014">
                <ANNOTATION_VALUE>You won't manage.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1230"
                TIME_SLOT_REF1="ts2024" TIME_SLOT_REF2="ts2029">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1240"
                TIME_SLOT_REF1="ts2076" TIME_SLOT_REF2="ts2080">
                <ANNOTATION_VALUE>This...Asyl...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1241"
                TIME_SLOT_REF1="ts2079" TIME_SLOT_REF2="ts2084">
                <ANNOTATION_VALUE>Rakhat told me to take Asyl with myself.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1242"
                TIME_SLOT_REF1="ts2083" TIME_SLOT_REF2="ts2086">
                <ANNOTATION_VALUE>Asyl says he does not want to go,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1243"
                TIME_SLOT_REF1="ts2090" TIME_SLOT_REF2="ts2092">
                <ANNOTATION_VALUE>Was it Aksay?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1244"
                TIME_SLOT_REF1="ts2094" TIME_SLOT_REF2="ts2098">
                <ANNOTATION_VALUE>The place where those people stayed?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1247"
                TIME_SLOT_REF1="ts2102" TIME_SLOT_REF2="ts2104">
                <ANNOTATION_VALUE>Oh, the hell with it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1249"
                TIME_SLOT_REF1="ts2114" TIME_SLOT_REF2="ts2116">
                <ANNOTATION_VALUE>Take some.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1273"
                TIME_SLOT_REF1="ts2204" TIME_SLOT_REF2="ts2212">
                <ANNOTATION_VALUE> Yes, we get off at the statation.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1274"
                TIME_SLOT_REF1="ts2214" TIME_SLOT_REF2="ts2218">
                <ANNOTATION_VALUE>Station...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1285"
                TIME_SLOT_REF1="ts2260" TIME_SLOT_REF2="ts2264">
                <ANNOTATION_VALUE>Fourteen something..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1287"
                TIME_SLOT_REF1="ts2266" TIME_SLOT_REF2="ts2271">
                <ANNOTATION_VALUE>I guess sixteen something.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1293"
                TIME_SLOT_REF1="ts2292" TIME_SLOT_REF2="ts2294">
                <ANNOTATION_VALUE>"I am in Zhalanashkol"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1294"
                TIME_SLOT_REF1="ts2296" TIME_SLOT_REF2="ts2301">
                <ANNOTATION_VALUE>Because it is its station. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1301"
                TIME_SLOT_REF1="ts2316" TIME_SLOT_REF2="ts2319">
                <ANNOTATION_VALUE>And you get off at ten thirty in the morning.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1303"
                TIME_SLOT_REF1="ts2328" TIME_SLOT_REF2="ts2330">
                <ANNOTATION_VALUE>Yes, the same train!</ANNOTATION_VALUE>
