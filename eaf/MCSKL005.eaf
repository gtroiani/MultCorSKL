        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1136"
                TIME_SLOT_REF1="ts1602" TIME_SLOT_REF2="ts1604">
                <ANNOTATION_VALUE>For the trip?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1141"
                TIME_SLOT_REF1="ts1622" TIME_SLOT_REF2="ts1626">
                <ANNOTATION_VALUE>What's up Kulpash?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1142"
                TIME_SLOT_REF1="ts1628" TIME_SLOT_REF2="ts1632">
                <ANNOTATION_VALUE>You know I am at Nazgul's place. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1144"
                TIME_SLOT_REF1="ts1634" TIME_SLOT_REF2="ts1636">
                <ANNOTATION_VALUE>I missed her, so I got to her place today.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1145"
                TIME_SLOT_REF1="ts1638" TIME_SLOT_REF2="ts1641">
                <ANNOTATION_VALUE>You are missing.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1147"
                TIME_SLOT_REF1="ts1654" TIME_SLOT_REF2="ts1658">
                <ANNOTATION_VALUE>Hmmm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1151"
                TIME_SLOT_REF1="ts1660" TIME_SLOT_REF2="ts1669">
                <ANNOTATION_VALUE> One of my girl classmates was planning to go, but for some reason she is not answering her phone today. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1158"
                TIME_SLOT_REF1="ts1686" TIME_SLOT_REF2="ts1697">
                <ANNOTATION_VALUE> As long as we get the tickets first, finding a room is not a problem </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1159"
                TIME_SLOT_REF1="ts1698" TIME_SLOT_REF2="ts1700">
                <ANNOTATION_VALUE>There will be one for sure.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1160"
                TIME_SLOT_REF1="ts1702" TIME_SLOT_REF2="ts1704">
                <ANNOTATION_VALUE>Doesn't matter if the room is expensive.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1161"
                TIME_SLOT_REF1="ts1706" TIME_SLOT_REF2="ts1709">
                <ANNOTATION_VALUE>If it is a room for two, it is even better.</ANNOTATION_VALUE>
