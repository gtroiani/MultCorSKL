        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2066"
                TIME_SLOT_REF1="ts226" TIME_SLOT_REF2="ts248">
                <ANNOTATION_VALUE>When we were studying offline at school, our classes started at 9 AM till 3PM.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2067"
                TIME_SLOT_REF1="ts250" TIME_SLOT_REF2="ts264">
                <ANNOTATION_VALUE>And we started studying online, everyone was like and how will it be? And then they shortened our classes from 90 minutes till 45.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2068"
                TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts272">
                <ANNOTATION_VALUE>So, 90 minutes, and...</ANNOTATION_VALUE>
