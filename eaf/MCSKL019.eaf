        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2145"
                TIME_SLOT_REF1="ts418" TIME_SLOT_REF2="ts443">
                <ANNOTATION_VALUE>I've just remembered how we, being 5th or 6th graders, were sent to a very old cinema to watch a movie on Nazarbayev's life.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
