        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a736"
                TIME_SLOT_REF1="ts1038" TIME_SLOT_REF2="ts1048">
                <ANNOTATION_VALUE>It is because I have hyperfixation - I like remembering things.</ANNOTATION_VALUE>
