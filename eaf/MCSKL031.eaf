            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1418"
                TIME_SLOT_REF1="ts466" TIME_SLOT_REF2="ts492">
                <ANNOTATION_VALUE>It was compulsory for us, for example, but starting from this year you can take two of four hundred level courses instead of the capstone project.</ANNOTATION_VALUE>
