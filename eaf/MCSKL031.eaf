        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4300"
                TIME_SLOT_REF1="ts3198" TIME_SLOT_REF2="ts3212">
                <ANNOTATION_VALUE>She recevied a lot of complains, for example, last fall, most students were complaining but she was not fired. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4306"
                TIME_SLOT_REF1="ts3234" TIME_SLOT_REF2="ts3238">
                <ANNOTATION_VALUE>Well, it is strange.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4307"
                TIME_SLOT_REF1="ts3242" TIME_SLOT_REF2="ts3247">
                <ANNOTATION_VALUE>She received complaints every time, every semester. So, she also gets rebukes but nothing happens. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4734"
                TIME_SLOT_REF1="ts3249" TIME_SLOT_REF2="ts3272">
                <ANNOTATION_VALUE>They told us that the complaints were delivered, but somethos nothing changed. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4315"
                TIME_SLOT_REF1="ts3278" TIME_SLOT_REF2="ts3288">
