    <TIER LINGUISTIC_TYPE_REF="Translation" TIER_ID="trx_en@SPK6010">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1333"
                TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts7">
                <ANNOTATION_VALUE>Yes, classes are over already.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1334"
                TIME_SLOT_REF1="ts10" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>So, how did your Spring semester go?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3683"
                TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>QQQQ</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1338"
                TIME_SLOT_REF1="ts34" TIME_SLOT_REF2="ts40">
                <ANNOTATION_VALUE>Most importantly, I submitted my capstone, so I am chilling.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1341"
                TIME_SLOT_REF1="ts46" TIME_SLOT_REF2="ts48">
                <ANNOTATION_VALUE>Pardon?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1342"
                TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts58">
                <ANNOTATION_VALUE>No, you write it on your own.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1344"
                TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts62">
                <ANNOTATION_VALUE>Actually, capstone in linguistics is not good.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1345"
                TIME_SLOT_REF1="ts68" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>Basically, you do nothing the whole year.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1348"
                TIME_SLOT_REF1="ts76" TIME_SLOT_REF2="ts84">
                <ANNOTATION_VALUE>Not like you really do nothing but they keep telling you to do this or that.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1351"
                TIME_SLOT_REF1="ts88" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>Literature review was an useless thing to be honest.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1354"
                TIME_SLOT_REF1="ts96" TIME_SLOT_REF2="ts108">
                <ANNOTATION_VALUE>That's it. Capstone in Mathematics is cool, it goes only one semester in spring.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1358"
                TIME_SLOT_REF1="ts110" TIME_SLOT_REF2="ts124">
                <ANNOTATION_VALUE>And the capstone presentation, imagine that you write your capstone project for one year and they give you only five minutes to present it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1365"
                TIME_SLOT_REF1="ts134" TIME_SLOT_REF2="ts136">
                <ANNOTATION_VALUE>Five dash seven.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1366"
                TIME_SLOT_REF1="ts138" TIME_SLOT_REF2="ts140">
                <ANNOTATION_VALUE>I do not know.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1367"
                TIME_SLOT_REF1="ts142" TIME_SLOT_REF2="ts146">
                <ANNOTATION_VALUE>There are not so many of us, so they could have given us more time.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2184"
                TIME_SLOT_REF1="ts148" TIME_SLOT_REF2="ts158">
                <ANNOTATION_VALUE> Mathematics or engineering students were given thirty minutes for each one to present but we only had five minutes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1374"
                TIME_SLOT_REF1="ts166" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>It takes four minutes to only explain the topic.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1376"
                TIME_SLOT_REF1="ts182" TIME_SLOT_REF2="ts184">
                <ANNOTATION_VALUE>In front of people.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1377"
                TIME_SLOT_REF1="ts190" TIME_SLOT_REF2="ts192">
                <ANNOTATION_VALUE>I do not know.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1378"
                TIME_SLOT_REF1="ts200" TIME_SLOT_REF2="ts204">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1379"
                TIME_SLOT_REF1="ts206" TIME_SLOT_REF2="ts236">
                <ANNOTATION_VALUE>If I not mistaken, sociology students presented their capstone projects in front of other universities, not universities, but potential employers.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1390"
                TIME_SLOT_REF1="ts244" TIME_SLOT_REF2="ts246">
                <ANNOTATION_VALUE>Yes, you may skip the capstone project.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1391"
                TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts266">
                <ANNOTATION_VALUE>Starting from this year we, linguistics, to be specific WLLC students [may skip the capstone project].</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1394"
                TIME_SLOT_REF1="ts276" TIME_SLOT_REF2="ts290">
                <ANNOTATION_VALUE>Well, it is preferable to write one because it shows that you did an individual research on your own.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1400"
