    <TIER LINGUISTIC_TYPE_REF="Translation"  TIER_ID="trx_en@SPK3001">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a724"
                TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>Tell me? Who is going to give me money? Tell me. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a725"
                TIME_SLOT_REF1="ts10" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>I spend all of my money on food and that's it. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a726"
                TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts24">
                <ANNOTATION_VALUE>Every three days I go bring food and that's it. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a727"
                TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>Because we live in a village, we buy everything. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a728"
                TIME_SLOT_REF1="ts34" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>Except for meat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a729"
                TIME_SLOT_REF1="ts38" TIME_SLOT_REF2="ts40">
                <ANNOTATION_VALUE>All other stuff - we buy.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a730"
                TIME_SLOT_REF1="ts42" TIME_SLOT_REF2="ts48">
                <ANNOTATION_VALUE>I do not want to leave for city. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a731"
                TIME_SLOT_REF1="ts50" TIME_SLOT_REF2="ts56">
                <ANNOTATION_VALUE>Even when I am in the city for teacher courses, I barely feel comfortable and at east. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a734"
                TIME_SLOT_REF1="ts58" TIME_SLOT_REF2="ts66">
                <ANNOTATION_VALUE>I always want to leave for the village as soon as possible. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a737"
                TIME_SLOT_REF1="ts80" TIME_SLOT_REF2="ts82">
                <ANNOTATION_VALUE>Oh..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a738"
                TIME_SLOT_REF1="ts90" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>Mhm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a742"
                TIME_SLOT_REF1="ts100" TIME_SLOT_REF2="ts104">
                <ANNOTATION_VALUE>Oh I see.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a743"
                TIME_SLOT_REF1="ts118" TIME_SLOT_REF2="ts122">
                <ANNOTATION_VALUE>Mhm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a744"
                TIME_SLOT_REF1="ts130" TIME_SLOT_REF2="ts146">
                <ANNOTATION_VALUE>No, maintaining the place is not my concern. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a746"
                TIME_SLOT_REF1="ts159" TIME_SLOT_REF2="ts162">
                <ANNOTATION_VALUE>More time.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a747"
                TIME_SLOT_REF1="ts165" TIME_SLOT_REF2="ts174">
                <ANNOTATION_VALUE>For self-care... for yourself.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a749"
                TIME_SLOT_REF1="ts176" TIME_SLOT_REF2="ts180">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a750"
                TIME_SLOT_REF1="ts186" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>Oh.. I am already spending enough of my time and attention on kids...  I think no one else spends as much time as I do on kids...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a757"
                TIME_SLOT_REF1="ts224" TIME_SLOT_REF2="ts230">
                <ANNOTATION_VALUE>Oh my!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a764"
                TIME_SLOT_REF1="ts268" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>Of course. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a766"
                TIME_SLOT_REF1="ts290" TIME_SLOT_REF2="ts294">
                <ANNOTATION_VALUE>I am so fed up to be honest. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a768"
                TIME_SLOT_REF1="ts304" TIME_SLOT_REF2="ts306">
                <ANNOTATION_VALUE>Plus my legs hurt.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a769"
                TIME_SLOT_REF1="ts308" TIME_SLOT_REF2="ts314">
                <ANNOTATION_VALUE>I am just such a restless person. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a770"
                TIME_SLOT_REF1="ts316" TIME_SLOT_REF2="ts320">
                <ANNOTATION_VALUE>I have too much pressure on me. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a771"
                TIME_SLOT_REF1="ts322" TIME_SLOT_REF2="ts324">
                <ANNOTATION_VALUE>I am just a restless person.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a772"
                TIME_SLOT_REF1="ts326" TIME_SLOT_REF2="ts329">
                <ANNOTATION_VALUE>For me, everything must be spick-and-span.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a773"
                TIME_SLOT_REF1="ts330" TIME_SLOT_REF2="ts334">
                <ANNOTATION_VALUE>If there is one thing that is not the way I want, I go crazy. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a774"
                TIME_SLOT_REF1="ts336" TIME_SLOT_REF2="ts342">
                <ANNOTATION_VALUE>Tomorrow I have work.. from seven to eleven (in the morning).</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a775"
                TIME_SLOT_REF1="ts352" TIME_SLOT_REF2="ts354">
                <ANNOTATION_VALUE>That... you...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a777"
                TIME_SLOT_REF1="ts356" TIME_SLOT_REF2="ts358">
                <ANNOTATION_VALUE>where is that thing of that person?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a778"
                TIME_SLOT_REF1="ts360" TIME_SLOT_REF2="ts362">
                <ANNOTATION_VALUE>Where did I leave that?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a779"
                TIME_SLOT_REF1="ts364" TIME_SLOT_REF2="ts368">
                <ANNOTATION_VALUE>Give it to me... do not lift it. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a781"
                TIME_SLOT_REF1="ts370" TIME_SLOT_REF2="ts372">
                <ANNOTATION_VALUE>Let me just let it go.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a782"
                TIME_SLOT_REF1="ts378" TIME_SLOT_REF2="ts386">
                <ANNOTATION_VALUE>Give it to me, Nazgul. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a785"
                TIME_SLOT_REF1="ts390" TIME_SLOT_REF2="ts392">
                <ANNOTATION_VALUE>What?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a786"
                TIME_SLOT_REF1="ts396" TIME_SLOT_REF2="ts399">
                <ANNOTATION_VALUE>What do you mean?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a787"
                TIME_SLOT_REF1="ts407" TIME_SLOT_REF2="ts408">
                <ANNOTATION_VALUE/>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a788"
                TIME_SLOT_REF1="ts412" TIME_SLOT_REF2="ts417">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a789"
                TIME_SLOT_REF1="ts427" TIME_SLOT_REF2="ts434">
                <ANNOTATION_VALUE>Did you become besties after you scolded her? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a793"
                TIME_SLOT_REF1="ts436" TIME_SLOT_REF2="ts446">
                <ANNOTATION_VALUE>Look at ther eyelids. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a795"
                TIME_SLOT_REF1="ts448" TIME_SLOT_REF2="ts450">
                <ANNOTATION_VALUE>Of that...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a796"
                TIME_SLOT_REF1="ts452" TIME_SLOT_REF2="ts458">
                <ANNOTATION_VALUE>Where are my glasses?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a797"
                TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts466">
                <ANNOTATION_VALUE>Give my glasses to me.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a801"
                TIME_SLOT_REF1="ts472" TIME_SLOT_REF2="ts476">
                <ANNOTATION_VALUE>Oh I see.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a811"
                TIME_SLOT_REF1="ts512" TIME_SLOT_REF2="ts517">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a815"
                TIME_SLOT_REF1="ts546" TIME_SLOT_REF2="ts550">
                <ANNOTATION_VALUE>Oh dear, what are you saying...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a826"
                TIME_SLOT_REF1="ts602" TIME_SLOT_REF2="ts607">
                <ANNOTATION_VALUE>They are in the pushinka. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a829"
                TIME_SLOT_REF1="ts612" TIME_SLOT_REF2="ts616">
                <ANNOTATION_VALUE>That one that is very light...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a830"
                TIME_SLOT_REF1="ts618" TIME_SLOT_REF2="ts622">
                <ANNOTATION_VALUE>Yes that one...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a837"
                TIME_SLOT_REF1="ts670" TIME_SLOT_REF2="ts674">
                <ANNOTATION_VALUE>Give it to me.. Let me wash her face. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a838"
                TIME_SLOT_REF1="ts680" TIME_SLOT_REF2="ts688">
                <ANNOTATION_VALUE>Bring her slippers.. I will wash her face for her.. Go.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a843"
                TIME_SLOT_REF1="ts694" TIME_SLOT_REF2="ts698">
                <ANNOTATION_VALUE>Who?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a844"
                TIME_SLOT_REF1="ts704" TIME_SLOT_REF2="ts706">
                <ANNOTATION_VALUE>Why?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a856"
                TIME_SLOT_REF1="ts780" TIME_SLOT_REF2="ts782">
                <ANNOTATION_VALUE>Yes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a874"
                TIME_SLOT_REF1="ts872" TIME_SLOT_REF2="ts875">
                <ANNOTATION_VALUE>What?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a877"
                TIME_SLOT_REF1="ts880" TIME_SLOT_REF2="ts883">
                <ANNOTATION_VALUE>Why?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a896"
                TIME_SLOT_REF1="ts984" TIME_SLOT_REF2="ts1048">
                <ANNOTATION_VALUE>"I want to live in a city".... I say in the city...two days and my brain...No he is saying this since yesterday... he says "aunt Bayan I want you to live in the city.. aunt Monshak says it is very easy to live in the city..."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a903"
                TIME_SLOT_REF1="ts1060" TIME_SLOT_REF2="ts1089">
                <ANNOTATION_VALUE>Asyl, I get all oft. But I have no money for that.. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a906"
                TIME_SLOT_REF1="ts1090" TIME_SLOT_REF2="ts1099">
                <ANNOTATION_VALUE>No money.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a912"
                TIME_SLOT_REF1="ts1130" TIME_SLOT_REF2="ts1150">
                <ANNOTATION_VALUE>Oh my god! Until they grow up, nothing... I am literally feeding them off my mouth... What are you talking about?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a915"
                TIME_SLOT_REF1="ts1154" TIME_SLOT_REF2="ts1156">
                <ANNOTATION_VALUE>How can I possibly save money...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a916"
                TIME_SLOT_REF1="ts1158" TIME_SLOT_REF2="ts1163">
                <ANNOTATION_VALUE>I am feeding the entire family.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a917"
                TIME_SLOT_REF1="ts1172" TIME_SLOT_REF2="ts1182">
                <ANNOTATION_VALUE>I cannot help but bring something to my relatives every time I visit them.. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a918"
                TIME_SLOT_REF1="ts1184" TIME_SLOT_REF2="ts1190">
                <ANNOTATION_VALUE>How can I then save money after this? </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a920"
                TIME_SLOT_REF1="ts1192" TIME_SLOT_REF2="ts1194">
                <ANNOTATION_VALUE>I do not earn millions.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a921"
                TIME_SLOT_REF1="ts1204" TIME_SLOT_REF2="ts1214">
                <ANNOTATION_VALUE>No, that Asyl also says that... after we began talking about the city. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a923"
                TIME_SLOT_REF1="ts1218" TIME_SLOT_REF2="ts1222">
                <ANNOTATION_VALUE>Yes, money talk.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a924"
                TIME_SLOT_REF1="ts1225" TIME_SLOT_REF2="ts1228">
                <ANNOTATION_VALUE>She [aunt Zhanat], just the other day, said...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
