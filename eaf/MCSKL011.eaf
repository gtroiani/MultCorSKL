    <TIER LINGUISTIC_TYPE_REF="Translation"  TIER_ID="trx_en@SPK0014">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a732"
                TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts68">
                <ANNOTATION_VALUE>Oh. You will get used to it. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a733"
                TIME_SLOT_REF1="ts70" TIME_SLOT_REF2="ts72">
                <ANNOTATION_VALUE>Like aunt Monshak.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a735"
                TIME_SLOT_REF1="ts74" TIME_SLOT_REF2="ts86">
                <ANNOTATION_VALUE>Aunt Monshak herself says now that city is way better than village. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a736"
                TIME_SLOT_REF1="ts88" TIME_SLOT_REF2="ts98">
                <ANNOTATION_VALUE>She says that living in an apartment is easy [i.e., isn’t very demanding when it comes to chores.]</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a739"
                TIME_SLOT_REF1="ts102" TIME_SLOT_REF2="ts107">
                <ANNOTATION_VALUE>You know what..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a740"
                TIME_SLOT_REF1="ts108" TIME_SLOT_REF2="ts116">
                <ANNOTATION_VALUE>Let's say you buy a two- or three-bedroom apartment, right... </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a741"
                TIME_SLOT_REF1="ts120" TIME_SLOT_REF2="ts128">
                <ANNOTATION_VALUE>Maintaining such an area is just nothing. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a745"
                TIME_SLOT_REF1="ts132" TIME_SLOT_REF2="ts178">
                <ANNOTATION_VALUE>Once you mop the floors that is it... You will have more of what ... you know... more time... for self-care...for yourself.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a748"
                TIME_SLOT_REF1="ts182" TIME_SLOT_REF2="ts184">
                <ANNOTATION_VALUE>For children.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a751"
                TIME_SLOT_REF1="ts192" TIME_SLOT_REF2="ts196">
                <ANNOTATION_VALUE>Like I mean...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a752"
                TIME_SLOT_REF1="ts198" TIME_SLOT_REF2="ts202">
                <ANNOTATION_VALUE>like this..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a753"
                TIME_SLOT_REF1="ts204" TIME_SLOT_REF2="ts209">
                <ANNOTATION_VALUE>sitting by you..</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a754"
                TIME_SLOT_REF1="ts210" TIME_SLOT_REF2="ts212">
                <ANNOTATION_VALUE>like this...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a755"
                TIME_SLOT_REF1="ts214" TIME_SLOT_REF2="ts218">
                <ANNOTATION_VALUE>But here you always have work... </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
